rules_version = '2';

// Iantopia Firestore rules. Previously these lived only in the Firebase
// console, which is why the leaderboards and village visits were refused
// ("Missing or insufficient permissions") -- nothing here was ever set.
//
// Deploy with:  firebase deploy --only firestore:rules
// or paste this file into Firebase console > Firestore > Rules.
//
// Trust model: players write their own save data directly, but the Strubles
// balance and anything that moves money is written only by the arena server
// (arena-server/wallet.js), so a browser can't change a balance. These rules
// stop anyone from writing someone else's document, and keep private data private.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each player's own save data. Only the owner reads or writes it.
    // The wallet is server-owned: the balance, the claims and the gain record are
    // written only by the arena server (Admin SDK), so a browser can't write them
    // or change them. Everything else in the save is the player's own.
    match /users/{uid} {
      function serverOwned(k) {
        return request.resource.data.get(k, null) == resource.data.get(k, null);
      }
      function noServerFields(d) {
        return !('strubles_balance_v1' in d) && !('wallet_claims' in d) && !('wallet_seen' in d)
          && !('strubles_last_gain_v1' in d) && !('wallet_last_op' in d) && !('wallet_rounds' in d) && !('wallet_budget' in d) && !('paid_ids_v1' in d) && !('balance_reset_at' in d) && !('ban_until' in d)
          && !('cheat_warning_at' in d) && !('admin_warning' in d) && !('gift_day' in d);
      }
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !(exists(/databases/$(database)/documents/bans/$(request.auth.uid)) && get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until > request.time)
        && request.resource.size() < 200000
        && noServerFields(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && !(exists(/databases/$(database)/documents/bans/$(request.auth.uid)) && get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until > request.time)
        && request.resource.size() < 200000
        && serverOwned('strubles_balance_v1') && serverOwned('wallet_claims') && serverOwned('wallet_seen')
        && serverOwned('strubles_last_gain_v1') && serverOwned('wallet_last_op') && serverOwned('wallet_rounds') && serverOwned('wallet_budget') && serverOwned('paid_ids_v1') && serverOwned('balance_reset_at') && serverOwned('ban_until')
        && serverOwned('cheat_warning_at') && serverOwned('admin_warning') && serverOwned('gift_day');
    }

    // Public boards: anyone can read, only the owner writes their own row.
    // Field shapes are checked, and values must be plausible ranges. A
    // cheater can still post any value inside those ranges.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && !(exists(/databases/$(database)/documents/bans/$(request.auth.uid)) && get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until > request.time)
        && request.resource.data.gdp is number && request.resource.data.gdp >= 0
        && request.resource.data.efficiency is number && request.resource.data.efficiency >= 0
        && request.resource.data.buildings is number && request.resource.data.buildings >= 0 && request.resource.data.buildings <= 1000
        && request.resource.data.population is number && request.resource.data.population >= 0 && request.resource.data.population <= 1000000
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40;
    }
    match /minesweeper_leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && !(exists(/databases/$(database)/documents/bans/$(request.auth.uid)) && get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until > request.time)
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40;
    }

    // Bans are written only by the server (Admin SDK bypasses these rules).
    // Clients may never read or write them, so a ban can't be lifted from
    // the browser.
    match /bans/{uid} {
      allow read, write: if false;
    }
    match /horse_leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && !(exists(/databases/$(database)/documents/bans/$(request.auth.uid)) && get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until > request.time);
    }

    // Village snapshots back the public visit page. A village is readable by visitors
    // only while its owner has opted in (visitable == true). Only the owner can publish
    // or change their village.
    match /village_snapshots/{uid} {
      allow read: if (resource != null && resource.data.visitable == true)
        || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;

      // Likes: anyone signed in can like a village once, as themselves.
      // The like's document id is the liker's uid, so one like per person.
      match /likes/{likerUid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == likerUid;
        allow update, delete: if false;
      }

      // Gifts and notes into the village. The server writes them (Admin SDK bypasses
      // these rules), so a browser can't create any. The owner can read their own inbox.
      match /gifts/{giftId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update, delete: if false;
      }
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
