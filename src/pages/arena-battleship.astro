<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Arena: Battleship</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0a0c12">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style is:global>
  :root { --bg:#0f1115; --panel:#161c27; --ink:#e9eef9; --muted:#9fb0cf; --gold:#ffd700; }
  * { box-sizing:border-box; cursor:none !important; }
  html, body { margin:0; height:100%; }
  body { height:100dvh; display:flex; flex-direction:column; color:var(--ink); font-family: 'Press Start 2P', ui-monospace; cursor:none; background:#0f1115; background-image: url('/Taiwan%20Strait.png'); background-size: cover; background-position: center; background-attachment: fixed; position:relative; overflow:hidden; }
  body::before { content:''; position:fixed; inset:0; z-index:-1; background:rgba(0,0,0,.5); pointer-events:none; }

  main { flex:1; display:flex; flex-direction:column; padding:20px; max-width:1200px; margin:0 auto; width:100%; position:relative; z-index:1; }
  .top-bar { display:flex; justify-content:space-between; margin-bottom:20px; align-items:center; }
  .balance { font-size:11px; color:var(--gold); background:rgba(0,0,0,.5); padding:8px 12px; border:2px solid var(--gold); }
  .title { font-size:18px; color:var(--gold); font-weight:700; text-shadow:0 0 10px rgba(255,215,0,.5); }

  .back-link { position:fixed; top:20px; left:20px; color:var(--gold); text-decoration:none; border:2px solid #000; padding:6px 10px; background:#000; font-size:9px; font-weight:700; z-index:2; }

  /* SETUP PHASE */
  .phase-setup { display:flex; gap:20px; flex:1; }
  .ship-palette { background:rgba(0,0,0,.4); border:2px solid var(--gold); padding:15px; width:150px; overflow-y:auto; }
  .ship-item { background:rgba(255,215,0,.1); border:1px solid var(--gold); padding:8px; margin-bottom:8px; font-size:9px; color:var(--gold); cursor:pointer; border-radius:4px; }
  .ship-item:hover { background:rgba(255,215,0,.2); }

  .grid-container { flex:1; display:flex; flex-direction:column; background:rgba(0,0,0,.4); border:2px solid var(--gold); padding:15px; }
  .grid-controls { display:flex; gap:10px; margin-bottom:10px; flex-wrap:nowrap; }
  .grid-btn { background:var(--gold); color:#000; border:none; padding:6px 12px; font-size:9px; font-weight:700; cursor:pointer; border-radius:4px; flex:1; min-width:70px; }
  .grid-btn:hover { background:#ffe766; }

  .grid { display:grid; grid-template-columns:repeat(10, 1fr); gap:2px; flex:1; }
  .grid-cell { aspect-ratio:1; background:rgba(0,100,150,.3); border:1px solid rgba(255,215,0,.3); cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:8px; position:relative; }
  .grid-cell:hover { background:rgba(0,150,200,.4); }
  .grid-cell.water { background:rgba(0,100,150,.2); }
  .grid-cell.ship { background:rgba(100,100,100,.4); border-color:var(--gold); }
  .grid-cell.preview { background:rgba(255,215,0,.3); animation:pulse 0.5s infinite; }
  @keyframes pulse { 0%,100% { opacity:0.3; } 50% { opacity:0.7; } }

  .ship-sprite { background-size:contain; background-repeat:no-repeat; background-position:center; filter:drop-shadow(0 0 4px rgba(255,215,0,.4)); }
  @keyframes shipPlace { 0% { transform:scale(0.8); opacity:0; } 100% { transform:scale(1); opacity:1; } }
  .grid-cell.placing .ship-sprite { animation:shipPlace 0.3s ease-out; }
  @keyframes hitFlash { 0%,100% { filter:brightness(1); } 50% { filter:brightness(1.5) drop-shadow(0 0 8px #ff0000); } }
  .board-cell.hit { animation:hitFlash 0.4s; }
  @keyframes missRipple { 0% { transform:scale(1); opacity:1; } 100% { transform:scale(1.3); opacity:0; } }
  .board-cell.miss { animation:missRipple 0.5s ease-out; }

  .grid-label-h { display:grid; grid-template-columns:repeat(10, 1fr); gap:2px; margin-bottom:5px; }
  .grid-label-v { font-size:8px; color:var(--gold); font-weight:700; text-align:center; width:20px; }
  .label-cell { text-align:center; font-size:8px; color:var(--gold); font-weight:700; }

  .setup-status { font-size:10px; color:var(--muted); margin-top:10px; }

  /* BATTLE PHASE */
  .phase-battle { display:grid; grid-template-columns:1fr 1fr; gap:20px; flex:1; }
  .battle-board { background:rgba(0,0,0,.4); border:2px solid var(--gold); padding:clamp(10px, 2vw, 20px); display:flex; flex-direction:column; }
  @media (max-width:1024px) {
    .phase-battle { grid-template-columns:1fr; gap:15px; }
  }
  @media (max-width:768px) {
    .phase-setup { flex-direction:column; gap:15px; }
    .ship-palette { width:100%; height:auto; max-height:150px; }
    .grid-container { flex:1; min-height:300px; }
    main { padding:10px; }
    .grid-cell, .board-cell { font-size:6px; }
  }
  .board-title { font-size:12px; color:var(--gold); margin-bottom:10px; font-weight:700; }
  .board-grid { display:grid; grid-template-columns:repeat(10, 1fr); gap:2px; flex:1; }
  .board-cell { aspect-ratio:1; background:rgba(0,100,150,.2); border:1px solid rgba(255,215,0,.3); cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .board-cell:hover { background:rgba(0,150,200,.4); }
  .board-cell.hit { background:#ff3333; border-color:#ff0000; }
  .board-cell.miss { background:#3366ff; border-color:#0000ff; }
  .board-cell.ship { background:rgba(100,100,100,.4); border-color:var(--gold); }
  .board-cell.sunk { background:#aa0000; }

  .turn-indicator { font-size:10px; color:var(--muted); margin-top:10px; }
  .turn-indicator.active { color:#00ff00; font-weight:700; }

  /* RESULT PHASE */
  .phase-result { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; }
  .result-banner { background:rgba(0,0,0,.6); border:3px solid var(--gold); padding:30px; text-align:center; }
  .result-text { font-size:16px; color:var(--gold); margin:0; }
  .result-payout { font-size:14px; color:#00ff00; margin-top:10px; }
  .result-button { background:var(--gold); color:#000; border:none; padding:10px 20px; font-size:11px; font-weight:700; cursor:pointer; margin-top:20px; border-radius:4px; }
  .result-button:hover { background:#ffe766; }

  /* Now Playing modal -- same structure/classes as every other page's
     picker so Arena feels like one system with the rest of the site. */
  .overlay{ position:fixed; inset:0; background:rgba(0,0,0,.85); z-index:100; display:none; align-items:center; justify-content:center; padding:20px; }
  .overlay.open{ display:flex; }
  .modal{ width:min(360px,90vw); max-height:70vh; overflow-y:auto; background:#0a0a0a; border:3px solid var(--gold); padding:20px; box-shadow:0 0 20px rgba(255,215,0,.4); }
  .modal-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; gap:10px; }
  .modal-head h2{ margin:0; font-size:12px; color:var(--gold); font-weight:400; }
  .btn{ color:var(--gold); text-decoration:none; border:3px solid var(--gold); padding:8px 12px; background:#000; font-size:9px; transition:background .2s, color .2s; cursor:none; font-family:inherit; letter-spacing:1px; text-transform:uppercase; }
  .btn:hover{ background:var(--gold); color:#000; }
  .picker-row { display:flex; align-items:center; padding:6px 0; border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:11px; }
  .picker-row:last-child { border-bottom:none; }
  .volume-row{ display:flex; align-items:center; gap:10px; margin-bottom:16px; padding-bottom:14px; border-bottom:1px solid rgba(255,215,0,0.3); }
  .volume-row input[type="range"]{ flex:1; accent-color:var(--gold); cursor:none; touch-action:none; padding:14px 0; }
  .volume-mute-btn{ all:unset; cursor:none; font-size:16px; padding:4px 8px; border:1px solid var(--gold); background:#000; }
  #now-playing { position:fixed; bottom:20px; right:20px; z-index:20; color:var(--gold); background:#000; border:3px solid var(--gold); padding:10px 14px; font-size:14px; cursor:none; transition:background 0.2s; }
  #now-playing:hover { background:var(--gold); color:#000; }

  /* BET PHASE (lobby browsing) */
  .phase-bet { background:rgba(0,0,0,.4); border:2px solid var(--gold); padding:20px; max-width:400px; margin:0 auto; }
  .bet-input { background:#000; border:2px solid var(--gold); color:var(--gold); padding:8px; font-family:inherit; font-size:11px; width:100%; margin-bottom:10px; box-sizing:border-box; }
  .bet-btn { color:#000; background:var(--gold); border:2px solid #000; padding:8px 12px; font-size:10px; font-weight:700; width:100%; cursor:pointer; }
  .bet-btn:hover { background:#ffe766; }
  .bet-status { font-size:9px; color:var(--muted); margin:10px 0; }
  #lobby-list { margin-top:15px; }
  #lobby-list-heading { font-size:9px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px; }
  .lobby-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:8px 10px; border:2px solid rgba(255,215,0,.3); margin-bottom:6px; background:rgba(255,215,0,.05); }
  .lobby-row .lobby-bet { font-size:11px; color:var(--gold); }
  .lobby-row.own { border-color:rgba(255,215,0,.6); background:rgba(255,215,0,.1); }
  .lobby-row.own .lobby-bet::after { content:' (yours — waiting)'; color:var(--muted); font-size:9px; }
  .lobby-row button { color:#000; background:var(--gold); border:2px solid #000; padding:6px 10px; font-size:9px; font-weight:700; cursor:pointer; }
  .lobby-row button:hover { background:#ffe766; }
  #lobby-empty { font-size:9px; color:var(--muted); padding:8px 0; }
</style>
</head>
<body>
  <a href="/arena" class="back-link">← Arena</a>
  <main>
    <div class="top-bar">
      <div class="title">⚓ Battleship 1v1</div>
      <div class="balance">Balance: <span id="balance">0</span> Strubles</div>
    </div>

    <!-- BET PHASE (lobby browsing) -->
    <div id="phase-bet" class="phase-bet">
      <div class="bet-status">Enter a bet to open a lobby, or match one below</div>
      <input type="number" id="bet-input" class="bet-input" min="100" step="100" placeholder="Bet amount" />
      <button id="find-match" class="bet-btn">Open Lobby</button>
      <div class="bet-status" id="status-message"></div>

      <div id="lobby-list">
        <div id="lobby-list-heading">Open Lobbies</div>
        <div id="lobby-rows"></div>
        <div id="lobby-empty">No open lobbies yet — be the first to place a bet.</div>
      </div>
    </div>

    <!-- SETUP PHASE -->
    <div id="phase-setup" class="phase-setup" style="display:none;">
      <div class="ship-palette">
        <div style="font-size:10px; color:var(--gold); margin-bottom:10px;">Ships</div>
        <div id="ship-list"></div>
      </div>
      <div class="grid-container">
        <div class="grid-controls">
          <button class="grid-btn" id="rotate-btn">Rotate (R)</button>
          <button class="grid-btn" id="clear-btn">Clear All</button>
          <button class="grid-btn" id="ready-btn">Ready!</button>
        </div>
        <div style="display:flex; gap:10px; margin-bottom:10px;">
          <div class="grid-label-v" style="width:auto;"></div>
          <div class="grid-label-h" id="grid-header"></div>
        </div>
        <div style="display:flex; gap:10px;">
          <div id="grid-labels" style="display:flex; flex-direction:column; gap:2px;"></div>
          <div class="grid" id="grid-placement"></div>
        </div>
        <div class="setup-status" id="setup-status">Place all ships to continue...</div>
      </div>
    </div>

    <!-- BATTLE PHASE -->
    <div id="phase-battle" class="phase-battle" style="display:none;">
      <div class="battle-board">
        <div class="board-title">Your Fleet</div>
        <div class="board-grid" id="grid-your"></div>
      </div>
      <div class="battle-board">
        <div class="board-title">Enemy Radar</div>
        <div class="board-grid" id="grid-enemy"></div>
        <div class="turn-indicator" id="turn-indicator">Waiting for opponent...</div>
      </div>
    </div>

    <!-- RESULT PHASE -->
    <div id="phase-result" class="phase-result" style="display:none;">
      <div class="result-banner">
        <p class="result-text" id="result-text">Victory!</p>
        <p class="result-payout" id="result-payout">+5000 Strubles</p>
        <button class="result-button" id="back-lobby-btn">Back to Lobby</button>
      </div>
    </div>
  </main>

  <button id="now-playing" title="Music options">🎵</button>

  <!-- Music Playlist Modal -->
  <div class="overlay" id="playlist-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Now Playing</h2>
        <button class="btn" id="playlist-close" type="button">Close</button>
      </div>
      <div class="volume-row">
        <button class="volume-mute-btn" id="mute-btn" aria-label="Toggle sound" title="Toggle sound">🔊</button>
        <input type="range" id="volume-slider" min="0" max="100" value="50" aria-label="Music volume" />
      </div>
      <div id="playlist-list"></div>
    </div>
  </div>

  <audio id="theme-music" src="/audio/music/koronba-ryegen.mp3" preload="auto" loop></audio>

<script is:inline src="/cursor-library.js?v=4"></script>
<script is:inline src="/cursor.js?v=3"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<script is:inline src="/cloud-sync.js?v=9"></script>
<script is:inline src="/strubles.js?v=3"></script>
<script is:inline src="/battleship-sprites.js"></script>
<script is:inline src="/music-library.js?v=13"></script>
<script is:inline src="/music-position.js?v=1"></script>
<script is:inline>
  // Koronba plays for free on Arena Battleship -- tactical intensity to match.
  window.PAGE_FREE_TRACK_KEY = 'koronba';
</script>
<script is:inline src="/pickers.js?v=11"></script>
<script is:inline>
(() => {
  const themeMusic = document.getElementById('theme-music');
  const VOLUME_KEY = 'music_volume_v1';
  const volumeSlider = document.getElementById('volume-slider');
  const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
  themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.5;
  volumeSlider.value = Math.round(themeMusic.volume * 100);
  volumeSlider.addEventListener('input', () => {
    themeMusic.volume = volumeSlider.value / 100;
    localStorage.setItem(VOLUME_KEY, themeMusic.volume);
  });

  let audioEnabled = true;
  function tryPlayTheme() {
    if (!audioEnabled) return;
    themeMusic.play().catch(() => {});
  }
  tryPlayTheme();
  const unlockTheme = () => {
    tryPlayTheme();
    window.removeEventListener('pointerdown', unlockTheme);
    window.removeEventListener('keydown', unlockTheme);
  };
  window.addEventListener('pointerdown', unlockTheme);
  window.addEventListener('keydown', unlockTheme);

  const muteBtn = document.getElementById('mute-btn');
  muteBtn.addEventListener('click', () => {
    audioEnabled = !audioEnabled;
    muteBtn.textContent = audioEnabled ? '🔊' : '🔇';
    if (audioEnabled) tryPlayTheme();
    else themeMusic.pause();
  });

  // Sound effects
  const SFX = {
    place: new Audio('/audio/sfx/minesweeper-reveal.mp3'),
    hit: new Audio('/audio/sfx/lootbox-win.mp3'),
    miss: new Audio('/audio/sfx/minesweeper-unflag.mp3'),
    sink: new Audio('/audio/sfx/jackpot-win.mp3')
  };

  Object.values(SFX).forEach(sfx => { sfx.volume = 0.6; });

  const SHIP_TYPES = [
    { name: 'Carrier', size: 5 },
    { name: 'Battleship', size: 4 },
    { name: 'Cruiser', size: 3 },
    { name: 'Submarine', size: 3 },
    { name: 'Destroyer', size: 2 }
  ];

  const WS_URL = window.location.protocol === 'https:' ? 'wss://iantopia.com/arena-ws/battleship' : 'ws://localhost:4001';
  let ws = null;
  let phase = 'bet'; // bet, setup, battle, result
  let grid = Array(10).fill(null).map(() => Array(10).fill(0));
  let placedShips = [];
  let selectedShip = null;
  let horizontal = true;
  let yourIndex = null;
  let opponentGrid = Array(10).fill(null).map(() => Array(10).fill(0));
  let myQueueId = null;

  function updateBalance() {
    document.getElementById('balance').textContent = Strubles.get().toLocaleString();
  }

  function showPhase(p) {
    document.getElementById('phase-bet').style.display = p === 'bet' ? 'block' : 'none';
    document.getElementById('phase-setup').style.display = p === 'setup' ? 'flex' : 'none';
    document.getElementById('phase-battle').style.display = p === 'battle' ? 'grid' : 'none';
    document.getElementById('phase-result').style.display = p === 'result' ? 'flex' : 'none';
    phase = p;
  }

  function showStatus(msg) {
    document.getElementById('status-message').textContent = msg;
  }

  function renderLobbies(lobbies) {
    const container = document.getElementById('lobby-rows');
    const empty = document.getElementById('lobby-empty');
    const relevant = lobbies.filter(l => l.gameType === 'battleship');
    container.innerHTML = '';
    if (relevant.length === 0) {
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';
    relevant.forEach((lobby) => {
      const isOwn = lobby.queueId === myQueueId;
      const row = document.createElement('div');
      row.className = 'lobby-row' + (isOwn ? ' own' : '');
      const betSpan = document.createElement('span');
      betSpan.className = 'lobby-bet';
      betSpan.textContent = `${lobby.bet.toLocaleString()} Strubles`;
      row.appendChild(betSpan);
      if (!isOwn) {
        const btn = document.createElement('button');
        btn.textContent = 'Match Bet';
        btn.addEventListener('click', () => {
          if (!ws || ws.readyState !== WebSocket.OPEN) return;
          ws.send(JSON.stringify({ type: 'match_bet', queueId: lobby.queueId }));
        });
        row.appendChild(btn);
      }
      container.appendChild(row);
    });
  }

  function initSetupPhase() {
    showPhase('setup');
    grid = Array(10).fill(null).map(() => Array(10).fill(0));
    placedShips = [];
    renderGridSetup();
    renderShipPalette();
  }

  function renderShipPalette() {
    const palette = document.getElementById('ship-list');
    palette.innerHTML = SHIP_TYPES.map(ship =>
      `<div class="ship-item" data-ship="${ship.name}" style="opacity:${placedShips.find(s => s.name === ship.name) ? 0.5 : 1}">${ship.name} (${ship.size})</div>`
    ).join('');
    document.querySelectorAll('.ship-item').forEach(el => {
      el.addEventListener('click', () => selectShip(el.dataset.ship));
    });
  }

  function selectShip(name) {
    if (placedShips.find(s => s.name === name)) return;
    selectedShip = name;
    renderGridSetup();
  }

  function renderGridSetup() {
    // Header
    const header = document.getElementById('grid-header');
    header.innerHTML = 'ABCDEFGHIJ'.split('').map(c => `<div class="label-cell">${c}</div>`).join('');

    // Grid labels
    const labels = document.getElementById('grid-labels');
    labels.innerHTML = '1234567890'.split('').map((n, i) => `<div class="grid-label-v">${i+1}</div>`).join('');

    // Grid cells
    const gridEl = document.getElementById('grid-placement');
    gridEl.innerHTML = '';
    for (let y = 0; y < 10; y++) {
      for (let x = 0; x < 10; x++) {
        const cell = document.createElement('div');
        cell.className = 'grid-cell';
        if (grid[y][x]) {
          cell.classList.add('ship', 'placing');
          // Find which ship occupies this cell and render it
          for (const ship of placedShips) {
            const shipDef = SHIP_TYPES.find(s => s.name === ship.name);
            let occupies = false;
            if (ship.horizontal) {
              occupies = ship.y === y && x >= ship.x && x < ship.x + shipDef.size;
            } else {
              occupies = ship.x === x && y >= ship.y && y < ship.y + shipDef.size;
            }
            if (occupies && x === ship.x && y === ship.y) {
              // Only render sprite at ship's origin
              const sprite = document.createElement('div');
              sprite.className = 'ship-sprite';
              applyShipSprite(sprite, ship.name, ship.horizontal);
              sprite.style.position = 'absolute';
              sprite.style.opacity = '0.8';
              cell.style.position = 'relative';
              cell.appendChild(sprite);
              break;
            }
          }
        }

        cell.dataset.x = x;
        cell.dataset.y = y;
        cell.addEventListener('click', () => { placeShip(x, y); SFX.place.play(); });
        gridEl.appendChild(cell);
      }
    }
  }

  function placeShip(x, y) {
    if (!selectedShip) return;
    const ship = SHIP_TYPES.find(s => s.name === selectedShip);
    const cells = [];

    if (horizontal) {
      if (x + ship.size > 10) return;
      for (let i = 0; i < ship.size; i++) {
        if (grid[y][x + i]) return;
        cells.push([x + i, y]);
      }
    } else {
      if (y + ship.size > 10) return;
      for (let i = 0; i < ship.size; i++) {
        if (grid[y + i][x]) return;
        cells.push([x, y + i]);
      }
    }

    for (const [nx, ny] of cells) {
      grid[ny][nx] = 1;
    }
    placedShips.push({ name: selectedShip, x, y, horizontal });
    selectedShip = null;
    renderGridSetup();
    renderShipPalette();

    if (placedShips.length === 5) {
      document.getElementById('setup-status').textContent = 'All ships placed! Click Ready to proceed.';
    }
  }

  function readyForBattle() {
    if (placedShips.length !== 5) return;
    const ships = placedShips.map(s => ({
      name: s.name,
      x: s.x,
      y: s.y,
      horizontal: s.horizontal
    }));
    ws.send(JSON.stringify({ type: 'place_ships', ships }));
  }

  document.getElementById('rotate-btn').addEventListener('click', () => {
    horizontal = !horizontal;
    renderGridSetup();
  });

  document.getElementById('clear-btn').addEventListener('click', () => {
    grid = Array(10).fill(null).map(() => Array(10).fill(0));
    placedShips = [];
    selectedShip = null;
    renderGridSetup();
    renderShipPalette();
    document.getElementById('setup-status').textContent = 'Place all ships to continue...';
  });

  document.getElementById('ready-btn').addEventListener('click', readyForBattle);
  document.getElementById('back-lobby-btn').addEventListener('click', () => location.href = '/arena');

  // Connect and authenticate as soon as we know the user's signed in --
  // not on bet placement -- so the lobby list (which streams in over
  // this same connection) is visible before they've entered a bet at
  // all, letting them browse and match an existing lobby immediately.
  function connectAuth() {
    if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) return;
    const user = CloudSync.currentUser;
    if (!user) return;
    user.getIdToken().then(token => {
      ws = new WebSocket(WS_URL);
      ws.onopen = () => {
        ws.send(JSON.stringify({ type: 'auth', token }));
      };
      ws.onmessage = (event) => handleMessage(JSON.parse(event.data));
      ws.onerror = () => console.error('WS error');
      ws.onclose = () => {
        showStatus('Disconnected -- reconnecting...');
        ws = null;
        myQueueId = null;
        setTimeout(connectAuth, 2000);
      };
    });
  }
  window.addEventListener('cloudsync:authchanged', (e) => {
    if (e.detail.user) connectAuth();
  });
  if (window.CloudSync && CloudSync.isSignedIn()) connectAuth();

  document.getElementById('find-match').addEventListener('click', () => {
    if (!window.CloudSync || !CloudSync.isSignedIn()) {
      showStatus('Must be signed in');
      return;
    }
    if (!ws || ws.readyState !== WebSocket.OPEN) {
      showStatus('Still connecting, try again in a moment...');
      connectAuth();
      return;
    }
    const bet = parseInt(document.getElementById('bet-input').value || 0);
    if (!bet || bet < 100) {
      showStatus('Bet must be at least 100');
      return;
    }
    if (Strubles.get() < bet) {
      showStatus('Insufficient balance');
      return;
    }
    ws.send(JSON.stringify({ type: 'join_queue', bet, gameType: 'battleship' }));
  });

  function handleMessage(msg) {
    if (msg.type === 'auth_ok') {
      showStatus('Connected. Enter a bet to open a lobby, or match one below.');
    } else if (msg.type === 'lobby_update') {
      renderLobbies(msg.lobbies);
    } else if (msg.type === 'status' && msg.status === 'queued') {
      myQueueId = msg.queueId;
      showStatus('Waiting for opponent... (or someone can match your bet)');
    } else if (msg.type === 'game_start') {
      // Matched: this is when setup (ship placement) actually begins.
      yourIndex = msg.yourIndex;
      myQueueId = null;
      initSetupPhase();
    } else if (msg.type === 'error') {
      showStatus(msg.message);
    } else if (msg.type === 'placement_result') {
      if (!msg.valid) alert('Placement error: ' + msg.error);
    } else if (msg.type === 'battle_start') {
      showPhase('battle');
      updateBattleDisplay();
      updateTurnIndicator(msg.currentTurn);
    } else if (msg.type === 'fire_result') {
      applyFireResult(msg);
    } else if (msg.type === 'game_result') {
      showGameResult(msg.results);
    } else if (msg.type === 'opponent_disconnected') {
      showPhase('result');
      document.getElementById('result-text').textContent = msg.winner === yourIndex ? 'Opponent disconnected -- you win!' : 'Disconnected -- opponent wins.';
      document.getElementById('result-payout').textContent = '';
      updateBalance();
    }
  }

  function updateTurnIndicator(currentTurn) {
    const el = document.getElementById('turn-indicator');
    const yourTurn = currentTurn === yourIndex;
    el.textContent = yourTurn ? 'Your turn -- fire!' : "Opponent's turn...";
    el.classList.toggle('active', yourTurn);
  }

  function applyFireResult(msg) {
    const { lastMove } = msg;
    // The shooter's own view marks the cell on the enemy radar grid;
    // the receiving player marks the same cell on their own fleet grid.
    const targetGridId = lastMove.shooterIndex === yourIndex ? 'grid-enemy' : 'grid-your';
    const cell = document.querySelector(`#${targetGridId} [data-x="${lastMove.x}"][data-y="${lastMove.y}"]`);
    if (cell) {
      cell.classList.add(lastMove.hit ? 'hit' : 'miss');
      if (lastMove.sunkShip) cell.classList.add('sunk');
    }
    if (lastMove.hit) SFX[lastMove.sunkShip ? 'sink' : 'hit'].play();
    else SFX.miss.play();

    updateTurnIndicator(msg.currentTurn);
  }

  function showGameResult(results) {
    showPhase('result');
    if (!results) return;
    const mine = results[yourIndex];
    const resultText = document.getElementById('result-text');
    const resultPayout = document.getElementById('result-payout');
    resultText.textContent = mine.result === 'win' ? 'Victory!' : 'Defeat.';
    resultPayout.textContent = mine.payout > 0 ? `+${mine.payout.toLocaleString()} Strubles` : '';
    updateBalance();
  }

  function updateBattleDisplay() {
    const yourGrid = document.getElementById('grid-your');
    const enemyGrid = document.getElementById('grid-enemy');

    for (let y = 0; y < 10; y++) {
      for (let x = 0; x < 10; x++) {
        const cell = document.createElement('div');
        cell.className = 'board-cell';
        cell.dataset.x = x;
        cell.dataset.y = y;
        cell.addEventListener('click', () => fireAt(x, y));
        enemyGrid.appendChild(cell);
      }
    }

    for (let y = 0; y < 10; y++) {
      for (let x = 0; x < 10; x++) {
        const cell = document.createElement('div');
        cell.className = 'board-cell';
        if (grid[y][x]) cell.classList.add('ship');
        yourGrid.appendChild(cell);
      }
    }
  }

  function fireAt(x, y) {
    // Actual hit/miss/turn feedback arrives asynchronously via
    // fire_result once the server resolves the shot -- see
    // applyFireResult(). Guard client-side against an obviously invalid
    // click (already-targeted cell, not your turn) so a click can't fire
    // twice while waiting on the round trip; the server re-validates
    // regardless.
    const cell = document.querySelector(`#grid-enemy [data-x="${x}"][data-y="${y}"]`);
    if (cell && (cell.classList.contains('hit') || cell.classList.contains('miss'))) return;
    ws.send(JSON.stringify({ type: 'action', action: 'fire', x, y }));
  }

  showPhase('bet');
  updateBalance();
  window.addEventListener('strubles:change', updateBalance);
})();
</script>
</body>
</html>
