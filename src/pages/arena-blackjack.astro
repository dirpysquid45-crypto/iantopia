<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Arena: Blackjack 1v1</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0a0c12">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style is:global>
  :root { --bg:#0f1115; --panel:#161c27; --ink:#e9eef9; --muted:#9fb0cf; --gold:#ffd700; --felt:#1a472a; }
  * { box-sizing:border-box; cursor:none !important; }
  html, body { margin:0; height:100%; }
  body { min-height:100dvh; display:flex; flex-direction:column; color:var(--ink); font-family: 'Press Start 2P', ui-monospace; cursor:none; background-image: url('/video/casino-entrance.gif'); background-size: cover; background-position: center; background-attachment: fixed; position:relative; }
  body::before { content:''; position:fixed; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.45); pointer-events:none; z-index:0; }
  main { flex:1; display:flex; flex-direction:column; align-items:center; padding:20px; max-width:1200px; margin:0 auto; width:100%; position:relative; z-index:1; }
  .top-bar { width:100%; display:flex; justify-content:space-between; margin-bottom:16px; }
  .balance { font-size:11px; color:var(--gold); background:rgba(0,0,0,.5); padding:8px 12px; border:2px solid var(--gold); }

  /* The felt table -- same gradient, gold border, floating animation and
     pixel-grid overlay as the original solo /blackjack, so the VS table
     reads as the same game, not a reskin. */
  .table { width:min(900px, 95vw); background: linear-gradient(135deg, var(--felt) 0%, #235c3a 50%, var(--felt) 100%); border:4px solid var(--gold); padding:20px; box-shadow:0 20px 50px rgba(0,0,0,.5), 0 0 20px rgba(255,215,0,.4), 0 0 40px rgba(255,215,0,.25), 0 0 80px rgba(255,215,0,.15); position:relative; animation: tableFloat 4s ease-in-out infinite; }
  @keyframes tableFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  .table::before { content:''; position:absolute; top:0; left:0; right:0; bottom:0; background-image: repeating-linear-gradient(90deg, transparent, transparent 20px, rgba(255,215,0,0.04) 20px, rgba(255,215,0,0.04) 40px), repeating-linear-gradient(0deg, transparent, transparent 20px, rgba(255,215,0,0.04) 20px, rgba(255,215,0,0.04) 40px); pointer-events:none; }

  .row { margin-top:16px; padding:14px; border:3px solid #8b7a1a; background:rgba(0,0,0,0.35); box-shadow:0 0 10px rgba(255,215,0,.2), inset 0 0 12px rgba(255,215,0,.08); position:relative; z-index:1; transition: border-color .2s, box-shadow .2s; }
  .row:first-child { margin-top:0; }
  .row.active-hand { border-color:#ffeb3b; box-shadow:0 0 16px rgba(255,235,59,.6), inset 0 0 14px rgba(255,235,59,.15); }
  .label { color:var(--gold); font-size:10px; margin-bottom:8px; text-transform:uppercase; letter-spacing:1px; }
  .hand { display:flex; gap:8px; flex-wrap:wrap; align-items:center; min-height:96px; }

  .card-slot { width:64px; height:96px; border:3px solid #000; background:rgba(0,0,0,0.3); padding:8px; display:flex; align-items:center; justify-content:center; }
  .card-slot.red { border-color:#8b1e2b; }
  .card-img { width:48px; height:48px; image-rendering:pixelated; image-rendering:crisp-edges; }
  .card-slot.deal-in { animation: cardDealIn 0.3s ease-out; }
  @keyframes cardDealIn {
    0%   { transform: translateX(-40px) rotateY(90deg); opacity:0; }
    60%  { transform: translateX(4px) rotateY(0deg); opacity:1; }
    100% { transform: translateX(0) rotateY(0deg); opacity:1; }
  }
  @media (max-width:768px) {
    .card-slot { width:44px; height:66px; padding:3px; }
    .card-img { width:32px; height:32px; }
  }

  .score-display { margin-top:10px; font-size:13px; color:#fff; font-weight:400; }
  @media (max-width:768px) {
    .top-bar { flex-direction:column; gap:10px; align-items:flex-start; }
    main { padding:10px; }
  }
  .actions { display:flex; gap:10px; margin-top:15px; flex-wrap:nowrap; }
  button.action-btn {
    all:unset; cursor:pointer; padding:12px 24px; border:3px solid #333; background:#4a6fa5; color:#fff; font-weight:400; font-size:11px;
    font-family:'Press Start 2P', ui-monospace, monospace; transition: background .15s, transform .1s; flex:1; min-width:60px; text-align:center;
  }
  button.action-btn:hover:not(:disabled) { background:#6a8fc5; }
  button.action-btn:active:not(:disabled) { transform: translateY(2px); }
  button.action-btn.accent { background:#22757a; --glow-color:#22d3ee; }
  button.action-btn.accent:hover:not(:disabled) { background:#2f9aa1; }
  button.action-btn:not(:disabled) { animation: neonBtnPulse 2s ease-in-out infinite; }
  button.action-btn:disabled { opacity:.5; cursor:not-allowed; animation:none; }
  .bet-section { background:rgba(0,0,0,.4); border:2px solid var(--gold); padding:15px; }
  .bet-input { background:#000; border:2px solid var(--gold); color:var(--gold); padding:8px; font-family:inherit; font-size:11px; width:100%; margin-bottom:10px; }
  .bet-btn { color:#000; background:var(--gold); border:2px solid #000; padding:8px 12px; font-size:10px; font-weight:700; width:100%; cursor:pointer; transition: background .2s, transform .1s; }
  .bet-btn:hover:not(:disabled) { background:#ffe766; }
  .bet-btn:active:not(:disabled) { transform: translateY(2px); }
  @keyframes neonBtnPulse {
    0%, 100% { box-shadow: 0 0 4px var(--glow-color, #ffd700), 0 0 10px var(--glow-color, #ffd700); text-shadow: 0 0 4px var(--glow-color, #ffd700); }
    50% { box-shadow: 0 0 10px var(--glow-color, #ffd700), 0 0 24px var(--glow-color, #ffd700), 0 0 38px var(--glow-color, #ffd700); text-shadow: 0 0 8px var(--glow-color, #ffd700); }
  }
  #find-match { animation: neonBtnPulse 2s ease-in-out infinite; }
  .status { font-size:9px; color:var(--muted); margin:10px 0; }
  .back-link { position:fixed; top:20px; left:20px; color:var(--gold); text-decoration:none; border:2px solid #000; padding:6px 10px; background:#000; font-size:9px; font-weight:700; z-index:10; transition:background 0.2s; }
  .back-link:hover { background:var(--gold); color:#000; }

  #strubles-badge { position:fixed; top:20px; right:20px; display:flex; align-items:center; gap:8px; background:#000; padding:8px 12px; border:3px solid #ffd700; font-weight:700; z-index:10; font-size:11px; color:var(--gold); }
  #strubles-badge img { width:24px; height:24px; }

  #bj-money-overlay { display:none; position:fixed; inset:0; z-index:199; background-image:url('/video/raining-money.gif'); background-size:cover; background-position:center; pointer-events:none; }
  #bj-money-overlay.show { display:block; }
  #bj-celebration { display:none; position:fixed; inset:0; z-index:200; align-items:center; justify-content:center; pointer-events:none; background: rgba(0,0,0,0.35); }
  #bj-celebration.show { display:flex; }
  #bj-celebration span { font-family:'Press Start 2P'; font-size:clamp(32px, 11vw, 120px); letter-spacing:4px; text-align:center; padding:0 10px; text-shadow: 4px 4px 0 #000, -4px -4px 0 #000, 4px -4px 0 #000, -4px 4px 0 #000, 0 0 40px currentColor; animation: bjFlash 3.5s steps(1) forwards; }
  @keyframes bjFlash {
    0%   { color:#ffeb3b; }
    8%   { color:#000; }
    16%  { color:#fff; }
    24%  { color:#ffeb3b; }
    32%  { color:#000; }
    40%  { color:#fff; }
    48%  { color:#ffeb3b; }
    56%  { color:#000; }
    64%  { color:#fff; }
    72%, 100% { color:#ffeb3b; }
  }

  /* Now Playing modal -- same structure/classes as every other page's
     picker so Arena feels like one system with the rest of the site. */
  .overlay{ position:fixed; inset:0; background:rgba(0,0,0,.85); z-index:100; display:none; align-items:center; justify-content:center; padding:20px; }
  .overlay.open{ display:flex; }
  .modal{ width:min(360px,90vw); max-height:70vh; overflow-y:auto; background:#0a0a0a; border:3px solid var(--gold); padding:20px; box-shadow:0 0 20px rgba(255,215,0,.4); }
  .modal-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; gap:10px; }
  .modal-head h2{ margin:0; font-size:12px; color:var(--gold); font-weight:400; }
  .btn{ color:var(--gold); text-decoration:none; border:3px solid var(--gold); padding:8px 12px; background:#000; font-size:9px; transition:background .2s, color .2s; cursor:none; font-family:inherit; letter-spacing:1px; text-transform:uppercase; }
  .btn:hover{ background:var(--gold); color:#000; }
  .picker-row { display:flex; align-items:center; padding:6px 0; border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:11px; }
  .picker-row:last-child { border-bottom:none; }
  .volume-row{ display:flex; align-items:center; gap:10px; margin-bottom:16px; padding-bottom:14px; border-bottom:1px solid rgba(255,215,0,0.3); }
  .volume-row input[type="range"]{ flex:1; accent-color:var(--gold); cursor:none; touch-action:none; padding:14px 0; }
  .volume-mute-btn{ all:unset; cursor:none; font-size:16px; padding:4px 8px; border:1px solid var(--gold); background:#000; }
  #now-playing { position:fixed; bottom:20px; right:20px; z-index:20; color:var(--gold); background:#000; border:3px solid var(--gold); padding:10px 14px; font-size:14px; cursor:none; transition:background 0.2s; }
  #now-playing:hover { background:var(--gold); color:#000; }

  #lobby-list { margin-top:15px; }
  #lobby-list-heading { font-size:9px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px; }
  .lobby-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:8px 10px; border:2px solid rgba(255,215,0,.3); margin-bottom:6px; background:rgba(255,215,0,.05); }
  .lobby-row .lobby-bet { font-size:11px; color:var(--gold); }
  .lobby-row.own { border-color:rgba(255,215,0,.6); background:rgba(255,215,0,.1); }
  .lobby-row.own .lobby-bet::after { content:' (yours — waiting)'; color:var(--muted); font-size:9px; }
  .lobby-row button { color:#000; background:var(--gold); border:2px solid #000; padding:6px 10px; font-size:9px; font-weight:700; cursor:pointer; }
  .lobby-row button:hover { background:#ffe766; }
  #lobby-empty { font-size:9px; color:var(--muted); padding:8px 0; }

  /* Trump card glow effect */
  .trump-card { filter: drop-shadow(0 0 8px rgba(255,215,0,.8)) drop-shadow(0 0 4px rgba(255,215,0,.5)); border-color:#ffd700 !important; box-shadow:0 0 12px rgba(255,215,0,.4), inset 0 0 8px rgba(255,215,0,.15) !important; }
</style>
</head>
<body>
  <a href="/arena" class="back-link">← Arena</a>

  <div id="strubles-badge">
    <img src="/strubles.png" alt="Struble">
    <span id="bal">0</span>
  </div>

  <div id="bj-money-overlay"></div>
  <div id="bj-celebration"><span>YOU WIN!</span></div>

  <main>
    <div class="top-bar">
      <div class="balance">Balance: <span id="balance">0</span> Strubles</div>
    </div>

    <div id="bet-section" class="bet-section">
      <div class="status">Enter your bet to open a lobby, or match an existing one below</div>
      <input type="number" id="bet-input" class="bet-input" min="100" step="100" placeholder="Bet amount" />
      <button id="find-match" class="bet-btn">Open Lobby</button>
      <div class="status" id="status-message"></div>

      <div id="lobby-list">
        <div id="lobby-list-heading">Open Lobbies</div>
        <div id="lobby-rows"></div>
        <div id="lobby-empty">No open lobbies yet — be the first to place a bet.</div>
      </div>
    </div>

    <div id="game-section" class="table" style="display:none;">
      <section class="row">
        <div class="label">Opponent</div>
        <div class="hand" id="opponent-hand"></div>
        <div class="score-display" id="opponent-score"></div>
      </section>

      <section class="row" id="your-row">
        <div class="label">You</div>
        <div class="hand" id="your-hand"></div>
        <div class="score-display" id="your-score"></div>
        <div class="actions">
          <button id="hit" class="action-btn accent">Hit</button>
          <button id="stand" class="action-btn accent">Stand</button>
        </div>
      </section>
    </div>

    <div id="result-section" style="display:none; text-align:center;">
      <div style="font-size:14px; color:var(--gold); margin:20px 0;" id="result-message"></div>
      <div id="rematch-prompt" style="margin:20px 0;">
        <p style="color:var(--muted); font-size:12px; margin:10px 0;">Play another round?</p>
        <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
          <button id="rematch-accept" class="bet-btn" style="flex:1; min-width:120px;">Rematch</button>
          <button id="rematch-decline" class="bet-btn" style="flex:1; min-width:120px;">Back to Lobby</button>
        </div>
        <p id="rematch-status" style="color:var(--muted); font-size:10px; margin:10px 0; display:none;"></p>
      </div>
    </div>
  </main>

  <button id="now-playing" title="Music options">🎵</button>

  <!-- Music Playlist Modal -->
  <div class="overlay" id="playlist-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Now Playing</h2>
        <button class="btn" id="playlist-close" type="button">Close</button>
      </div>
      <div class="volume-row">
        <button class="volume-mute-btn" id="mute-btn" aria-label="Toggle sound" title="Toggle sound">🔊</button>
        <input type="range" id="volume-slider" min="0" max="100" value="50" aria-label="Music volume" />
      </div>
      <div id="playlist-list"></div>
    </div>
  </div>

  <audio id="theme-music" src="/audio/music/Balatro-Main-Theme.mp3" preload="auto" loop></audio>

<script is:inline src="/cursor-library.js?v=4"></script>
<script is:inline src="/cursor.js?v=3"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<script is:inline src="/cloud-sync.js?v=9"></script>
<script is:inline src="/tycoon-bank.js?v=1"></script>
<script is:inline src="/strubles.js?v=3"></script>
<script is:inline src="/blackjack-engine.js?v=2"></script>
<script is:inline src="/music-library.js?v=13"></script>
<script is:inline src="/music-position.js?v=1"></script>
<script is:inline>
  // Balatro plays for free on Arena Blackjack, matching solo /blackjack.
  window.PAGE_FREE_TRACK_KEY = 'balatro';
</script>
<script is:inline src="/pickers.js?v=11"></script>
<script is:inline>
(() => {
  const themeMusic = document.getElementById('theme-music');
  const VOLUME_KEY = 'music_volume_v1';
  const volumeSlider = document.getElementById('volume-slider');
  const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
  themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.5;
  volumeSlider.value = Math.round(themeMusic.volume * 100);
  volumeSlider.addEventListener('input', () => {
    themeMusic.volume = volumeSlider.value / 100;
    localStorage.setItem(VOLUME_KEY, themeMusic.volume);
  });

  let audioEnabled = true;
  function tryPlayTheme() {
    if (!audioEnabled) return;
    themeMusic.play().catch(() => {});
  }
  tryPlayTheme();
  const unlockTheme = () => {
    tryPlayTheme();
    window.removeEventListener('pointerdown', unlockTheme);
    window.removeEventListener('keydown', unlockTheme);
  };
  window.addEventListener('pointerdown', unlockTheme);
  window.addEventListener('keydown', unlockTheme);

  const muteBtn = document.getElementById('mute-btn');
  muteBtn.addEventListener('click', () => {
    audioEnabled = !audioEnabled;
    muteBtn.textContent = audioEnabled ? '🔊' : '🔇';
    if (audioEnabled) tryPlayTheme();
    else themeMusic.pause();
  });

  const WS_URL = window.location.protocol === 'https:' ? 'wss://iantopia.com/arena-ws/blackjack' : 'ws://localhost:4001';
  let ws = null;
  let yourIndex = null;
  let myQueueId = null;
  let prevHandLengths = [0, 0];

  // Same card sprite mapping and deal sound system as the original solo
  // /blackjack -- reused verbatim so the VS table's cards look and sound
  // identical, not just similarly styled.
  function suitName(s) {
    return { '♠':'spades', '♥':'hearts', '♦':'diamonds', '♣':'clubs' }[s];
  }
  function rankCode(v) {
    if (v === '10') return '10';
    if (['A','J','Q','K'].includes(v)) return v;
    return '0' + v;
  }
  function cardImgSrc(c) {
    return `/assets/casino/cards/card_${suitName(c.s)}_${rankCode(c.v)}.png`;
  }

  const AUDIO_BASE = '/assets/casino/audio/';
  const audioCache = {};
  function playSound(name) {
    if (!audioEnabled) return;
    let audio = audioCache[name];
    if (!audio) {
      audio = new Audio(`${AUDIO_BASE}${name}.ogg`);
      audio.volume = 0.5;
      audioCache[name] = audio;
    }
    audio.currentTime = 0;
    audio.play().catch(() => {});
  }
  function playRandomSound(base, count) {
    playSound(`${base}-${1 + Math.floor(Math.random() * count)}`);
  }

  // Renders real card sprites into a hand's slots, deal-in animating and
  // sounding only the newly-added cards (tracked via prevCount) so a
  // full re-render on every server update doesn't replay the whole hand.
  function renderHand(hand, el, prevCount) {
    el.innerHTML = '';
    const Engine = window.BlackjackEngine;
    hand.forEach((c, i) => {
      const slot = document.createElement('div');
      slot.className = 'card-slot' + ((c.s === '♥' || c.s === '♦') ? ' red' : '');
      if (Engine && Engine.isTrumpCard(c)) {
        slot.classList.add('trump-card');
      }
      const img = document.createElement('img');
      img.className = 'card-img';
      img.src = cardImgSrc(c);
      img.alt = `${c.v} of ${suitName(c.s)}`;
      slot.appendChild(img);
      el.appendChild(slot);
      if (i >= prevCount) {
        slot.classList.add('deal-in');
        playRandomSound('card-place', 4);
      }
    });
  }

  function updateBalance() {
    const bal = Strubles.get().toLocaleString();
    document.getElementById('balance').textContent = bal;
    document.getElementById('bal').textContent = bal;
  }

  function showCelebration() {
    const overlay = document.getElementById('bj-money-overlay');
    const celebration = document.getElementById('bj-celebration');
    overlay.classList.add('show');
    celebration.classList.add('show');
    setTimeout(() => {
      overlay.classList.remove('show');
      celebration.classList.remove('show');
    }, 3500);
  }

  function showStatus(msg) {
    document.getElementById('status-message').textContent = msg;
  }

  // Connect and authenticate as soon as we know the user's signed in --
  // not on bet placement -- so the lobby list (which streams in over
  // this same connection) is visible before they've entered a bet at
  // all, letting them browse and match an existing lobby immediately.
  async function connectAuth() {
    if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) return;
    const user = CloudSync.currentUser;
    if (!user) return;
    const token = await user.getIdToken();
    ws = new WebSocket(WS_URL);
    ws.onopen = () => {
      ws.send(JSON.stringify({ type: 'auth', token }));
    };
    ws.onmessage = (event) => handleMessage(JSON.parse(event.data));
    ws.onerror = () => showStatus('Connection error');
    ws.onclose = () => {
      showStatus('Disconnected -- reconnecting...');
      ws = null;
      myQueueId = null;
      setTimeout(connectAuth, 2000);
    };
  }
  window.addEventListener('cloudsync:authchanged', (e) => {
    if (e.detail.user) connectAuth();
  });
  if (window.CloudSync && CloudSync.isSignedIn()) connectAuth();

  document.getElementById('find-match').addEventListener('click', () => {
    if (!window.CloudSync || !CloudSync.isSignedIn()) {
      showStatus('Must be signed in');
      return;
    }
    if (!ws || ws.readyState !== WebSocket.OPEN) {
      showStatus('Still connecting, try again in a moment...');
      connectAuth();
      return;
    }
    const bet = parseInt(document.getElementById('bet-input').value || 0);
    if (!bet || bet < 100) {
      showStatus('Bet must be at least 100');
      return;
    }
    const balance = Strubles.get();
    if (balance < bet) {
      showStatus('Insufficient balance');
      return;
    }
    ws.send(JSON.stringify({ type: 'join_queue', bet, gameType: 'blackjack' }));
  });

  function renderLobbies(lobbies) {
    const container = document.getElementById('lobby-rows');
    const empty = document.getElementById('lobby-empty');
    const relevant = lobbies.filter(l => l.gameType === 'blackjack');
    container.innerHTML = '';
    if (relevant.length === 0) {
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';
    relevant.forEach((lobby) => {
      const isOwn = lobby.queueId === myQueueId;
      const row = document.createElement('div');
      row.className = 'lobby-row' + (isOwn ? ' own' : '');
      const betSpan = document.createElement('span');
      betSpan.className = 'lobby-bet';
      betSpan.textContent = `${lobby.bet.toLocaleString()} Strubles`;
      row.appendChild(betSpan);
      if (!isOwn) {
        const btn = document.createElement('button');
        btn.textContent = 'Match Bet';
        btn.addEventListener('click', () => {
          if (!ws || ws.readyState !== WebSocket.OPEN) return;
          ws.send(JSON.stringify({ type: 'match_bet', queueId: lobby.queueId }));
        });
        row.appendChild(btn);
      }
      container.appendChild(row);
    });
  }

  function handleMessage(msg) {
    if (msg.type === 'auth_ok') {
      showStatus('Connected. Enter a bet to open a lobby, or match one below.');
    } else if (msg.type === 'lobby_update') {
      renderLobbies(msg.lobbies);
    } else if (msg.type === 'status' && msg.status === 'queued') {
      myQueueId = msg.queueId;
      showStatus('Waiting for opponent... (or someone can match your bet)');
    } else if (msg.type === 'game_start') {
      yourIndex = msg.yourIndex;
      myQueueId = null;
      prevHandLengths = [0, 0];
      document.getElementById('bet-section').style.display = 'none';
      document.getElementById('game-section').style.display = 'block';
      document.getElementById('your-row').classList.add('active-hand');
      document.getElementById('hit').disabled = false;
      document.getElementById('stand').disabled = false;
      renderGameState(msg.yourHand, msg.opponentVisibleCards, msg.yourBustLimit, msg.opponentBustLimit, [false, false]);
    } else if (msg.type === 'game_update') {
      renderGameState(msg.yourHand, msg.opponentVisibleCards, null, null, msg.done);
      const youDone = !!(msg.done && msg.done[yourIndex]);
      document.getElementById('hit').disabled = youDone;
      document.getElementById('stand').disabled = youDone;
    } else if (msg.type === 'game_result') {
      const result = msg.results[yourIndex];
      document.getElementById('your-row').classList.remove('active-hand');
      document.getElementById('game-section').style.display = 'none';
      document.getElementById('result-section').style.display = 'block';
      const resultText = result.result === 'win' ? `🎉 You won ${result.payout} Strubles!` : result.result === 'push' ? `Tie! Got your bet back.` : `You lost.`;
      document.getElementById('result-message').textContent = resultText;
      if (result.result === 'win') {
        showCelebration();
        playRandomSound('chips-stack', 6);
      }
      updateBalance();
      // Show rematch prompt
      document.getElementById('rematch-accept').disabled = false;
      document.getElementById('rematch-decline').disabled = false;
      document.getElementById('rematch-status').style.display = 'none';
    } else if (msg.type === 'show_rematch_prompt') {
      // Server initiated rematch prompt (game finished)
      document.getElementById('rematch-accept').disabled = false;
      document.getElementById('rematch-decline').disabled = false;
      document.getElementById('rematch-status').style.display = 'none';
    } else if (msg.type === 'rematch_opponent_accepted') {
      document.getElementById('rematch-status').textContent = 'Opponent accepted! Starting rematch...';
      document.getElementById('rematch-status').style.display = 'block';
      document.getElementById('rematch-accept').disabled = true;
      document.getElementById('rematch-decline').disabled = true;
    } else if (msg.type === 'rematch_failed') {
      document.getElementById('rematch-status').textContent = msg.message;
      document.getElementById('rematch-status').style.display = 'block';
      document.getElementById('rematch-accept').disabled = true;
      document.getElementById('rematch-decline').disabled = true;
    } else if (msg.type === 'game_start' && msg.isRematch) {
      // New game started from rematch
      yourIndex = msg.yourIndex;
      myQueueId = null;
      prevHandLengths = [0, 0];
      document.getElementById('result-section').style.display = 'none';
      document.getElementById('game-section').style.display = 'block';
      document.getElementById('your-row').classList.add('active-hand');
      document.getElementById('hit').disabled = false;
      document.getElementById('stand').disabled = false;
      renderGameState(msg.yourHand, msg.opponentVisibleCards, msg.yourBustLimit, msg.opponentBustLimit, [false, false]);
      showStatus('Rematch started!');
    } else if (msg.type === 'balance_update') {
      Strubles.set(msg.balance);
      updateBalance();
    } else if (msg.type === 'error') {
      showStatus(msg.message);
    }
  }

  function renderGameState(yourHand, opponentVisibleCards, yourBustLimit, opponentBustLimit, doneFlags) {
    // Render your full hand
    renderHand(yourHand, document.getElementById('your-hand'), prevHandLengths[0]);
    // Render only opponent's visible cards (first 2)
    renderHand(opponentVisibleCards, document.getElementById('opponent-hand'), 0);
    prevHandLengths[0] = yourHand.length;

    // Show goal card status if present
    const Engine = window.BlackjackEngine;
    const yourVal = Engine ? Engine.handValue(yourHand) : '';
    const oppVal = Engine ? Engine.handValue(opponentVisibleCards) : '';
    const yourGoalText = Engine && Engine.hasGoalCard(yourHand) ? ' 🎯' : '';
    const oppGoalText = opponentVisibleCards && opponentVisibleCards.some(c => c.isGoalCard) ? ' 🎯' : '';

    // Show bust limits (21 or 31 if goal card present)
    const yourLimit = yourBustLimit || (Engine ? Engine.getBustLimit(yourHand) : 21);
    const oppLimit = opponentBustLimit || 21; // Don't know opponent's limit until game ends

    document.getElementById('your-score').textContent = `Total: ${yourVal}${yourGoalText} (bust at ${yourLimit}+)`;
    document.getElementById('opponent-score').textContent = `Total: ${oppVal}${oppGoalText}`;
  }

  document.getElementById('hit').addEventListener('click', () => ws?.send(JSON.stringify({ type: 'action', action: 'hit' })));
  document.getElementById('stand').addEventListener('click', () => ws?.send(JSON.stringify({ type: 'action', action: 'stand' })));

  document.getElementById('rematch-accept').addEventListener('click', () => {
    document.getElementById('rematch-accept').disabled = true;
    document.getElementById('rematch-decline').disabled = true;
    document.getElementById('rematch-status').textContent = 'Waiting for opponent...';
    document.getElementById('rematch-status').style.display = 'block';
    ws?.send(JSON.stringify({ type: 'rematch_accept' }));
  });

  document.getElementById('rematch-decline').addEventListener('click', () => {
    location.href = '/arena';
  });

  updateBalance();
  window.addEventListener('strubles:change', updateBalance);

  if (window.initPickers) { setTimeout(window.initPickers, 100); }
})();
</script>
</body>
</html>
