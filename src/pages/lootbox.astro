  .shop-card.owned{ opacity:.55; filter:grayscale(.5); }
  .shop-card .art{ width:100%; height:56px; display:flex; align-items:center; justify-content:center; font-size:32px; }
  .shop-card .art img{ max-width:100%; max-height:100%; object-fit:contain; }
  .shop-card .tier-tag{ font-size:7px; padding:2px 6px; border:1px solid; text-transform:uppercase; letter-spacing:.5px; }
  .shop-card .name{ color:var(--parchment-ink); font-size:9px; line-height:1.5; min-height:27px; }
  .shop-card .price{ color:#8a5a1a; font-size:11px; font-weight:700; }
  .shop-card .buy-btn{
    all:unset; width:100%; margin-top:4px; padding:8px 6px; box-sizing:border-box; text-align:center;
    background:var(--brass); color:#1c1108; border:3px solid #1c1108; cursor:none;
    font-family:inherit; font-size:8px; font-weight:700; letter-spacing:.5px; text-transform:uppercase;
  }
  .shop-card .buy-btn:hover{ background:#e8c176; }
  .shop-card .buy-btn.disabled{ background:#8a7a5a; color:#4a4030; }

  /* This page's own bg-picker script (not pickers.js, but the same pattern)
     toggles this class on <video id="bg-video"> (display:none inline) —
     without this rule the class gets added but nothing makes it visible,
     so video-type backgrounds silently never show. */
  #bg-video { display: none; }
  #bg-video.show { display: block; }

  /* ---------- Contents modal ---------- */
  .overlay{
    position:fixed; inset:0; background:rgba(0,0,0,.85); z-index:40;
    display:none; align-items:center; justify-content:center; padding:20px;
  }
  .overlay.open{ display:flex; }
  .modal{
    width:min(720px,95vw); max-height:85vh; overflow-y:auto;
    background:#0a0a0a; border:4px solid var(--gold); padding:20px;
  }
  .modal-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; gap:10px; }
  .modal-head h2{ margin:0; font-size:12px; color:var(--gold); font-weight:400; }
  .tier-head{
    font-size:9px; letter-spacing:1px; text-transform:uppercase; margin:16px 0 8px;
    padding-bottom:6px; border-bottom:2px solid currentColor;
  }
  .tier-items{ display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:8px; }
  .tier-item{ display:flex; align-items:center; gap:8px; font-size:8px; color:var(--muted); background:#10141c; padding:8px; border-left:4px solid currentColor; line-height:1.6; }
  .tier-item img{ width:26px; height:26px; object-fit:contain; flex:0 0 26px; }
  .tier-item .te{ font-size:20px; flex:0 0 26px; text-align:center; }
  .tier-item span{ color:var(--ink); }
  .tier-item small{ display:block; color:var(--muted); font-size:7px; line-height:1.5; margin-top:3px; }

  @media (max-width:768px){
    :root{ --tile-w: 132px; }
    body{ padding:10px; background-attachment:scroll; align-items:flex-start; }
    /* Top clearance for the fixed badge + icon cluster below -- without it,
       the header (which starts almost immediately under body's own small
       mobile padding) renders directly underneath both fixed elements
       instead of below them. */
    .wrap{ width:100%; padding:14px; margin-top:56px; }
    h1{ font-size:clamp(11px,3.4vw,14px); }
    .badge{ top:calc(6px + env(safe-area-inset-top)); left:calc(6px + env(safe-area-inset-left)); font-size:10px; padding:6px 8px; }
    .badge img{ width:20px; height:20px; }
    .top-actions{ top:calc(6px + env(safe-area-inset-top)); right:calc(6px + env(safe-area-inset-right)); gap:4px; }
    .top-actions .btn{ padding:6px 8px; font-size:11px; }
    .tile{ height:150px; padding:10px 8px 8px; }
    .tile-emoji{ font-size:48px; }
    .reveal-card{ padding:18px 20px; }
    .reveal-card img{ width:170px; height:130px; }
    .reveal-emoji{ font-size:72px; }
    .case-anim-box{ font-size:96px; }
  }
</style>
</head>
