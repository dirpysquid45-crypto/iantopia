  body[data-wing="tavern"] #case-select{ display:none; }

  .tavern-hint{ text-align:center; font-size:8px; color:var(--muted); line-height:1.8; margin:-6px 0 16px; }

  .shop-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:14px; }
  /* Plank-textured parchment card — same wood-grain border technique as
     the Shop tile above, but filled with parchment so item art/price
     reads clearly against the card itself rather than the dark oak. */
  .shop-card{
    position:relative;
    background: var(--parchment);
    border: 6px solid transparent;
    border-image: repeating-linear-gradient(115deg, #4a2f1a 0 6px, #5c3b22 6px 12px, #3a2412 12px 18px) 6;
    box-shadow: 0 6px 14px rgba(0,0,0,.5);
    padding:14px 12px 12px;
