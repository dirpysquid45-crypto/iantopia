<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Iantopia Cases</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0a0c12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script is:inline src="/pwa.js?v=1" defer></script>
<link rel="preload" as="image" href="/strubles.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<!--
  is:global is REQUIRED here, not stylistic. Astro scopes <style> by stamping
  data-astro-cid-* on elements in the template and rewriting selectors to match.
  The reel tiles and reveal artwork are built at runtime via innerHTML, so they
  never receive that attribute and every scoped rule silently skips them —
  tiles fall back to the natural size of their GIF, widths stop being uniform,
  and the reel's landing math (which assumes a fixed step) lands on the wrong
  item. This page is a standalone document, so scoping buys nothing anyway.
-->
<style is:global>
  :root{
    --bg:#0f1115; --panel:#161c27; --ink:#e9eef9; --muted:#9fb0cf;
    --accent:#22d3ee; --gold:#ffd700; --money:#39ff14;
    --tile-w: 186px; --tile-gap: 10px;
    /* Tavern wing palette — see body[data-wing="tavern"] below. Kept as
       root-level tokens (not hardcoded per-rule) so the wing-scoped block
       only has to swap variables/visibility, not redeclare every rule. */
    --oak-dark:#2b1a10; --oak-mid:#5c3b22; --oak-light:#8a5a34;
    --brass:#d4a656; --parchment:#f0dfb8; --parchment-ink:#3a2a14;
  }
  *{box-sizing:border-box}
  body{
    margin:0;
    background-image:url('/video/nyskyline.gif');
    background-size:cover; background-position:center; background-attachment:fixed;
    color:var(--ink); font-family:'Press Start 2P', ui-monospace, 'Courier New', monospace;
    min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px;
    cursor:none; position:relative;
  }
  body::before{
    content:''; position:fixed; inset:0;
    background-image:url('/video/raining-money.gif');
    background-size:cover; background-position:center; background-attachment:fixed;
    pointer-events:none; z-index:0; opacity:.5;
  }
  body::after{
    content:''; position:fixed; inset:0;
    background:rgba(0,0,0,.55); pointer-events:none; z-index:0;
  }
  main{ position:relative; z-index:1; }

  .wrap{
    width:min(1000px,96vw);
    background:#0a0a0a;
    border:4px solid var(--gold);
    padding:24px;
    box-shadow:0 20px 50px rgba(0,0,0,.5), 0 0 20px rgba(255,215,0,.4), 0 0 60px rgba(255,215,0,.18);
  }
  header{ display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:3px solid var(--gold); padding-bottom:12px; gap:10px; }
  header a, .btn{
    color:var(--gold); text-decoration:none; border:3px solid var(--gold); padding:8px 12px;
    background:#000; font-size:9px; transition:background .2s, color .2s; cursor:none;
    font-family:inherit; letter-spacing:1px; text-transform:uppercase;
  }
  header a:hover, .btn:hover{ background:var(--gold); color:#000; }
  h1{
    margin:0; font-size:clamp(14px,2.6vw,20px); color:var(--gold); font-weight:400;
    text-transform:uppercase; text-align:center; letter-spacing:1px;
    text-shadow:0 0 5px var(--gold), 0 0 12px var(--gold), 0 0 24px rgba(255,215,0,.6);
  }

  .badge{
    position:fixed; top:calc(15px + env(safe-area-inset-top)); left:calc(20px + env(safe-area-inset-left));
    display:flex; align-items:center; gap:8px;
    background:#000; border:3px solid var(--gold); padding:8px 12px; z-index:30;
    box-shadow:0 0 10px rgba(255,215,0,.3); font-size:12px;
  }
  .badge img{ width:28px; height:28px; }
  .top-actions{
    position:fixed; top:calc(15px + env(safe-area-inset-top)); right:calc(20px + env(safe-area-inset-right));
    z-index:30; display:flex; gap:6px;
  }
  #np-btn{
    background:#000; border:3px solid var(--gold); color:var(--gold);
    font-family:inherit; font-size:9px; padding:10px 12px; cursor:none; line-height:1.4;
    max-width:150px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    display:flex; align-items:center; gap:8px; flex-shrink:0;
  }
  #np-btn:hover{ background:var(--gold); color:#000; }

  .track-row{
    display:flex; justify-content:space-between; align-items:center; gap:10px;
    padding:12px; margin-bottom:8px; border:2px solid #232a37; background:#10141c;
    font-size:9px; color:var(--ink); line-height:1.7; cursor:none;
  }
  .track-row:hover{ border-color:var(--gold); }
  .track-row.active{ border-color:var(--money); color:var(--money); }
  .track-empty{ color:var(--muted); font-size:9px; padding:12px; line-height:1.9; }

  .small{ color:var(--muted); font-size:9px; line-height:1.8; }
  .small strong{ color:var(--money); }

  /* ---------- Wing toggle (Cases / Shop) ---------- */
  /* One page, two rooms — this and the oak Shop tile below (in .case-grid)
     are the two ways in from the Casino side; from the Tavern side this
     same pill is how you get back. Kept persistent/visible in both wings
     rather than only-forward navigation. */
  .wing-tabs{ display:flex; gap:8px; justify-content:center; margin-bottom:18px; }
  .wing-tab{
    all:unset; cursor:none; padding:8px 16px; border:3px solid var(--gold); color:var(--gold);
    background:#000; font-family:inherit; font-size:9px; letter-spacing:1px; text-transform:uppercase;
    transition:background .15s, color .15s;
  }
  .wing-tab.active{ background:var(--gold); color:#000; }
  body[data-wing="tavern"] .wing-tab{ border-color:var(--brass); color:var(--brass); }
  body[data-wing="tavern"] .wing-tab.active{ background:var(--brass); color:var(--oak-dark); }

  /* ---------- Case select ---------- */
  .case-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:16px; }
  .case-card{
    border:3px solid #2a3242; background:#10141c; padding:16px; display:flex; flex-direction:column; gap:10px;
    text-align:center; transition:border-color .2s, transform .15s;
  }
  .case-card:hover{ border-color:var(--gold); transform:translateY(-3px); }
  .case-emoji{ font-size:44px; line-height:1; }
  .case-name{ font-size:11px; color:var(--gold); line-height:1.5; }
  .case-blurb{ font-size:8px; color:var(--muted); line-height:1.8; min-height:4.5em; }
  .case-cost{ font-size:10px; color:var(--money); }
  .case-owned{ font-size:8px; color:var(--accent); min-height:1.4em; }
  .case-actions{ display:flex; gap:8px; justify-content:center; flex-wrap:wrap; }

  /* The Shop tile: a 5th, hardcoded card (not data-driven like the 4 case
     cards) that reads as a wooden sign bolted onto the casino wall rather
     than another case. Spans 2 of the grid's auto-fit columns so 4 normal
     cards + this one reads as "6 units across 5 tiles" instead of an odd
     5-up row. Gold lettering (var(--gold), not the oak/brass palette) on
     purpose — ties it to the site's existing identity color rather than
     introducing a new hue, per request. */
  .case-card.shop-tile{
    grid-column: span 2;
    background:
      linear-gradient(115deg, rgba(255,255,255,.12) 0%, transparent 30%),
      repeating-linear-gradient(115deg, #4a2f1a 0 6px, #5c3b22 6px 12px, #3a2412 12px 18px);
    border-color: var(--gold);
    justify-content:center;
  }
  .case-card.shop-tile:hover{ border-color:#ffe766; }
  .case-card.shop-tile .case-name{
    color:var(--gold); font-size:13px; text-shadow:1px 1px 0 #000;
  }
  .case-card.shop-tile .case-blurb{ color:#e8d9be; min-height:0; }
  @media (max-width:768px){
    .case-card.shop-tile{ grid-column: span 1; }
  }

  button{ font-family:inherit; cursor:none; }
  button:disabled{ opacity:.4; }
  button.primary{
    all:unset; cursor:none; padding:12px 20px; border:3px solid var(--money);
    background:#0a2e0a; color:var(--money); font-size:10px; text-align:center;
    font-family:'Press Start 2P', ui-monospace, monospace; text-transform:uppercase; letter-spacing:1px;
    transition:background .15s, transform .1s;
  }
  button.primary:hover:not(:disabled){ background:#0f3d0f; }
  button.primary:active:not(:disabled){ transform:translateY(2px); }
  button.primary:disabled{ cursor:none; opacity:.35; }

  /* ---------- Reel ---------- */
  #open-view{ display:none; }
  #open-view.active{ display:block; }
  #case-select.hidden{ display:none; }

  .reel-title{ text-align:center; font-size:11px; color:var(--gold); margin-bottom:14px; }

  .reel-viewport{
    position:relative; overflow:hidden; border:3px solid #2a3242; background:#080a0f;
    padding:16px 0; margin-bottom:18px;
    -webkit-mask-image:linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
    mask-image:linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
  }
  .reel-strip{ display:flex; gap:var(--tile-gap); will-change:transform; }
  .reel-marker{
    position:absolute; top:0; bottom:0; left:50%; width:4px; margin-left:-2px;
    background:var(--gold); box-shadow:0 0 12px var(--gold), 0 0 24px var(--gold); z-index:5; pointer-events:none;
  }
  .reel-marker::before, .reel-marker::after{
    content:''; position:absolute; left:50%; transform:translateX(-50%);
    border-left:9px solid transparent; border-right:9px solid transparent;
  }
  .reel-marker::before{ top:0; border-top:12px solid var(--gold); }
  .reel-marker::after{ bottom:0; border-bottom:12px solid var(--gold); }

  /* CS2 proportions: landscape tile, art dominating, name small at the bottom. */
  .tile{
    flex:0 0 var(--tile-w); width:var(--tile-w); height:190px;
    background:linear-gradient(180deg, #171d28 0%, #0b0e14 70%);
    border:2px solid #232a37; border-bottom-width:7px;
    display:flex; flex-direction:column; align-items:center; justify-content:flex-end;
    gap:10px; padding:14px 10px 10px;
    position:relative; overflow:hidden;
  }
  .tile-art{
    flex:1 1 auto; width:100%; display:flex; align-items:center; justify-content:center; min-height:0;
  }
  /* Fixed size + object-fit, not max-width/auto: auto-sized images never
     enlarge past their native resolution, so small source art (e.g. a
     93x120 badge icon) would render tiny instead of filling the tile. */
  .tile img{ width:110px; height:110px; object-fit:contain; }
  .tile img.pixel-art{ image-rendering:pixelated; }
  .tile-emoji{ font-size:72px; line-height:1; }
  .tile-label{
    font-size:7px; color:var(--muted); text-align:center; line-height:1.7;
    width:100%; flex:0 0 auto;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
  }

  /* ---------- Case open animation ---------- */
  /* Plays before the reel: the case rattles, winds up, then bursts. */
  #case-anim{ display:none; }
  #case-anim.active{ display:flex; align-items:center; justify-content:center; height:190px; margin-bottom:18px; }
  .case-anim-box{
    font-size:130px; line-height:1; transform-origin:50% 60%;
    filter:drop-shadow(0 0 12px var(--gold));
  }
  .case-anim-box.rattle{ animation:caseRattle 1.5s cubic-bezier(.36,.07,.19,.97) both; }
  .case-anim-box.burst{ animation:caseBurst .45s ease-out forwards; }
  @keyframes caseRattle{
    0%   { transform:rotate(0) scale(1); }
    10%  { transform:rotate(-6deg) scale(1.02); }
    20%  { transform:rotate(6deg)  scale(1.02); }
    30%  { transform:rotate(-9deg) scale(1.05); }
    40%  { transform:rotate(9deg)  scale(1.05); }
    55%  { transform:rotate(-13deg) scale(1.09); filter:drop-shadow(0 0 26px var(--gold)); }
    70%  { transform:rotate(13deg)  scale(1.12); }
    85%  { transform:rotate(-16deg) scale(1.16); filter:drop-shadow(0 0 44px var(--money)); }
    100% { transform:rotate(0) scale(1.2); filter:drop-shadow(0 0 60px #fff); }
  }
  @keyframes caseBurst{
    0%   { transform:scale(1.2); opacity:1; filter:drop-shadow(0 0 60px #fff) brightness(1); }
    40%  { transform:scale(1.55); opacity:1; filter:drop-shadow(0 0 90px #fff) brightness(3); }
    100% { transform:scale(2.6); opacity:0; filter:brightness(6); }
  }
  /* Full-bleed white flash at the moment the case pops. */
  #flash{
    position:fixed; inset:0; background:#fff; opacity:0; pointer-events:none; z-index:50;
  }
  #flash.fire{ animation:flashOut .5s ease-out; }
  @keyframes flashOut{ 0%{opacity:.85} 100%{opacity:0} }

  .reel-viewport.hidden{ display:none; }

  /* ---------- Reveal ---------- */
  #reveal{ display:none; text-align:center; }
  #reveal.active{ display:block; animation:revealIn .45s ease-out; }
  @keyframes revealIn{ from{ opacity:0; transform:scale(.9);} to{ opacity:1; transform:scale(1);} }
  .reveal-card{
    display:inline-flex; flex-direction:column; align-items:center; gap:14px;
    padding:26px 34px; border:4px solid var(--rc,#fff); background:#0b0e14; margin-bottom:16px;
  }
  /* Same fixed-size-over-auto reasoning as .tile img above. */
  .reveal-card img{ width:200px; height:170px; object-fit:contain; }
  .reveal-card img.pixel-art{ image-rendering:pixelated; }
  .reveal-emoji{ font-size:104px; line-height:1; }
  .reveal-rarity{ font-size:9px; letter-spacing:2px; text-transform:uppercase; color:var(--rc,#fff); }
  .reveal-label{ font-size:13px; color:#fff; line-height:1.6; max-width:340px; }
  .reveal-desc{ font-size:9px; color:var(--muted); line-height:1.7; max-width:320px; margin:0 auto; }
  .reveal-desc:empty{ display:none; }
  .reveal-note{ font-size:9px; color:var(--money); line-height:1.8; }
  .reveal-actions{ display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:6px; }

  /* Volume + mute controls inside the Now Playing popup — same pattern on
     every page (home/blackjack/lootbox); only the accent color changes. */
  .volume-row{
    display:flex; align-items:center; gap:10px; margin-bottom:16px;
    padding-bottom:14px; border-bottom:1px solid rgba(255,215,0,0.3);
  }
  .volume-row input[type="range"]{ flex:1; accent-color:var(--gold); cursor:none; touch-action:none; padding:14px 0; }
  .volume-mute-btn{
    all:unset; cursor:none; font-size:16px; padding:4px 8px;
    border:1px solid var(--gold); border-radius:0; background:#000;
  }

  /* ---------- Background themes ----------
     Universal across every page — see background-library.js's `theme`
     field and pickers.js's applyBg() (and home's/lootbox's own copies of
     the same lookup). Whichever background is active on THIS page (each
     page's active background is still independent, same as always) picks
     up the matching class here automatically. Scoped to the chrome shared
     by every page — the utility button row, modal buttons, and the mute
     button — not this page's own bespoke game buttons. */
  body.theme-hello-kitty header a, body.theme-hello-kitty header button,
  body.theme-hello-kitty .btn, body.theme-hello-kitty .volume-mute-btn {
    background:#ffb6d9; border-color:#ff5fa8; color:#9c004f; text-shadow:none;
    box-shadow:0 0 12px rgba(255,95,168,.4);
  }
  body.theme-hello-kitty header a:hover, body.theme-hello-kitty header button:hover,
  body.theme-hello-kitty .btn:hover, body.theme-hello-kitty .volume-mute-btn:hover {
    background:#ffd1e8;
  }

  body.theme-old-ppl-slot header a, body.theme-old-ppl-slot header button,
  body.theme-old-ppl-slot .btn, body.theme-old-ppl-slot .volume-mute-btn {
    background:#ffd700; border-color:#c9a227; color:#3a2a00; text-shadow:none;
    box-shadow:0 0 12px rgba(255,215,0,.45);
  }
  body.theme-old-ppl-slot header a:hover, body.theme-old-ppl-slot header button:hover,
  body.theme-old-ppl-slot .btn:hover, body.theme-old-ppl-slot .volume-mute-btn:hover {
    background:#ffe766;
  }

  @keyframes uv-glow {
    0%, 100% { box-shadow:0 0 10px rgba(157,78,221,.35); }
    50%      { box-shadow:0 0 22px rgba(176,38,255,.65); }
  }
  body.theme-waster header a, body.theme-waster header button, body.theme-waster .btn, body.theme-waster .volume-mute-btn,
  body.theme-evian header a, body.theme-evian header button, body.theme-evian .btn, body.theme-evian .volume-mute-btn {
    background:#1a0533; border-color:#9d4edd; color:#e0aaff; text-shadow:0 0 8px rgba(176,38,255,.6);
    animation: uv-glow 2.4s ease-in-out infinite;
  }
  body.theme-waster header a:hover, body.theme-waster header button:hover, body.theme-waster .btn:hover, body.theme-waster .volume-mute-btn:hover,
  body.theme-evian header a:hover, body.theme-evian header button:hover, body.theme-evian .btn:hover, body.theme-evian .volume-mute-btn:hover {
    background:#2d0a5c;
  }

  @keyframes beat-pulse {
    0%, 100% { filter:brightness(1); }
    50%      { filter:brightness(1.28); }
  }
  body.theme-girl-like-me header a, body.theme-girl-like-me header button,
  body.theme-girl-like-me .btn, body.theme-girl-like-me .volume-mute-btn {
    animation: beat-pulse .438s ease-in-out infinite;
  }

  @keyframes rgb-cycle {
    0%   { filter:hue-rotate(0deg); }
    100% { filter:hue-rotate(360deg); }
  }
  body.theme-clarity header a, body.theme-clarity header button,
  body.theme-clarity .btn, body.theme-clarity .volume-mute-btn {
    animation: rgb-cycle 1.875s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    body.theme-waster header a, body.theme-waster header button, body.theme-waster .btn, body.theme-waster .volume-mute-btn,
    body.theme-evian header a, body.theme-evian header button, body.theme-evian .btn, body.theme-evian .volume-mute-btn,
    body.theme-girl-like-me header a, body.theme-girl-like-me header button, body.theme-girl-like-me .btn, body.theme-girl-like-me .volume-mute-btn,
    body.theme-clarity header a, body.theme-clarity header button, body.theme-clarity .btn, body.theme-clarity .volume-mute-btn {
      animation:none;
    }
  }

  /* Deeper coverage: this page's own title, outline, and the actual
     "open case" button (button.primary — green by default, not gold) —
     not just the shared utility chrome above. */
  body.theme-hello-kitty h1 { color:#ffb6d9; text-shadow:0 0 5px #ff5fa8, 0 0 12px #ff5fa8, 0 0 24px rgba(255,95,168,.6); }
  body.theme-hello-kitty .wrap { border-color:#ff5fa8; box-shadow:0 20px 50px rgba(0,0,0,.5), 0 0 20px rgba(255,95,168,.4), 0 0 60px rgba(255,95,168,.18); }
  body.theme-hello-kitty button.primary { border-color:#ff5fa8; background:#33001a; color:#ff8dc2; }
  body.theme-hello-kitty button.primary:hover:not(:disabled) { background:#4d0033; }
  body.theme-hello-kitty .small strong { color:#ff8dc2; }

  body.theme-old-ppl-slot h1 { text-shadow:0 0 5px #ffd700, 0 0 12px #ffd700, 0 0 24px rgba(255,215,0,.6); }
  body.theme-old-ppl-slot .wrap { border-color:#ffd700; box-shadow:0 20px 50px rgba(0,0,0,.5), 0 0 20px rgba(255,215,0,.45), 0 0 60px rgba(255,215,0,.2); }
  body.theme-old-ppl-slot button.primary { border-color:#ffd700; background:#332b00; color:#ffe766; }
  body.theme-old-ppl-slot button.primary:hover:not(:disabled) { background:#4d4000; }

  body.theme-waster h1, body.theme-evian h1 { color:#e0aaff; text-shadow:0 0 5px #9d4edd, 0 0 12px #9d4edd, 0 0 24px rgba(176,38,255,.6); }
  body.theme-waster .wrap, body.theme-evian .wrap {
    border-color:#9d4edd; box-shadow:0 20px 50px rgba(0,0,0,.5), 0 0 20px rgba(157,78,221,.4), 0 0 60px rgba(157,78,221,.18);
  }
  body.theme-waster button.primary, body.theme-evian button.primary { border-color:#9d4edd; background:#1a0533; color:#e0aaff; }
  body.theme-waster button.primary:hover:not(:disabled), body.theme-evian button.primary:hover:not(:disabled) { background:#2d0a5c; }
  body.theme-waster .small strong, body.theme-evian .small strong { color:#e0aaff; }

  body.theme-girl-like-me h1, body.theme-girl-like-me .wrap {
    animation: beat-pulse .438s ease-in-out infinite;
  }

  body.theme-clarity h1, body.theme-clarity .wrap, body.theme-clarity button.primary:not(:disabled) {
    animation: rgb-cycle 1.875s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    body.theme-girl-like-me h1, body.theme-girl-like-me .wrap,
    body.theme-clarity h1, body.theme-clarity .wrap, body.theme-clarity button.primary:not(:disabled) {
      animation:none;
    }
  }

  /* ---------- Tavern wing ---------- */
  /* Scoped entirely under this one attribute selector so both palettes
     coexist in one stylesheet without fighting — switching wings just
     flips this attribute (see setWing() in the page script) plus which
     section is visible; nothing here needs its own separate stylesheet
     or duplicated markup. */
  body[data-wing="tavern"] .wrap{
    border-color: var(--brass);
    box-shadow: 0 20px 50px rgba(0,0,0,.5), 0 0 20px rgba(212,166,86,.35), 0 0 60px rgba(212,166,86,.15);
  }
  body[data-wing="tavern"] header{ border-bottom-color: var(--brass); }
  body[data-wing="tavern"] header a,
  body[data-wing="tavern"] .btn{
    color: var(--brass); border-color: var(--brass);
  }
  body[data-wing="tavern"] header a:hover,
  body[data-wing="tavern"] .btn:hover{ background: var(--brass); color: var(--oak-dark); }
  body[data-wing="tavern"] h1{
    color: var(--brass); text-shadow: 2px 2px 0 #000;
  }
  body[data-wing="tavern"] #np-btn,
