  <!-- lootbox.js reads window.TYCOON_MAX_PER_TYPE for the building
       ownership cap — without this, it silently falls back to its own
       hardcoded default instead of the real, single-source-of-truth
       value in tycoon-buildings.js. -->
  <script is:inline src="/tycoon-buildings.js?v=5"></script>
  <script is:inline src="/lootbox.js?v=9"></script>
  <script is:inline src="/cursor-library.js?v=4"></script>
  <script is:inline src="/cursor.js?v=3"></script>
  <script is:inline src="/music-position.js?v=1"></script>
  <script is:inline>
    // Register pickers for bg/cursor only (lootbox handles music itself)
    window.initPickersForBgAndCursor = function() {
      const BG_LIB = window.BACKGROUND_LIBRARY || {};
      const CURSOR_LIB = window.CURSOR_LIBRARY || {};
      function loadInventory() {
        try {
          const inv = localStorage.getItem('strubles_inventory_v1');
          return inv ? JSON.parse(inv) : { cursors: [], backgrounds: [] };
        } catch {
          return { cursors: [], backgrounds: [] };
        }
      }
      // Background — wing-aware: Casino and Tavern each keep their own
      // independent choice (two separate storage keys), so switching wings
      // never clobbers the other one's pick. Casino keeps its original key
      // (active_bg_v1) untouched, preserving whatever's already saved from
      // before this page had a Tavern wing at all.
      const bgBtn = document.getElementById('bg-btn');
      const bgOverlay = document.getElementById('bg-overlay');
      const bgList = document.getElementById('bg-list');
      const bgClose = document.getElementById('bg-close');
      if (bgBtn && bgOverlay && bgList && bgClose) {
        const BG_KEY_BY_WING = { casino: 'active_bg_v1', tavern: 'shopkeep_active_bg_v1' };
        // "Default" resolves differently per wing rather than always meaning
        // BG_LIB.default (Taipei) — same override idea pickers.js's
        // PAGE_DEFAULT_BG uses elsewhere, just inlined since this page
        // hand-rolls its own picker instead of including pickers.js.
        const WING_DEFAULT_BG = {
          casino: BG_LIB.ny_skyline || { type:'gif', src:'/video/nyskyline.gif', position:'center', label:'NY Skyline' },
          tavern: BG_LIB.tavern || { type:'gif', src:'/video/tavern.gif', position:'center', label:'Tavern' },
        };
        function activeBgKey(){ return BG_KEY_BY_WING[window.__wing] || BG_KEY_BY_WING.casino; }
        function resolveBg(key){
          if (key === 'default' || !BG_LIB[key]) return WING_DEFAULT_BG[window.__wing] || BG_LIB.default;
          return BG_LIB[key];
        }
        function applyBg(bg){
          const vid = document.getElementById('bg-video');
          if (bg.type === 'video') {
            document.body.style.backgroundImage = 'none';
            if (vid) { vid.src = bg.src; vid.classList.add('show'); vid.play().catch(() => {}); }
          } else {
            if (vid) { vid.classList.remove('show'); vid.pause(); }
            document.body.style.backgroundImage = `url('${bg.src}')`;
            document.body.style.backgroundPosition = bg.position || 'center';
          }
          if (window.BACKGROUND_THEME_CLASSES) document.body.classList.remove(...window.BACKGROUND_THEME_CLASSES);
          if (bg.theme) document.body.classList.add(bg.theme);
        }
        function renderBgPicker() {
          bgList.innerHTML = '';
          const activeKey = localStorage.getItem(activeBgKey()) || 'default';
          Object.entries(BG_LIB).forEach(([key, bg]) => {
            // Inventory-only shelf backgrounds never show up here — they're
            // restricted to the dedicated Inventory Room picker.
            if (bg.restricted) return;
            // Locked backgrounds are hidden entirely, not shown-and-greyed —
            // you can't see it until you've actually unlocked it. The
            // Tavern's own default background is always available here,
            // same as 'default' always is, regardless of wing.
            const owned = loadInventory().backgrounds?.includes(key) || key === 'default' || key === 'tavern';
            if (!owned) return;
            const row = document.createElement('div');
            row.className = 'picker-row';
            row.style.cursor = 'pointer';
            const label = document.createElement('span');
            label.textContent = bg.label;
            const indicator = document.createElement('span');
            indicator.style.marginLeft = 'auto';
            indicator.textContent = activeKey === key ? '✓' : '';
            row.appendChild(label);
            row.appendChild(indicator);
            row.addEventListener('click', () => {
              localStorage.setItem(activeBgKey(), key);
              applyBg(resolveBg(key));
              renderBgPicker();
              // Previously dispatched nothing — see cloud-sync.js's SYNC_EVENTS.
              window.dispatchEvent(new CustomEvent('active-background:changed', { detail: { key } }));
            });
            bgList.appendChild(row);
          });
        }
        bgBtn.addEventListener('click', () => {
          renderBgPicker();
          bgOverlay.classList.add('open');
        });
        bgClose.addEventListener('click', () => bgOverlay.classList.remove('open'));
        bgOverlay.addEventListener('click', (e) => { if (e.target === bgOverlay) bgOverlay.classList.remove('open'); });

        // Called on init AND on every wing switch (see setWing() above).
        window.applyWingBackground = function(w){
          const key = localStorage.getItem(BG_KEY_BY_WING[w] || BG_KEY_BY_WING.casino) || 'default';
          applyBg(resolveBg(key));
        };
        window.applyWingBackground('casino');
      }
      // Cursor
      const cursorBtn = document.getElementById('cursor-btn');
      const cursorOverlay = document.getElementById('cursor-overlay');
      const cursorList = document.getElementById('cursor-list');
      const cursorClose = document.getElementById('cursor-close');
      if (cursorBtn && cursorOverlay && cursorList && cursorClose) {
        const ACTIVE_CURSOR_KEY = 'active_cursor_v1';
        function renderCursorPicker() {
          cursorList.innerHTML = '';
          Object.entries(CURSOR_LIB).forEach(([key, cursor]) => {
            const owned = loadInventory().cursors?.includes(key) || key === 'default';
            // Hidden entirely when locked, not shown-and-greyed.
            if (!owned) return;
            const row = document.createElement('div');
            row.className = 'picker-row';
            row.style.cursor = 'pointer';
            const label = document.createElement('span');
            label.textContent = cursor.label;
            const indicator = document.createElement('span');
            indicator.style.marginLeft = 'auto';
            indicator.textContent = (localStorage.getItem(ACTIVE_CURSOR_KEY) === key) ? '✓' : '';
            row.appendChild(label);
            row.appendChild(indicator);
            row.addEventListener('click', () => {
              localStorage.setItem(ACTIVE_CURSOR_KEY, key);
              window.dispatchEvent(new Event('cursor:changed'));
              renderCursorPicker();
            });
            cursorList.appendChild(row);
          });
        }
        cursorBtn.addEventListener('click', () => {
          renderCursorPicker();
          cursorOverlay.classList.add('open');
        });
        cursorClose.addEventListener('click', () => cursorOverlay.classList.remove('open'));
        cursorOverlay.addEventListener('click', (e) => { if (e.target === cursorOverlay) cursorOverlay.classList.remove('open'); });
      }
    };
  </script>
  <script is:inline>
  (() => {
    const RARITIES = window.CASE_RARITIES;
    const ORDER = window.CASE_RARITY_ORDER;
    const ITEMS = window.CASE_ITEMS;
    const CASES = window.CASES;

    const balEl = document.getElementById('bal');
    const caseSelect = document.getElementById('case-select');
    const caseGrid = document.getElementById('case-grid');
    const openView = document.getElementById('open-view');
    const reelTitle = document.getElementById('reel-title');
    const viewport = document.getElementById('reel-viewport');
    const strip = document.getElementById('reel-strip');
    const reveal = document.getElementById('reveal');
    const againBtn = document.getElementById('again-btn');
    const backBtn = document.getElementById('back-btn');

    let currentCaseKey = null;
    let spinning = false;

    // ---------- Wing (Casino / Tavern) ----------
    // Always starts on Casino, never persisted -- "the lootbox page's
    // default is the skyline" is a fresh-load guarantee, not a remembered
    // preference. setWing() is called after the bg/music systems below are
    // defined (see the bottom of this script), not here.
    let wing = 'casino';
    // Mirrored onto window because initPickersForBgAndCursor lives in an
    // earlier, separate <script> block (not nested in this IIFE) and needs
    // to read the current wing too -- a bare closure reference to `wing`
    // from there would be undefined, not this scope's value.
    window.__wing = wing;
    const wingTitle = document.getElementById('wing-title');
    const tabCasino = document.getElementById('tab-casino');
    const tabTavern = document.getElementById('tab-tavern');

    function setWing(next){
      // If a reel is mid-flight, treat a wing switch the same as "Back to
      // Cases" first -- there's no sensible "leave a spinning reel" state.
      if (spinning) return;
      if (openView.classList.contains('active')) {
        openView.classList.remove('active');
        reveal.classList.remove('active');
        caseSelect.classList.remove('hidden');
      }
      wing = next;
      window.__wing = wing;
      document.body.dataset.wing = wing;
      wingTitle.textContent = wing === 'tavern' ? 'The Tavern' : 'Iantopia Cases';
      tabCasino.classList.toggle('active', wing === 'casino');
      tabTavern.classList.toggle('active', wing === 'tavern');
      if (wing === 'tavern') renderCosmetics();
      if (window.applyWingBackground) window.applyWingBackground(wing);
      if (window.applyWingMusic) window.applyWingMusic(wing);
    }
    tabCasino.addEventListener('click', () => setWing('casino'));
    tabTavern.addEventListener('click', () => setWing('tavern'));

    const syncBal = () => { balEl.textContent = Strubles.get().toLocaleString(); };
    syncBal();
    window.addEventListener('strubles:change', syncBal);
    window.addEventListener('storage', syncBal);

    // ---------- Audio ----------
    const AUDIO_BASE = '/assets/casino/audio/';
    let audioEnabled = true;
    // Both sfx pools used to hardcode their volume once at creation (.5 and
    // .35) completely independent of the music slider below — dragging the
    // slider only ever touched themeMusic, so the loudest, most frequent
    // sound on this page (the reel ticks during a spin) never changed no
    // matter where it was set. Reading the slider fresh on every play keeps
    // these proportional to it instead: each boost is picked so sfx sound
    // exactly as loud as before at the slider's default position (0.3), but
    // now actually move with it in either direction.
    function sfxVolume(boost) { return Math.min(1, (parseFloat(volumeSlider.value) / 100) + boost); }
    const cache = {};
    function sound(name){
      if (!audioEnabled) return null;
      let a = cache[name];
      if (!a) { a = new Audio(`${AUDIO_BASE}${name}.ogg`); cache[name] = a; }
      a.volume = sfxVolume(0.2);
      return a;
    }
    function play(name){ const a = sound(name); if (a) { a.currentTime = 0; a.play().catch(()=>{}); } }
    function playRandom(base, count){ play(`${base}-${1 + Math.floor(Math.random()*count)}`); }

    // Ticks fire faster than one <audio> can restart, so round-robin a small
    // pool of clones — otherwise the reel sounds like it's dropping every
    // other tick at full speed.
    const TICK_POOL_SIZE = 6;
    const tickPool = [];
    for (let i = 0; i < TICK_POOL_SIZE; i++) {
      tickPool.push(new Audio(`${AUDIO_BASE}chip-lay-1.ogg`));
    }
    let tickIdx = 0;
    function playTick(){
      if (!audioEnabled) return;
      const a = tickPool[tickIdx = (tickIdx + 1) % TICK_POOL_SIZE];
      a.volume = sfxVolume(0.05);
      a.currentTime = 0;
      a.play().catch(()=>{});
    }

    // ---------- Music: unlocked tracks playable while opening ----------
    const LOOTBOX_THEME = { label: 'Lootbox Theme', src: '/audio/music/lootbox-theme.mp3' };
    const TRACKS = Object.assign({}, window.MUSIC_LIBRARY, { default: LOOTBOX_THEME });
    // Kept separate on purpose — each page's music choice is independent.
    // Falls back to LOOTBOX_THEME when unset/'default' below.
    const ACTIVE_TRACK_KEY = 'lootbox_active_track_v1';
    const INV_KEY = 'strubles_inventory_v1';

    const themeMusic = document.getElementById('theme-music');
    // Shared across every page — a volume change here follows you to
    // blackjack/home, since it's one dial, not per-page track state.
    const VOLUME_KEY = 'music_volume_v1';
    const volumeSlider = document.getElementById('volume-slider');
    const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
    themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.3;
    volumeSlider.value = Math.round(themeMusic.volume * 100);
    volumeSlider.addEventListener('input', () => {
      themeMusic.volume = volumeSlider.value / 100;
      localStorage.setItem(VOLUME_KEY, themeMusic.volume);
    });
    window.addEventListener('storage', (e) => {
      if (e.key === VOLUME_KEY && e.newValue != null) {
        themeMusic.volume = parseFloat(e.newValue);
        volumeSlider.value = Math.round(themeMusic.volume * 100);
      }
    });

    function loadInv(){
      try { const v = localStorage.getItem(INV_KEY); return v ? JSON.parse(v) : {}; } catch { return {}; }
    }
    function activeTrackKey(){
      const k = localStorage.getItem(ACTIVE_TRACK_KEY);
      return (k && TRACKS[k]) ? k : 'default';
    }

    let trackKey = activeTrackKey();
    // Position is stored per track — one shared key would resume a new song at
    // the timestamp of the previous one.
    const posKey = (k) => `lootbox_pos_${k}_v1`;

    // MusicPosition.track() opens an interval + unload listeners and hands back
    // a teardown. Dropping it would stack a new interval per switch, each still
    // writing this element's time under a stale key.
    let stopTracking = null;

    function applyTrack(key, restart){
      const t = TRACKS[key] || LOOTBOX_THEME;
      trackKey = key;
      if (stopTracking) { stopTracking(); stopTracking = null; }

      themeMusic.src = t.src;

      if (restart) {
        themeMusic.currentTime = 0;
      } else if (window.MusicPosition) {
        // currentTime cannot be set before metadata exists, so wait for it
        // rather than assigning into a element that will ignore the write.
        themeMusic.addEventListener('loadedmetadata', function once(){
          themeMusic.removeEventListener('loadedmetadata', once);
          window.MusicPosition.restore(posKey(key), themeMusic);
        });
      }

      if (window.MusicPosition) stopTracking = window.MusicPosition.track(posKey(key), themeMusic);
      tryPlayTheme();
    }

    const tryPlayTheme = () => { if (audioEnabled) themeMusic.play().catch(()=>{}); };
    applyTrack(trackKey, false);

    // Tavern wing: one fixed track, no picker (see the <audio id="tavern-music">
    // note near its tag) — but it shares the same mute state and volume
    // slider as Casino, so there's still just one dial for the whole page.
    const tavernMusic = document.getElementById('tavern-music');
    tavernMusic.volume = themeMusic.volume;
    volumeSlider.addEventListener('input', () => { tavernMusic.volume = volumeSlider.value / 100; });

    window.applyWingMusic = function(w){
      if (w === 'tavern') {
        themeMusic.pause();
        if (audioEnabled) tavernMusic.play().catch(() => {});
      } else {
        tavernMusic.pause();
        if (audioEnabled) themeMusic.play().catch(() => {});
      }
    };

    const unlock = () => {
      if (wing === 'tavern') { if (audioEnabled) tavernMusic.play().catch(() => {}); }
      else tryPlayTheme();
      window.removeEventListener('pointerdown', unlock); window.removeEventListener('keydown', unlock);
    };
    window.addEventListener('pointerdown', unlock);
    window.addEventListener('keydown', unlock);

    document.getElementById('mute-btn').addEventListener('click', (e) => {
      audioEnabled = !audioEnabled;
      e.currentTarget.textContent = audioEnabled ? '🔊' : '🔇';
      const active = wing === 'tavern' ? tavernMusic : themeMusic;
      if (audioEnabled) active.play().catch(() => {}); else active.pause();
    });

    const playlistOverlay = document.getElementById('playlist-overlay');
    const playlistList = document.getElementById('playlist-list');

    function renderPlaylist(){
      const unlockedTracks = (loadInv().tracks || []).filter((k) => TRACKS[k]);
      const keys = ['default', ...unlockedTracks];
      playlistList.innerHTML = keys.map((k) => {
        const active = k === trackKey;
        return `<div class="track-row${active ? ' active' : ''}" data-key="${k}">
          <span>${TRACKS[k].label}</span>${active ? '<span>▶</span>' : ''}
        </div>`;
      }).join('') + (unlockedTracks.length === 0
        ? '<div class="track-empty">No tracks unlocked yet — music drops from Classified upward. The Signal Case is stuffed with them.</div>'
        : '');

      playlistList.querySelectorAll('.track-row').forEach((row) => {
        row.addEventListener('click', () => {
          applyTrack(row.dataset.key, true);
          localStorage.setItem(ACTIVE_TRACK_KEY, row.dataset.key);
          playlistOverlay.classList.remove('open');
          renderPlaylist();
          // Previously dispatched nothing — see cloud-sync.js's SYNC_EVENTS.
          window.dispatchEvent(new CustomEvent('active-track:changed', { detail: { key: row.dataset.key } }));
        });
      });
    }

    document.getElementById('np-btn').addEventListener('click', () => {
      renderPlaylist();
      playlistOverlay.classList.add('open');
    });
    document.getElementById('playlist-close').addEventListener('click', () => playlistOverlay.classList.remove('open'));
    playlistOverlay.addEventListener('click', (e) => {
      if (e.target === playlistOverlay) playlistOverlay.classList.remove('open');
    });

    // A track won mid-session should become selectable straight away.
    window.addEventListener('music:unlocked', () => { if (playlistOverlay.classList.contains('open')) renderPlaylist(); });

    // ---------- Rendering helpers ----------
    function visual(item, cls){
      if (!item.img) return `<span class="${cls}">${item.emoji || '❓'}</span>`;
      const pixelClass = item.pixelated ? ' pixel-art' : '';
      return `<img src="${item.img}" alt="" loading="lazy" class="${pixelClass}">`;
    }
    function tileHTML(id){
      const it = ITEMS[id];
      if (!it) return '';
      const color = (RARITIES[it.tier] || {}).color || '#fff';
      return `<div class="tile" style="border-bottom-color:${color};box-shadow:inset 0 -34px 38px -34px ${color}">
        <div class="tile-art">${visual(it, 'tile-emoji')}</div>
        <div class="tile-label">${it.label}</div>
      </div>`;
    }

    // ---------- Case select ----------
    function renderCases(){
      const owned = IantopiaCase.getCases();
      caseGrid.innerHTML = Object.entries(CASES).map(([key, def]) => {
        const n = owned[key] || 0;
        return `<div class="case-card">
          <div class="case-emoji">${def.emoji || '📦'}</div>
          <div class="case-name">${def.label}</div>
          <div class="case-blurb">${def.blurb || ''}</div>
          <div class="case-cost">${def.cost.toLocaleString()} Strubles</div>
          <div class="case-owned">${n ? `You own ${n}` : ''}</div>
          <div class="case-actions">
            <button class="primary" data-buy="${key}" type="button">Buy</button>
            <button class="primary" data-open="${key}" type="button" ${n ? '' : 'disabled'}>Open</button>
          </div>
          <button class="btn" data-contents="${key}" type="button">Contents</button>
        </div>`;
      }).join('')
      // 5th tile, hardcoded rather than data-driven — not a case, just a
      // door into the Tavern wing. Spans 2 grid columns (see .shop-tile
      // CSS) so it reads as double-width against the 4 normal cards.
      + `<div class="case-card shop-tile" id="shop-tile">
          <div class="case-emoji">🍺</div>
          <div class="case-name">The Shopkeep</div>
          <div class="case-blurb">Skip the RNG — buy exactly what you want, no rolling required.</div>
        </div>`;

      caseGrid.querySelectorAll('[data-buy]').forEach((b) => {
        b.addEventListener('click', () => {
          const res = IantopiaCase.buyCase(b.dataset.buy);
          if (!res.ok) { flashCase(b, res.message); return; }
          playRandom('chips-stack', 6);
          renderCases();
        });
      });
      caseGrid.querySelectorAll('[data-open]').forEach((b) => {
        b.addEventListener('click', () => startOpen(b.dataset.open));
      });
      caseGrid.querySelectorAll('[data-contents]').forEach((b) => {
        b.addEventListener('click', () => showContents(b.dataset.contents));
      });
      const shopTile = document.getElementById('shop-tile');
      if (shopTile) shopTile.addEventListener('click', () => setWing('tavern'));
    }

    function flashCase(btn, msg){
      const card = btn.closest('.case-card');
      const el = card.querySelector('.case-owned');
      const prev = el.textContent;
      el.textContent = msg;
      el.style.color = '#eb4b4b';
      setTimeout(() => { el.textContent = prev; el.style.color = ''; }, 1800);
    }

    // ---------- Tavern: direct-buy cosmetics ----------
    // Ported from the standalone Shopkeep page — same getShopListings()/
    // buyItemDirect() calls, same card markup, just living in this page's
    // #tavern-shop section instead of its own route now.
    const cosmeticGrid = document.getElementById('cosmetic-grid');
    function renderCosmetics(){
      const listings = IantopiaCase.getShopListings().sort((a, b) => a.price - b.price);
      cosmeticGrid.innerHTML = listings.map((item) => {
        const rarity = RARITIES[item.tier] || { label: item.tier, color: '#ccc' };
        const art = item.img
          ? `<img src="${item.img}" alt="${item.label}">`
          : (item.emoji || '❔');
        return `<div class="shop-card${item.owned ? ' owned' : ''}" data-id="${item.id}">
          <div class="art">${art}</div>
          <div class="tier-tag" style="color:${rarity.color};border-color:${rarity.color}">${rarity.label}</div>
          <div class="name">${item.label}</div>
          <div class="price">${item.owned ? 'Owned' : `${item.price.toLocaleString()} Strubles`}</div>
          <button class="buy-btn${item.owned ? ' disabled' : ''}" type="button" ${item.owned ? 'disabled' : ''}>${item.owned ? 'Owned' : 'Buy'}</button>
        </div>`;
      }).join('');

      cosmeticGrid.querySelectorAll('.buy-btn:not(.disabled)').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.closest('.shop-card').dataset.id;
          const res = IantopiaCase.buyItemDirect(id);
          if (res.ok) { playRandom('chips-stack', 6); renderCosmetics(); syncBal(); }
        });
      });
    }
    window.addEventListener('inventory:changed', () => { if (wing === 'tavern') renderCosmetics(); });

    // ---------- Opening ----------
    function startOpen(caseKey){
      if (spinning) return;
      // A longer strip means more travel time at speed before the decelerating
      // tail, which is where the tension actually lives.
      const res = IantopiaCase.openCase(caseKey, { reelLength: 88, winnerIndex: 80 });
      if (!res.ok) { renderCases(); return; }

      currentCaseKey = caseKey;
      spinning = true;
      caseSelect.classList.add('hidden');
      openView.classList.add('active');
      reveal.classList.remove('active');
      reelTitle.textContent = CASES[caseKey].label;

      strip.innerHTML = res.reel.map(tileHTML).join('');
      strip.style.transition = 'none';
      strip.style.transform = 'translateX(0px)';

      // setTimeout rather than rAF: rAF does not fire at all in a backgrounded
      // tab, which would strand the reel after the case had already been spent.
      // animateTo() forces its own layout flush, so a frame callback buys nothing.
      playCaseAnimation(caseKey).then(() => setTimeout(() => animateTo(res), 30));
    }

    // The case rattles, winds up, then bursts into a flash before the reel
    // appears. Resolves when the reel should start moving.
    function playCaseAnimation(caseKey){
      const anim = document.getElementById('case-anim');
      const box = document.getElementById('case-anim-box');
      const flash = document.getElementById('flash');
      const viewport = document.getElementById('reel-viewport');

      box.textContent = (CASES[caseKey] && CASES[caseKey].emoji) || '📦';
      box.className = 'case-anim-box';
      anim.classList.add('active');
      viewport.classList.add('hidden');

      playRandom('cards-pack-take-out', 2);
      void box.offsetWidth; // restart the animation on repeat opens
      box.classList.add('rattle');

      return new Promise((resolve) => {
        setTimeout(() => {
          box.classList.remove('rattle');
          box.classList.add('burst');
          playRandom('cards-pack-open', 2);
          flash.classList.remove('fire');
          void flash.offsetWidth;
          flash.classList.add('fire');
        }, 1500);

        setTimeout(() => {
          anim.classList.remove('active');
          viewport.classList.remove('hidden');
          resolve();
        }, 1900);
      });
    }

    function animateTo(res){
      const tiles = strip.children;
      if (tiles.length < 2) { finish(res); return; }

      // Measure the true step from the DOM rather than assuming the CSS values,
      // so changing --tile-w or --tile-gap can't desync the landing position.
      const step = tiles[1].offsetLeft - tiles[0].offsetLeft;
      const tileW = tiles[0].offsetWidth;
      const centre = viewport.clientWidth / 2;

      // Land off-centre by a random fraction of a tile so the winner doesn't
      // snap to dead centre every single time.
      const jitter = (Math.random() - 0.5) * tileW * 0.5;
      const target = -(res.winnerIndex * step + tileW / 2 - centre + jitter);

      const DURATION = 9400;

      strip.style.transition = 'none';
      strip.style.transform = 'translateX(0px)';
      void strip.offsetWidth; // force reflow so the reset isn't coalesced
      // Long tail: the curve spends most of its time in the final crawl, so the
      // last handful of tiles inch past the marker one at a time.
      strip.style.transition = `transform ${DURATION}ms cubic-bezier(.10,.68,.12,1)`;
      strip.style.transform = `translateX(${target}px)`;

      // Tick whenever a new tile crosses the marker.
      let lastIdx = -1, running = true;
      (function tickLoop(){
        if (!running) return;
        const m = new DOMMatrixReadOnly(getComputedStyle(strip).transform);
        const idx = Math.round((-m.m41 + centre) / step);
        if (idx !== lastIdx) { if (lastIdx !== -1) playTick(); lastIdx = idx; }
        requestAnimationFrame(tickLoop);
      })();

      let settled = false;
      const done = (e) => {
        if (e && (e.target !== strip || e.propertyName !== 'transform')) return;
        if (settled) return;
        settled = true;
        clearTimeout(guard);
        strip.removeEventListener('transitionend', done);
        running = false;
        finish(res);
      };
      strip.addEventListener('transitionend', done);

      // transitionend is the only thing that reveals the prize, and it can be
      // missed — an interrupted transition, a backgrounded tab, or a browser
      // honouring prefers-reduced-motion will never fire it. Without this guard
      // the reel hangs forever with spinning=true and the case is already spent.
      const guard = setTimeout(done, DURATION + 600);
    }

    function finish(res){
      spinning = false;
      syncBal();

      const color = res.rarity.color || '#fff';
      const card = document.getElementById('reveal-card');
      card.style.setProperty('--rc', color);
      card.style.boxShadow = `0 0 20px ${color}, 0 0 60px ${color}55, inset 0 0 40px ${color}22`;

      document.getElementById('reveal-rarity').textContent = res.rarity.label;
      document.getElementById('reveal-visual').innerHTML = visual(res.item, 'reveal-emoji');
      document.getElementById('reveal-label').textContent = res.item.label;
      document.getElementById('reveal-desc').textContent = res.item.description || '';

      const note = document.getElementById('reveal-note');
      if (res.duplicate) {
        note.textContent = `Duplicate — refunded ${res.refund.toLocaleString()} Strubles`;
      } else if (res.item.type === 'strubles') {
        note.textContent = `+${res.item.amount.toLocaleString()} added to your balance`;
      } else if (res.item.type === 'unlock_page') {
        note.textContent = `Unlocked: ${res.item.path}`;
      } else {
        note.textContent = 'Added to your inventory';
      }

      // Action items hand back a mailto instead of navigating on their own —
      // a redirect mid-reveal would yank the player off the page.
      const actions = document.querySelector('.reveal-actions');
      const old = actions.querySelector('[data-mailto]');
      if (old) old.remove();
      if (res.mailto) {
        const a = document.createElement('a');
        a.className = 'btn'; a.dataset.mailto = '1'; a.href = res.mailto; a.textContent = 'Send It';
        actions.insertBefore(a, actions.firstChild);
      }

      // Loud tiers get a loud sound.
      if (res.tier === 'exceedingly_rare' || res.tier === 'covert') playRandom('chips-stack', 6);
      else playRandom('chip-lay', 3);

      reveal.classList.add('active');
      againBtn.disabled = IantopiaCase.getCaseCount(currentCaseKey) === 0;
      againBtn.textContent = againBtn.disabled ? 'No Cases Left' : 'Open Another';
    }

    againBtn.addEventListener('click', () => { if (!againBtn.disabled) startOpen(currentCaseKey); });
    backBtn.addEventListener('click', () => {
      openView.classList.remove('active');
      reveal.classList.remove('active');
      caseSelect.classList.remove('hidden');
      renderCases();
    });

    // ---------- Contents / odds ----------
    const contentsOverlay = document.getElementById('contents-overlay');
    function showContents(caseKey){
      const def = CASES[caseKey];
      const odds = IantopiaCase.oddsFor(caseKey);
      document.getElementById('contents-title').textContent = def.label;

      let html = '';
      // Highest rarity first — that's what people open the panel to check.
      [...ORDER].reverse().forEach((tier) => {
        const ids = IantopiaCase.itemsInTier(caseKey, tier);
        if (!ids.length) return;
        const r = RARITIES[tier];
        html += `<div class="tier-head" style="color:${r.color}">${r.label} — ${odds[tier]}%</div>`;
        html += `<div class="tier-items">` + ids.map((id) => {
          const it = ITEMS[id];
          const vis = it.img ? `<img src="${it.img}" alt="">` : `<span class="te">${it.emoji || '❓'}</span>`;
          // Most items are self-explanatory from their name (a background,
          // a cursor skin) — description is only worth showing when one
          // actually exists (currently just the Tycoon buildings), rather
          // than padding every row with empty space.
          const desc = it.description ? `<small>${it.description}</small>` : '';
          return `<div class="tier-item" style="color:${r.color}">${vis}<span>${it.label}${desc}</span></div>`;
        }).join('') + `</div>`;
      });
      document.getElementById('contents-body').innerHTML = html;
      contentsOverlay.classList.add('open');
    }
    document.getElementById('contents-close').addEventListener('click', () => contentsOverlay.classList.remove('open'));
    contentsOverlay.addEventListener('click', (e) => { if (e.target === contentsOverlay) contentsOverlay.classList.remove('open'); });

    renderCases();
    setWing('casino');

    // Initialize pickers (background and cursor only; lootbox has its own music logic)
    if (window.initPickersForBgAndCursor) {
      setTimeout(window.initPickersForBgAndCursor, 100);
    }
  })();
  </script>
</body>
</html>
