<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Horse Game</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0a0c12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script is:inline src="/pwa.js?v=1" defer></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<!--
  Rewritten as a canvas game (chrome://dino's own architecture: a single
  Runner object owns state, one requestAnimationFrame loop both advances
  physics AND draws every frame from that state). Everything on screen is
  a draw call, not a DOM node someone can attach a second, competing
  listener to -- which is what caused the last version's real bug (a
  button's click handler and its ancestor's pointerdown handler both
  reacting to the same click, racing two physics loops against each
  other). is:global is kept for the same reason as every other page here:
  the canvas and overlays still get manipulated at runtime.
-->
<style is:global>
  :root { --bg:#0f1115; --panel:#161c27; --ink:#e9eef9; --muted:#9fb0cf; --gold:#ffd700; }
  * { box-sizing:border-box; }
  html, body { margin:0; height:100%; }
  body {
    height:100dvh;
    display:flex; flex-direction:column;
    background:var(--bg); color:var(--ink);
    font-family: 'Press Start 2P', ui-monospace, 'Courier New', monospace;
    cursor:none;
    position:relative;
    overflow-x:hidden; overflow-y:auto;
  }

  #sky-bg {
    position:fixed; inset:0; z-index:-2;
    background-image:url('/horse-game/plain.gif');
    background-size:cover; background-position:center;
  }

  #strubles-badge{
    position:fixed; top:calc(15px + env(safe-area-inset-top)); left:calc(20px + env(safe-area-inset-left)); display:flex; align-items:center; gap:8px;
    background:#000; padding:8px 12px; border:3px solid var(--gold);
    font-weight:700; z-index:20;
  }
  #strubles-badge img{ width:28px; height:28px; }

  main {
    position:relative; z-index:2; max-width:900px; width:100%; margin:0 auto;
    padding:16px 24px 24px; padding-top:calc(80px + env(safe-area-inset-top));
    flex:1 1 auto; min-height:0;
    display:flex; flex-direction:column;
  }

  header { flex:0 0 auto; display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; border-bottom:4px solid #000; padding-bottom:10px; flex-wrap:wrap; gap:10px; }
  header a { color:var(--gold); text-decoration:none; border:3px solid #000; padding:8px 12px; font-weight:700; background:#000; transition:background 0.2s; font-size:10px; cursor:none; }
  header a:hover { background:var(--gold); color:#000; }
  header button { color:var(--gold); background:#000; border:2px solid var(--gold); padding:4px 6px; cursor:none; transition:background 0.2s; font-size:14px; }
  header button:hover { background:var(--gold); color:#000; }

  h1 {
    margin:0; font-size:clamp(12px,2.4vw,18px); letter-spacing:1px; color:var(--gold); font-weight:400;
    text-shadow: 2px 2px 0 #000; text-align:center; width:100%;
  }

  #stats-bar {
    flex:0 0 auto;
    display:flex; justify-content:center; gap:18px; flex-wrap:wrap;
    background:rgba(0,0,0,.55); border:2px solid var(--gold); padding:8px 14px;
    margin-bottom:14px; font-size:9px; color:#fff;
  }
  #stats-bar b { color:var(--gold); }

  /* ---------- Game stage ---------- */
  #game-stage {
    position:relative;
    flex:1 1 auto; min-height:200px; max-height:380px;
    border:3px solid #000; outline:2px solid var(--gold); outline-offset:-2px;
    overflow:hidden;
    background-image:url('/horse-game/plain.gif');
    background-size:cover; background-position:center;
    touch-action:none;
  }
  /* The photo backdrop stays a plain CSS background (the browser already
     animates its gif frames for free); the canvas on top only ever draws
     the parts of the scene that actually move -- ground, horse, hurdles,
     dust, flashes -- so none of that huge image has to be re-drawn by JS
     every frame. */
  #game-canvas {
    position:absolute; inset:0; display:block; width:100%; height:100%;
  }

  .stage-overlay {
    position:absolute; inset:0; z-index:10;
    background:rgba(0,0,0,.72);
    display:flex; align-items:center; justify-content:center;
    text-align:center; padding:20px;
  }
  .stage-overlay[hidden] { display:none; }
  .stage-box h2 { margin:0 0 12px; font-size:14px; color:var(--gold); text-shadow:2px 2px 0 #000; }
  .stage-box p { margin:0 0 16px; font-size:9px; line-height:1.9; color:var(--ink); }
  .stage-box b { color:var(--gold); }
  .stage-box .btn {
    color:#000; background:var(--gold); text-decoration:none; border:3px solid #000;
    padding:10px 18px; font-size:11px; font-weight:700; cursor:none;
    font-family:inherit;
  }
  .stage-box .btn:hover { background:#ffe766; }
  #sound-hint {
    margin:14px 0 0; font-size:7px; color:var(--muted); line-height:1.7;
    max-width:260px;
  }

  #hint {
    flex:0 0 auto; text-align:center; font-size:8px; color:var(--muted);
    margin-top:10px; line-height:1.8;
  }
</style>
</head>
<body>
  <div id="sky-bg"></div>

  <div id="strubles-badge">
    <img src="/strubles.png" alt="Struble">
    <span id="bal">0</span>
  </div>

  <main>
    <header>
      <a href="/" title="Back to Iantopia">← Home</a>
      <h1>HORSE GAME</h1>
      <div style="display:flex; gap:4px;">
        <button id="duck-btn" title="Duck (or hold ↓ / S)">⬇</button>
        <button id="track-btn" title="Switch music">🎵</button>
        <button id="mute-btn" title="Toggle sound">🔊</button>
      </div>
    </header>

    <div id="stats-bar">
      <span>Hurdles cleared: <b id="stat-cleared">0</b></span>
      <span>Best: <b id="stat-best">0</b></span>
      <span>Strubles this run: <b id="stat-earned">0</b></span>
    </div>

    <div id="game-stage">
      <canvas id="game-canvas"></canvas>

      <div class="stage-overlay" id="start-overlay">
        <div class="stage-box">
          <h2>🐴 Horse Game</h2>
          <p>Space / ↑ / tap to jump — hold for a higher jump.<br>
          Walk off a gap's edge and you'll fall in — jump clear of it instead. Big gaps have a glowing orb: jump toward it, then tap jump again while touching it to boost across.<br>
          After 50 hurdles cleared, low planes start flying in — ↓ / S / the ⬇ button to duck under one, or it's game over.<br>
          Hurdles cleared and coins collected both pay <b>Strubles</b>.</p>
          <button class="btn" id="start-btn" type="button">▶ Start Running</button>
          <p id="sound-hint">🔇 Browsers block audio until you interact — sound starts the moment you press Start.</p>
        </div>
      </div>

      <div class="stage-overlay" id="gameover-overlay" hidden>
        <div class="stage-box">
          <h2 id="gameover-title">Wiped Out!</h2>
          <p>Hurdles cleared: <b id="final-cleared">0</b><br>Strubles earned: <b id="final-earned">0</b><br>Best: <b id="final-best">0</b></p>
          <button class="btn" id="restart-btn" type="button">↻ Try Again</button>
        </div>
      </div>
    </div>

    <div id="hint">Now playing: <span id="np-label">Arvan Khoyor Jil</span></div>
  </main>

  <!-- "auto" would start an eager full 15MB download the instant the page
       loads, competing for bandwidth with cursor.js and plain.gif right
       when they need it most -- metadata is enough for playback to begin
       immediately on .play() (audio streams progressively), without that
       contention. -->
  <audio id="theme-music" src="/audio/music/arvan-khoyor-jil.mp3" preload="metadata" loop></audio>
  <audio id="sfx-clear" src="/audio/sfx/minesweeper-flag.mp3" preload="none"></audio>

<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<script is:inline src="/cloud-sync.js?v=7"></script>
<script is:inline src="/strubles.js?v=2"></script>
<script is:inline src="/cursor-library.js?v=2"></script>
<script is:inline src="/cursor.js?v=3"></script>

<script is:inline>
(function () {
  const $ = (id) => document.getElementById(id);

  // ---------- Strubles balance ----------
  function syncBalance() { try { $('bal').textContent = Strubles.get().toLocaleString(); } catch {} }
  syncBalance();
  window.addEventListener('strubles:change', syncBalance);

  // ---------- Sound ----------
  let audioEnabled = true;
  const themeMusic = $('theme-music');
  const sfxClear = $('sfx-clear');
  const VOLUME_KEY = 'music_volume_v1';
  const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
  const vol = isFinite(savedVolume) ? savedVolume : 0.3;
  themeMusic.volume = vol;
  sfxClear.volume = Math.min(1, vol + 0.3);

  const TRACKS = [
    { src: '/audio/music/arvan-khoyor-jil.mp3', label: 'Arvan Khoyor Jil' },
    { src: '/audio/music/wild-horse.mp3', label: 'Amazing Wild Horse' },
  ];
  let trackIdx = 0;
  function applyTrack(restart) {
    themeMusic.src = TRACKS[trackIdx].src;
    $('np-label').textContent = TRACKS[trackIdx].label;
    if (restart) tryPlayTheme();
  }
  $('track-btn').addEventListener('click', () => {
    trackIdx = (trackIdx + 1) % TRACKS.length;
    applyTrack(true);
  });

  function tryPlayTheme() { if (audioEnabled) themeMusic.play().catch(() => {}); }
  themeMusic.addEventListener('play', () => { const h = $('sound-hint'); if (h) h.remove(); }, { once: true });
  applyTrack(false);
  tryPlayTheme();
  const unlockTheme = () => {
    tryPlayTheme();
    window.removeEventListener('pointerdown', unlockTheme);
    window.removeEventListener('keydown', unlockTheme);
  };
  window.addEventListener('pointerdown', unlockTheme);
  window.addEventListener('keydown', unlockTheme);
  $('mute-btn').addEventListener('click', () => {
    audioEnabled = !audioEnabled;
    $('mute-btn').textContent = audioEnabled ? '🔊' : '🔇';
    if (audioEnabled) tryPlayTheme(); else themeMusic.pause();
  });
  function playClearSfx() {
    if (!audioEnabled) return;
    try { sfxClear.currentTime = 0; sfxClear.play().catch(() => {}); } catch {}
  }

  // ================= Game =================
  // One state object; the render loop is a pure function of it. Every
  // input path (keyboard, pointer, the two buttons) only ever calls
  // beginRun()/jump()/releaseJump() below -- none of them touch DOM
  // elements or spin up their own animation frame chain, so there's no
  // way for two of them firing off the same physical gesture to fight
  // each other the way the DOM-node version could.
  const stage = $('game-stage');
  const canvas = $('game-canvas');
  const ctx = canvas.getContext('2d');
  const startOverlay = $('start-overlay');
  const gameoverOverlay = $('gameover-overlay');
  const BEST_KEY = 'horse_game_best_v1';

  const horseImg = new Image();
  horseImg.src = '/horse-game/horse.png';
  const HORSE_ASPECT = 602 / 760; // native horse.png h/w, in case it loads late
  // Duck sprite: the same horse squashed wide and short (built offline via
  // PIL -- non-uniform resize + a shear so it reads as "comedically
  // stretched", not just a scaled-down copy).
  const horseDuckImg = new Image();
  horseDuckImg.src = '/horse-game/horse-duck.png';
  const DUCK_ASPECT = 301 / 1146;
  const grassImg = new Image();
  grassImg.src = '/tycoon/grass-foreground.png';
  const GRASS_ASPECT = 130 / 1085;
  // Plane obstacle reuses the tycoon page's existing silly-airplane.gif.
  // drawImage() on a gif-backed Image only ever paints its first frame --
  // deliberate: this keeps the file's "everything on screen is a draw
  // call, not a DOM node" rule intact instead of syncing an animated <img>
  // overlay to canvas state for one obstacle type.
  const planeImg = new Image();
  planeImg.src = '/tycoon/silly-airplane.gif';
  const PLANE_ASPECT = 325 / 512;
  const strubleImg = new Image();
  strubleImg.src = '/strubles.png';

  // Physics constants researched from chromium's actual trex-runner
  // (GRAVITY 0.6, INITIAL_JUMP_VELOCITY ~12, SPEED 6->13 px/frame @60fps --
  // https://github.com/wayou/t-rex-runner/blob/gh-pages/index.js), scaled
  // to px/s for this dt-based loop and tuned a bit floatier so a
  // first-timer's mistimed opening jump isn't an instant loss.
  const GRAVITY = -2200;
  const JUMP_VELOCITY = 900;
  // Releasing early clamps the upward speed instead of letting gravity
  // keep fighting full momentum -- same short-hop-vs-full-jump feel as
  // the real game's endJump()/DROP_VELOCITY.
  const RELEASE_CLAMP = 260;
  const GROUND_H = 46;
  const HORSE_X = 56;
  const START_SPEED = 250;
  const MAX_SPEED = 640;
  const ACCEL = 16; // px/s^2 of *speed* -- world keeps getting faster

  // Two obstacle sizes (the real game's CACTUS_SMALL/CACTUS_LARGE) so the
  // skyline of hurdles reads as varied rather than one shape on a loop;
  // large ones start appearing once the run has picked up some speed.
  const HURDLE_TYPES = [
    { w: 20, h: 40, weight: 3 },
    { w: 28, h: 60, weight: 1 },
  ];

  // Ducking shrinks the horse's own hitbox height so it can pass under a
  // low plane a standing horse couldn't. Holding duck mid-air instead
  // fast-falls, chrome-dino style, rather than doing nothing.
  const DUCK_HEIGHT_FACTOR = 0.55;
  const FASTFALL_GRAVITY_MULT = 2.4;

  const COIN_R = 8;
  const ORB_R = 15;
  // Added to whatever vertical speed the horse already has on a
  // successful parry -- a second, smaller hop stacked on the jump already
  // in progress, not a fresh one.
  const ORB_BOOST_VELOCITY = 760;

  // -- Physics-derived fairness bound -------------------------------------
  // There's no published Geometry Dash generation algorithm to copy (real
  // GD levels are hand-built, not procedural), so gaps are instead gated
  // by what THIS game's own jump can actually clear: airtime is exactly
  // how long a jump spends above y=0 under this gravity/launch speed, so
  // airtime * ground speed is the farthest a full, uninterrupted jump can
  // carry the horse forward. Nothing is ever generated wider than that
  // (with a safety margin) unless a jump orb is placed to make up the gap.
  function jumpAirtime() { return 2 * (JUMP_VELOCITY / Math.abs(GRAVITY)); }
  function maxJumpDistance(atSpeed) { return jumpAirtime() * atSpeed; }
  const GAP_SAFETY = 0.78; // plain gaps may use at most this fraction of a true max jump
  const ORB_GAP_SAFETY = 1.65; // orb-assisted gaps may exceed a single jump's reach

  let W = 0, H = 0, groundY = 0;
  let horseW = 96, horseH = 96 * HORSE_ASPECT;
  let dpr = Math.max(1, window.devicePixelRatio || 1);

  function resize() {
    W = stage.clientWidth;
    H = stage.clientHeight;
    dpr = Math.max(1, window.devicePixelRatio || 1);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    groundY = H - GROUND_H;
    horseW = Math.min(112, W * 0.13);
    horseH = horseW * HORSE_ASPECT;
  }
  window.addEventListener('resize', resize);
  resize();

  let state = 'idle'; // idle | playing | over
  let horse = { y: 0, vy: 0, holding: false, ducking: false, falling: false };
  let hurdles = [];
  let gaps = [];
  let coins = [];
  let planes = [];
  let orbs = [];
  let dust = [];
  let bursts = []; // brief celebratory flashes on streak milestones
  let particles = []; // orb-activation burst
  let shake = 0;
  let groundScroll = 0;
  let speed = START_SPEED;
  let spawnTimer = 0;
  let dustTimer = 0;
  let cleared = 0, earned = 0;
  let deathReason = 'Wiped Out!';
  let best = parseInt(localStorage.getItem(BEST_KEY), 10) || 0;
  $('stat-best').textContent = best.toLocaleString();

  function hurdleHitbox(w) { return { inset: w * 0.12 }; }

  // Single source of truth for the horse's current collision box --
  // ducking only shrinks its height (and only while grounded), so every
  // obstacle type checks against this instead of re-deriving it.
  function horseBox() {
    const h = (horse.ducking && horse.y <= 0.5 && !horse.falling) ? horseH * DUCK_HEIGHT_FACTOR : horseH;
    const left = HORSE_X + horseW * 0.24;
    const right = HORSE_X + horseW * 0.86;
    const top = groundY - horse.y - h;
    const bottom = groundY - horse.y;
    return { left, right, top, bottom, h };
  }

  function beginRun() {
    // Idempotent by design -- if this somehow fires twice for one
    // gesture, the second call is a harmless no-op instead of quietly
    // resetting a run that already started.
    if (state === 'playing') return;
    state = 'playing';
    horse.y = 0; horse.vy = 0; horse.holding = false; horse.ducking = false; horse.falling = false;
    speed = START_SPEED;
    spawnTimer = 1.1;
    dustTimer = 0;
    cleared = 0; earned = 0; deathReason = 'Wiped Out!';
    hurdles = []; gaps = []; coins = []; planes = []; orbs = [];
    dust = []; bursts = []; particles = []; shake = 0;
    $('stat-cleared').textContent = '0';
    $('stat-earned').textContent = '0';
    startOverlay.hidden = true;
    gameoverOverlay.hidden = true;
  }

  function jump() {
    if (state !== 'playing') { beginRun(); return; }
    if (horse.falling) return; // already committed to the hole -- no jumping out of it
    if (horse.y > 0.5 || horse.vy > 0) {
      // Airborne -- a second, distinct jump press only ever does one
      // thing: parry a live orb it's currently touching. Deliberately a
      // real double-click, not an auto-pickup on overlap -- tap to jump,
      // then tap again near the orb.
      const box = horseBox();
      const cx = (box.left + box.right) / 2;
      const cy = (box.top + box.bottom) / 2;
      for (const o of orbs) {
        if (o.used) continue;
        if (Math.hypot(cx - o.x, cy - o.y) <= ORB_R + 18) {
          o.used = true;
          horse.vy = Math.max(horse.vy, 0) + ORB_BOOST_VELOCITY;
          horse.holding = true;
          spawnOrbBurst(o.x, o.y);
          break;
        }
      }
      return;
    }
    if (horse.ducking) return; // grounded + ducking: duck and jump are exclusive
    horse.vy = JUMP_VELOCITY;
    horse.holding = true;
  }

  function releaseJump() {
    if (horse.holding && horse.vy > RELEASE_CLAMP) horse.vy = RELEASE_CLAMP;
    horse.holding = false;
  }

  function startDuck() { horse.ducking = true; }
  function endDuck() { horse.ducking = false; }

  function endGame(reason) {
    state = 'over';
    shake = 0.25;
    deathReason = reason || 'Wiped Out!';
    if (cleared > best) {
      best = cleared;
      localStorage.setItem(BEST_KEY, String(best));
    }
    $('gameover-title').textContent = deathReason;
    $('final-cleared').textContent = cleared.toLocaleString();
    $('final-earned').textContent = earned.toLocaleString();
    $('final-best').textContent = best.toLocaleString();
    $('stat-best').textContent = best.toLocaleString();
    gameoverOverlay.hidden = false;
  }

  function pickHurdleType() {
    const pool = speed > 380 ? HURDLE_TYPES : [HURDLE_TYPES[0]];
    const total = pool.reduce((s, t) => s + t.weight, 0);
    let r = Math.random() * total;
    for (const t of pool) { if ((r -= t.weight) <= 0) return t; }
    return pool[0];
  }

  let nextHurdleId = 1;

  // One coin per jump, never a cluster -- a single Struble icon floating
  // over the obstacle that just called for a jump.
  function spawnCoin(x, y) {
    const roll = Math.random();
    const value = roll < 0.15 ? 3 : (roll < 0.4 ? 2 : 1);
    coins.push({ x, y, r: COIN_R, value, collected: false, bob: Math.random() * Math.PI * 2 });
  }

  // One plane type: big, low, and lethal unless ducked. (An earlier
  // decorative high-altitude band was cut -- it had no collision at all
  // and just cluttered the sky with obstacles that could never hurt you.)
  function spawnPlane(x) {
    const w = Math.min(220, W * 0.3);
    const h = w * PLANE_ASPECT;
    // Positioned so its bottom edge sits just above a *ducked* horse's
    // head -- a duck clears it clean, standing height does not.
    const duckH = horseH * DUCK_HEIGHT_FACTOR;
    const margin = 6;
    const bottom = groundY - duckH - margin;
    const y = bottom - h / 2;
    planes.push({ x, y, w, h, bob: Math.random() * Math.PI * 2 });
  }

  function spawnGap(x, w, withOrb) {
    gaps.push({ x, w });
    if (withOrb) {
      orbs.push({ x: x + w / 2, y: groundY - Math.min(160, H * 0.42), used: false, phase: Math.random() * Math.PI * 2 });
    }
  }

  function spawnOrbBurst(x, y) {
    for (let i = 0; i < 14; i++) {
      const a = (i / 14) * Math.PI * 2;
      particles.push({
        x, y,
        vx: Math.cos(a) * (120 + Math.random() * 80),
        vy: Math.sin(a) * (120 + Math.random() * 80),
        age: 0, life: 0.5 + Math.random() * 0.2,
      });
    }
  }

  function tierForSpeed(atSpeed) {
    if (atSpeed < 350) return 0;
    if (atSpeed < 450) return 1;
    if (atSpeed < 550) return 2;
    return 3;
  }

  // Pattern/encounter spawner: replaces a single-hurdle random timer with
  // a pool of hand-designed encounters gated by tier (== speed), each
  // introducing a new obstacle type only once the run is fast enough that
  // it's fair to ask of the player. Gaps within any pattern are clamped
  // to maxJumpDistance()-derived bounds above, so nothing built here can
  // ever be mathematically uncrossable.
  function buildEncounter(originX, atSpeed) {
    const tier = tierForSpeed(atSpeed);
    const maxGap = maxJumpDistance(atSpeed) * GAP_SAFETY;
    const maxOrbGap = maxJumpDistance(atSpeed) * ORB_GAP_SAFETY;

    const patterns = [
      { tier: 0, weight: 3, build: () => {
        const t = pickHurdleType();
        hurdles.push({ id: nextHurdleId++, x: originX, w: t.w, h: t.h, cleared: false });
        if (Math.random() < 0.5) spawnCoin(originX + t.w / 2, groundY - horseH * 1.5);
      }},
      { tier: 1, weight: 2, build: () => {
        const t1 = pickHurdleType();
        const t2 = pickHurdleType();
        hurdles.push({ id: nextHurdleId++, x: originX, w: t1.w, h: t1.h, cleared: false });
        hurdles.push({ id: nextHurdleId++, x: originX + t1.w + 46 + Math.random() * 30, w: t2.w, h: t2.h, cleared: false });
      }},
      { tier: 2, weight: 2, build: () => {
        const w = Math.max(36, Math.min(maxGap, 55 + Math.random() * 35));
        spawnGap(originX, w, false);
        spawnCoin(originX + w / 2, groundY - horseH * 1.3);
      }},
      { tier: 3, weight: 2, build: () => {
        // A bit more than one clean jump can clear, capped well under a
        // third of the visible stage so it never reads as an oversized
        // chasm regardless of how fast the run has gotten.
        const orbCap = Math.min(maxOrbGap, W * 0.3);
        const w = Math.max(Math.min(maxGap + 24, orbCap), Math.min(orbCap, maxGap + 24 + Math.random() * 40));
        spawnGap(originX, w, true);
      }},
      // The deadly low plane only enters rotation after 50 hurdle clears
      // -- an explicit skill-gate rather than a speed-tier one, so it
      // reliably shows up once a player has proven they can handle the
      // basics, independent of how fast the run happens to be going.
      { tier: 0, weight: 3, enabled: () => cleared >= 50, build: () => {
        spawnPlane(originX);
      }},
      { tier: 0, weight: 1, enabled: () => cleared >= 50, build: () => {
        spawnPlane(originX);
        const t = pickHurdleType();
        hurdles.push({ id: nextHurdleId++, x: originX + 220 + Math.random() * 40, w: t.w, h: t.h, cleared: false });
      }},
    ];

    const pool = patterns.filter((p) => p.tier <= tier && (!p.enabled || p.enabled()));
    const total = pool.reduce((s, p) => s + p.weight, 0);
    let r = Math.random() * total;
    for (const p of pool) { if ((r -= p.weight) <= 0) { p.build(); return; } }
    pool[0].build();
  }

  function spawnDust(vx) {
    dust.push({
      x: HORSE_X + horseW * 0.25 + (Math.random() - 0.5) * 10,
      y: groundY - 2,
      vx: -vx * 0.4 - 30 - Math.random() * 30,
      vy: -20 - Math.random() * 30,
      life: 0.5 + Math.random() * 0.25,
      age: 0,
      r: 2 + Math.random() * 2.5,
    });
  }

  let lastT = 0;
  function update(dt) {
    speed = Math.min(MAX_SPEED, speed + ACCEL * dt);
    groundScroll = (groundScroll + speed * dt) % (grassImg.naturalWidth ? grassImg.naturalWidth * (GROUND_H / (grassImg.naturalHeight || 130)) : 200);

    // Horse physics -- ducking mid-air fast-falls instead of doing
    // nothing, same as chrome dino's own duck-in-air behavior. The
    // ground clamp itself is decided further down, once this frame's gap
    // positions are known (see "Ground contact" below) -- stepping onto
    // open air falls through instead of snapping back to y=0.
    const grounded = horse.y <= 0.5 && !horse.falling;
    const gravityMult = (horse.ducking && !grounded && !horse.falling) ? FASTFALL_GRAVITY_MULT : 1;
    horse.vy += GRAVITY * gravityMult * dt;
    horse.y += horse.vy * dt;

    // Dust while grounded and running
    dustTimer -= dt;
    if (horse.y <= 0.5 && dustTimer <= 0) {
      spawnDust(speed);
      dustTimer = 0.09;
    }
    for (let i = dust.length - 1; i >= 0; i--) {
      const d = dust[i];
      d.age += dt;
      d.x += d.vx * dt;
      d.y += d.vy * dt;
      d.vy += 260 * dt;
      if (d.age >= d.life) dust.splice(i, 1);
    }

    // Hurdles
    const horseLeft = HORSE_X + horseW * 0.24;
    const horseRight = HORSE_X + horseW * 0.86;
    for (let i = hurdles.length - 1; i >= 0; i--) {
      const h = hurdles[i];
      h.x -= speed * dt;
      const hb = hurdleHitbox(h.w);
      const hurdleLeft = h.x + hb.inset;
      const hurdleRight = h.x + h.w - hb.inset;
      const xOverlap = horseRight > hurdleLeft && horseLeft < hurdleRight;
      if (xOverlap && horse.y < h.h - 8) {
        endGame('Wiped Out!');
        return;
      }
      if (!h.cleared && h.x + h.w < HORSE_X) {
        h.cleared = true;
        cleared++; earned++;
        try { Strubles.add(1); } catch {}
        $('stat-cleared').textContent = cleared.toLocaleString();
        $('stat-earned').textContent = earned.toLocaleString();
        playClearSfx();
        if (cleared % 10 === 0) {
          bursts.push({ x: HORSE_X + horseW * 0.5, y: groundY - horseH * 0.6, age: 0, life: 0.9, text: `${cleared} STREAK!` });
        }
      }
      if (h.x + h.w < -30) hurdles.splice(i, 1);
    }

    // Gaps -- scroll first so "Ground contact" below reads this frame's
    // real positions, not last frame's.
    for (let i = gaps.length - 1; i >= 0; i--) {
      const g = gaps[i];
      g.x -= speed * dt;
      if (g.x + g.w < -30) gaps.splice(i, 1);
    }

    // Ground contact -- the horse only actually falls into a gap once it
    // physically crosses onto the open space over it, rather than dying
    // the instant a hitbox merely touches the gap's edge. Once falling
    // starts it's committed (no jumping out, see jump()) and gravity just
    // keeps pulling it down past the ground line into the hole, ending
    // the run once it's fallen far enough to be off-screen.
    if (!horse.falling && horse.y <= 0.5) {
      const centerX = HORSE_X + horseW * 0.5;
      const overGap = gaps.some((g) => centerX > g.x && centerX < g.x + g.w);
      if (overGap) {
        horse.falling = true;
      } else {
        horse.y = 0; horse.vy = 0; horse.holding = false;
      }
    }
    if (horse.falling && horse.y < -H * 0.55) {
      endGame('Fell in a Gap!');
      return;
    }

    // Planes -- big, low, lethal unless ducked under.
    for (let i = planes.length - 1; i >= 0; i--) {
      const p = planes[i];
      p.x -= speed * dt;
      p.bob += dt * 3;
      const box = horseBox();
      const planeLeft = p.x + p.w * 0.1;
      const planeRight = p.x + p.w * 0.9;
      const planeTop = p.y - p.h * 0.5;
      const planeBottom = p.y + p.h * 0.5;
      const xOverlap = box.right > planeLeft && box.left < planeRight;
      const yOverlap = box.bottom > planeTop && box.top < planeBottom;
      if (xOverlap && yOverlap) {
        endGame('Clipped by a Plane!');
        return;
      }
      if (p.x + p.w < -40) planes.splice(i, 1);
    }

    // Orbs -- pickup/boost is handled entirely in jump() (a real second
    // press), this just scrolls and pulses them, and drops ones that
    // scrolled off unused.
    for (let i = orbs.length - 1; i >= 0; i--) {
      const o = orbs[i];
      o.x -= speed * dt;
      o.phase += dt * 4;
      if (o.x < -40) orbs.splice(i, 1);
    }

    // Coins -- sparse, variable-value, collectible in any horse state.
    for (let i = coins.length - 1; i >= 0; i--) {
      const c = coins[i];
      c.x -= speed * dt;
      c.bob += dt * 5;
      if (!c.collected) {
        const box = horseBox();
        const dx = c.x - (box.left + box.right) / 2;
        const dy = c.y - (box.top + box.bottom) / 2;
        if (Math.hypot(dx, dy) < c.r + horseW * 0.28) {
          c.collected = true;
          earned += c.value;
          try { Strubles.add(c.value); } catch {}
          $('stat-earned').textContent = earned.toLocaleString();
        }
      }
      if (c.x < -30) coins.splice(i, 1);
    }

    // Orb-burst particles
    for (let i = particles.length - 1; i >= 0; i--) {
      const pt = particles[i];
      pt.age += dt;
      pt.x += (pt.vx - speed) * dt;
      pt.y += pt.vy * dt;
      pt.vx *= 0.94; pt.vy *= 0.94;
      if (pt.age >= pt.life) particles.splice(i, 1);
    }

    // Spawn
    spawnTimer -= dt;
    if (spawnTimer <= 0) {
      buildEncounter(W + 20, speed);
      const base = Math.max(0.6, 1.45 - speed / 750);
      spawnTimer = base + Math.random() * 0.5;
    }

    for (let i = bursts.length - 1; i >= 0; i--) {
      bursts[i].age += dt;
      if (bursts[i].age >= bursts[i].life) bursts.splice(i, 1);
    }
    if (shake > 0) shake = Math.max(0, shake - dt);
  }

  function drawGround() {
    const h = GROUND_H;
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, groundY, W, h);
    ctx.clip();
    if (grassImg.complete && grassImg.naturalWidth) {
      const tileW = h / GRASS_ASPECT;
      let x = -groundScroll;
      while (x < W) {
        ctx.drawImage(grassImg, x, groundY, tileW, h);
        x += tileW;
      }
    } else {
      ctx.fillStyle = '#2f6d2f';
      ctx.fillRect(0, groundY, W, h);
    }
    ctx.restore();

    // Punch REAL gaps: clear the ground pixels entirely so the stage's
    // own background shows through underneath, same as the empty sky
    // above the ground strip -- reads as the grass actually being cut
    // into two separated pieces, not a solid block painted over it.
    for (const g of gaps) {
      ctx.clearRect(g.x, groundY - 2, g.w, h + 2);
      const edgeL = ctx.createLinearGradient(g.x, 0, g.x + 6, 0);
      edgeL.addColorStop(0, 'rgba(0,0,0,.5)'); edgeL.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = edgeL;
      ctx.fillRect(g.x, groundY, 6, h);
      const edgeR = ctx.createLinearGradient(g.x + g.w - 6, 0, g.x + g.w, 0);
      edgeR.addColorStop(0, 'rgba(0,0,0,0)'); edgeR.addColorStop(1, 'rgba(0,0,0,.5)');
      ctx.fillStyle = edgeR;
      ctx.fillRect(g.x + g.w - 6, groundY, 6, h);
    }
  }

  function drawHurdle(h) {
    const baseY = groundY;
    const topY = baseY - h.h;
    ctx.fillStyle = '#6b4423';
    ctx.strokeStyle = '#3e2812';
    ctx.lineWidth = 1;
    const postW = 4;
    ctx.fillRect(h.x, topY, postW, h.h);
    ctx.strokeRect(h.x, topY, postW, h.h);
    ctx.fillRect(h.x + h.w - postW, topY, postW, h.h);
    ctx.strokeRect(h.x + h.w - postW, topY, postW, h.h);
    const rails = h.h > 45 ? [topY + 3, topY + h.h * 0.42, topY + h.h * 0.74] : [topY + 3, topY + h.h * 0.55];
    for (const ry of rails) {
      const grad = ctx.createLinearGradient(h.x, 0, h.x + h.w, 0);
      grad.addColorStop(0, '#ffffff'); grad.addColorStop(0.5, '#d0342c'); grad.addColorStop(1, '#ffffff');
      ctx.fillStyle = grad;
      ctx.fillRect(h.x - 2, ry, h.w + 4, 6);
      ctx.strokeStyle = 'rgba(0,0,0,.35)';
      ctx.strokeRect(h.x - 2, ry, h.w + 4, 6);
    }
  }

  function drawHorse() {
    const ducking = horse.ducking && horse.y <= 0.5 && !horse.falling;
    const w = ducking ? horseW * 1.3 : horseW;
    const h = ducking ? w * DUCK_ASPECT : horseH;
    const x = ducking ? HORSE_X - (w - horseW) * 0.35 : HORSE_X;
    const y = groundY - h - horse.y;
    // Gallop bob only while grounded and actually running -- airborne
    // motion already reads from the jump arc itself.
    const bob = (state === 'playing' && horse.y <= 0.5 && !horse.falling)
      ? Math.sin(performance.now() / 90) * 3
      : 0;
    ctx.save();
    if (horse.falling) {
      // Tumble into the hole as it sinks -- the fall animation the ground
      // clamp used to skip straight past with an instant death.
      const cx = x + w / 2, cy = y + h / 2;
      const fallT = Math.min(1, -horse.y / (H * 0.55));
      ctx.translate(cx, cy);
      ctx.rotate(fallT * Math.PI * 1.6);
      ctx.translate(-cx, -cy);
      ctx.globalAlpha = 1 - fallT * 0.3;
    }
    ctx.shadowColor = 'rgba(0,0,0,.35)';
    ctx.shadowBlur = 6;
    ctx.shadowOffsetY = 4;
    const img = ducking ? horseDuckImg : horseImg;
    if (img.complete && img.naturalWidth) {
      ctx.drawImage(img, x, y + bob, w, h);
    } else {
      ctx.fillStyle = '#5b3a24';
      ctx.fillRect(x, y + bob, w, h);
    }
    ctx.restore();
  }

  function drawCoin(c) {
    if (c.collected) return;
    const bobY = c.y + Math.sin(c.bob) * 3;
    const scaleX = Math.abs(Math.cos(c.bob * 0.5)) * 0.6 + 0.4; // lazy spin, coin-flip style
    const size = c.r * 2.6;
    ctx.save();
    ctx.translate(c.x, bobY);
    ctx.scale(scaleX, 1);
    ctx.shadowColor = 'rgba(255,215,0,.65)';
    ctx.shadowBlur = 8;
    if (strubleImg.complete && strubleImg.naturalWidth) {
      ctx.drawImage(strubleImg, -size / 2, -size / 2, size, size);
    } else {
      ctx.beginPath();
      ctx.arc(0, 0, c.r, 0, Math.PI * 2);
      ctx.fillStyle = '#ffd700';
      ctx.fill();
    }
    ctx.restore();
  }

  function drawPlane(p) {
    const bobY = p.y + Math.sin(p.bob) * 2;
    ctx.save();
    if (planeImg.complete && planeImg.naturalWidth) {
      ctx.drawImage(planeImg, p.x, bobY - p.h / 2, p.w, p.h);
    } else {
      ctx.fillStyle = '#c9c9c9';
      ctx.fillRect(p.x, bobY - p.h / 2, p.w, p.h);
    }
    ctx.restore();
  }

  function drawOrb(o) {
    if (o.used) return;
    const pulse = 0.7 + Math.sin(o.phase) * 0.3;
    ctx.save();
    ctx.translate(o.x, o.y);
    const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, ORB_R * 2.2);
    grad.addColorStop(0, `rgba(255,230,80,${(0.55 * pulse).toFixed(2)})`);
    grad.addColorStop(1, 'rgba(255,230,80,0)');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(0, 0, ORB_R * 2.2, 0, Math.PI * 2);
    ctx.fill();
    ctx.beginPath();
    ctx.arc(0, 0, ORB_R * pulse, 0, Math.PI * 2);
    ctx.fillStyle = '#fff2a8';
    ctx.fill();
    ctx.lineWidth = 3;
    ctx.strokeStyle = '#ffcf1f';
    ctx.stroke();
    ctx.restore();
  }

  function drawParticles() {
    for (const pt of particles) {
      const t = 1 - pt.age / pt.life;
      ctx.fillStyle = `rgba(255,224,90,${t.toFixed(2)})`;
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, 2.5 * t + 1, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  function drawDust() {
    for (const d of dust) {
      const t = 1 - d.age / d.life;
      ctx.fillStyle = `rgba(196,168,120,${(t * 0.55).toFixed(2)})`;
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.r * (1.4 - t * 0.6), 0, Math.PI * 2);
      ctx.fill();
    }
  }

  function drawSpeedLines() {
    // Kicks in as the run approaches max speed -- a purely visual cue
    // that things are getting hairier, echoing the real game's inverted
    // day/night escalation without needing to invert this page's photo
    // background.
    const t = Math.max(0, (speed - MAX_SPEED * 0.72) / (MAX_SPEED * 0.28));
    if (t <= 0) return;
    ctx.save();
    ctx.globalAlpha = t * 0.35;
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 1;
    const n = 5;
    for (let i = 0; i < n; i++) {
      const ly = (H / (n + 1)) * (i + 1) + Math.sin(performance.now() / 200 + i) * 6;
      const lw = 30 + t * 60;
      const lx = (W - ((performance.now() / 4 + i * 137) % (W + lw)));
      ctx.beginPath();
      ctx.moveTo(lx, ly);
      ctx.lineTo(lx + lw, ly);
      ctx.stroke();
    }
    ctx.restore();
  }

  function drawBursts() {
    for (const b of bursts) {
      const t = b.age / b.life;
      ctx.save();
      ctx.globalAlpha = 1 - t;
      ctx.fillStyle = '#ffd700';
      ctx.font = '700 13px "Press Start 2P", monospace';
      ctx.textAlign = 'center';
      ctx.shadowColor = '#000';
      ctx.shadowBlur = 3;
      ctx.fillText(b.text, b.x, b.y - t * 24);
      ctx.restore();
    }
  }

  function render() {
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    if (shake > 0) {
      const s = shake * 10;
      ctx.translate((Math.random() - 0.5) * s, (Math.random() - 0.5) * s);
    }
    drawSpeedLines();
    drawDust();
    for (const c of coins) drawCoin(c);
    for (const h of hurdles) drawHurdle(h);
    for (const p of planes) drawPlane(p);
    for (const o of orbs) drawOrb(o);
    drawHorse();
    drawGround();
    drawParticles();
    drawBursts();
    ctx.restore();
  }

  // One perpetual loop, started exactly once below and never again --
  // physics only advance while playing, but a frame is always drawn, so
  // the canvas never goes blank/stale behind the start or game-over
  // overlay and there is no second "idle loop" that could ever race this
  // one the way the old dual-listener setup did.
  function frame(t) {
    let dt = (t - lastT) / 1000;
    lastT = t;
    dt = Math.min(dt, 0.05);
    if (state === 'playing') update(dt);
    render();
    requestAnimationFrame(frame);
  }

  // ---------- Input: every path funnels into the same handful of functions ----------
  window.addEventListener('keydown', (e) => {
    if (e.key === ' ' || e.key === 'ArrowUp' || e.code === 'Space') {
      e.preventDefault();
      if (!e.repeat) jump();
    } else if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') {
      e.preventDefault();
      startDuck();
    }
  });
  window.addEventListener('keyup', (e) => {
    if (e.key === ' ' || e.key === 'ArrowUp' || e.code === 'Space') releaseJump();
    else if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') endDuck();
  });
  stage.addEventListener('pointerdown', () => jump());
  stage.addEventListener('pointerup', () => releaseJump());
  stage.addEventListener('pointerleave', () => releaseJump());
  const duckBtn = $('duck-btn');
  duckBtn.addEventListener('pointerdown', (e) => { e.preventDefault(); startDuck(); });
  duckBtn.addEventListener('pointerup', endDuck);
  duckBtn.addEventListener('pointerleave', endDuck);
  $('start-btn').addEventListener('click', () => tryPlayTheme());
  $('restart-btn').addEventListener('click', () => tryPlayTheme());

  lastT = performance.now();
  requestAnimationFrame(frame);

  // Read-only introspection for QA -- same idea as window.Strubles, just
  // for this page's own run state. Nothing here can mutate gameplay.
  window.HorseGame = {
    getState: () => ({
      state, speed, cleared, earned, best, deathReason,
      horse: { y: horse.y, vy: horse.vy, ducking: horse.ducking, falling: horse.falling },
      hurdles: hurdles.map((h) => ({ id: h.id, x: h.x, w: h.w, h: h.h, cleared: h.cleared })),
      gaps: gaps.map((g) => ({ x: g.x, w: g.w })),
      coins: coins.map((c) => ({ x: c.x, y: c.y, value: c.value, collected: c.collected })),
      planes: planes.map((p) => ({ x: p.x, y: p.y })),
      orbs: orbs.map((o) => ({ x: o.x, y: o.y, used: o.used })),
      horseX: HORSE_X, horseW,
    }),
  };
})();
</script>
</body>
</html>
