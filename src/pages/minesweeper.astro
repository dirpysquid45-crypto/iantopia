<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Iantopia Minesweeper</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0a0c12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script is:inline src="/pwa.js?v=1" defer></script>
<link rel="preload" as="image" href="/strubles.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<!--
  is:global is REQUIRED. Astro scopes <style> by stamping data-astro-cid-* on
  elements in the template and rewriting selectors to match. The whole board
  is built at runtime via createElement, so it never receives that attribute
  and every scoped rule silently skips it. Same trap as blackjack/lootbox.
-->
<style is:global>
  :root { --bg:#0f1115; --panel:#161c27; --ink:#e9eef9; --muted:#9fb0cf; --gold:#ffd700; --cell: 28px; }
  * { box-sizing:border-box; }
  body {
    margin:0;
    /* background-image (longhand, not the `background` shorthand) — the bg
       picker only ever touches this one property via JS, so background-size/
       position/attachment/repeat declared below stay in effect no matter
       what image gets swapped in. Without this split, the shorthand reset
       those to their defaults, and a picked GIF tiled at natural size
       instead of covering the viewport as one image. */
    background-image: radial-gradient(circle at 50% 0%, #1a1f2e 0%, #0a0c12 60%, #000 100%);
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-repeat: no-repeat;
    color:var(--ink);
    font-family: 'Press Start 2P', ui-monospace, 'Courier New', monospace;
    min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px;
    cursor:none;
    position:relative;
  }
  body::before {
    content:''; position:fixed; inset:0;
    background-image:
      repeating-linear-gradient(90deg, transparent, transparent 24px, rgba(255,215,0,0.03) 24px, rgba(255,215,0,0.03) 25px),
      repeating-linear-gradient(0deg, transparent, transparent 24px, rgba(255,215,0,0.03) 24px, rgba(255,215,0,0.03) 25px);
    pointer-events:none; z-index:0;
  }
  main { position:relative; z-index:1; }
  .table {
    width:min(900px, 96vw);
    background: linear-gradient(135deg, #161c27 0%, #0d1017 100%);
    border:4px solid var(--gold);
    padding:20px;
    box-shadow:0 20px 50px rgba(0,0,0,.6), 0 0 20px rgba(255,215,0,.3), 0 0 60px rgba(255,215,0,.12);
  }
  header { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; border-bottom:4px solid #000; padding-bottom:10px; }
  header a { color:var(--gold); text-decoration:none; border:3px solid #000; padding:8px 12px; font-weight:700; background:#000; transition:background 0.2s; font-size:10px; cursor:none; }
  header a:hover { background:var(--gold); color:#000; }
  header button { color:var(--gold); background:#000; border:2px solid var(--gold); padding:4px 6px; cursor:none; transition:background 0.2s; }
  header button:hover { background:var(--gold); color:#000; }

  /* Full-page mine-hit effect. Sits above everything (including the picker
     overlays at z-index:100) since it's a momentary reaction to losing, not
     part of the normal UI. Opacity-only fade so the GIF's own frames keep
     playing underneath rather than being clipped/restarted by display:none. */
  #explosion-overlay {
    position:fixed; inset:0; z-index:200; pointer-events:none;
    background-image:url('/Explosion.gif');
    background-size:cover; background-position:center; background-repeat:no-repeat;
    opacity:0; transition:opacity .15s ease;
  }
  #explosion-overlay.show { opacity:1; }

  /* pickers.js only toggles this class on the <video id="bg-video"> element
     (which starts display:none inline) — without this rule the class gets
     added correctly but nothing actually makes the video visible, so a
     video-type background silently never shows. */
  #bg-video { display: none; }
  #bg-video.show { display: block; }

  /* Now Playing / Backgrounds / Cursors popups — same system as every other page. */
  .overlay{
    position:fixed; inset:0; background:rgba(0,0,0,.85); z-index:100;
    display:none; align-items:center; justify-content:center; padding:20px;
  }
  .overlay.open{ display:flex; }
  .modal{
    width:min(360px,90vw); max-height:70vh; overflow-y:auto;
    background:#0a0a0a; border:3px solid var(--gold); padding:20px;
    box-shadow:0 0 20px rgba(255,215,0,.4);
  }
  .modal-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; gap:10px; }
  .modal-head h2{ margin:0; font-size:12px; color:var(--gold); font-weight:400; }
  .btn{
    color:var(--gold); text-decoration:none; border:3px solid var(--gold); padding:8px 12px;
    background:#000; font-size:9px; transition:background .2s, color .2s; cursor:none;
    font-family:inherit; letter-spacing:1px; text-transform:uppercase;
  }
  .btn:hover{ background:var(--gold); color:#000; }
  .picker-row { display:flex; align-items:center; padding:6px 0; border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:11px; }
  .picker-row:last-child { border-bottom:none; }

  .volume-row{
    display:flex; align-items:center; gap:10px; margin-bottom:16px;
    padding-bottom:14px; border-bottom:1px solid rgba(255,215,0,0.3);
  }
  .volume-row input[type="range"]{ flex:1; accent-color:var(--gold); cursor:none; touch-action:none; padding:14px 0; }
  .volume-mute-btn{
    all:unset; cursor:none; font-size:16px; padding:4px 8px;
    border:1px solid var(--gold); background:#000;
  }

  h1 {
    margin:0; font-size:clamp(13px,2.6vw,20px); letter-spacing:1px; color:var(--gold); font-weight:400;
    text-shadow: 2px 2px 0 #000;
    text-align:center;
  }

  #strubles-badge{
    position:fixed; top:calc(15px + env(safe-area-inset-top)); left:calc(20px + env(safe-area-inset-left)); display:flex; align-items:center; gap:8px;
    background:#000; padding:8px 12px; border:3px solid var(--gold);
    font-weight:700; z-index:20;
  }
  #strubles-badge img{ width:28px; height:28px; }

  /* ---------- Controls ---------- */
  .controls-row { display:flex; gap:10px; flex-wrap:wrap; align-items:center; justify-content:center; margin-top:14px; }
  /* flex-wrap was missing here specifically — .controls-row (the parent)
     already wraps, but that only lets .diff-group itself drop to a new
     line, not the 4 buttons inside it, so on narrow screens they still
     overflowed off both edges instead of wrapping to a second row. */
  .diff-group { display:flex; gap:6px; flex-wrap:wrap; justify-content:center; }
  .diff-btn {
    all:unset; cursor:none; padding:8px 12px; border:3px solid #333; background:#1a1f2e;
    color:var(--muted); font-size:9px; font-family:inherit; letter-spacing:1px; text-transform:uppercase;
  }
  .diff-btn.active { border-color:var(--gold); color:var(--gold); background:#2a2410; }
  .diff-btn:hover { border-color:var(--gold); }

  .betbox{ display:flex; align-items:center; gap:8px; }
  .betbox input{ width:70px; padding:8px 10px; border:3px solid #000; background:#0f1523; color:var(--ink); font-weight:700; font-family:inherit; font-size:11px; }
  .betbox button { padding:8px 14px; min-width:44px; min-height:44px; }

  button {
    all:unset; cursor:none; padding:12px 20px; border:3px solid #333;
    background:#4a6fa5; color:#fff; font-weight:400; font-size:11px;
    font-family:'Press Start 2P', ui-monospace, monospace;
    transition: background .15s, transform .1s;
  }
  button:hover:not(:disabled) { background:#6a8fc5; }
  button:active:not(:disabled) { transform: translateY(2px); }
  button.primary { background:#2c5f8a; --glow-color:#3d9bff; animation: neonBtnPulse 2s ease-in-out infinite; }
  button.primary:hover:not(:disabled) { background:#3d7cae; }
  button.accent { background:#22757a; --glow-color:#22d3ee; }
  button.accent.active { background:#7a5a22; --glow-color:#ffd700; animation: neonBtnPulse 2s ease-in-out infinite; }
  button.accent:hover:not(:disabled) { background:#2f9aa1; }
  @keyframes neonBtnPulse {
    0%, 100% { box-shadow: 0 0 4px var(--glow-color), 0 0 10px var(--glow-color); text-shadow: 0 0 4px var(--glow-color); }
    50% { box-shadow: 0 0 10px var(--glow-color), 0 0 24px var(--glow-color), 0 0 38px var(--glow-color); text-shadow: 0 0 8px var(--glow-color); }
  }
  button:disabled { opacity:.5; cursor:not-allowed; }

  .status-row { display:flex; justify-content:center; gap:24px; margin-top:14px; font-size:11px; color:var(--gold); }

  /* ---------- Board ---------- */
  .board-wrap { display:flex; justify-content:center; margin-top:16px; overflow-x:auto; padding-bottom:6px; }
  .board {
    display:grid;
    gap:2px;
    background:#000;
    border:4px solid #333;
    padding:4px;
    width:max-content;
  }
  /* Dense boards (Hormuz's 40-wide grid) can't fit on a phone screen even
     at the smallest legible cell size once every cell's gap+border is
     counted — those add up independently of cell size, so wide/tall modes
     shed them here instead of shrinking cells past readability. */
  .board.dense { gap:0; border-width:2px; padding:2px; }
  .board.dense .cell { border-width:1px; }
  .cell {
    all:unset;
    /* all:unset resets box-sizing to its initial value (content-box),
       overriding the global border-box reset — without restating it here,
       each cell's 2px border renders on top of width/height instead of
       inside it, so the fit-to-viewport math below silently undercounts
       every cell's true footprint. */
    box-sizing:border-box;
    width:var(--cell); height:var(--cell);
    display:flex; align-items:center; justify-content:center;
    background:#3a4356;
    border:2px solid;
    border-color:#5a6578 #23283a #23283a #5a6578;
    font-size:calc(var(--cell) * 0.5);
    font-family:ui-monospace, 'Courier New', monospace;
    font-weight:700;
    cursor:none;
    user-select:none;
    -webkit-user-select:none;
    touch-action:manipulation;
  }
  .cell:hover:not(.revealed) { background:#454f66; }
  .cell.revealed { background:#181c26; border:1px solid #23283a; cursor:default; }
  .cell.mine { background:#7a2222; }
  .cell.mine.exploded { background:#ff3333; }
  .cell.flagged { background:#3a4356; }
  /* Water cells in Hormuz mode aren't part of the sweep at all — fully
     transparent and inert so the satellite photo shows straight through,
     which is what actually reads as a coastline rather than a rectangle. */
  .cell.water { background:transparent; border:none; pointer-events:none; }
  .board.hormuz { background-size:100% 100%; background-repeat:no-repeat; }
  .cell[data-n="1"] { color:#4fa8ff; }
  .cell[data-n="2"] { color:#4caf50; }
  .cell[data-n="3"] { color:#ff5252; }
  .cell[data-n="4"] { color:#ab47bc; }
  .cell[data-n="5"] { color:#a1887f; }
  .cell[data-n="6"] { color:#26c6da; }
  .cell[data-n="7"] { color:#eee; }
  .cell[data-n="8"] { color:#9e9e9e; }

  .status { margin-top:14px; text-align:center; font-weight:400; font-size:11px; color:#fff; min-height:16px; }
  .status.win { color:#4caf50; }
  .status.lose { color:#ff5252; }

  #earn-panel {
    display: flex; gap: 15px; margin-top: 24px; flex-wrap: wrap; justify-content: center;
    padding: 16px; background: rgba(255, 215, 0, 0.06); border: 3px solid var(--gold);
  }
  #earn-panel a {
    padding: 12px 18px; font-size: 10px;
    background: var(--gold); border: 3px solid #8b7a1a;
    color: #000; text-decoration: none; font-weight: 400; text-transform: uppercase; letter-spacing: 1px;
    font-family:'Press Start 2P', ui-monospace, monospace; cursor:none;
  }
  #earn-panel a:hover { background:#ffe958; }

  @media (max-width:768px){
    body { overflow-y:auto; padding:12px; }
    .table { width:100vw; max-width:100%; padding:10px; margin:0 -12px; }
    h1 { font-size:clamp(11px,3vw,14px); }
    header { flex-direction:column; gap:6px; }
    :root { --cell: 22px; }
    .controls-row { gap:6px; }
    .diff-btn { font-size:8px; padding:6px 8px; }
    .betbox input { width:50px; font-size:9px; }
    button { font-size:9px; padding:8px 12px; }
    #strubles-badge { top: calc(8px + env(safe-area-inset-top)); left: calc(8px + env(safe-area-inset-left)); padding: 6px 8px; }
    #strubles-badge img { width: 22px; height: 22px; }
  }
</style>
</head>
<body>
  <div id="strubles-badge">
    <img src="/strubles.png" alt="Struble">
    <span id="bal">0</span>
  </div>

  <main class="table">
    <header>
      <a href="/" title="Back to Iantopia">← Home</a>
      <h1>MINESWEEPER AT IANTOPIA</h1>
      <div style="display:flex; gap:4px;">
        <a href="/inventory" title="Inventory" style="color:var(--gold); background:#000; border:2px solid var(--gold); padding:4px 6px; text-decoration:none; display:inline-flex; align-items:center;">🎒</a>
        <button id="now-playing" title="Music options">🎵</button>
        <button id="bg-btn" title="Change background">🖼️</button>
        <button id="cursor-btn" title="Change cursor">🖱️</button>
      </div>
    </header>

    <div class="controls-row">
      <div class="diff-group" id="diff-group">
        <button class="diff-btn active" data-diff="beginner">Beginner</button>
        <button class="diff-btn" data-diff="intermediate">Intermediate</button>
        <button class="diff-btn" data-diff="expert">Expert</button>
        <button class="diff-btn" data-diff="hormuz">🌊 Strait of Hormuz</button>
      </div>
    </div>

    <div class="controls-row">
      <div class="betbox">
        <span style="font-size:9px; color:var(--gold);">Bet</span>
        <button id="bet-minus">−</button>
        <input id="bet" type="number" min="1" step="1" value="10" />
        <button id="bet-plus">+</button>
      </div>
      <button id="btn-new" class="primary">New Game</button>
      <button id="btn-flag-mode" class="accent">🚩 Flag Mode</button>
    </div>

    <div class="status-row">
      <span>💣 <span id="mine-count">10</span></span>
      <span>⏱️ <span id="timer">0</span>s</span>
      <span>Payout: <span id="payout-mult">1.5x</span></span>
    </div>

    <div class="board-wrap">
      <div class="board" id="board"></div>
    </div>

    <div class="status" id="status">Set a bet and press New Game. Right-click (or Flag Mode) to flag a cell.</div>

    <div id="earn-panel">
      <a href="/lootbox">🎁 루트박스 🫧 𓇼𓏲*ੈ✩‧₊˚🎐</a>
    </div>
  </main>

  <!-- Music Playlist Modal -->
  <div class="overlay" id="playlist-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Now Playing</h2>
        <button class="btn" id="playlist-close" type="button">Close</button>
      </div>
      <div class="volume-row">
        <button class="volume-mute-btn" id="mute-btn" aria-label="Toggle sound" title="Toggle sound">🔊</button>
        <input type="range" id="volume-slider" min="0" max="100" value="30" aria-label="Music volume" />
      </div>
      <div id="playlist-list"></div>
    </div>
  </div>

  <!-- Background Picker Modal -->
  <div class="overlay" id="bg-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Backgrounds</h2>
        <button class="btn" id="bg-close" type="button">Close</button>
      </div>
      <div id="bg-list"></div>
    </div>
  </div>

  <!-- Cursor Picker Modal -->
  <div class="overlay" id="cursor-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Cursors</h2>
        <button class="btn" id="cursor-close" type="button">Close</button>
      </div>
      <div id="cursor-list"></div>
    </div>
  </div>

  <!-- Drone footage is minesweeper's true default background (a video, not a
       static image), so it ships already sourced + shown + autoplaying
       rather than waiting for a picker selection. -->
  <video id="bg-video" class="show" src="/video/minesweeper-drone-footage.mp4" autoplay muted loop playsinline style="position:fixed; top:0; left:0; width:100%; height:100%; object-fit:cover; z-index:-1;"></video>
  <div id="explosion-overlay"></div>

  <audio id="theme-music" src="/audio/music/minesweeper-desert.mp3" preload="none" loop></audio>

<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<!-- Headless here (no account UI on this page) — see blackjack.astro for
     why every page needs this now, not just home. -->
<script is:inline src="/cloud-sync.js?v=6"></script>
<script is:inline src="/music-library.js?v=8"></script>
<script is:inline src="/music-position.js?v=1"></script>
<script is:inline src="/background-library.js?v=7"></script>
<script is:inline src="/cursor-library.js?v=2"></script>
<script is:inline src="/case-data.js?v=9"></script>
<script is:inline src="/cursor.js?v=3"></script>
<script is:inline src="/strubles.js?v=2"></script>
<script is:inline>
  window.PAGE_DEFAULT_BG = { type: 'video', src: '/video/minesweeper-drone-footage.mp4', label: 'Drone Footage' };
  // Desert plays for free on minesweeper specifically (its hardcoded resting
  // default below) without needing to be unlocked from a case — but it's
  // still a real, separately case-unlockable track for every OTHER page.
  window.PAGE_FREE_TRACK_KEY = 'mario_desert';
</script>
<script is:inline src="/pickers.js?v=9"></script>

<script is:inline>
(() => {
  const $ = id => document.getElementById(id);
  const balNumEl = $('bal');
  const boardEl = $('board');
  const statusEl = $('status');
  const mineCountEl = $('mine-count');
  const timerEl = $('timer');
  const payoutMultEl = $('payout-mult');
  const betInput = $('bet');
  const newGameBtn = $('btn-new');
  const flagModeBtn = $('btn-flag-mode');

  // Classic standard Minesweeper board sizes, plus a payout multiplier
  // scaled to risk (win chance drops sharply as mine density climbs).
  // hormuz has no fixed mine count — it's computed from however many land
  // cells the sampled coastline actually has (see sampleHormuzMask).
  const DIFFICULTIES = {
    beginner:     { rows: 9,  cols: 9,  mines: 10, mult: 1.5 },
    intermediate: { rows: 16, cols: 16, mines: 40, mult: 3 },
    expert:       { rows: 16, cols: 30, mines: 99, mult: 6 },
    // Sweeping the water instead of the coastline covers a somewhat larger
    // area (~55% of the grid vs. ~44% for land), so the payout comes down
    // a little to match — same per-cell mine odds, just more cells to clear.
    hormuz:       { rows: 30, cols: 40, mineDensity: 0.18, mult: 4.5 },
  };
  let diffKey = 'beginner';

  let board = [];       // board[r][c] = { mine, revealed, flagged, adjacent, land }
  let rows = 0, cols = 0, mineTotal = 0, landTotal = 0;
  let firstClickDone = false;
  let gameActive = false;
  let flagMode = false;
  let currentBet = 0;
  let flagCount = 0;
  let revealedSafeCount = 0;
  let timerInterval = null;
  let elapsed = 0;

  function syncBalance() { try { balNumEl.textContent = Strubles.get(); } catch {} }
  syncBalance();
  window.addEventListener('strubles:change', syncBalance);
  window.addEventListener('storage', syncBalance);

  // --- Sound effects (additive; does not affect game state) ---
  const SFX_BASE = '/audio/sfx/';
  let audioEnabled = true;
  const sfxCache = {};
  function playSfx(name) {
    if (!audioEnabled) return;
    let audio = sfxCache[name];
    if (!audio) {
      audio = new Audio(`${SFX_BASE}${name}.mp3`);
      audio.volume = 0.5;
      sfxCache[name] = audio;
    }
    audio.currentTime = 0;
    audio.play().catch(() => {});
  }
  // Victory-1 plays first; victory-2 only starts once victory-1 actually
  // finishes, never layered on top of it (explicit user correction — these
  // are sequential, not simultaneous).
  function playVictorySequence() {
    if (!audioEnabled) return;
    const first = new Audio(`${SFX_BASE}minesweeper-victory-1.mp3`);
    first.volume = 0.5;
    first.addEventListener('ended', () => {
      if (!audioEnabled) return;
      const second = new Audio(`${SFX_BASE}minesweeper-victory-2.mp3`);
      second.volume = 0.5;
      second.play().catch(() => {});
    });
    first.play().catch(() => {});
  }

  // --- Theme music (background loop, tied to the same mute control) ---
  const themeMusic = $('theme-music');
  const VOLUME_KEY = 'music_volume_v1';
  const volumeSlider = $('volume-slider');
  const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
  themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.3;
  volumeSlider.value = Math.round(themeMusic.volume * 100);
  volumeSlider.addEventListener('input', () => {
    themeMusic.volume = volumeSlider.value / 100;
    localStorage.setItem(VOLUME_KEY, themeMusic.volume);
  });
  window.addEventListener('storage', (e) => {
    if (e.key === VOLUME_KEY && e.newValue != null) {
      themeMusic.volume = parseFloat(e.newValue);
      volumeSlider.value = Math.round(themeMusic.volume * 100);
    }
  });
  const MUSIC_POS_KEY = 'minesweeper_theme_pos_v1';
  if (window.MusicPosition) {
    window.MusicPosition.restore(MUSIC_POS_KEY, themeMusic);
    window.MusicPosition.track(MUSIC_POS_KEY, themeMusic);
  }
  function tryPlayTheme() {
    if (!audioEnabled) return;
    themeMusic.play().catch(() => {});
  }
  tryPlayTheme();
  const unlockTheme = () => {
    tryPlayTheme();
    window.removeEventListener('pointerdown', unlockTheme);
    window.removeEventListener('keydown', unlockTheme);
  };
  window.addEventListener('pointerdown', unlockTheme);
  window.addEventListener('keydown', unlockTheme);

  const muteBtn = $('mute-btn');
  muteBtn.addEventListener('click', () => {
    audioEnabled = !audioEnabled;
    muteBtn.textContent = audioEnabled ? '🔊' : '🔇';
    if (audioEnabled) tryPlayTheme();
    else themeMusic.pause();
  });

  function setStatus(msg, cls) {
    statusEl.textContent = msg;
    statusEl.className = 'status' + (cls ? ' ' + cls : '');
  }

  function startTimer(resumeElapsed) {
    stopTimer();
    elapsed = resumeElapsed || 0;
    timerEl.textContent = String(elapsed);
    timerInterval = setInterval(() => {
      elapsed++;
      timerEl.textContent = String(elapsed);
      saveGameState();
    }, 1000);
  }
  function stopTimer() {
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = null;
  }

  function inBounds(r, c) { return r >= 0 && r < rows && c >= 0 && c < cols; }
  function neighbors(r, c) {
    const out = [];
    for (let dr = -1; dr <= 1; dr++) {
      for (let dc = -1; dc <= 1; dc++) {
        if (dr === 0 && dc === 0) continue;
        if (inBounds(r + dr, c + dc)) out.push([r + dr, c + dc]);
      }
    }
    return out;
  }

  // landMask[r][c] === true marks a cell as part of the sweep — the water
  // in Hormuz mode, coastline excluded (no mine, never revealed/flagged,
  // rendered via the .water CSS class despite being real land). Every
  // other mode passes no mask, so every cell defaults to swept.
  function buildEmptyBoard(landMask) {
    board = [];
    landTotal = 0;
    for (let r = 0; r < rows; r++) {
      const row = [];
      for (let c = 0; c < cols; c++) {
        const land = landMask ? landMask[r][c] : true;
        if (land) landTotal++;
        row.push({ mine: false, revealed: false, flagged: false, adjacent: 0, land });
      }
      board.push(row);
    }
  }

  // Mines are placed only after the first click, excluding that cell and
  // its neighbors, so the opening move is never an instant loss and
  // usually opens up a real cascade instead of a single bare number.
  // Non-swept cells (land: false — the coastline in Hormuz mode) are
  // never eligible.
  function placeMines(safeR, safeC) {
    // Reset first — placeMinesNoGuess() below calls this repeatedly on the
    // same board object while it searches for a solvable layout, and a
    // stale mine/adjacent from a rejected attempt would otherwise leak into
    // the next one.
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) { board[r][c].mine = false; board[r][c].adjacent = 0; }
    }
    const forbidden = new Set([`${safeR},${safeC}`]);
    neighbors(safeR, safeC).forEach(([r, c]) => forbidden.add(`${r},${c}`));

    let placed = 0;
    let attempts = 0;
    const maxAttempts = rows * cols * 50; // safety valve against an impossible mine count
    while (placed < mineTotal && attempts < maxAttempts) {
      attempts++;
      const r = Math.floor(Math.random() * rows);
      const c = Math.floor(Math.random() * cols);
      const key = `${r},${c}`;
      if (forbidden.has(key) || board[r][c].mine || !board[r][c].land) continue;
      board[r][c].mine = true;
      placed++;
    }
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        if (board[r][c].mine || !board[r][c].land) continue;
        board[r][c].adjacent = neighbors(r, c).filter(([nr, nc]) => board[nr][nc].mine).length;
      }
    }
  }

  // Simulates a logic-only player against the CURRENT board's real mine
  // layout: starting from the first-click flood, repeatedly applies two
  // levels of deduction until nothing new can be proven —
  //   1. single-point: a number whose remaining unknown neighbors exactly
  //      match its remaining mine count means they're all mines (or all
  //      safe, if it already has enough flagged);
  //   2. subset elimination: for two numbered cells whose unknown-neighbor
  //      sets nest inside one another (A ⊆ B), the cells in B but not A
  //      must account for exactly (B's remaining mines − A's remaining
  //      mines) of them — resolving them if that's 0 or all of them.
  // Single-point alone turned out to be far too weak to ever fully clear a
  // board Hormuz's size (~650+ cells) — it rejected essentially every
  // layout tried, which meant placeMinesNoGuess() below was silently
  // falling back to plain-random every single time. Subset elimination is
  // the standard second-level technique every real "no-guess" generator
  // uses, and is what actually gets boards this large over the line.
  // Returns how much of the board this got through, not just pass/fail, so
  // the caller can pick the LEAST-bad attempt even when none fully clears.
  function attemptSolve(safeR, safeC) {
    const revealed = board.map((row) => row.map(() => false));
    const flagged = board.map((row) => row.map(() => false));
    const totalSafe = landTotal - mineTotal;
    let revealedCount = 0;

    function floodReveal(r, c) {
      const queue = [[r, c]];
      while (queue.length) {
        const [cr, cc] = queue.shift();
        if (revealed[cr][cc] || flagged[cr][cc]) continue;
        revealed[cr][cc] = true;
        revealedCount++;
        if (board[cr][cc].adjacent === 0) {
          neighbors(cr, cc).forEach(([nr, nc]) => {
            if (board[nr][nc].land && !board[nr][nc].mine && !revealed[nr][nc]) queue.push([nr, nc]);
          });
        }
      }
    }
    floodReveal(safeR, safeC);

    const cellKey = (r, c) => r * cols + c;
    const sameCell = ([ar, ac], [br, bc]) => ar === br && ac === bc;

    let progress = true;
    while (progress && revealedCount < totalSafe) {
      progress = false;

      // Pass 1: single-point deduction. Also collects every still-ambiguous
      // constraint (a numbered cell with unknowns left that this pass
      // couldn't resolve) for pass 2 to work with.
      const constraints = [];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (!revealed[r][c] || !board[r][c].land) continue;
          const num = board[r][c].adjacent;
          if (num === 0) continue;
          const landNeighbors = neighbors(r, c).filter(([nr, nc]) => board[nr][nc].land);
          const unknown = landNeighbors.filter(([nr, nc]) => !revealed[nr][nc] && !flagged[nr][nc]);
          if (unknown.length === 0) continue;
          const flaggedCount = landNeighbors.filter(([nr, nc]) => flagged[nr][nc]).length;
          const remaining = num - flaggedCount;
          if (remaining === 0) {
            unknown.forEach(([nr, nc]) => floodReveal(nr, nc));
            progress = true;
          } else if (remaining === unknown.length) {
            unknown.forEach(([nr, nc]) => { flagged[nr][nc] = true; });
            progress = true;
          } else {
            constraints.push({ cells: unknown, mines: remaining });
          }
        }
      }
      if (progress) continue; // fresh single-point info first — cheaper, and can unlock more of the same

      // Pass 2: subset elimination, scoped to constraint pairs that
      // actually share an unknown cell (found via an inverted index)
      // rather than comparing every pair on the board.
      const byCell = new Map();
      constraints.forEach((cons, idx) => {
        cons.cells.forEach(([r, c]) => {
          const k = cellKey(r, c);
          if (!byCell.has(k)) byCell.set(k, []);
          byCell.get(k).push(idx);
        });
      });
      const compared = new Set();
      for (const idxList of byCell.values()) {
        for (const i of idxList) {
          for (const j of idxList) {
            if (i === j) continue;
            const pairKey = i < j ? `${i}-${j}` : `${j}-${i}`;
            if (compared.has(pairKey)) continue;
            compared.add(pairKey);
            const A = constraints[i], B = constraints[j];
            const [small, big] = A.cells.length <= B.cells.length ? [A, B] : [B, A];
            const isSubset = small.cells.every((cell) => big.cells.some((bc) => sameCell(cell, bc)));
            if (!isSubset) continue;
            const diffCells = big.cells.filter((cell) => !small.cells.some((sc) => sameCell(cell, sc)));
            if (!diffCells.length) continue;
            const diffMines = big.mines - small.mines;
            if (diffMines === 0) {
              diffCells.forEach(([dr, dc]) => floodReveal(dr, dc));
              progress = true;
            } else if (diffMines === diffCells.length) {
              diffCells.forEach(([dr, dc]) => { flagged[dr][dc] = true; });
              progress = true;
            }
          }
        }
      }
    }
    return { solved: revealedCount === totalSafe, revealedCount, totalSafe };
  }

  // Regenerates the mine layout (same first click, same board shape),
  // keeping whichever attempt the solver above got furthest through — the
  // first fully-solvable one if any turns up, otherwise the closest miss —
  // within an attempt/time budget. Hormuz's irregular coastline is what
  // actually produces most forced 50/50s (see cleanupMask for the other
  // half of that fix), so this stays scoped to Hormuz rather than changing
  // the classic difficulties' character. "Best of N" rather than "first
  // success or bust" matters at this board size: a full clean solve isn't
  // found on every attempt even with subset elimination, so this way every
  // game is at least as solvable as a single random attempt would be, and
  // usually meaningfully more so — never worse.
  function placeMinesNoGuess(safeR, safeC) {
    const MAX_ATTEMPTS = 40;
    const TIME_BUDGET_MS = 1500;
    const start = performance.now();
    let bestSnapshot = null;
    let bestRevealed = -1;
    for (let attempt = 0; attempt < MAX_ATTEMPTS && performance.now() - start < TIME_BUDGET_MS; attempt++) {
      placeMines(safeR, safeC);
      const result = attemptSolve(safeR, safeC);
      if (result.solved) return; // perfect — leave this layout in place
      if (result.revealedCount > bestRevealed) {
        bestRevealed = result.revealedCount;
        bestSnapshot = board.map((row) => row.map((cell) => ({ mine: cell.mine, adjacent: cell.adjacent })));
      }
    }
    if (bestSnapshot) {
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          board[r][c].mine = bestSnapshot[r][c].mine;
          board[r][c].adjacent = bestSnapshot[r][c].adjacent;
        }
      }
    }
  }

  // Board dimensions swing wildly by mode (9x9 up to 30x40 for Hormuz), so a
  // fixed cell size meant the wider/taller modes overflowed the viewport and
  // needed scrolling to reach every cell — worst on mobile. Instead, size
  // cells to whatever actually fits the space available for the CURRENT
  // mode, recomputed on every render and on resize/orientation change.
  const boardWrap = document.querySelector('.board-wrap');
  // .board adds fixed chrome around the cell grid (gap between cells,
  // padding + border) that doesn't scale with cell size — has to be
  // subtracted before dividing by cols/rows, or the fit undershoots and
  // the board still overflows.
  function fitFor(chrome, gap, minCell) {
    const wrapTop = boardWrap.getBoundingClientRect().top;
    const availableWidth = boardWrap.clientWidth - chrome - (cols - 1) * gap;
    const availableHeight = (window.innerHeight - wrapTop - 16) - chrome - (rows - 1) * gap;
    return Math.max(minCell, Math.min(30, Math.floor(availableWidth / cols), Math.floor(availableHeight / rows)));
  }
  function fitCellSize() {
    if (!boardWrap || !rows || !cols) return;
    // Try the normal (roomier-looking) chrome first; only fall back to the
    // gap-free "dense" chrome — trading visual polish for actually fitting
    // the screen — when normal chrome would push cells below readable size.
    let cell = fitFor(16, 2, 9);
    let dense = cell < 14;
    if (dense) cell = fitFor(8, 0, 6);
    boardEl.classList.toggle('dense', dense);
    document.documentElement.style.setProperty('--cell', cell + 'px');
  }
  let resizeRaf = null;
  window.addEventListener('resize', () => {
    if (resizeRaf) cancelAnimationFrame(resizeRaf);
    resizeRaf = requestAnimationFrame(fitCellSize);
  });

  // Persists the whole in-progress round — including the real mine layout,
  // which is fine since it never leaves this browser's own localStorage —
  // so leaving the page and coming back (even after closing the tab) picks
  // up exactly where you left off instead of losing the board and the bet
  // already spent on it. Cleared the instant a round actually ends (see
  // endGame above) so a finished board is never mistaken for one in progress.
  const SAVE_KEY = 'minesweeper_game_v1';
  function saveGameState() {
    if (!gameActive) return;
    try {
      localStorage.setItem(SAVE_KEY, JSON.stringify({
        diffKey, rows, cols, mineTotal, landTotal, firstClickDone,
        currentBet, flagCount, revealedSafeCount, elapsed, board,
      }));
    } catch {}
  }
  function clearSavedGame() {
    try { localStorage.removeItem(SAVE_KEY); } catch {}
  }
  function tryResumeSavedGame() {
    let saved = null;
    try { saved = JSON.parse(localStorage.getItem(SAVE_KEY) || 'null'); } catch {}
    if (!saved || !Array.isArray(saved.board) || !saved.board.length) return false;

    diffKey = saved.diffKey;
    rows = saved.rows; cols = saved.cols;
    mineTotal = saved.mineTotal; landTotal = saved.landTotal;
    firstClickDone = saved.firstClickDone; currentBet = saved.currentBet;
    flagCount = saved.flagCount; revealedSafeCount = saved.revealedSafeCount;
    board = saved.board;
    gameActive = true;

    document.querySelectorAll('.diff-btn').forEach((b) => b.classList.toggle('active', b.dataset.diff === diffKey));
    const diff = DIFFICULTIES[diffKey];
    payoutMultEl.textContent = diff.mult + 'x';
    mineCountEl.textContent = String(mineTotal - flagCount);
    betInput.value = currentBet;
    renderBoard();
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) updateCellVisual(r, c);
    startTimer(saved.elapsed);
    setStatus(`Resumed your game in progress. Bet ${currentBet} Strubles.`);
    return true;
  }

  function renderBoard() {
    fitCellSize();
    boardEl.style.gridTemplateColumns = `repeat(${cols}, var(--cell))`;
    boardEl.classList.toggle('hormuz', diffKey === 'hormuz');
    boardEl.style.backgroundImage = diffKey === 'hormuz' ? "url('/Hormuz.jpg')" : 'none';
    boardEl.innerHTML = '';
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const btn = document.createElement('button');
        btn.className = 'cell' + (board[r][c].land ? '' : ' water');
        btn.dataset.r = r;
        btn.dataset.c = c;
        boardEl.appendChild(btn);
      }
    }
  }

  function cellEl(r, c) {
    return boardEl.children[r * cols + c];
  }

  function updateCellVisual(r, c) {
    const cell = board[r][c];
    const el = cellEl(r, c);
    el.classList.toggle('flagged', cell.flagged);
    if (!cell.revealed) {
      el.textContent = cell.flagged ? '🚩' : '';
      el.classList.remove('revealed');
      delete el.dataset.n;
      return;
    }
    el.classList.add('revealed');
    el.classList.remove('flagged');
    if (cell.mine) {
      el.classList.add('mine');
      el.textContent = '💣';
    } else if (cell.adjacent > 0) {
      el.textContent = String(cell.adjacent);
      el.dataset.n = String(cell.adjacent);
    } else {
      el.textContent = '';
    }
  }

  // BFS flood-fill: revealing a 0-adjacent cell reveals its whole
  // connected region, matching standard Minesweeper behavior.
  function revealCell(startR, startC) {
    const queue = [[startR, startC]];
    const seen = new Set();
    while (queue.length) {
      const [r, c] = queue.shift();
      const key = `${r},${c}`;
      if (seen.has(key)) continue;
      seen.add(key);
      const cell = board[r][c];
      if (cell.revealed || cell.flagged) continue;
      cell.revealed = true;
      if (!cell.mine) revealedSafeCount++;
      updateCellVisual(r, c);
      if (!cell.mine && cell.adjacent === 0) {
        neighbors(r, c).forEach(([nr, nc]) => {
          if (board[nr][nc].land && !board[nr][nc].revealed && !board[nr][nc].flagged) queue.push([nr, nc]);
        });
      }
    }
  }

  function revealAllMines(explodedR, explodedC) {
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        if (board[r][c].mine) {
          board[r][c].revealed = true;
          updateCellVisual(r, c);
          if (r === explodedR && c === explodedC) cellEl(r, c).classList.add('exploded');
        }
      }
    }
  }

  function endGame(won, explodedR, explodedC) {
    gameActive = false;
    stopTimer();
    clearSavedGame();
    if (!won) revealAllMines(explodedR, explodedC);
    if (won) {
      const payout = Math.round(currentBet * DIFFICULTIES[diffKey].mult);
      Strubles.add(payout);
      setStatus(`✓ Cleared the board! +${payout} Strubles`, 'win');
      playVictorySequence();
    } else {
      setStatus(`💥 Boom. Lost ${currentBet} Strubles.`, 'lose');
      playSfx('minesweeper-mine-hit');
      showExplosion();
    }
  }

  // Explosion.gif is ~1.8s start to finish — held for that long, then
  // faded out. GIFs have no JS-visible "finished playing" event, so the
  // duration below is measured from the source file rather than detected.
  const explosionOverlay = document.getElementById('explosion-overlay');
  let explosionTimer = null;
  function showExplosion() {
    if (!explosionOverlay) return;
    if (explosionTimer) clearTimeout(explosionTimer);
    explosionOverlay.style.backgroundImage = 'none';
    void explosionOverlay.offsetWidth; // force reflow so the GIF below restarts from frame 1
    explosionOverlay.style.backgroundImage = "url('/Explosion.gif')";
    explosionOverlay.classList.add('show');
    explosionTimer = setTimeout(() => explosionOverlay.classList.remove('show'), 1800);
  }

  function onCellClick(r, c) {
    if (!gameActive) return;
    const cell = board[r][c];
    if (cell.revealed || !cell.land) return;

    if (flagMode) {
      cell.flagged = !cell.flagged;
      flagCount += cell.flagged ? 1 : -1;
      mineCountEl.textContent = String(mineTotal - flagCount);
      updateCellVisual(r, c);
      playSfx(cell.flagged ? 'minesweeper-flag' : 'minesweeper-unflag');
      saveGameState();
      return;
    }
    if (cell.flagged) return;

    if (!firstClickDone) {
      firstClickDone = true;
      if (diffKey === 'hormuz') placeMinesNoGuess(r, c);
      else placeMines(r, c);
      startTimer();
    }

    if (cell.mine) {
      cell.revealed = true;
      updateCellVisual(r, c);
      endGame(false, r, c);
      return;
    }

    playSfx('minesweeper-reveal');
    revealCell(r, c);
    if (revealedSafeCount === landTotal - mineTotal) {
      endGame(true);
    } else {
      saveGameState();
    }
  }

  function onCellFlag(e, r, c) {
    e.preventDefault();
    if (!gameActive) return;
    const cell = board[r][c];
    if (cell.revealed || !cell.land) return;
    cell.flagged = !cell.flagged;
    flagCount += cell.flagged ? 1 : -1;
    mineCountEl.textContent = String(mineTotal - flagCount);
    updateCellVisual(r, c);
    playSfx(cell.flagged ? 'minesweeper-flag' : 'minesweeper-unflag');
    saveGameState();
  }

  boardEl.addEventListener('click', (e) => {
    const el = e.target.closest('.cell');
    if (!el) return;
    onCellClick(Number(el.dataset.r), Number(el.dataset.c));
  });
  boardEl.addEventListener('contextmenu', (e) => {
    const el = e.target.closest('.cell');
    if (!el) return;
    onCellFlag(e, Number(el.dataset.r), Number(el.dataset.c));
  });

  flagModeBtn.addEventListener('click', () => {
    flagMode = !flagMode;
    flagModeBtn.classList.toggle('active', flagMode);
  });

  // Samples /Hormuz.jpg down to exactly rows x cols and classifies each
  // cell by comparing red vs. blue channels — water reflects more blue
  // light than sand/desert does, so a plain r > b comparison reproduces
  // the coastline shape with no other processing needed (verified against
  // the actual source image before shipping). The mask this returns feeds
  // straight into `land` throughout the rest of the file, which really
  // just means "part of the sweep" — Hormuz mode sweeps the WATER (mines
  // hide in the strait, not on the coastline), so this inverts the raw
  // red>blue land classification before returning it.
  let hormuzImagePromise = null;
  function loadHormuzImage() {
    if (!hormuzImagePromise) {
      hormuzImagePromise = new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = '/Hormuz.jpg';
      });
    }
    return hormuzImagePromise;
  }
  async function sampleHormuzMask(sampleRows, sampleCols) {
    const img = await loadHormuzImage();
    const canvas = document.createElement('canvas');
    canvas.width = sampleCols;
    canvas.height = sampleRows;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, sampleCols, sampleRows);
    const { data } = ctx.getImageData(0, 0, sampleCols, sampleRows);
    const mask = [];
    for (let r = 0; r < sampleRows; r++) {
      const row = [];
      for (let c = 0; c < sampleCols; c++) {
        const i = (r * sampleCols + c) * 4;
        row.push(data[i] <= data[i + 2]); // blue >= red => water => sweepable
      }
      mask.push(row);
    }
    return mask;
  }

  // Reclassifies small, mostly-enclosed pockets of sweepable water as shore
  // instead. The coastline sampling above sometimes carves off a tiny 2-3
  // cell inlet that's otherwise cut off from the rest of the strait — with
  // no connection for logical information to flow in from, whatever's in
  // there (mine or not) can never be deduced, only guessed. That's the
  // "some branches just end in a 1x2/1x3 you have to guess" pattern.
  // Cells smaller than MIN_POCKET_SIZE get folded into the shore instead of
  // being swept at all, which removes the trap outright rather than trying
  // to work around it during play. This only affects genuinely tiny,
  // disconnected pockets — the main body of the strait is thousands of
  // cells and untouched.
  const MIN_POCKET_SIZE = 6;
  function cleanupMask(mask) {
    const h = mask.length, w = mask[0].length;
    const seen = mask.map((row) => row.map(() => false));
    for (let r = 0; r < h; r++) {
      for (let c = 0; c < w; c++) {
        if (!mask[r][c] || seen[r][c]) continue;
        const stack = [[r, c]];
        const cells = [];
        seen[r][c] = true;
        while (stack.length) {
          const [cr, cc] = stack.pop();
          cells.push([cr, cc]);
          for (let dr = -1; dr <= 1; dr++) {
            for (let dc = -1; dc <= 1; dc++) {
              if (dr === 0 && dc === 0) continue;
              const nr = cr + dr, nc = cc + dc;
              if (nr < 0 || nr >= h || nc < 0 || nc >= w) continue;
              if (!mask[nr][nc] || seen[nr][nc]) continue;
              seen[nr][nc] = true;
              stack.push([nr, nc]);
            }
          }
        }
        if (cells.length < MIN_POCKET_SIZE) {
          cells.forEach(([cr, cc]) => { mask[cr][cc] = false; });
        }
      }
    }
    return mask;
  }

  // Renders the board shape for whatever difficulty is currently selected,
  // with no mines and no bet spent — purely a preview. Without this,
  // switching to the Hormuz tab left the previous mode's board on screen
  // until "New Game" was clicked, which reads as "the shape is broken"
  // rather than "you haven't started a round yet".
  let previewToken = 0;
  async function previewBoard() {
    const myToken = ++previewToken; // guards against a slow Hormuz sample
    const diff = DIFFICULTIES[diffKey];               // finishing after the user has since switched away
    rows = diff.rows; cols = diff.cols;
    let landMask = null;
    if (diffKey === 'hormuz') {
      try {
        landMask = cleanupMask(await sampleHormuzMask(rows, cols));
      } catch {
        return; // real error surfaces when they actually click New Game
      }
    }
    if (myToken !== previewToken) return;
    buildEmptyBoard(landMask);
    renderBoard();
    mineCountEl.textContent = diffKey === 'hormuz' ? String(Math.round(landTotal * diff.mineDensity)) : String(diff.mines);
  }

  document.getElementById('diff-group').addEventListener('click', (e) => {
    const btn = e.target.closest('.diff-btn');
    if (!btn || gameActive) return;
    diffKey = btn.dataset.diff;
    document.querySelectorAll('.diff-btn').forEach((b) => b.classList.toggle('active', b === btn));
    const diff = DIFFICULTIES[diffKey];
    payoutMultEl.textContent = diff.mult + 'x';
    mineCountEl.textContent = diffKey === 'hormuz' ? '...' : String(diff.mines);
    previewBoard();
  });

  async function newGame() {
    const bet = Math.max(1, Math.floor(Number(betInput.value) || 0));
    if (!Strubles.spend(bet)) {
      setStatus('Not enough Strubles for that bet.', 'lose');
      return;
    }
    currentBet = bet;
    playSfx('minesweeper-start');
    const diff = DIFFICULTIES[diffKey];
    rows = diff.rows; cols = diff.cols;
    firstClickDone = false;
    gameActive = true;
    flagCount = 0;
    revealedSafeCount = 0;
    timerEl.textContent = '0';
    payoutMultEl.textContent = diff.mult + 'x';
    stopTimer();

    let landMask = null;
    if (diffKey === 'hormuz') {
      newGameBtn.disabled = true;
      setStatus('Loading the strait...');
      try {
        landMask = cleanupMask(await sampleHormuzMask(rows, cols));
      } catch {
        setStatus('Could not load the map — refund issued.', 'lose');
        Strubles.add(bet);
        gameActive = false;
        newGameBtn.disabled = false;
        return;
      }
      newGameBtn.disabled = false;
    }
    buildEmptyBoard(landMask);
    mineTotal = diffKey === 'hormuz' ? Math.round(landTotal * diff.mineDensity) : diff.mines;
    mineCountEl.textContent = String(mineTotal);
    renderBoard();
    setStatus(`Bet ${bet} Strubles. Click any cell to begin.`);
    saveGameState();
  }

  newGameBtn.addEventListener('click', () => {
    if (gameActive && !confirm(`You have a game in progress with a ${currentBet} Strubles bet riding on it. Starting a new game forfeits that bet completely — it will not be refunded. Continue?`)) {
      return;
    }
    newGame();
  });
  document.getElementById('bet-minus').addEventListener('click', () => {
    betInput.value = Math.max(1, (Number(betInput.value) || 1) - 5);
  });
  document.getElementById('bet-plus').addEventListener('click', () => {
    betInput.value = Math.max(1, (Number(betInput.value) || 1) + 5);
  });

  // Resume an in-progress round if one was saved (see saveGameState above);
  // otherwise render an empty beginner board immediately so the page isn't
  // blank before the first "New Game" click.
  if (!tryResumeSavedGame()) {
    rows = DIFFICULTIES.beginner.rows; cols = DIFFICULTIES.beginner.cols; mineTotal = DIFFICULTIES.beginner.mines;
    buildEmptyBoard();
    renderBoard();
  }

  // Read-only debug hook — e.g. `__msDebugBoard().board` from DevTools to
  // inspect the real mine layout without revealing it in the UI, or
  // `__msDebugBoard().attemptSolveCheck(r, c)` to re-run the solver against
  // the current layout from a given first click.
  window.__msDebugBoard = () => ({ board, rows, cols, mineTotal, landTotal, diffKey, gameActive, attemptSolveCheck: attemptSolve });

  if (window.initPickers) setTimeout(window.initPickers, 100);
})();
</script>
</body>
</html>
