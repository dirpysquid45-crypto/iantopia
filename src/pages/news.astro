<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>The Iantopia Times</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#d9d9d9">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script is:inline src="/pwa.js?v=1" defer></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- Times New Roman is a system font (no webfont needed) for the Paper wing;
     Share Tech Mono gives the Matrix wing an actual terminal/hacker feel
     distinct from the pixel-arcade font every game page uses. -->
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet">
<!--
  is:global is REQUIRED — the headline cards and the Matrix rain canvas are
  built/driven at runtime via JS, so Astro's scoped data-astro-cid-*
  attribute never lands on them. Same trap documented on every other page.
-->
<style is:global>
  :root {
    /* Paper wing — cool newsprint grey, not warm sepia. --paper-accent used
       to be a brick red for headers/kickers; flattened to neutral so the
       ONLY color anywhere in the text is the lean tags (left/center/right)
       and, later, stock ticker up/down ticks — everything else leans on
       weight/caps/rules for hierarchy instead, same as an actual B&W paper. */
    --paper-bg:#d9d9d9; --paper-ink:#1a1a1a; --paper-muted:#5a5a5a; --paper-rule:#1a1a1a; --paper-accent:#2a2a2a;
    /* Matrix wing */
    --matrix-bg:#000; --matrix-green:#00ff41; --matrix-dim:#0a3d1a; --matrix-card:#04120a;
  }
  * { box-sizing:border-box; }
  html, body { margin:0; height:100%; }
  body {
    min-height:100dvh;
    background: var(--paper-bg);
    color: var(--paper-ink);
    font-family: 'Times New Roman', Times, serif;
    cursor:none;
    position:relative;
  }
  /* Subtle aged-paper texture — layered radial noise, no image asset needed. */
  body::before {
    content:''; position:fixed; inset:0; z-index:-1; pointer-events:none;
    background:
      radial-gradient(circle at 20% 30%, rgba(0,0,0,.05) 0, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(0,0,0,.05) 0, transparent 45%),
      radial-gradient(circle at 50% 90%, rgba(0,0,0,.04) 0, transparent 50%);
  }

  main { max-width:960px; width:100%; margin:0 auto; padding:20px 20px 60px; }

  header.masthead {
    text-align:center; border-bottom:4px double var(--paper-rule); padding-bottom:14px; margin-bottom:6px;
    position:relative;
  }
  #home-link {
    position:absolute; left:0; top:0; color:var(--paper-ink); text-decoration:none;
    border:1px solid var(--paper-ink); padding:4px 10px; font-size:12px; font-family:inherit; cursor:none;
  }
  #home-link:hover { background:var(--paper-ink); color:var(--paper-bg); }
  .masthead-title-row {
    display:flex; align-items:center; justify-content:center; gap:14px; flex-wrap:wrap;
  }
  .masthead-logo { width:44px; height:44px; flex-shrink:0; filter:grayscale(1); }
  .masthead h1 {
    margin:6px 0 4px; font-size:clamp(32px,7vw,58px); font-weight:700; letter-spacing:1px;
    text-transform:uppercase;
  }
  .masthead .tagline { font-style:italic; font-size:13px; color:var(--paper-muted); }
  .dateline {
    display:flex; justify-content:space-between; font-size:11px; letter-spacing:.5px; text-transform:uppercase;
    border-top:1px solid var(--paper-rule); border-bottom:1px solid var(--paper-rule);
    padding:6px 2px; margin:10px 0 24px;
  }

  #wing-tabs { display:flex; justify-content:center; gap:10px; margin:0 0 26px; }
  .wing-tab {
    all:unset; cursor:pointer; padding:8px 18px; border:2px solid var(--paper-ink); font-family:inherit;
    font-size:12px; letter-spacing:1px; text-transform:uppercase; background:transparent; color:var(--paper-ink);
  }
  .wing-tab.active { background:var(--paper-ink); color:var(--paper-bg); }

  .digest {
    border:1px solid var(--paper-rule); padding:20px 24px; margin-bottom:32px; background:rgba(245,245,245,.4);
  }
  .digest h2 {
    margin:0 0 10px; font-size:14px; text-transform:uppercase; letter-spacing:2px; color:var(--paper-accent);
    border-bottom:2px solid var(--paper-accent); padding-bottom:6px;
  }
  .digest p { line-height:1.7; font-size:16px; margin:0 0 10px; }
  .digest .byline { font-size:11px; font-style:italic; color:var(--paper-muted); }

  .section-head {
    font-size:13px; text-transform:uppercase; letter-spacing:2px; border-bottom:2px solid var(--paper-rule);
    padding-bottom:6px; margin:0 0 16px;
  }
  .placeholder-note {
    font-size:11px; color:var(--paper-muted); font-style:italic; margin:-8px 0 20px;
  }

  /* Stock ticks are the SECOND (and last) explicit exception to the
     no-color rule, alongside the lean tags -- up/down is the one place
     color legitimately carries information here. */
  .stock-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px,1fr)); gap:0; column-gap:24px; margin-bottom:32px; }
  .stock-card { border-top:1px solid var(--paper-rule); padding:12px 0; display:flex; justify-content:space-between; align-items:baseline; gap:8px; }
  .stock-card .label { font-size:12px; font-weight:700; }
  .stock-card .figures { text-align:right; }
  .stock-card .price { font-size:13px; }
  .stock-card .tick { font-size:12px; font-weight:700; }
  .tick-up { color:#1a7a1a; }
  .tick-down { color:#aa2222; }
  .tick-flat { color:var(--paper-muted); }

  .headline-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:0; column-gap:28px; }
  .headline-card {
    border-top:1px solid var(--paper-rule); padding:16px 0; break-inside:avoid;
  }
  .headline-card .kicker {
    font-size:10px; text-transform:uppercase; letter-spacing:1.5px; color:var(--paper-accent); font-weight:700;
  }
  .headline-card h3 {
    margin:6px 0 8px; font-size:19px; line-height:1.3; font-weight:700;
  }
  .headline-card p { margin:0 0 8px; font-size:14px; line-height:1.55; color:#333; }
  .headline-card .source-row {
    display:flex; justify-content:space-between; font-size:11px; color:var(--paper-muted); flex-wrap:wrap; gap:6px;
  }
  .headline-card .source-row a { color:inherit; font-weight:700; text-decoration:none; }
  .headline-card .source-row a:hover { text-decoration:underline; }
  .lean-tag {
    padding:1px 6px; border:1px solid currentColor; font-size:9px; text-transform:uppercase; letter-spacing:.5px;
  }
  .lean-left { color:#2255aa; }
  .lean-center { color:var(--paper-muted); }
  .lean-right { color:#aa2222; }

  /* ---------- Matrix wing ---------- */
  body[data-wing="matrix"] {
    background: var(--matrix-bg); color: var(--matrix-green);
    font-family:'Share Tech Mono', ui-monospace, monospace;
  }
  body[data-wing="matrix"]::before { display:none; }
  #matrix-rain {
    position:fixed; inset:0; z-index:-1; display:none;
  }
  body[data-wing="matrix"] #matrix-rain { display:block; }

  body[data-wing="matrix"] header.masthead { border-bottom-color: var(--matrix-green); }
  body[data-wing="matrix"] #home-link { border-color: var(--matrix-green); color: var(--matrix-green); }
  body[data-wing="matrix"] #home-link:hover { background: var(--matrix-green); color:#000; }
  body[data-wing="matrix"] .masthead h1 {
    text-shadow: 0 0 8px var(--matrix-green), 0 0 20px rgba(0,255,65,.5);
  }
  body[data-wing="matrix"] .masthead-logo {
    filter: drop-shadow(0 0 6px var(--matrix-green)) grayscale(.3) brightness(1.1);
  }
  body[data-wing="matrix"] .masthead .tagline { color:#4ecb7a; font-style:normal; }
  body[data-wing="matrix"] .dateline { border-color: var(--matrix-dim); color:#4ecb7a; }
  body[data-wing="matrix"] .wing-tab { border-color: var(--matrix-green); color: var(--matrix-green); }
  body[data-wing="matrix"] .wing-tab.active { background: var(--matrix-green); color:#000; }
  body[data-wing="matrix"] .digest {
    border-color: var(--matrix-green); background: rgba(0,12,5,.95);
    box-shadow: 0 0 20px rgba(0,255,65,.15), inset 0 0 20px rgba(0,255,65,.05);
  }
  body[data-wing="matrix"] .digest h2 { color: var(--matrix-green); border-color: var(--matrix-green); }
  body[data-wing="matrix"] .digest .byline { color:#4ecb7a; }
  body[data-wing="matrix"] .section-head { border-color: var(--matrix-dim); color: var(--matrix-green); }
  body[data-wing="matrix"] .placeholder-note { color:#4ecb7a; }
  /* Panels sit on top of moving rain, not a static image -- .35 opacity let
     the animation wash out the text underneath. Near-solid keeps the rain
     visible around the edges without fighting legibility. */
  body[data-wing="matrix"] .headline-card {
    border-color: var(--matrix-dim); background: rgba(0,12,5,.94); padding:16px 14px; margin-bottom:2px;
  }
  body[data-wing="matrix"] .headline-card .kicker { color:#7fffb0; }
  body[data-wing="matrix"] .headline-card h3 { color: var(--matrix-green); }
  body[data-wing="matrix"] .headline-card p { color:#7fcf9a; }
  body[data-wing="matrix"] .headline-card .source-row { color:#4ecb7a; }
  body[data-wing="matrix"] .lean-left { color:#4aa3ff; }
  body[data-wing="matrix"] .lean-center { color:#4ecb7a; }
  body[data-wing="matrix"] .lean-right { color:#ff5c5c; }
  body[data-wing="matrix"] .stock-grid { background: rgba(0,12,5,.94); border:1px solid var(--matrix-dim); padding:4px 14px; }
  body[data-wing="matrix"] .stock-card { border-top-color: var(--matrix-dim); }
  body[data-wing="matrix"] .stock-card .label { color: var(--matrix-green); }
  body[data-wing="matrix"] .stock-card .price { color:#7fcf9a; }
  body[data-wing="matrix"] .tick-up { color:#39ff6a; }
  body[data-wing="matrix"] .tick-down { color:#ff5c5c; }
  body[data-wing="matrix"] .tick-flat { color:#4ecb7a; }

  @media (max-width:640px) {
    .masthead h1 { font-size:clamp(24px,9vw,36px); }
    #home-link { position:static; display:inline-block; margin-bottom:10px; }
  }
</style>
</head>
<body>
  <canvas id="matrix-rain"></canvas>

  <main>
    <header class="masthead">
      <a href="/" id="home-link">← Home</a>
      <div class="masthead-title-row">
        <img src="/strubles.png" alt="" class="masthead-logo">
        <h1 id="masthead-title">The Iantopia Times</h1>
      </div>
      <div class="tagline" id="masthead-tagline">Glorious Iantopia Times — Extra Extra! Grep All About It!</div>
    </header>

    <div class="dateline">
      <span id="dateline-date"></span>
      <span>Vol. I — Iantopia Wire Service</span>
    </div>

    <div id="wing-tabs">
      <button class="wing-tab" id="tab-paper" type="button">📰 Paper</button>
      <button class="wing-tab" id="tab-matrix" type="button">🖥️ Matrix</button>
    </div>

    <section class="digest">
      <h2>Morning Digest</h2>
      <p id="digest-text">Loading digest…</p>
      <div class="byline" id="digest-byline"></div>
    </section>

    <div class="section-head">Market Movers</div>
    <p class="placeholder-note" id="stock-note">Loading live market data…</p>
    <div class="stock-grid" id="stock-grid"></div>

    <div class="section-head">Coverage Comparison</div>
    <p class="placeholder-note" id="coverage-note">Loading today's headlines…</p>
    <div class="headline-grid" id="headline-grid"></div>

    <div class="section-head">Research &amp; Context</div>
    <p class="placeholder-note" id="research-note">Loading Pew Research context…</p>
    <div class="headline-grid" id="research-grid"></div>
  </main>

<script is:inline src="/cursor-library.js?v=2"></script>
<script is:inline src="/cursor.js?v=3"></script>
<script is:inline>
(function () {
  const $ = (id) => document.getElementById(id);

  // ---------- Dateline ----------
  $('dateline-date').textContent = new Date().toLocaleDateString(undefined, {
    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
  });

  // ---------- Shared helpers ----------
  // Everything below is real, externally-sourced text (RSS feed content,
  // LLM output) going into innerHTML -- unlike the old hardcoded sample
  // strings, this needs escaping. A compromised or malformed feed item is
  // the threat model, not this site's own code.
  function esc(s) {
    const div = document.createElement('div');
    div.textContent = s == null ? '' : String(s);
    return div.innerHTML;
  }
  function safeHref(url) {
    try {
      const u = new URL(url, location.href);
      return (u.protocol === 'http:' || u.protocol === 'https:') ? u.href : '#';
    } catch { return '#'; }
  }

  // ---------- Morning digest ----------
  const digestText = $('digest-text');
  const digestByline = $('digest-byline');
  fetch('/news-data/digest.json')
    .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then((data) => {
      if (!data.available || !data.text) {
        digestText.textContent = data.note || 'The digest is not available right now — the ingestion pipeline may not have run yet, or the local model is offline.';
        digestByline.textContent = '';
        return;
      }
      digestText.textContent = data.text;
      digestByline.textContent = `— Generated locally on Qasim (${data.model}), ${new Date(data.generated_at).toLocaleString()}.`;
    })
    .catch(() => {
      digestText.textContent = 'The digest is not available right now.';
      digestByline.textContent = '';
    });

  // ---------- Coverage comparison (real cross-outlet clusters) ----------
  const headlineGrid = $('headline-grid');
  const coverageNote = $('coverage-note');
  function renderHeadlineCard({ kicker, title, body }) {
    return `<div class="headline-card">
      <div class="kicker">${esc(kicker)}</div>
      <h3>${esc(title)}</h3>
      ${body}
    </div>`;
  }
  fetch('/news-data/clusters.json')
    .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then((data) => {
      const clusters = data.clusters || [];
      const unclustered = (data.unclustered || []).slice(0, 12);
      if (!clusters.length && !unclustered.length) throw new Error('no coverage yet');

      const clusterCards = clusters.map((c) => {
        const rows = c.items.map((item) =>
          `<div class="source-row"><a href="${safeHref(item.link)}" target="_blank" rel="noopener noreferrer">${esc(item.source)}</a><span>${esc(item.title)}</span></div>`
        ).join('');
        return renderHeadlineCard({
          kicker: `Cross-outlet — ${c.items.length} outlets`,
          title: c.title,
          body: rows,
        });
      });
      const singleCards = unclustered.map((item) => renderHeadlineCard({
        kicker: item.source,
        title: item.title,
        body: `<p>${esc(item.summary)}</p><div class="source-row"><a href="${safeHref(item.link)}" target="_blank" rel="noopener noreferrer">Read at ${esc(item.source)} →</a></div>`,
      }));

      headlineGrid.innerHTML = clusterCards.concat(singleCards).join('');
      coverageNote.textContent = clusters.length
        ? `${clusters.length} stories covered by multiple outlets today, plus other headlines below.`
        : 'No story was covered by more than one outlet in this run — showing today’s headlines individually instead.';
    })
    .catch(() => {
      coverageNote.textContent = 'Coverage data is not available right now.';
    });

  // ---------- Research & context (Pew Research) ----------
  const researchGrid = $('research-grid');
  const researchNote = $('research-note');
  fetch('/news-data/headlines.json')
    .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then((data) => {
      const research = (data.items || []).filter((i) => i.category === 'research').slice(0, 8);
      if (!research.length) throw new Error('no research items');
      researchGrid.innerHTML = research.map((item) => renderHeadlineCard({
        kicker: item.source,
        title: item.title,
        body: `<p>${esc(item.summary)}</p><div class="source-row"><a href="${safeHref(item.link)}" target="_blank" rel="noopener noreferrer">Read at ${esc(item.source)} →</a></div>`,
      })).join('');
      researchNote.textContent = 'Analysis and survey data from Pew Research Center — periodic, not daily, so not clustered against wire headlines above.';
    })
    .catch(() => {
      researchNote.textContent = 'Research context is not available right now.';
    });

  // ---------- Market movers (real data — first pipeline stage) ----------
  const stockGrid = $('stock-grid');
  const stockNote = $('stock-note');
  fetch('/news-data/stocks.json')
    .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then((data) => {
      const movers = data.movers || [];
      if (!movers.length) throw new Error('no movers');
      stockGrid.innerHTML = movers.map((m) => {
        const pct = m.change_percent;
        const tickClass = pct > 0 ? 'tick-up' : pct < 0 ? 'tick-down' : 'tick-flat';
        const arrow = pct > 0 ? '▲' : pct < 0 ? '▼' : '—';
        const sign = pct > 0 ? '+' : '';
        return `<div class="stock-card">
          <span class="label">${m.label}</span>
          <span class="figures">
            <span class="price">${m.price.toLocaleString()}</span>
            <span class="tick ${tickClass}">${arrow} ${sign}${pct.toFixed(2)}%</span>
          </span>
        </div>`;
      }).join('');
      stockNote.textContent = `As of ${movers[0].as_of} — sorted by magnitude of change.`;
    })
    .catch(() => {
      stockNote.textContent = 'Live market data unavailable.';
    });

  // ---------- Wing toggle ----------
  let wing = 'paper';
  const tabPaper = $('tab-paper');
  const tabMatrix = $('tab-matrix');
  const mastheadTitle = $('masthead-title');
  const mastheadTagline = $('masthead-tagline');

  function setWing(next) {
    wing = next;
    document.body.dataset.wing = wing;
    tabPaper.classList.toggle('active', wing === 'paper');
    tabMatrix.classList.toggle('active', wing === 'matrix');
    if (wing === 'matrix') {
      mastheadTitle.textContent = 'IANTOPIA://SIGNAL';
      mastheadTagline.textContent = 'wire intercepted. source verified. spin flagged.';
      startRain();
    } else {
      mastheadTitle.textContent = 'The Iantopia Times';
      mastheadTagline.textContent = 'Glorious Iantopia Times — Extra Extra! Grep All About It!';
      stopRain();
    }
  }
  tabPaper.addEventListener('click', () => setWing('paper'));
  tabMatrix.addEventListener('click', () => setWing('matrix'));

  // ---------- Matrix digital rain (canvas, no assets needed) ----------
  const canvas = $('matrix-rain');
  const ctx = canvas.getContext('2d');
  const CHARS = 'アイウエオカキクケコサシスセソタチツテト0123456789';
  let columns = [];
  let rainInterval = null;

  function resizeRain() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const fontSize = 16;
    const colCount = Math.floor(canvas.width / fontSize);
    columns = new Array(colCount).fill(0).map(() => Math.random() * -50);
  }
  window.addEventListener('resize', () => { if (wing === 'matrix') resizeRain(); });

  function drawRain() {
    ctx.fillStyle = 'rgba(0,0,0,.2)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#00ff41';
    ctx.font = '16px monospace';
    columns.forEach((y, i) => {
      const char = CHARS[Math.floor(Math.random() * CHARS.length)];
      ctx.fillText(char, i * 16, y * 16);
      columns[i] = (y * 16 > canvas.height && Math.random() > 0.975) ? 0 : y + 1;
    });
  }
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function startRain() {
    if (rainInterval) return;
    resizeRain();
    // Paint one static frame so reduced-motion users still see the Matrix
    // look, just not the animated rain -- an empty canvas would read as a
    // rendering bug, not a deliberate accessibility choice.
    if (reduceMotion) { drawRain(); return; }
    rainInterval = setInterval(drawRain, 40);
  }
  function stopRain() {
    if (rainInterval) { clearInterval(rainInterval); rainInterval = null; }
  }

  // Runs only after startRain/stopRain exist above -- setWing('paper')'s
  // else-branch calls stopRain(), which threw a temporal-dead-zone error
  // when this ran up where setWing itself is defined, before `let
  // rainInterval` (further down the script) had executed.
  setWing('paper');
})();
</script>
</body>
</html>
