---
// A 3D town rendered in the browser. Every shape is generated in code (no models
// or textures are loaded). The buildings come from the repo's own Tycoon data
// (public/tycoon-buildings.js), and the layout comes from the player's village
// save, or from a sample hamlet if there is none.
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>World</title>
  <style>
    html, body { margin:0; height:100%; background:#0b1620; color:#fff; font-family: monospace; overflow:hidden; }
    #world { position:fixed; inset:0; touch-action:none; }
    #legend { position:fixed; left:12px; top:12px; background:rgba(0,0,0,.7); border:2px solid #ffd700; padding:10px 12px; font-size:11px; line-height:1.7; max-width:260px; }
    #legend b { color:#ffd700; }
    #note { position:fixed; right:12px; bottom:12px; background:rgba(0,0,0,.7); border:2px solid #ffd700; padding:8px 10px; font-size:10px; }
    a.back { position:fixed; right:12px; top:12px; color:#ffd700; background:#000; border:2px solid #ffd700; padding:6px 10px; text-decoration:none; font-size:11px; }
  </style>
</head>
<body>
  <div id="world"></div>
  <div id="legend"><b>WORLD</b><br /><span id="stats">building…</span><br /><span style="color:#7db6ff">■ residential</span> <span style="color:#ffb457">■ commercial</span> <span style="color:#c99bf0">■ industrial</span> <span style="color:#7ccf6a">■ park</span></div>
  <div id="note">drag to turn · scroll to zoom</div>
  <a class="back" href="/">← Home</a>
  <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
  <script is:inline src="/tycoon-buildings.js?v=14"></script>
  <script is:inline>
    (function () {
      var stats = document.getElementById('stats');
      var host = document.getElementById('world');
      var DEFS = window.TYCOON_BUILDINGS || {};
      var MAP = 24;                       // tiles per side
      var ZONE_COLOR = { residential: 0x4f8fe0, commercial: 0xe0952e, industrial: 0xa96bd0, park: 0x6fbf5a };

      if (!window.THREE || !window.WebGLRenderingContext) {
        host.innerHTML = '<p style="padding:24px">This page needs WebGL. Try a current browser.</p>';
        return;
      }

      // ----- the layout: the player's village if there is one, else a sample hamlet
      function loadLayout() {
        try {
          var v = JSON.parse(localStorage.getItem('tycoon_village_v2') || 'null');
          if (v && Array.isArray(v.b) && v.b.length) return { buildings: v.b, tiles: v.tiles || {}, sample: false };
        } catch (e) {}
        return sampleHamlet();
      }
      function sampleHamlet() {
        var tiles = {}, buildings = [], id = 1;
        function road(x, y) { tiles[x + '_' + y] = 'road'; }
        for (var i = 4; i <= 19; i++) { road(i, 4); road(i, 19); road(4, i); road(19, i); }
        for (var j = 9; j <= 14; j++) road(j, 11);
        function put(key, x, y) { buildings.push({ id: id++, key: key, x: x, y: y, status: 'complete' }); }
        var houses = ['shabby_apartment', 'generic_building', 'pagoda'];
        var spots = [[5,5],[7,5],[10,5],[13,5],[16,5],[5,13],[7,13],[10,13],[13,13],[16,13]];
        spots.forEach(function (s, n) { put(houses[n % 3], s[0], s[1]); });
        put('bank', 16, 7);
        put('seven_eleven', 13, 7);
        put('generic_skyscraper', 6, 16);
        put('office_building', 10, 16);
        put('factory', 14, 16);
        put('park', 20, 6);
        return { buildings: buildings, tiles: tiles, sample: true };
      }

      var layout = loadLayout();

      // ----- renderer, scene, camera
      var renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      host.appendChild(renderer.domElement);

      var scene = new THREE.Scene();
      scene.background = new THREE.Color(0x9fd3f0);
      scene.fog = new THREE.Fog(0x9fd3f0, 60, 140);

      var camera = new THREE.PerspectiveCamera(40, 1, 0.1, 400);
      var target = new THREE.Vector3(MAP / 2, 0, MAP / 2);
      var yaw = Math.PI / 4, pitch = 0.9, dist = 42;

      function placeCamera() {
        var p = Math.max(0.2, Math.min(1.45, pitch));
        camera.position.set(
          target.x + dist * Math.cos(p) * Math.sin(yaw),
          target.y + dist * Math.sin(p),
          target.z + dist * Math.cos(p) * Math.cos(yaw));
        camera.lookAt(target);
      }

      scene.add(new THREE.HemisphereLight(0xffffff, 0x4a6b3a, 0.9));
      var sun = new THREE.DirectionalLight(0xfff1d6, 1.1);
      sun.position.set(20, 40, 15);
      sun.castShadow = true;
      sun.shadow.mapSize.set(2048, 2048);
      sun.shadow.camera.left = -30; sun.shadow.camera.right = 30;
      sun.shadow.camera.top = 30; sun.shadow.camera.bottom = -30;
      sun.shadow.camera.far = 120;
      scene.add(sun);

      // ----- ground: grass, then roads and water on top
      var ground = new THREE.Mesh(new THREE.BoxGeometry(MAP, 0.6, MAP),
        new THREE.MeshLambertMaterial({ color: 0x6aa84f }));
      ground.position.set(MAP / 2, -0.3, MAP / 2);
      ground.receiveShadow = true;
      scene.add(ground);

      var roadMat = new THREE.MeshLambertMaterial({ color: 0x3a3d44 });
      var waterMat = new THREE.MeshLambertMaterial({ color: 0x3f8fd6 });
      Object.keys(layout.tiles).forEach(function (k) {
        var p = k.split('_'), type = layout.tiles[k];
        var mat = type === 'road' ? roadMat : type === 'water' ? waterMat : null;
        if (!mat) return;
        var t = new THREE.Mesh(new THREE.BoxGeometry(1, 0.08, 1), mat);
        t.position.set(+p[0] + 0.5, 0.04, +p[1] + 0.5);
        t.receiveShadow = true;
        scene.add(t);
      });

      // ----- buildings: height from output, footprint from the Tycoon definitions
      var counts = { residential: 0, commercial: 0, industrial: 0, park: 0 };
      var output = 0;
      var rnd = (function (seed) { return function () { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }; })(7);
      layout.buildings.forEach(function (s) {
        if (s.status !== 'complete') return;
        var def = DEFS[s.key];
        if (!def) return;
        var w = def.w || 1, h = def.h || 1;
        var isPark = s.key === 'park';
        var zone = isPark ? 'park' : def.zone;
        var height = isPark ? 0.3 : 1.2 + (def.production || 1) * 0.7 + (def.housing || 0) * 0.2;
        var color = ZONE_COLOR[zone] || 0xcccccc;
        var body = new THREE.Mesh(new THREE.BoxGeometry(w * 0.86, height, h * 0.86),
          new THREE.MeshLambertMaterial({ color: color }));
        body.position.set(s.x + w / 2, height / 2, s.y + h / 2);
        body.castShadow = true;
        body.receiveShadow = true;
        scene.add(body);
        if (!isPark) {
          var roof = new THREE.Mesh(new THREE.ConeGeometry(Math.max(w, h) * 0.6, 0.9, 4),
            new THREE.MeshLambertMaterial({ color: 0x8a4b2a }));
          roof.rotation.y = Math.PI / 4;
          roof.position.set(s.x + w / 2, height + 0.45, s.y + h / 2);
          roof.castShadow = true;
          scene.add(roof);
        } else {
          for (var t = 0; t < 6; t++) {
            var px = s.x + 0.5 + rnd() * (w - 1), pz = s.y + 0.5 + rnd() * (h - 1);
            var trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.1, 0.6, 6), new THREE.MeshLambertMaterial({ color: 0x6b4a2b }));
            trunk.position.set(px, 0.6, pz);
            var crown = new THREE.Mesh(new THREE.SphereGeometry(0.45, 8, 6), new THREE.MeshLambertMaterial({ color: 0x2f7d32 }));
            crown.position.set(px, 1.2, pz);
            crown.castShadow = true;
            scene.add(trunk, crown);
          }
        }
        counts[zone] = (counts[zone] || 0) + 1;
        output += def.production || 0;
      });

      stats.textContent = (layout.sample ? 'sample hamlet · ' : 'your village · ') +
        Object.keys(counts).map(function (z) { return z + ' ' + counts[z]; }).join(' · ') +
        ' · output ' + output + '/min';

      // ----- camera controls: drag to turn and tilt, wheel or pinch to zoom
      var drag = null;
      renderer.domElement.addEventListener('pointerdown', function (e) {
        drag = { x: e.clientX, y: e.clientY, yaw: yaw, pitch: pitch };
        renderer.domElement.setPointerCapture(e.pointerId);
      });
      renderer.domElement.addEventListener('pointermove', function (e) {
        if (!drag) return;
        yaw = drag.yaw - (e.clientX - drag.x) * 0.008;
        pitch = drag.pitch + (e.clientY - drag.y) * 0.004;
        placeCamera();
      });
      renderer.domElement.addEventListener('pointerup', function () { drag = null; });
      renderer.domElement.addEventListener('pointercancel', function () { drag = null; });
      renderer.domElement.addEventListener('wheel', function (e) {
        e.preventDefault();
        dist = Math.max(14, Math.min(90, dist * (1 + e.deltaY * 0.001)));
        placeCamera();
      }, { passive: false });

      function resize() {
        var w = host.clientWidth, h = host.clientHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
      window.addEventListener('resize', resize);
      resize();
      placeCamera();

      renderer.setAnimationLoop(function () { renderer.render(scene, camera); });
    })();
  </script>
</body>
</html>
