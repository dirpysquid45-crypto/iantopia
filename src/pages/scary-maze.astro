<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
<title>???</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<meta name="theme-color" content="#000000">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style is:global>
  :root { --orange:#ff6f00; --purple:#5e17a8; --green:#39ff14; }
  * { box-sizing:border-box; }
  html, body { margin:0; height:100%; overflow:hidden; background:#000; }
  body {
    font-family:'Press Start 2P', ui-monospace, monospace;
    color:#fff; cursor:default;
    display:flex; align-items:center; justify-content:center;
    position:relative;
  }
  #stage { position:fixed; inset:0; display:flex; align-items:center; justify-content:center; }
  /* Square game board, not edge-to-edge -- a contained frame reads more
     like the classic prank than a full-viewport canvas does. */
  canvas { display:block; touch-action:none; border:3px solid #0ff; box-shadow:0 0 30px rgba(0,255,255,.35); }

  #hud {
    position:fixed; top:12px; left:50%; transform:translateX(-50%);
    font-size:10px; color:var(--orange); text-shadow:0 0 8px rgba(255,111,0,.7);
    text-align:center; z-index:5; line-height:1.8; pointer-events:none;
  }

  /* Shown at all times, separate from the HUD, which the game rewrites. */
  #prize-note {
    position:fixed; bottom:14px; left:50%; transform:translateX(-50%); z-index:5;
    font-size:10px; color:var(--green); text-shadow:0 0 8px rgba(57,255,20,.6);
    text-align:center; line-height:1.8; pointer-events:none; white-space:nowrap;
  }

  a.back-link {
    position:fixed; top:14px; left:14px; z-index:6;
    color:var(--purple); background:#000; border:2px solid var(--purple);
    padding:8px 12px; font-family:inherit; font-size:9px; text-decoration:none;
  }
  a.back-link:hover { background:var(--purple); color:#fff; }

  /* ---------- Jumpscare ---------- */
  #jumpscare {
    position:fixed; inset:0; z-index:50; background:#000;
    display:none; align-items:center; justify-content:center; overflow:hidden;
  }
  #jumpscare.show { display:flex; }
  #jumpscare img { width:100%; height:100%; object-fit:cover; }
  @keyframes screenShake {
    0%,100% { transform:translate(0,0); }
    10% { transform:translate(-14px,8px); } 20% { transform:translate(12px,-10px); }
    30% { transform:translate(-10px,-6px); } 40% { transform:translate(14px,10px); }
    50% { transform:translate(-8px,12px); } 60% { transform:translate(10px,-8px); }
    70% { transform:translate(-12px,-4px); } 80% { transform:translate(6px,10px); }
    90% { transform:translate(-10px,-10px); }
  }
  #jumpscare.show { animation: screenShake 0.6s linear 3; }

  /* ---------- Confetti ---------- */
  #confetti { position:fixed; inset:0; z-index:45; pointer-events:none; display:none; }

  /* ---------- Result screen ---------- */
  #result-screen {
    position:fixed; inset:0; z-index:40; background:#000;
    display:none; flex-direction:column; align-items:center; justify-content:center;
    gap:18px; text-align:center; padding:20px;
  }
  #result-screen.show { display:flex; }
  #result-screen h1 { font-size:clamp(16px,4vw,24px); color:var(--green); text-shadow:0 0 16px rgba(57,255,20,.7); margin:0; }
  #result-screen .reward {
    display:flex; flex-direction:column; align-items:center; gap:10px;
    border:3px solid var(--purple); padding:18px 24px; background:#120a1e;
    box-shadow:0 0 30px rgba(94,23,168,.5);
  }
  #result-screen .reward img { width:110px; filter:drop-shadow(0 0 16px rgba(94,23,168,.8)); }
  #result-screen .reward span { font-size:9px; color:#ce93d8; line-height:1.8; }
  #result-screen a {
    color:var(--orange); border:2px solid var(--orange); background:#1a0a00;
    padding:10px 18px; text-decoration:none; font-size:10px;
  }
  #result-screen a:hover { background:var(--orange); color:#1a0a00; }
</style>
</head>
<body>
  <a class="back-link" href="/">← Iantopia</a>
  <div id="hud">Click the red square to pick it up.</div>
  <div id="prize-note">Beat the maze for a free collectible!</div>

  <div id="stage"><canvas id="maze"></canvas></div>

  <div id="jumpscare"><img src="/maze-game/scary-face.jpg" alt="" /></div>
  <canvas id="confetti"></canvas>

  <div id="result-screen">
    <h1>you made it out</h1>
    <div class="reward">
      <img src="/assets/decorations/job-application-form.png" alt="Job Application Form" />
      <span>Reward unlocked: Job Application Form<br>(check your Inventory)</span>
    </div>
    <a href="/">← Back to Iantopia</a>
  </div>

  <audio id="sfx-scream" src="/maze-game/scream.mp3" preload="auto"></audio>
  <audio id="sfx-cheer" src="/maze-game/kids_cheering.mp3" preload="auto"></audio>

<script is:inline>
(() => {
  const canvas = document.getElementById('maze');
  const ctx = canvas.getContext('2d');
  const hud = document.getElementById('hud');
  const jumpscare = document.getElementById('jumpscare');
  const resultScreen = document.getElementById('result-screen');
  const confettiCanvas = document.getElementById('confetti');
  const confettiCtx = confettiCanvas.getContext('2d');
  const sfxScream = document.getElementById('sfx-scream');
  const sfxCheer = document.getElementById('sfx-cheer');

  // Normalized (0..1) waypoints -- a single winding corridor, not a
  // branching maze, same as the classic prank this page recreates. Scaled
  // to actual canvas pixels on every resize.
  const WAYPOINTS = [
    [0.10, 0.10], [0.10, 0.42], [0.34, 0.42], [0.34, 0.14], [0.58, 0.14],
    [0.58, 0.55], [0.28, 0.55], [0.28, 0.80], [0.52, 0.80], [0.52, 0.62],
    [0.74, 0.62], [0.74, 0.90], [0.90, 0.90], [0.90, 0.36], [0.68, 0.36],
    [0.68, 0.20], [0.90, 0.20], [0.90, 0.06], [0.50, 0.06],
  ];
  const START_WIDTH = 46, END_WIDTH = 15; // the corridor narrows toward the end, like the original

  let W = 0, H = 0, PAD = 0;
  let path = [];       // WAYPOINTS scaled to pixels
  let segLen = [];      // length of each segment
  let totalLen = 0, cumLen = [];

  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    // Square board: the smaller of width/height, with a margin, instead of
    // stretching to fill a rectangular viewport.
    const side = Math.min(window.innerWidth, window.innerHeight) * 0.88;
    W = side; H = side;
    PAD = side * 0.06;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const innerW = W - PAD * 2, innerH = H - PAD * 2;
    path = WAYPOINTS.map(([x, y]) => [PAD + x * innerW, PAD + y * innerH]);
    segLen = []; cumLen = [0]; totalLen = 0;
    for (let i = 1; i < path.length; i++) {
      const d = Math.hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);
      segLen.push(d); totalLen += d; cumLen.push(totalLen);
    }
    draw();
  }

  // Corridor width at distance `d` along the path -- a smooth, continuous
  // narrowing from START_WIDTH to END_WIDTH, not a sudden drop.
  function widthAt(d) {
    const t = Math.max(0, Math.min(1, d / totalLen));
    return START_WIDTH + (END_WIDTH - START_WIDTH) * t;
  }

  function draw() {
    ctx.fillStyle = '#000'; ctx.fillRect(0, 0, W, H);
    // Floor: flat light cyan-blue, square (butt-cap/miter) joints instead
    // of rounded, for the blockier look.
    ctx.lineCap = 'butt'; ctx.lineJoin = 'miter';
    ctx.strokeStyle = '#7de8ff';
    for (let i = 1; i < path.length; i++) {
      ctx.lineWidth = widthAt((cumLen[i - 1] + cumLen[i]) / 2);
      ctx.beginPath(); ctx.moveTo(...path[i - 1]); ctx.lineTo(...path[i]); ctx.stroke();
    }
    // Square start/end markers (not circles), matching the dot.
    ctx.fillStyle = '#ff2d2d';
    ctx.fillRect(path[0][0] - 7, path[0][1] - 7, 14, 14);
    ctx.fillStyle = '#ff2d2d';
    ctx.fillRect(path[path.length - 1][0] - 8, path[path.length - 1][1] - 8, 16, 16);
  }

  // Signed distance from (x,y) to the nearest point on the path, plus the
  // arc-length at that nearest point (used to look up the corridor width
  // there, since it narrows along the way).
  function nearest(x, y) {
    let best = Infinity, bestLen = 0;
    for (let i = 1; i < path.length; i++) {
      const [x1, y1] = path[i - 1], [x2, y2] = path[i];
      const dx = x2 - x1, dy = y2 - y1;
      const len2 = dx * dx + dy * dy;
      let t = len2 ? ((x - x1) * dx + (y - y1) * dy) / len2 : 0;
      t = Math.max(0, Math.min(1, t));
      const px = x1 + dx * t, py = y1 + dy * t;
      const d = Math.hypot(x - px, y - py);
      if (d < best) { best = d; bestLen = cumLen[i - 1] + segLen[i - 1] * t; }
    }
    return { dist: best, len: bestLen };
  }

  function inCorridor(x, y) {
    const { dist, len } = nearest(x, y);
    return dist <= widthAt(len) / 2;
  }

  // The dot is a virtual point, not the system cursor -- a web page can't
  // move the real cursor. Once picked up, the pointer is locked (hidden,
  // relative movement only), so the dot can only travel the way the mouse
  // actually moves. The cursor can't jump across the maze to the end.
  let playing = false, over = false, hasStarted = false;
  let dotX = 0, dotY = 0, lastTouchX = 0, lastTouchY = 0;

  function resetDot() {
    dotX = path[0][0]; dotY = path[0][1];
  }

  function localPos(e) {
    const r = canvas.getBoundingClientRect();
    const t = e.touches && e.touches[0];
    return { x: (t ? t.clientX : e.clientX) - r.left, y: (t ? t.clientY : e.clientY) - r.top };
  }

  function nearDot(x, y) {
    return Math.hypot(x - dotX, y - dotY) < 24;
  }

  // Move the dot in small steps, so a fast flick can't jump over a wall
  // between two input events.
  function moveTo(tx, ty) {
    const dx = tx - dotX, dy = ty - dotY;
    const steps = Math.max(1, Math.ceil(Math.hypot(dx, dy) / 2));
    for (let i = 1; i <= steps; i++) {
      dotX += dx / steps; dotY += dy / steps;
      if (!inCorridor(dotX, dotY)) { caught(); return; }
    }
    const end = path[path.length - 1];
    if (Math.hypot(dotX - end[0], dotY - end[1]) < 16) win();
  }

  function caught() {
    over = true; playing = false;
    if (document.pointerLockElement) document.exitPointerLock();
    jumpscare.classList.add('show');
    try { sfxScream.currentTime = 0; sfxScream.volume = 0.85; sfxScream.play().catch(() => {}); } catch {}
    setTimeout(() => { location.href = '/'; }, 1900);
  }

  function win() {
    over = true; playing = false;
    if (document.pointerLockElement) document.exitPointerLock();
    grantJobApplication();
    showConfetti();
    try { sfxCheer.currentTime = 0; sfxCheer.volume = 0.8; sfxCheer.play().catch(() => {}); } catch {}
    setTimeout(() => {
      confettiCanvas.style.display = 'none';
      resultScreen.classList.add('show');
    }, 3600);
  }

  function showConfetti() {
    confettiCanvas.style.display = 'block';
    confettiCanvas.width = window.innerWidth; confettiCanvas.height = window.innerHeight;
    const colors = ['#ff2d2d', '#00e5ff', '#ff6f00', '#39ff14', '#ffd600', '#ff4fd8'];
    const pieces = Array.from({ length: 220 }, () => ({
      x: Math.random() * confettiCanvas.width,
      y: -Math.random() * confettiCanvas.height * 0.5,
      vx: (Math.random() - 0.5) * 4,
      vy: 2 + Math.random() * 4,
      s: 6 + Math.random() * 6,
      r: Math.random() * Math.PI,
      vr: (Math.random() - 0.5) * 0.3,
      c: colors[Math.floor(Math.random() * colors.length)],
    }));
    const end = performance.now() + 3400;
    (function frame(now) {
      confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
      for (const p of pieces) {
        p.x += p.vx; p.y += p.vy; p.vy += 0.03; p.r += p.vr;
        confettiCtx.save();
        confettiCtx.translate(p.x, p.y); confettiCtx.rotate(p.r);
        confettiCtx.fillStyle = p.c;
        confettiCtx.fillRect(-p.s / 2, -p.s / 4, p.s, p.s / 2);
        confettiCtx.restore();
      }
      if (now < end) requestAnimationFrame(frame);
    })(performance.now());
  }

  // Click the dot to pick it up (or resume after Esc).
  canvas.addEventListener('click', (e) => {
    if (playing || over) return;
    const p = localPos(e);
    if (nearDot(p.x, p.y)) canvas.requestPointerLock();
  });

  document.addEventListener('pointerlockchange', () => {
    if (over) return;
    const locked = document.pointerLockElement === canvas;
    playing = locked;
    if (locked) hasStarted = true;
    document.body.style.cursor = locked ? 'none' : 'default';
    hud.textContent = locked
      ? "Esc pauses. Don't touch the black walls."
      : (hasStarted ? 'Click the red square to resume.' : 'Click the red square to pick it up.');
  });

  canvas.addEventListener('mousemove', (e) => {
    if (playing) moveTo(dotX + e.movementX, dotY + e.movementY);
  });

  // Touch has no pointer lock, so the dot follows finger movement instead
  // of the finger's absolute position.
  canvas.addEventListener('touchstart', (e) => {
    if (over) return;
    const p = localPos(e);
    if (!playing && nearDot(p.x, p.y)) { playing = true; hasStarted = true; }
    lastTouchX = p.x; lastTouchY = p.y;
    hud.textContent = "Don't touch the black walls.";
  }, { passive: true });
  canvas.addEventListener('touchmove', (e) => {
    e.preventDefault();
    if (!playing) return;
    const p = localPos(e);
    moveTo(dotX + p.x - lastTouchX, dotY + p.y - lastTouchY);
    lastTouchX = p.x; lastTouchY = p.y;
  }, { passive: false });

  function grantJobApplication() {
    try {
      const raw = localStorage.getItem('strubles_inventory_v1');
      const inv = raw ? JSON.parse(raw) : {};
      if (!Array.isArray(inv.items)) inv.items = [];
      if (!inv.items.includes('col_jobapplication')) {
        inv.items.push('col_jobapplication');
        localStorage.setItem('strubles_inventory_v1', JSON.stringify(inv));
        window.dispatchEvent(new CustomEvent('inventory:changed'));
      }
    } catch {}
  }

  function loop() {
    draw();
    ctx.fillStyle = '#ff0000';
    ctx.shadowColor = '#ff0000'; ctx.shadowBlur = 10;
    ctx.fillRect(dotX - 6, dotY - 6, 12, 12);
    ctx.shadowBlur = 0;
    requestAnimationFrame(loop);
  }

  window.addEventListener('resize', () => {
    resize();
    // The board moved, so the dot goes back to the start and the game pauses.
    if (document.pointerLockElement) document.exitPointerLock();
    resetDot();
  });
  resize();
  resetDot();
  loop();
})();
</script>
</body>
</html>
