---
// A Christmas village rendered in the browser. It is self-contained: every
// shape is generated in code, and it uses no Iantopia data or art. Three.js
// is loaded from a pinned version on jsDelivr.
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Christmas Village</title>
  <style>
    html, body { margin:0; height:100%; background:#0d1a2b; color:#fff; font-family: Georgia, serif; overflow:hidden; }
    #village { position:fixed; inset:0; touch-action:none; }
    #panel { position:fixed; left:14px; top:14px; background:rgba(10,20,35,.72); border:1px solid #f3d27a; border-radius:10px; padding:12px 14px; font-size:14px; line-height:1.6; max-width:280px; }
    #panel h1 { margin:0 0 4px; font-size:20px; color:#ffe9a8; font-weight:normal; letter-spacing:1px; }
    #panel .dim { color:#b9c9dc; font-size:12px; }
    #hint { position:fixed; right:14px; bottom:14px; background:rgba(10,20,35,.72); border:1px solid #f3d27a; border-radius:10px; padding:8px 12px; font-size:12px; color:#ffe9a8; }
    a.back { position:fixed; right:14px; top:14px; color:#ffe9a8; background:rgba(10,20,35,.72); border:1px solid #f3d27a; border-radius:10px; padding:6px 10px; text-decoration:none; font-size:13px; }
  </style>
</head>
<body>
  <div id="village"></div>
  <div id="panel">
    <h1>Christmas Village</h1>
    <div class="dim" id="count">building the village…</div>
  </div>
  <div id="hint">drag to turn · right-drag or arrows to move · scroll to zoom</div>
  <a class="back" href="/">← Home</a>
  <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
  <script is:inline>
    (function () {
      var host = document.getElementById('village');
      var count = document.getElementById('count');
      if (!window.THREE || !window.WebGLRenderingContext) {
        host.innerHTML = '<p style="padding:24px">This page needs WebGL. Try a current browser.</p>';
        return;
      }

      // Seeded random, so the village is the same on every visit.
      var seed = 20261225;
      function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }
      function pick(list) { return list[Math.floor(rnd() * list.length)]; }

      var renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      host.appendChild(renderer.domElement);

      var scene = new THREE.Scene();
      scene.background = new THREE.Color(0x1b2a44);
      scene.fog = new THREE.Fog(0x1b2a44, 45, 120);

      var camera = new THREE.PerspectiveCamera(40, 1, 0.1, 300);
      var size = 30;
      var target = new THREE.Vector3(size / 2, 0, size / 2);
      var yaw = Math.PI / 4, pitch = 0.75, dist = 40;
      function placeCamera() {
        var p = Math.max(0.2, Math.min(1.4, pitch));
        camera.position.set(
          target.x + dist * Math.cos(p) * Math.sin(yaw),
          target.y + dist * Math.sin(p),
          target.z + dist * Math.cos(p) * Math.cos(yaw));
        camera.lookAt(target);
      }

      // Moonlight, a cool fill, and warm lamps.
      scene.add(new THREE.HemisphereLight(0xcfe3ff, 0x2a3a52, 0.8));
      var moon = new THREE.DirectionalLight(0xdfe9ff, 0.9);
      moon.position.set(-18, 34, 14);
      moon.castShadow = true;
      moon.shadow.mapSize.set(2048, 2048);
      moon.shadow.camera.left = -22; moon.shadow.camera.right = 22;
      moon.shadow.camera.top = 22; moon.shadow.camera.bottom = -22;
      moon.shadow.camera.far = 100;
      scene.add(moon);

      // Snowy ground, a frozen pond, and a packed-snow path.
      var ground = new THREE.Mesh(new THREE.BoxGeometry(size, 0.6, size),
        new THREE.MeshLambertMaterial({ color: 0xeef4fb }));
      ground.position.set(size / 2, -0.3, size / 2);
      ground.receiveShadow = true;
      scene.add(ground);

      var pond = new THREE.Mesh(new THREE.CylinderGeometry(3.2, 3.2, 0.1, 28),
        new THREE.MeshLambertMaterial({ color: 0x9cc9e8 }));
      pond.position.set(22, 0.05, 9);
      pond.receiveShadow = true;
      scene.add(pond);

      var pathMat = new THREE.MeshLambertMaterial({ color: 0xd9d2c3 });
      function path(x, z, w, d) {
        var p = new THREE.Mesh(new THREE.BoxGeometry(w, 0.08, d), pathMat);
        p.position.set(x, 0.04, z);
        p.receiveShadow = true;
        scene.add(p);
      }
      path(size / 2, size / 2, 2, size - 6);
      path(size / 2, size / 2, size - 10, 2);

      // Pine trees: stacked cones with snow on the tiers.
      function pine(x, z, s) {
        var g = new THREE.Group();
        var trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.12 * s, 0.16 * s, 1.0 * s, 6),
          new THREE.MeshLambertMaterial({ color: 0x5a3e28 }));
        trunk.position.y = 0.5 * s;
        g.add(trunk);
        var green = new THREE.MeshLambertMaterial({ color: 0x1f5a3a });
        var snow = new THREE.MeshLambertMaterial({ color: 0xffffff });
        for (var t = 0; t < 3; t++) {
          var r = (1.5 - t * 0.35) * s, y = (1.0 + t * 0.9) * s;
          var cone = new THREE.Mesh(new THREE.ConeGeometry(r, 1.4 * s, 8), green);
          cone.position.y = y;
          cone.castShadow = true;
          g.add(cone);
          var cap = new THREE.Mesh(new THREE.ConeGeometry(r * 0.55, 0.5 * s, 8), snow);
          cap.position.y = y + 0.42 * s;
          g.add(cap);
        }
        g.position.set(x, 0, z);
        scene.add(g);
      }

      // Houses: a box, a snowy pitched roof, a chimney, and warm windows.
      var wallColors = [0xb5543c, 0xd9b77a, 0x7d9b8c, 0xc9a0a0, 0xa9b8c8];
      function house(x, z, w, d, rot) {
        var g = new THREE.Group();
        var h = 2.2 + rnd() * 0.8;
        var walls = new THREE.Mesh(new THREE.BoxGeometry(w, h, d),
          new THREE.MeshLambertMaterial({ color: pick(wallColors) }));
        walls.position.y = h / 2;
        walls.castShadow = true;
        walls.receiveShadow = true;
        g.add(walls);
        var roof = new THREE.Mesh(new THREE.ConeGeometry(Math.max(w, d) * 0.75, 1.5, 4),
          new THREE.MeshLambertMaterial({ color: 0x6a3a2a }));
        roof.rotation.y = Math.PI / 4;
        roof.position.y = h + 0.75;
        roof.castShadow = true;
        g.add(roof);
        var snowRoof = new THREE.Mesh(new THREE.ConeGeometry(Math.max(w, d) * 0.4, 0.5, 4),
          new THREE.MeshLambertMaterial({ color: 0xffffff }));
        snowRoof.rotation.y = Math.PI / 4;
        snowRoof.position.y = h + 1.55;
        g.add(snowRoof);
        var chimney = new THREE.Mesh(new THREE.BoxGeometry(0.4, 1.2, 0.4),
          new THREE.MeshLambertMaterial({ color: 0x5a4a44 }));
        chimney.position.set(w * 0.25, h + 1.1, d * 0.2);
        g.add(chimney);
        var glow = new THREE.MeshBasicMaterial({ color: 0xffd27a });
        for (var k = 0; k < 2; k++) {
          var win = new THREE.Mesh(new THREE.PlaneGeometry(0.5, 0.6), glow);
          win.position.set(-w / 2 - 0.01, h * 0.55, -d * 0.25 + k * d * 0.5);
          win.rotation.y = -Math.PI / 2;
          g.add(win);
        }
        g.position.set(x, 0, z);
        g.rotation.y = rot || 0;
        scene.add(g);
      }

      // Candy-cane lamppost with a warm light on top.
      var candyRed = new THREE.MeshLambertMaterial({ color: 0xd42a2a });
      var candyWhite = new THREE.MeshLambertMaterial({ color: 0xffffff });
      function lamp(x, z) {
        var g = new THREE.Group();
        for (var i = 0; i < 6; i++) {
          var seg = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.07, 0.4, 6), i % 2 ? candyWhite : candyRed);
          seg.position.y = 0.2 + i * 0.4;
          g.add(seg);
        }
        var bulb = new THREE.Mesh(new THREE.SphereGeometry(0.22, 8, 6), new THREE.MeshBasicMaterial({ color: 0xffe6a8 }));
        bulb.position.y = 2.6;
        g.add(bulb);
        var light = new THREE.PointLight(0xffc878, 0.7, 6);
        light.position.y = 2.6;
        g.add(light);
        g.position.set(x, 0, z);
        scene.add(g);
      }

      // The town tree in the square: layered green with baubles and a star.
      function centreTree(x, z) {
        var g = new THREE.Group();
        var trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.3, 1.2, 8),
          new THREE.MeshLambertMaterial({ color: 0x5a3e28 }));
        trunk.position.y = 0.6;
        g.add(trunk);
        var green = new THREE.MeshLambertMaterial({ color: 0x1d6b3d });
        for (var t = 0; t < 4; t++) {
          var cone = new THREE.Mesh(new THREE.ConeGeometry(2.4 - t * 0.5, 1.8, 10), green);
          cone.position.y = 1.9 + t * 1.1;
          cone.castShadow = true;
          g.add(cone);
        }
        var baubleCols = [0xff4d4d, 0xffd24d, 0x4da6ff, 0xff8fd1];
        for (var b = 0; b < 16; b++) {
          var a = b * 2.4, r = 1.2 + (b % 3) * 0.35, y = 1.8 + (b % 4) * 0.8;
          var bauble = new THREE.Mesh(new THREE.SphereGeometry(0.13, 8, 6),
            new THREE.MeshBasicMaterial({ color: baubleCols[b % baubleCols.length] }));
          bauble.position.set(Math.cos(a) * r, y, Math.sin(a) * r);
          g.add(bauble);
        }
        var star = new THREE.Mesh(new THREE.OctahedronGeometry(0.38), new THREE.MeshBasicMaterial({ color: 0xffe066 }));
        star.position.y = 6.2;
        g.add(star);
        var glow = new THREE.PointLight(0xffe2a0, 1.2, 10);
        glow.position.y = 3.5;
        g.add(glow);
        g.position.set(x, 0, z);
        scene.add(g);
      }

      // A snowman and a stack of gift boxes.
      function snowman(x, z) {
        var g = new THREE.Group();
        var snow = new THREE.MeshLambertMaterial({ color: 0xffffff });
        [[0.6, 0.6], [0.45, 1.45], [0.3, 2.1]].forEach(function (p) {
          var ball = new THREE.Mesh(new THREE.SphereGeometry(p[0], 12, 9), snow);
          ball.position.y = p[1];
          ball.castShadow = true;
          g.add(ball);
        });
        var nose = new THREE.Mesh(new THREE.ConeGeometry(0.06, 0.25, 6), new THREE.MeshLambertMaterial({ color: 0xff8a2a }));
        nose.rotation.x = Math.PI / 2;
        nose.position.set(0, 2.12, 0.3);
        g.add(nose);
        g.position.set(x, 0, z);
        scene.add(g);
      }
      function gifts(x, z) {
        var cols = [0xc0392b, 0x2e86c1, 0x27ae60, 0xf1c40f];
        for (var i = 0; i < 4; i++) {
          var s = 0.5 + rnd() * 0.3;
          var box = new THREE.Mesh(new THREE.BoxGeometry(s, s, s), new THREE.MeshLambertMaterial({ color: cols[i] }));
          box.position.set(x + (i % 2) * 0.6, s / 2, z + Math.floor(i / 2) * 0.6);
          box.castShadow = true;
          scene.add(box);
          var ribbon = new THREE.Mesh(new THREE.BoxGeometry(s + 0.04, s + 0.04, 0.12), new THREE.MeshBasicMaterial({ color: 0xffe066 }));
          ribbon.position.copy(box.position);
          scene.add(ribbon);
        }
      }

      // Lay out the village.
      centreTree(size / 2, size / 2);
      lamp(size / 2 - 2.2, size / 2 - 2.2);
      lamp(size / 2 + 2.2, size / 2 - 2.2);
      lamp(size / 2 - 2.2, size / 2 + 2.2);
      lamp(size / 2 + 2.2, size / 2 + 2.2);
      var houses = [
        [6, 6, 3, 2.4, 0.2], [6, 12, 2.6, 2.6, -0.1], [6, 22, 3, 2.4, 0.3],
        [22, 16, 3.2, 2.6, -0.3], [22, 24, 2.6, 2.4, 0.1], [14, 24, 2.4, 2.2, 0.4],
        [24, 4, 2.6, 2.4, -0.2], [13, 5, 2.4, 2.2, 0.0]
      ];
      houses.forEach(function (h) { house(h[0], h[1], h[2], h[3], h[4]); });
      [[3, 3], [3, 27], [27, 27], [27, 3], [10, 20], [18, 22], [26, 12], [4, 16], [16, 3], [9, 27]].forEach(function (p) {
        pine(p[0], p[1], 0.9 + rnd() * 0.5);
      });
      snowman(18, 14);
      gifts(9, 16);
      gifts(20, 20);

      // Falling snow.
      var FLAKES = 900;
      var positions = new Float32Array(FLAKES * 3);
      var speeds = new Float32Array(FLAKES);
      for (var f = 0; f < FLAKES; f++) {
        positions[f * 3] = rnd() * size;
        positions[f * 3 + 1] = rnd() * 22;
        positions[f * 3 + 2] = rnd() * size;
        speeds[f] = 0.6 + rnd() * 0.8;
      }
      var flakeGeo = new THREE.BufferGeometry();
      flakeGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      var flakes = new THREE.Points(flakeGeo, new THREE.PointsMaterial({ color: 0xffffff, size: 0.14, transparent: true, opacity: 0.85, depthWrite: false }));
      scene.add(flakes);

      // Stars.
      var starPos = new Float32Array(200 * 3);
      for (var s2 = 0; s2 < 200; s2++) {
        starPos[s2 * 3] = (rnd() - 0.5) * 220;
        starPos[s2 * 3 + 1] = 40 + rnd() * 60;
        starPos[s2 * 3 + 2] = (rnd() - 0.5) * 220;
      }
      var starGeo = new THREE.BufferGeometry();
      starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
      scene.add(new THREE.Points(starGeo, new THREE.PointsMaterial({ color: 0xfff6d5, size: 0.5 })));

      count.textContent = 'a quiet village in the snow · ' + houses.length + ' houses · a town tree';

      // Left-drag turns and tilts. Right-drag, shift-drag, two-finger drag or the
      // arrow keys move across the village. Scroll zooms.
      var drag = null;
      var touches = {};
      var keys = {};
      var BOUND = -8;
      var BOUND_MAX = size + 8;
      renderer.domElement.addEventListener('contextmenu', function (e) { e.preventDefault(); });
      function panBy(dx, dz) {
        target.x = Math.max(BOUND, Math.min(BOUND_MAX, target.x + dx));
        target.z = Math.max(BOUND, Math.min(BOUND_MAX, target.z + dz));
      }
      // Moves in the direction the camera is facing, so arrows feel natural at any yaw.
      function panScreen(right, forward) {
        var rx = Math.cos(yaw), rz = -Math.sin(yaw);
        var fx = -Math.sin(yaw), fz = -Math.cos(yaw);
        panBy(rx * right + fx * forward, rz * right + fz * forward);
      }
      renderer.domElement.addEventListener('pointerdown', function (e) {
        touches[e.pointerId] = { x: e.clientX, y: e.clientY };
        var pan = e.button === 2 || e.shiftKey || (e.pointerType === 'touch' && activePointers() > 1);
        drag = { x: e.clientX, y: e.clientY, yaw: yaw, pitch: pitch, pan: pan };
        renderer.domElement.setPointerCapture(e.pointerId);
      });
      function activePointers() { return Object.keys(touches).length; }
      renderer.domElement.addEventListener('pointermove', function (e) {
        if (touches[e.pointerId]) touches[e.pointerId] = { x: e.clientX, y: e.clientY };
        if (!drag) return;
        if (drag.pan) {
          var k = dist * 0.0022;
          panScreen(-(e.clientX - drag.x) * k, (e.clientY - drag.y) * k);
          drag.x = e.clientX; drag.y = e.clientY;
        } else {
          yaw = drag.yaw - (e.clientX - drag.x) * 0.008;
          pitch = drag.pitch + (e.clientY - drag.y) * 0.004;
        }
        placeCamera();
      });
      function endDrag(e) { delete touches[e.pointerId]; drag = null; }
      renderer.domElement.addEventListener('pointerup', endDrag);
      renderer.domElement.addEventListener('pointercancel', endDrag);
      renderer.domElement.addEventListener('wheel', function (e) {
        e.preventDefault();
        dist = Math.max(14, Math.min(80, dist * (1 + e.deltaY * 0.001)));
        placeCamera();
      }, { passive: false });
      window.addEventListener('keydown', function (e) {
        if (/^(Arrow(Up|Down|Left|Right))$/.test(e.key)) { keys[e.key] = true; e.preventDefault(); }
      });
      window.addEventListener('keyup', function (e) { delete keys[e.key]; });
      window.addEventListener('blur', function () { keys = {}; });

      function resize() {
        var w = host.clientWidth, h = host.clientHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
      window.addEventListener('resize', resize);
      resize();
      placeCamera();

      // Read-only view of the camera, for tests.
      window.villageView = { get target() { return { x: target.x, z: target.z }; }, get dist() { return dist; } };
      var t0 = performance.now();
      renderer.setAnimationLoop(function () {
        var t = (performance.now() - t0) / 1000;
        var pos = flakeGeo.attributes.position.array;
        for (var i = 0; i < FLAKES; i++) {
          pos[i * 3 + 1] -= speeds[i] * 0.02;
          pos[i * 3] += Math.sin(t + i) * 0.003;
          if (pos[i * 3 + 1] < 0) { pos[i * 3 + 1] = 22; pos[i * 3] = Math.random() * size; pos[i * 3 + 2] = Math.random() * size; }
        }
        flakeGeo.attributes.position.needsUpdate = true;
        var step = dist * 0.012;
        var right = (keys.ArrowRight ? 1 : 0) - (keys.ArrowLeft ? 1 : 0);
        var forward = (keys.ArrowUp ? 1 : 0) - (keys.ArrowDown ? 1 : 0);
        if (right || forward) { panScreen(right * step, forward * step); placeCamera(); }
        renderer.render(scene, camera);
      });
    })();
  </script>
</body>
</html>
