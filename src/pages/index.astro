  <!-- Home theme music, Now Playing / playlist, and Inventory -->
  <script is:inline>
    (() => {
      // Hardcoded — the homepage default track is never looked up from
      // MUSIC_LIBRARY or localStorage. A stale cached music-library.js or a
      // leftover localStorage key must never be able to change what plays
      // by default here. Only an explicit, current-session playlist click
      // (handled below) can switch it to something else.
      const HOME_THEME = { label: 'Home Theme', src: '/audio/music/home-theme.mp3' };

      // Kept separate from other pages on purpose — each page's music/bg
      // choice is independent (a prior attempt to unify these caused a
      // worse bug: cloud-sync's debounced push could lose your choice
      // entirely if you navigated away within ~1s, so returning to a page
      // would silently revert to a stale value).
      const ACTIVE_TRACK_KEY = 'home_active_track_v1';
      const INV_KEY = 'strubles_inventory_v1';
      const LIBRARY = Object.assign({}, window.MUSIC_LIBRARY, { default: HOME_THEME });

      function loadInventory() {
        try {
          const v = localStorage.getItem(INV_KEY);
          return v ? JSON.parse(v) : {};
        } catch { return {}; }
      }

      function getActiveTrackKey() {
        const key = localStorage.getItem(ACTIVE_TRACK_KEY);
        return (key && key !== 'default' && LIBRARY[key]) ? key : 'default';
      }

      let audioEnabled = true;
      const themeMusic = document.getElementById('theme-music');
      const npEyebrow = document.getElementById('np-eyebrow');
      const npLabel = document.getElementById('np-label');
      const nowPlayingBtn = document.getElementById('now-playing');
      const modalMuteBtn = document.getElementById('modal-mute-btn');
      const volumeSlider = document.getElementById('volume-slider');

      // Shared across every page (home/blackjack/lootbox) so the volume level
      // — not the track, each page has its own — carries over between them.
      const VOLUME_KEY = 'music_volume_v1';
      const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
      themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.3;
      volumeSlider.value = Math.round(themeMusic.volume * 100);
      volumeSlider.addEventListener('input', () => {
        themeMusic.volume = volumeSlider.value / 100;
        localStorage.setItem(VOLUME_KEY, themeMusic.volume);
      });
      window.addEventListener('storage', (e) => {
        if (e.key === VOLUME_KEY && e.newValue != null) {
          themeMusic.volume = parseFloat(e.newValue);
          volumeSlider.value = Math.round(themeMusic.volume * 100);
        }
      });

      // Force the hardcoded default on every load, ignoring whatever is in
      // the <audio> tag's src attribute or any library lookup.
      themeMusic.src = HOME_THEME.src;
      npLabel.textContent = HOME_THEME.label;

      let activeTrackKey = getActiveTrackKey();

      const MUSIC_POS_KEY = 'home_theme_pos_v1';

      function applyActiveTrack(restart) {
        const track = activeTrackKey === 'default' ? HOME_THEME : (LIBRARY[activeTrackKey] || HOME_THEME);
        themeMusic.src = track.src;
        npLabel.textContent = track.label;
        if (restart) {
          themeMusic.currentTime = 0;
          tryPlayTheme();
        } else if (window.MusicPosition) {
          // Page load (not a manual track switch): resume where this track left off.
          window.MusicPosition.restore(MUSIC_POS_KEY, themeMusic);
        }
      }
      applyActiveTrack(false);
      if (window.MusicPosition) window.MusicPosition.track(MUSIC_POS_KEY, themeMusic);

      function tryPlayTheme() {
        if (!audioEnabled) return;
        themeMusic.play().catch(() => {});
      }
      tryPlayTheme();
      const unlockTheme = () => {
        tryPlayTheme();
        window.removeEventListener('pointerdown', unlockTheme);
        window.removeEventListener('keydown', unlockTheme);
      };
      window.addEventListener('pointerdown', unlockTheme);
      window.addEventListener('keydown', unlockTheme);

      modalMuteBtn.addEventListener('click', () => {
        audioEnabled = !audioEnabled;
        const icon = audioEnabled ? '🔊' : '🔇';
        modalMuteBtn.textContent = icon;
        npEyebrow.textContent = `${icon} Now Playing`;
        if (audioEnabled) tryPlayTheme();
        else themeMusic.pause();
      });

      // --- Playlist popup ---
      const playlistOverlay = document.getElementById('playlist-overlay');
      const playlistList = document.getElementById('playlist-list');
      const playlistClose = document.getElementById('playlist-close');

      function renderPlaylist() {
        const inv = loadInventory();
        const unlockedTracks = Array.isArray(inv.tracks) ? inv.tracks : [];
        let html = '';
        html += playlistRow('default', LIBRARY.default.label);
        if (unlockedTracks.length === 0) {
          html += '<div class="modal-empty">No extra tracks unlocked yet — try the Lootbox!</div>';
        } else {
          unlockedTracks.forEach((key) => {
            if (!LIBRARY[key]) return;
            html += playlistRow(key, LIBRARY[key].label);
          });
        }
        playlistList.innerHTML = html;
        playlistList.querySelectorAll('.modal-track').forEach((row) => {
          row.addEventListener('click', () => {
            activeTrackKey = row.dataset.key;
            localStorage.setItem(ACTIVE_TRACK_KEY, activeTrackKey);
            applyActiveTrack(true);
            playlistOverlay.classList.remove('open');
            renderPlaylist();
          });
        });
      }
      function playlistRow(key, label) {
        const activeClass = key === activeTrackKey ? ' active' : '';
        return `<div class="modal-track${activeClass}" data-key="${key}"><span>${label}</span>${key === activeTrackKey ? '<span>▶</span>' : ''}</div>`;
      }

      nowPlayingBtn.addEventListener('click', () => {
        renderPlaylist();
        playlistOverlay.classList.add('open');
      });
      playlistClose.addEventListener('click', () => playlistOverlay.classList.remove('open'));
      playlistOverlay.addEventListener('click', (e) => {
        if (e.target === playlistOverlay) playlistOverlay.classList.remove('open');
      });

      // --- Inventory button: navigates to the dedicated Inventory Room page
      // (shelf display + full categorized list) instead of opening a local
      // modal — kept as the same chest icon/drag target it always was, since
      // dragging an item near it to stash still works independently of what
      // a plain click does.
      const invBtn = document.getElementById('inv-btn');
      invBtn.addEventListener('click', () => { window.location.href = '/inventory'; });

      // --- Movable desktop items (sock, panda, ...) ---
      if (window.DesktopItems) window.DesktopItems.init(document.getElementById('desktop-items'), invBtn);

      const CURSOR_LIB = window.CURSOR_LIBRARY || {};

      // --- Account (Google Sign-In + progress sync) ---
      const accountBtn = document.getElementById('account-btn');
      const accountOverlay = document.getElementById('account-overlay');
      const accountClose = document.getElementById('account-close');
      const accountSignedOut = document.getElementById('account-signed-out');
      const accountSignedIn = document.getElementById('account-signed-in');
      const accountSigninBtn = document.getElementById('account-signin-btn');
      const accountSignoutBtn = document.getElementById('account-signout-btn');

      const GOOGLE_LOGO = '/assets/icons/google-logo.png';
      const accountBtnIcon = document.getElementById('account-btn-icon');
      const accountBtnLabel = document.getElementById('account-btn-label');

      // Google's photo CDN (lh3.googleusercontent.com) frequently fails to
      // load unless the request is sent with no referrer, and can still
      // occasionally 404 for a given account — fall back to the Google
      // logo rather than showing a broken image icon either way.
      function setAvatarSrc(imgEl, url) {
        imgEl.referrerPolicy = 'no-referrer';
        imgEl.onerror = () => { imgEl.onerror = null; imgEl.src = GOOGLE_LOGO; };
        imgEl.src = url || GOOGLE_LOGO;
      }

      function renderAccountState() {
        const user = window.CloudSync && window.CloudSync.currentUser;
        if (user) {
          setAvatarSrc(accountBtnIcon, user.photoURL);
          accountBtnLabel.textContent = user.displayName || user.email || 'Account';
          accountSignedOut.style.display = 'none';
          accountSignedIn.style.display = 'block';
          setAvatarSrc(document.getElementById('account-avatar'), user.photoURL);
          document.getElementById('account-name').textContent = user.displayName || '';
          document.getElementById('account-email').textContent = user.email || '';
        } else {
          accountBtnIcon.onerror = null;
          accountBtnIcon.src = GOOGLE_LOGO;
          accountBtnLabel.textContent = 'Sign In';
          accountSignedOut.style.display = 'block';
          accountSignedIn.style.display = 'none';
        }
      }
      window.addEventListener('cloudsync:authchanged', renderAccountState);
      renderAccountState();

      accountBtn.addEventListener('click', () => {
        renderAccountState();
        accountOverlay.classList.add('open');
      });
      accountClose.addEventListener('click', () => accountOverlay.classList.remove('open'));
      accountOverlay.addEventListener('click', (e) => {
        if (e.target === accountOverlay) accountOverlay.classList.remove('open');
      });
      accountSigninBtn.addEventListener('click', () => {
        window.CloudSync.signIn().catch((err) => console.error('[account] sign-in failed:', err));
      });
      accountSignoutBtn.addEventListener('click', () => {
        window.CloudSync.signOut().then(() => accountOverlay.classList.remove('open'));
      });

      // --- Background switcher ---
      // Kept separate from other pages on purpose — see the note on
      // ACTIVE_TRACK_KEY above for why.
      const ACTIVE_BG_KEY = 'home_active_bg_v1';
      const BG_LIBRARY = window.BACKGROUND_LIBRARY || { default: { label: 'Taipei', type: 'gif', src: '/video/taipei.gif', position: 'center' } };
      const bgBtn = document.getElementById('bg-btn');
      const bgVideo = document.getElementById('bg-video');
      const backgroundOverlay = document.getElementById('background-overlay');
      const backgroundList = document.getElementById('background-list');
      const backgroundClose = document.getElementById('background-close');

      let activeBgKey = 'default';
      function getActiveBgKey() {
        const key = localStorage.getItem(ACTIVE_BG_KEY);
        return (key && BG_LIBRARY[key]) ? key : 'default';
      }
      // Backgrounds that swap Now Playing to a matching track the moment
      // they're selected — a combo, not a separate unlock. Keyed the same
      // in both libraries on purpose (see music-library.js).
      const BACKGROUND_MUSIC_COMBOS = ['bladee_waster', 'evian_yxguden'];

      function applyBackground(key) {
        const bg = BG_LIBRARY[key] || BG_LIBRARY.default;
        activeBgKey = key;
        if (bg.type === 'video') {
          document.body.style.backgroundImage = 'none';
          bgVideo.src = bg.src;
          bgVideo.classList.add('show');
          bgVideo.play().catch(() => {});
        } else {
          bgVideo.classList.remove('show');
          bgVideo.pause();
          bgVideo.removeAttribute('src');
          document.body.style.backgroundImage = `url('${bg.src}')`;
          document.body.style.backgroundPosition = bg.position || 'center';
        }

        if (BACKGROUND_MUSIC_COMBOS.includes(key) && LIBRARY[key]) {
          activeTrackKey = key;
          localStorage.setItem(ACTIVE_TRACK_KEY, activeTrackKey);
          applyActiveTrack(true);
        }
      }
      applyBackground(getActiveBgKey());

      function renderBackgroundList() {
        const inv = loadInventory();
        const unlocked = Array.isArray(inv.backgrounds) ? inv.backgrounds : [];
        let html = bgRow('default', BG_LIBRARY.default.label);
        if (unlocked.length === 0) {
          html += '<div class="modal-empty">No extra backgrounds unlocked yet — try the Lootbox!</div>';
        } else {
          unlocked.forEach((key) => {
            if (!BG_LIBRARY[key]) return;
            html += bgRow(key, BG_LIBRARY[key].label);
          });
        }
        backgroundList.innerHTML = html;
        backgroundList.querySelectorAll('.modal-track').forEach((row) => {
          row.addEventListener('click', () => {
            const key = row.dataset.key;
            localStorage.setItem(ACTIVE_BG_KEY, key);
            applyBackground(key);
            backgroundOverlay.classList.remove('open');
            renderBackgroundList();
          });
        });
      }
      function bgRow(key, label) {
        const activeClass = key === activeBgKey ? ' active' : '';
        return `<div class="modal-track${activeClass}" data-key="${key}"><span>${label}</span>${key === activeBgKey ? '<span>▶</span>' : ''}</div>`;
      }

      bgBtn.addEventListener('click', () => {
        renderBackgroundList();
        backgroundOverlay.classList.add('open');
      });
      backgroundClose.addEventListener('click', () => backgroundOverlay.classList.remove('open'));
      backgroundOverlay.addEventListener('click', (e) => {
        if (e.target === backgroundOverlay) backgroundOverlay.classList.remove('open');
      });

      // --- Cursor picker ---
      // Writes the active key, then fires 'cursor:changed'; cursor.js listens
      // and re-skins its canvas live, so the swap is visible without a reload.
      const ACTIVE_CURSOR_KEY = 'active_cursor_v1';
      const cursorBtn = document.getElementById('cursor-btn');
      const cursorOverlay = document.getElementById('cursor-overlay');
      const cursorList = document.getElementById('cursor-list');
      const cursorClose = document.getElementById('cursor-close');

      function getActiveCursorKey() {
        const key = localStorage.getItem(ACTIVE_CURSOR_KEY);
        return (key && CURSOR_LIB[key]) ? key : 'default';
      }

      function cursorSwatch(entry) {
        return entry.emoji
          ? `<span class="cursor-swatch">${entry.emoji}</span>`
          : `<span class="cursor-swatch"><img src="${entry.point}" alt=""></span>`;
      }

      function renderCursorList() {
        const active = getActiveCursorKey();
        const unlocked = (loadInventory().cursors || []).filter((k) => CURSOR_LIB[k]);
        const keys = ['default', ...unlocked];

        cursorList.innerHTML = keys.map((key) => {
          const entry = CURSOR_LIB[key];
          const isActive = key === active;
          return `<div class="modal-track${isActive ? ' active' : ''}" data-key="${key}">
            <span>${cursorSwatch(entry)}${entry.label}</span>${isActive ? '<span>▶</span>' : ''}
          </div>`;
        }).join('') + (unlocked.length === 0
          ? '<div class="modal-empty">No extra cursors unlocked yet — try a case!</div>'
          : '');

        cursorList.querySelectorAll('.modal-track').forEach((row) => {
          row.addEventListener('click', () => {
            localStorage.setItem(ACTIVE_CURSOR_KEY, row.dataset.key);
            window.dispatchEvent(new CustomEvent('cursor:changed'));
            cursorOverlay.classList.remove('open');
            renderCursorList();
          });
        });
      }

      cursorBtn.addEventListener('click', () => {
        renderCursorList();
        cursorOverlay.classList.add('open');
      });
      cursorClose.addEventListener('click', () => cursorOverlay.classList.remove('open'));
      cursorOverlay.addEventListener('click', (e) => {
        if (e.target === cursorOverlay) cursorOverlay.classList.remove('open');
      });

      // --- Alternate Ending reveal ---
      // The link stays hidden until it's actually pulled from a case, so the
      // gold drop is what makes it appear rather than it always being there.
      const UNLOCKS_KEY = 'strubles_unlocks_v1';
      const endingLink = document.getElementById('ending-link');
      function syncEndingLink() {
        let pages = [];
        try {
          const u = JSON.parse(localStorage.getItem(UNLOCKS_KEY) || '{}');
          if (Array.isArray(u.pages)) pages = u.pages;
        } catch {}
        endingLink.hidden = !pages.includes('/alternate-ending');
      }
      syncEndingLink();
      window.addEventListener('storage', syncEndingLink);

      // Escape closes whichever modal is currently open
      window.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        [playlistOverlay, backgroundOverlay, cursorOverlay].forEach((overlay) => {
          overlay.classList.remove('open');
        });
      });
    })();
  </script>

</body>
</html>
