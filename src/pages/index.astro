<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Glorious Iantopia</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <!--
    is:global is REQUIRED. Astro scopes <style> by stamping data-astro-cid-* on
    template elements and rewriting selectors to match. The modal rows here
    (.modal-track, .modal-item, .inv-category, .cursor-swatch) are all built at
    runtime via innerHTML, so they never get that attribute and every scoped
    rule silently skips them — the playlist, inventory, background and cursor
    pickers all render as unstyled text. This is a standalone document, so
    scoping buys nothing.
  -->
  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    @keyframes titleGlow {
      0%, 100% {
        text-shadow: 0 0 10px rgba(255, 235, 59, 0.3), 0 0 20px rgba(255, 152, 86, 0.2);
      }
      50% {
        text-shadow: 0 0 20px rgba(255, 235, 59, 0.6), 0 0 40px rgba(255, 152, 86, 0.4), 0 0 60px rgba(255, 196, 0, 0.2);
      }
    }

    @keyframes titleScale {
      0% { transform: scale(0.95); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background-image: url('/video/taipei.gif');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      color: #ffffff;
      position: relative;
      overflow: hidden;
    }

    @media (max-width: 768px) {
      body {
        background-attachment: scroll;
      }
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.3);
      pointer-events: none;
      z-index: 0;
    }

    body > * {
      position: relative;
      z-index: 1;
    }


    @keyframes bob {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    .image-container {
      position: relative;
      perspective: 1000px;
      animation: bob 3s ease-in-out infinite;
      width: min(202px, 85vw);
      aspect-ratio: 629 / 839;
      margin-bottom: 20px;
    }

    .flip-card {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      filter: drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4));
    }
    .image-container:focus-visible {
      outline: 3px solid #ffeb3b;
      outline-offset: 6px;
      border-radius: 8px;
    }

    .flip-card-front,
    .flip-card-back {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .flip-card-back {
      transform: rotateY(180deg);
    }

    .flip-card img {
      max-width: 100%;
      height: 100%;
      object-fit: cover;
      box-shadow: 0 0 40px rgba(255, 235, 59, 0.5), 0 0 80px rgba(255, 152, 86, 0.3), inset 0 0 30px rgba(255, 235, 59, 0.2);
      border-radius: 8px;
    }

    h1 {
      font-family: 'Press Start 2P', cursive;
      font-size: clamp(1.2rem, 5vw, 2.5rem);
      font-weight: 400;
      margin: 20px 0 10px 0;
      color: #ffffff;
      letter-spacing: 2px;
      animation: titleScale 0.8s ease-out, titleGlow 3s ease-in-out infinite 0.8s;
      text-align: center;
      text-transform: uppercase;
    }

    a.big,
    button.big {
      text-decoration: none;
      padding: 18px 26px;
      border-radius: 0;
      background: #1d2330;
      border: 1px solid #2a3245;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      font-size: clamp(20px, 4vw, 34px);
      letter-spacing: 0.3px;
      color: #ffffff;
      cursor: none;
      transition: transform 0.2s;
      display: block;
      margin: 16px auto;
    }

    a.big:hover,
    button.big:hover {
      transform: translateY(-1px);
    }

    /* Neon sign buttons */
    a.big.neon-yt {
      background: #200000;
      border: 2px solid #ff1a1a;
      color: #ffffff;
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff, 0 0 20px rgba(255, 255, 255, 0.6);
      box-shadow: 0 0 6px #ff1a1a, 0 0 16px #ff1a1a, 0 0 32px rgba(255, 26, 26, 0.5), inset 0 0 10px rgba(255, 26, 26, 0.2);
      text-transform: uppercase;
    }
    a.big.neon-yt:hover {
      text-shadow: 0 0 6px #ffffff, 0 0 14px #ffffff, 0 0 28px rgba(255, 255, 255, 0.7);
      box-shadow: 0 0 10px #ff1a1a, 0 0 24px #ff1a1a, 0 0 48px rgba(255, 26, 26, 0.6), inset 0 0 14px rgba(255, 26, 26, 0.3);
    }

