  <!-- Timer Script -->
  <script is:inline>
    const TOPIA_START = new Date(2025, 8, 1, 0, 0, 0);
    function renderTopiaTimer() {
      const now = new Date();
      let months =
        (now.getFullYear() - TOPIA_START.getFullYear()) * 12 +
        (now.getMonth() - TOPIA_START.getMonth());
      let anchor = new Date(TOPIA_START);
      anchor.setMonth(TOPIA_START.getMonth() + months);
      if (anchor > now) {
        months--;
        anchor.setMonth(TOPIA_START.getMonth() + months);
      }

      let ms = now - anchor;
      const DAY = 86400000,
        HOUR = 3600000,
        MIN = 60000;
      const days = Math.floor(ms / DAY);
      ms %= DAY;
      const hours = Math.floor(ms / HOUR);
      ms %= HOUR;
      const minutes = Math.floor(ms / MIN);
      ms %= MIN;
      const seconds = Math.floor(ms / 1000);

      document.getElementById("topia-timer").textContent = `${months} months, ${days} days, ${hours} hours, ${minutes} minutes, ${seconds} seconds`;
    }
    renderTopiaTimer();
    setInterval(renderTopiaTimer, 1000);
  </script>

  <!-- Strubles -->
  <script is:inline src="/tycoon-cap.js?v=1"></script>
  <script is:inline src="/tycoon-bank.js?v=2"></script>
  <script is:inline src="/strubles.js?v=3"></script>

  <!-- Earn UI wiring -->
  <script is:inline>
    (function () {
      if (typeof Strubles !== "object") return;

      const amtEl = document.getElementById("strubles-amt");
      const dailyBtn = document.getElementById("btn-daily");

      const todayUTC = () => {
        const d = new Date();
        return `${d.getUTCFullYear()}-${d.getUTCMonth() + 1}-${d.getUTCDate()}`;
      };

      function updateUI() {
        amtEl.textContent = Strubles.get();
        if (dailyBtn) dailyBtn.disabled = !Strubles.canDailyClaim();
      }

      // --- Daily reel: same tier-first weighted-roll shape as the case
      // system, just five fixed payouts instead of a full item pool.
      // Floor 500, ceiling 5000, each step up rarer than the last. Moved
      // here from blackjack — the daily claim should be reachable from the
      // hub page, not tucked inside one specific minigame.
      const DAILY_TIERS = [
        { amt: 500,  weight: 50, tier: 'mil_spec',        label: 'Mil-Spec',         color: '#4b69ff' },
        { amt: 1000, weight: 27, tier: 'restricted',       label: 'Restricted',       color: '#8847ff' },
        { amt: 2000, weight: 15, tier: 'classified',       label: 'Classified',       color: '#d32ce6' },
        { amt: 3500, weight: 6,  tier: 'covert',           label: 'Covert',           color: '#eb4b4b' },
        { amt: 5000, weight: 2,  tier: 'exceedingly_rare', label: 'Exceedingly Rare', color: '#ffd700' },
      ];
      const DAILY_WEIGHT_TOTAL = DAILY_TIERS.reduce((s, t) => s + t.weight, 0);

      function pickDailyTier() {
        let r = Math.random() * DAILY_WEIGHT_TOTAL;
        for (const t of DAILY_TIERS) {
          r -= t.weight;
          if (r <= 0) return t;
        }
        return DAILY_TIERS[0];
      }

      const dailyReelOverlay = document.getElementById('daily-reel-overlay');
      const dailyReelViewport = document.getElementById('daily-reel-viewport');
      const dailyReelStrip = document.getElementById('daily-reel-strip');
      const dailyWinAmt = document.getElementById('daily-win-amt');
      const dailyWinTier = document.getElementById('daily-win-tier');
      const dailyReelClose = document.getElementById('daily-reel-close');

      function buildDailyTile(t) {
        const el = document.createElement('div');
        el.className = 'daily-tile' + (t.tier === 'exceedingly_rare' ? ' gold' : '');
        el.style.setProperty('--tier-c', t.color);
        el.innerHTML = `<img src="/strubles.png" alt="Struble" /><span class="amt">+${t.amt.toLocaleString()}</span>`;
        return el;
      }

      function playDailyReel(winner) {
        const FILLER_COUNT = 26;
        const WINNER_INDEX = 22;

        dailyReelStrip.innerHTML = '';
        dailyReelStrip.style.transition = 'none';
        dailyReelStrip.style.transform = 'translateX(0px)';
        for (let i = 0; i < FILLER_COUNT; i++) {
          dailyReelStrip.appendChild(buildDailyTile(i === WINNER_INDEX ? winner : pickDailyTier()));
        }
        void dailyReelStrip.offsetWidth; // force reflow so the reset above isn't coalesced

        requestAnimationFrame(() => {
          const tiles = dailyReelStrip.children;
          const step = tiles[1].offsetLeft - tiles[0].offsetLeft;
          const tileW = tiles[0].offsetWidth;
          const centre = dailyReelViewport.clientWidth / 2;
          const jitter = (Math.random() - 0.5) * tileW * 0.4;
          const target = -(WINNER_INDEX * step + tileW / 2 - centre + jitter);

          const DURATION = 3400;
          dailyReelStrip.style.transition = `transform ${DURATION}ms cubic-bezier(.14,.7,.16,1)`;
          dailyReelStrip.style.transform = `translateX(${target}px)`;

          let settled = false;
          const finish = (e) => {
            if (e && (e.target !== dailyReelStrip || e.propertyName !== 'transform')) return;
            if (settled) return;
            settled = true;
            dailyReelStrip.removeEventListener('transitionend', finish);
            revealDailyResult(winner);
          };
          dailyReelStrip.addEventListener('transitionend', finish);
          setTimeout(finish, DURATION + 300); // fallback if transitionend never fires
        });
      }

      function revealDailyResult(winner) {
        dailyWinAmt.textContent = `+${winner.amt.toLocaleString()} Strubles`;
        dailyWinAmt.style.color = winner.color;
        dailyWinTier.textContent = winner.label;
        dailyWinTier.style.color = winner.color;
        dailyWinAmt.classList.add('show');
        dailyWinTier.classList.add('show');
        dailyReelClose.classList.add('show');

        updateUI();
      }

      if (dailyReelClose) {
        dailyReelClose.addEventListener('click', () => {
          dailyReelOverlay.classList.remove('open');
        });
      }

      if (dailyBtn) {
        dailyBtn.addEventListener("click", () => {
          if (!Strubles.canDailyClaim()) return;
          dailyBtn.disabled = true;
          dailyWinAmt.classList.remove('show');
          dailyWinTier.classList.remove('show');
          dailyReelClose.classList.remove('show');
          dailyReelOverlay.classList.add('open');
          // The server rolls the prize and records the day's claim. The reel
          // plays the tier it returns, so the browser can't choose a bigger one.
          Strubles.dailyClaim((amount) => {
            const winner = DAILY_TIERS.find((t) => t.amt === amount);
            if (!winner) {
              dailyReelOverlay.classList.remove('open');
              dailyBtn.disabled = !Strubles.canDailyClaim();
              updateUI();
              return;
            }
            requestAnimationFrame(() => playDailyReel(winner));
          });
        });
      }

      window.addEventListener("strubles:change", updateUI);
      updateUI();
    })();
  </script>

  <!-- Custom Cursor Implementation (Canvas-based, shared across pages) -->
  <script is:inline src="/cursor.js?v=3"></script>

  <!-- Home theme music, Now Playing / playlist, and Inventory -->
  <script is:inline>
    (() => {
      // Hardcoded — the homepage default track is never looked up from
      // MUSIC_LIBRARY or localStorage. A stale cached music-library.js or a
      // leftover localStorage key must never be able to change what plays
      // by default here. Only an explicit, current-session playlist click
      // (handled below) can switch it to something else.
      const HOME_THEME = { label: 'Home Theme', src: '/audio/music/home-theme.mp3' };
      // Seasonal default, hardcoded for the same reason HOME_THEME is: must
      // never depend on a possibly-stale music-library.js. Resolved by
      // isHalloweenSeason() below, same no-persistent-write pattern as
      // getActiveBgKey() -- November 1st reverts to HOME_THEME with nothing
      // in localStorage to clean up.
      const HALLOWEEN_THEME = { label: '🎃 Ghost House', src: '/audio/music/ghost-house.mp3' };
      // isHalloweenSeason() itself is defined once, right after <body> opens.

      // Kept separate from other pages on purpose — each page's music/bg
      // choice is independent (a prior attempt to unify these caused a
      // worse bug: cloud-sync's debounced push could lose your choice
      // entirely if you navigated away within ~1s, so returning to a page
      // would silently revert to a stale value).
      const ACTIVE_TRACK_KEY = 'home_active_track_v1';
      const INV_KEY = 'strubles_inventory_v1';
      const LIBRARY = Object.assign({}, window.MUSIC_LIBRARY, { default: HOME_THEME, halloween: HALLOWEEN_THEME });

      function loadInventory() {
        try {
          const v = localStorage.getItem(INV_KEY);
          return v ? JSON.parse(v) : {};
        } catch { return {}; }
      }

      function getActiveTrackKey() {
        const key = localStorage.getItem(ACTIVE_TRACK_KEY);
        if (key && key !== 'default' && LIBRARY[key]) return key;
        // No explicit pick saved: Ghost House for all of October, Home
        // Theme otherwise -- resolved fresh on every load, nothing written
        // to localStorage, so this never needs manually turning off.
        return window.isHalloweenSeason() ? 'halloween' : 'default';
      }

      let audioEnabled = true;
      const themeMusic = document.getElementById('theme-music');
      const npEyebrow = document.getElementById('np-eyebrow');
      const npLabel = document.getElementById('np-label');
      const nowPlayingBtn = document.getElementById('now-playing');
      const modalMuteBtn = document.getElementById('modal-mute-btn');
      const volumeSlider = document.getElementById('volume-slider');

      // Shared across every page (home/blackjack/lootbox) so the volume level
      // — not the track, each page has its own — carries over between them.
      const VOLUME_KEY = 'music_volume_v1';
      const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
      themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.3;
      volumeSlider.value = Math.round(themeMusic.volume * 100);
      volumeSlider.addEventListener('input', () => {
        themeMusic.volume = volumeSlider.value / 100;
        localStorage.setItem(VOLUME_KEY, themeMusic.volume);
      });
      window.addEventListener('storage', (e) => {
        if (e.key === VOLUME_KEY && e.newValue != null) {
          themeMusic.volume = parseFloat(e.newValue);
          volumeSlider.value = Math.round(themeMusic.volume * 100);
        }
      });

      // Force the hardcoded default on every load, ignoring whatever is in
      // the <audio> tag's src attribute or any library lookup.
      themeMusic.src = HOME_THEME.src;
      npLabel.textContent = HOME_THEME.label;

      let activeTrackKey = getActiveTrackKey();

      const MUSIC_POS_KEY = 'home_theme_pos_v1';

      function applyActiveTrack(restart) {
        const track = activeTrackKey === 'default' ? HOME_THEME : (LIBRARY[activeTrackKey] || HOME_THEME);
        themeMusic.src = track.src;
        npLabel.textContent = track.label;
        if (restart) {
          themeMusic.currentTime = 0;
          tryPlayTheme();
        } else if (window.MusicPosition) {
          // Page load (not a manual track switch): resume where this track left off.
          window.MusicPosition.restore(MUSIC_POS_KEY, themeMusic);
        }
      }
      applyActiveTrack(false);
      if (window.MusicPosition) window.MusicPosition.track(MUSIC_POS_KEY, themeMusic);

      function tryPlayTheme() {
        if (!audioEnabled) return;
        themeMusic.play().catch(() => {});
      }
      tryPlayTheme();
      const unlockTheme = () => {
        tryPlayTheme();
        window.removeEventListener('pointerdown', unlockTheme);
        window.removeEventListener('keydown', unlockTheme);
      };
      window.addEventListener('pointerdown', unlockTheme);
      window.addEventListener('keydown', unlockTheme);

      modalMuteBtn.addEventListener('click', () => {
        audioEnabled = !audioEnabled;
        const icon = audioEnabled ? '🔊' : '🔇';
        modalMuteBtn.textContent = icon;
        npEyebrow.textContent = `${icon} Now Playing`;
        if (audioEnabled) tryPlayTheme();
        else themeMusic.pause();
      });

      // --- Playlist popup ---
      const playlistOverlay = document.getElementById('playlist-overlay');
      const playlistList = document.getElementById('playlist-list');
      const playlistClose = document.getElementById('playlist-close');

      function renderPlaylist() {
        const inv = loadInventory();
        const unlockedTracks = Array.isArray(inv.tracks) ? inv.tracks : [];
        let html = '';
        html += playlistRow('default', LIBRARY.default.label);
        if (unlockedTracks.length === 0) {
          html += '<div class="modal-empty">No extra tracks unlocked yet — try the Lootbox!</div>';
        } else {
          unlockedTracks.forEach((key) => {
            if (!LIBRARY[key]) return;
            html += playlistRow(key, LIBRARY[key].label);
          });
        }
        playlistList.innerHTML = html;
        playlistList.querySelectorAll('.modal-track').forEach((row) => {
          row.addEventListener('click', () => {
            activeTrackKey = row.dataset.key;
            localStorage.setItem(ACTIVE_TRACK_KEY, activeTrackKey);
            applyActiveTrack(true);
            playlistOverlay.classList.remove('open');
            renderPlaylist();
            // Previously dispatched nothing — see cloud-sync.js's SYNC_EVENTS.
            window.dispatchEvent(new CustomEvent('active-track:changed', { detail: { key: activeTrackKey } }));
          });
        });
      }
      function playlistRow(key, label) {
        const activeClass = key === activeTrackKey ? ' active' : '';
        return `<div class="modal-track${activeClass}" data-key="${key}"><span>${label}</span>${key === activeTrackKey ? '<span>▶</span>' : ''}</div>`;
      }

      nowPlayingBtn.addEventListener('click', () => {
        renderPlaylist();
        playlistOverlay.classList.add('open');
      });
      playlistClose.addEventListener('click', () => playlistOverlay.classList.remove('open'));
      playlistOverlay.addEventListener('click', (e) => {
        if (e.target === playlistOverlay) playlistOverlay.classList.remove('open');
      });

      // --- Inventory button: navigates to the dedicated Inventory Room page
      // (shelf display + full categorized list + item placement) instead of
      // opening a local modal or rendering items directly on home.
      const invBtn = document.getElementById('inv-btn');
      invBtn.addEventListener('click', () => { window.location.href = '/inventory'; });

      const CURSOR_LIB = window.CURSOR_LIBRARY || {};

      // --- Account (Google Sign-In + progress sync) ---
      const accountBtn = document.getElementById('account-btn');
      const accountOverlay = document.getElementById('account-overlay');
      const accountClose = document.getElementById('account-close');
      const accountSignedOut = document.getElementById('account-signed-out');
      const accountSignedIn = document.getElementById('account-signed-in');
      const accountSigninBtn = document.getElementById('account-signin-btn');
      const accountSignoutBtn = document.getElementById('account-signout-btn');

      const GOOGLE_LOGO = '/assets/icons/google-logo.png';
      const accountBtnIcon = document.getElementById('account-btn-icon');
      const accountBtnLabel = document.getElementById('account-btn-label');

      // Google's photo CDN (lh3.googleusercontent.com) frequently fails to
      // load unless the request is sent with no referrer, and can still
      // occasionally 404 for a given account — fall back to the Google
      // logo rather than showing a broken image icon either way.
      function setAvatarSrc(imgEl, url) {
        imgEl.referrerPolicy = 'no-referrer';
        imgEl.onerror = () => { imgEl.onerror = null; imgEl.src = GOOGLE_LOGO; };
        imgEl.src = url || GOOGLE_LOGO;
      }

      function renderAccountState() {
        const user = window.CloudSync && window.CloudSync.currentUser;
        if (user) {
          setAvatarSrc(accountBtnIcon, user.photoURL);
          accountBtnLabel.textContent = user.displayName || user.email || 'Account';
          accountSignedOut.style.display = 'none';
          accountSignedIn.style.display = 'block';
          setAvatarSrc(document.getElementById('account-avatar'), user.photoURL);
          document.getElementById('account-name').textContent = user.displayName || '';
          document.getElementById('account-email').textContent = user.email || '';
        } else {
          accountBtnIcon.onerror = null;
          accountBtnIcon.src = GOOGLE_LOGO;
          accountBtnLabel.textContent = 'Sign In';
          accountSignedOut.style.display = 'block';
          accountSignedIn.style.display = 'none';
        }
      }
      window.addEventListener('cloudsync:authchanged', renderAccountState);
      renderAccountState();

      accountBtn.addEventListener('click', () => {
        renderAccountState();
        accountOverlay.classList.add('open');
      });
      accountClose.addEventListener('click', () => accountOverlay.classList.remove('open'));
      accountOverlay.addEventListener('click', (e) => {
        if (e.target === accountOverlay) accountOverlay.classList.remove('open');
      });
      accountSigninBtn.addEventListener('click', () => {
        window.CloudSync.signIn().catch((err) => console.error('[account] sign-in failed:', err));
      });
      accountSignoutBtn.addEventListener('click', () => {
        window.CloudSync.signOut().then(() => accountOverlay.classList.remove('open'));
      });

      // --- Patch Notes ---
      // Static, first-party content (window.PATCH_NOTES) -- unlike the
      // news pipeline's esc()-escaped RSS content, this is authored here,
      // not pulled from anywhere untrusted, so it's safe to interpolate
      // directly.
      const patchBtn = document.getElementById('patch-btn');
      const patchOverlay = document.getElementById('patch-overlay');
      const patchClose = document.getElementById('patch-close');
      const patchList = document.getElementById('patch-list');
      function renderPatchNotes() {
        const notes = window.PATCH_NOTES || [];
        patchList.innerHTML = notes.length
          ? notes.map((entry) => `
            <div class="patch-entry">
              <div class="patch-date">${entry.date}</div>
              <div class="patch-title">${entry.title}</div>
              <ul>${(entry.changes || []).map((c) => `<li>${c}</li>`).join('')}</ul>
            </div>
          `).join('')
          : '<p style="color:#888; font-size:12px;">Nothing here yet.</p>';
      }
      patchBtn.addEventListener('click', () => {
        renderPatchNotes();
        patchOverlay.classList.add('open');
      });
      patchClose.addEventListener('click', () => patchOverlay.classList.remove('open'));
      patchOverlay.addEventListener('click', (e) => {
        if (e.target === patchOverlay) patchOverlay.classList.remove('open');
      });

      // --- Suggestion box ---
      // Writes straight to a `suggestions` Firestore collection, the same way
      // the leaderboards write their own. Sign-in is required so each note
      // carries an author and the collection's rules can be create-only.
      const suggestBtn = document.getElementById('suggest-btn');
      const suggestOverlay = document.getElementById('suggest-overlay');
      const suggestText = document.getElementById('suggest-text');
      const suggestSend = document.getElementById('suggest-send');
      const suggestStatus = document.getElementById('suggest-status');
      const suggestCount = document.getElementById('suggest-count');
      const SUGGEST_MAX = 1000;
      let suggestSending = false;

      function setSuggestStatus(msg, kind) {
        suggestStatus.textContent = msg || '';
        suggestStatus.className = kind || '';
      }
      suggestText.addEventListener('input', () => {
        suggestCount.textContent = `${suggestText.value.length} / ${SUGGEST_MAX}`;
      });
      suggestBtn.addEventListener('click', () => {
        setSuggestStatus('');
        suggestCount.textContent = `${suggestText.value.length} / ${SUGGEST_MAX}`;
        if (!window.CloudSync || !CloudSync.isSignedIn()) {
          setSuggestStatus('Sign in first so I know who to credit.', 'bad');
        }
        suggestOverlay.classList.add('open');
        suggestText.focus();
      });
      suggestSend.addEventListener('click', () => {
        if (suggestSending) return;
        const body = suggestText.value.trim();
        if (!body) { setSuggestStatus('Write something first.', 'bad'); return; }
        if (!window.CloudSync || !CloudSync.isSignedIn()) {
          setSuggestStatus('Sign in first — the Sign In button is up top.', 'bad');
          return;
        }
        suggestSending = true;
        suggestSend.disabled = true;
        setSuggestStatus('Sending...');
        sendSuggestion(body)
          .then((res) => {
            if (res.ok) { suggestText.value = ''; suggestCount.textContent = `0 / ${SUGGEST_MAX}`; }
            setSuggestStatus(res.message, res.ok ? 'ok' : 'bad');
          })
          .catch((err) => {
            console.error('[suggestions] send failed:', err);
            setSuggestStatus('Could not reach the server. Please try again.', 'bad');
          })
          .finally(() => { suggestSending = false; suggestSend.disabled = false; });
      });
      // Goes through the arena server (Admin SDK) rather than a direct Firestore
      // write, so it does not depend on Firestore rules for `suggestions`.
      async function sendSuggestion(text) {
        const token = await CloudSync.currentUser.getIdToken();
        const url = location.protocol === 'https:' ? 'wss://iantopia.com/arena-ws/suggest'
          : 'ws://' + (location.hostname || 'localhost') + ':4001';
        return new Promise((resolve, reject) => {
          const ws = new WebSocket(url);
          const timer = setTimeout(() => { try { ws.close(); } catch {} reject(new Error('timeout')); }, 10000);
          const done = (fn, v) => { clearTimeout(timer); try { ws.close(); } catch {} fn(v); };
          ws.onopen = () => ws.send(JSON.stringify({ type: 'auth', token }));
          ws.onmessage = (ev) => {
            let m; try { m = JSON.parse(ev.data); } catch { return; }
            if (m.type === 'auth_ok') ws.send(JSON.stringify({ type: 'suggest', text, page: location.pathname }));
            else if (m.type === 'suggest_result') done(resolve, m);
          };
          ws.onerror = () => done(reject, new Error('socket error'));
          ws.onclose = () => { clearTimeout(timer); reject(new Error('closed')); };
        });
      }
      document.getElementById('suggest-close')
        .addEventListener('click', () => suggestOverlay.classList.remove('open'));
      suggestOverlay.addEventListener('click', (e) => {
        if (e.target === suggestOverlay) suggestOverlay.classList.remove('open');
      });

      // --- Suggestion board (the Board tab) ---
      // Public, admin-approved suggestions, read through one guest connection to
      // the arena server (the same feed the old /suggestions page used). Names and
      // text are set with textContent, so nothing a player wrote is run as HTML.
      const suggestTabs = document.querySelectorAll('.suggest-tab');
      const panelSend = document.getElementById('suggest-panel-send');
      const panelBoard = document.getElementById('suggest-panel-board');
      const boardList = document.getElementById('suggest-board');
      let boardArena = null, boardReady = false;
      function renderBoard(rows) {
        boardList.textContent = '';
        if (!rows.length) {
          const empty = document.createElement('div'); empty.className = 'suggest-empty';
          empty.textContent = 'Nothing posted yet.';
          boardList.append(empty); return;
        }
        for (const r of rows) {
          const post = document.createElement('article'); post.className = 'suggest-post';
          const meta = document.createElement('div'); meta.className = 'suggest-meta-row';
          const who = document.createElement('b'); who.textContent = r.name || 'Anonymous';
          const when = document.createElement('span'); when.textContent = r.postedAt ? new Date(r.postedAt).toLocaleDateString() : '';
          meta.append(who, when);
          const body = document.createElement('p'); body.className = 'suggest-text'; body.textContent = r.text;
          post.append(meta, body); boardList.append(post);
        }
      }
      function loadBoard() {
        if (!boardArena) {
          boardArena = ArenaClient.create({
            game: 'suggest',
            canSwitchIdentity: () => false,
            onMessage: (msg) => {
              if (msg.type === 'auth_ok') { boardReady = true; boardArena.send({ type: 'suggestions_public' }); }
              else if (msg.type === 'suggestions_public') renderBoard(msg.rows);
              else if (msg.type === 'error') {
                boardList.innerHTML = '<div class="suggest-empty">Could not load the board. Try again later.</div>';
              }
            },
          });
          boardArena.connect();
        } else if (boardReady) {
          boardArena.send({ type: 'suggestions_public' });
        }
      }
      suggestTabs.forEach((tab) => tab.addEventListener('click', () => {
        const onBoard = tab.dataset.tab === 'board';
        suggestTabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panelSend.hidden = onBoard;
        panelBoard.hidden = !onBoard;
        if (onBoard) loadBoard();
      }));

      // --- Background switcher ---
      // Kept separate from other pages on purpose — see the note on
      // ACTIVE_TRACK_KEY above for why.
      const ACTIVE_BG_KEY = 'home_active_bg_v1';
      const BG_LIBRARY = window.BACKGROUND_LIBRARY || { default: { label: 'Taipei', type: 'gif', src: '/video/taipei.gif', position: 'center' } };
      const bgBtn = document.getElementById('bg-btn');
      const bgVideo = document.getElementById('bg-video');
      const backgroundOverlay = document.getElementById('background-overlay');
      const backgroundList = document.getElementById('background-list');
      const backgroundClose = document.getElementById('background-close');

      let activeBgKey = 'default';
      function getActiveBgKey() {
        const key = localStorage.getItem(ACTIVE_BG_KEY);
        // key !== 'default' matters: a returning visitor's storage very
        // often already holds the literal string "default" (the picker
        // writes it back on every open, not just on a real change), which
        // the old `key && BG_LIBRARY[key]` check treated as just as
        // "explicit" as actually picking Vegas or Minecraft -- so it never
        // fell through to the seasonal check below, and the whole page
        // stayed on Taipei/white-title/plain-buttons for anyone who'd ever
        // visited before. getActiveTrackKey() already excluded it; this
        // one didn't, which is exactly why music switched to Ghost House
        // but the background (and therefore the title/button theme, both
        // driven off this) silently didn't.
        if (key && key !== 'default' && BG_LIBRARY[key]) return key;
        // No explicit (non-default) pick saved: the Halloween background
        // for all of October, Taipei otherwise -- see getActiveTrackKey()
        // above for why this resolves fresh each load instead of writing a
        // choice.
        return (window.isHalloweenSeason() && BG_LIBRARY.halloween_theme) ? 'halloween_theme' : 'default';
      }
      // Same fix as every other page's pickers.js already has: without this,
      // the video restarted from 0:00 on every trip back to the homescreen
      // while the audio track kept its place, so the two drifted out of sync
      // (worse under lag, where the video reload itself takes a beat).
      const VIDEO_POS_KEY = 'home_video_pos_v1';

      // Clicking the word "Haunted" switches this visitor to the spooky theme:
      // the Halloween background (which applies the theme colours) and the
      // Ghost House track, saved like any other pick. One-way on purpose; the
      // Background picker changes it back.
      (function () {
        const word = document.querySelector('.haunted-word');
        if (!word) return;
        const goSpooky = () => {
          if (document.body.classList.contains('theme-halloween')) return;
          try { localStorage.setItem(ACTIVE_BG_KEY, 'halloween_theme'); } catch {}
          applyBackground('halloween_theme');
          activeTrackKey = 'ghost_house';
          try { localStorage.setItem(ACTIVE_TRACK_KEY, activeTrackKey); } catch {}
          applyActiveTrack(true);
          window.dispatchEvent(new CustomEvent('active-track:changed', { detail: { key: activeTrackKey } }));
        };
        word.addEventListener('click', goSpooky);
        word.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); goSpooky(); }
        });
      })();

      function applyBackground(key) {
        // A saved Raining Money choice becomes the overlay on the default background.
        if (key === 'raining_money') { if (window.MoneyRain) window.MoneyRain.set(true); key = 'default'; }
        const bg = BG_LIBRARY[key] || BG_LIBRARY.default;
        activeBgKey = key;
        if (bg.type === 'video') {
          document.body.style.backgroundImage = 'none';
          bgVideo.src = bg.src;
          bgVideo.classList.add('show');
          if (window.MusicPosition) {
            window.MusicPosition.restore(VIDEO_POS_KEY, bgVideo);
            if (!bgVideo.dataset.positionTracked) {
              bgVideo.dataset.positionTracked = '1';
              window.MusicPosition.track(VIDEO_POS_KEY, bgVideo);
            }
          }
          bgVideo.play().catch(() => {});
        } else {
          bgVideo.classList.remove('show');
          bgVideo.pause();
          bgVideo.removeAttribute('src');
          document.body.style.backgroundImage = `url('${bg.src}')`;
          document.body.style.backgroundPosition = bg.position || 'center';
        }

        // Combo track: reads bg.comboTrack from background-library.js
        // instead of a hardcoded per-key list here (that list assumed the
        // music key always matched the background key, which broke the
        // moment a background needed a differently-named track -- e.g.
        // 'minecraft' the background vs. 'minecraft_ost' the track. Every
        // other page's pickers.js already does this the generic way; home
        // was the one place still on the old pattern.
        if (bg.comboTrack && LIBRARY[bg.comboTrack]) {
          activeTrackKey = bg.comboTrack;
          localStorage.setItem(ACTIVE_TRACK_KEY, activeTrackKey);
          applyActiveTrack(true);
          window.dispatchEvent(new CustomEvent('active-track:changed', { detail: { key: activeTrackKey } }));
        }

        // Generic now — reads which theme class (if any) this key declares
        // in background-library.js rather than hardcoding each key here, so
        // adding a themed background never means touching this function
        // again. Every other page's picker does the same lookup, which is
        // what makes a theme "universal": whichever page has this
        // background active picks up the same class automatically.
        if (window.BACKGROUND_THEME_CLASSES) document.body.classList.remove(...window.BACKGROUND_THEME_CLASSES);
        if (bg.theme) document.body.classList.add(bg.theme);
        // The Halloween look is part of the same theme: set it here, after the
        // class list is cleared, so it survives a background change either way.
        if (window.setHalloweenLook) window.setHalloweenLook(bg.theme === 'theme-halloween');
      }
      applyBackground(getActiveBgKey());

      const COMMON_BG_KEYS = ['iantopia_wood'];
      function renderBackgroundList() {
        const inv = loadInventory();
        const unlocked = Array.isArray(inv.backgrounds) ? inv.backgrounds : [];
        let html = bgRow('default', BG_LIBRARY.default.label);
        // Common backgrounds that everyone can pick, no unlock needed.
        COMMON_BG_KEYS.forEach((key) => {
          if (BG_LIBRARY[key] && !unlocked.includes(key)) html += bgRow(key, BG_LIBRARY[key].label);
        });
        if (unlocked.length === 0) {
          html += '<div class="modal-empty">No extra backgrounds unlocked yet — try the Lootbox!</div>';
        } else {
          unlocked.forEach((key) => {
            if (!BG_LIBRARY[key]) return;
            // Raining Money is an overlay, not a background: it has its own row below.
            if (key === 'raining_money') return;
            // Inventory-only shelf backgrounds never show up here — they're
            // restricted to the dedicated Inventory Room picker.
            if (BG_LIBRARY[key].restricted) return;
            html += bgRow(key, BG_LIBRARY[key].label);
          });
        }
        // Raining Money layers over whichever background is chosen, so it has its own on/off row.
        if (unlocked.includes('raining_money') && window.MoneyRain) {
          const on = window.MoneyRain.isOn();
          html += '<div class="modal-track' + (on ? ' active' : '') + '" data-money="1"><span>🌧️ Raining Money (over any background)</span><span>' + (on ? 'ON' : 'OFF') + '</span></div>';
        }
        backgroundList.innerHTML = html;
        backgroundList.querySelectorAll('.modal-track[data-money]').forEach((row) => {
          row.addEventListener('click', () => { window.MoneyRain.set(!window.MoneyRain.isOn()); renderBackgroundList(); });
        });
        backgroundList.querySelectorAll('.modal-track[data-key]').forEach((row) => {
          row.addEventListener('click', () => {
            const key = row.dataset.key;
            localStorage.setItem(ACTIVE_BG_KEY, key);
            applyBackground(key);
            backgroundOverlay.classList.remove('open');
            renderBackgroundList();
            // Previously dispatched nothing — see cloud-sync.js's SYNC_EVENTS.
            window.dispatchEvent(new CustomEvent('active-background:changed', { detail: { key } }));
          });
        });
      }
      function bgRow(key, label) {
        const activeClass = key === activeBgKey ? ' active' : '';
        return `<div class="modal-track${activeClass}" data-key="${key}"><span>${label}</span>${key === activeBgKey ? '<span>▶</span>' : ''}</div>`;
      }

      bgBtn.addEventListener('click', () => {
        renderBackgroundList();
        backgroundOverlay.classList.add('open');
      });
      backgroundClose.addEventListener('click', () => backgroundOverlay.classList.remove('open'));
      backgroundOverlay.addEventListener('click', (e) => {
        if (e.target === backgroundOverlay) backgroundOverlay.classList.remove('open');
      });

      // --- Cursor picker ---
      // Writes the active key, then fires 'cursor:changed'; cursor.js listens
      // and re-skins its canvas live, so the swap is visible without a reload.
      const ACTIVE_CURSOR_KEY = 'active_cursor_v1';
      const cursorBtn = document.getElementById('cursor-btn');
      const cursorOverlay = document.getElementById('cursor-overlay');
      const cursorList = document.getElementById('cursor-list');
      const cursorClose = document.getElementById('cursor-close');

      function getActiveCursorKey() {
        const key = localStorage.getItem(ACTIVE_CURSOR_KEY);
        return (key && CURSOR_LIB[key]) ? key : 'default';
      }

      function cursorSwatch(entry) {
        return entry.emoji
          ? `<span class="cursor-swatch">${entry.emoji}</span>`
          : `<span class="cursor-swatch"><img src="${entry.point}" alt=""></span>`;
      }

      function renderCursorList() {
        const active = getActiveCursorKey();
        const unlocked = (loadInventory().cursors || []).filter((k) => CURSOR_LIB[k]);
        const keys = ['default', ...unlocked];

        cursorList.innerHTML = keys.map((key) => {
          const entry = CURSOR_LIB[key];
          const isActive = key === active;
          return `<div class="modal-track${isActive ? ' active' : ''}" data-key="${key}">
            <span>${cursorSwatch(entry)}${entry.label}</span>${isActive ? '<span>▶</span>' : ''}
          </div>`;
        }).join('') + (unlocked.length === 0
          ? '<div class="modal-empty">No extra cursors unlocked yet — try a case!</div>'
          : '');

        cursorList.querySelectorAll('.modal-track').forEach((row) => {
          row.addEventListener('click', () => {
            localStorage.setItem(ACTIVE_CURSOR_KEY, row.dataset.key);
            window.dispatchEvent(new CustomEvent('cursor:changed'));
            cursorOverlay.classList.remove('open');
            renderCursorList();
          });
        });
      }

      cursorBtn.addEventListener('click', () => {
        renderCursorList();
        cursorOverlay.classList.add('open');
      });
      cursorClose.addEventListener('click', () => cursorOverlay.classList.remove('open'));
      cursorOverlay.addEventListener('click', (e) => {
        if (e.target === cursorOverlay) cursorOverlay.classList.remove('open');
      });

      // --- Alternate Ending reveal ---
      // The link stays hidden until it's actually pulled from a case, so the
      // gold drop is what makes it appear rather than it always being there.
      const UNLOCKS_KEY = 'strubles_unlocks_v1';
      const endingLink = document.getElementById('ending-link');
      function syncEndingLink() {
        let pages = [];
        try {
          const u = JSON.parse(localStorage.getItem(UNLOCKS_KEY) || '{}');
          if (Array.isArray(u.pages)) pages = u.pages;
        } catch {}
        endingLink.hidden = !pages.includes('/alternate-ending');
      }
      syncEndingLink();
      window.addEventListener('storage', syncEndingLink);

      // Escape closes whichever modal is currently open
      window.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        [playlistOverlay, backgroundOverlay, cursorOverlay, patchOverlay].forEach((overlay) => {
          overlay.classList.remove('open');
        });
      });

      // --- Minecraft theme: button click SFX ---
      // Delegated on document rather than bound per-button, since the
      // button set here is the same open-ended list the stone-texture CSS
      // already targets (.big, the icon buttons, etc.) -- one listener
      // covers all of them without needing to enumerate or re-bind on
      // every re-render. Only fires while the theme is actually active,
      // reuses audioEnabled (the same mute flag the music picker above
      // already respects) so muting silences this too.
      const minecraftClickSfx = new Audio('/audio/sfx/minecraft-click.mp3');
      minecraftClickSfx.volume = 0.5;
      document.addEventListener('click', (e) => {
        if (!audioEnabled || !document.body.classList.contains('theme-minecraft')) return;
        if (!e.target.closest('a.big, button.big, #inv-btn, #bg-btn, #cursor-btn, #account-btn, #patch-btn, #now-playing, #ending-link')) return;
        minecraftClickSfx.currentTime = 0;
        minecraftClickSfx.play().catch(() => {});
      });
    })();
  </script>

</body>
</html>
