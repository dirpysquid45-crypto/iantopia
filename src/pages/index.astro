<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Glorious Iantopia</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="theme-color" content="#0a0c12">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <script is:inline src="/pwa.js?v=1" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <!--
    is:global is REQUIRED. Astro scopes <style> by stamping data-astro-cid-* on
    template elements and rewriting selectors to match. The modal rows here
    (.modal-track, .cursor-swatch) are all built at
    runtime via innerHTML, so they never get that attribute and every scoped
    rule silently skips them — the playlist, background and cursor
    pickers all render as unstyled text. This is a standalone document, so
    scoping buys nothing.
  -->
  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    @keyframes titleGlow {
      0%, 100% {
        text-shadow: 0 0 10px rgba(255, 235, 59, 0.3), 0 0 20px rgba(255, 152, 86, 0.2);
      }
      50% {
        text-shadow: 0 0 20px rgba(255, 235, 59, 0.6), 0 0 40px rgba(255, 152, 86, 0.4), 0 0 60px rgba(255, 196, 0, 0.2);
      }
    }

    @keyframes titleScale {
      0% { transform: scale(0.95); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background-image: url('/video/taipei.gif');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      color: #ffffff;
      position: relative;
      overflow: hidden;
    }

    @media (max-width: 768px) {
      body {
        background-attachment: scroll;
      }
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.3);
      pointer-events: none;
      z-index: 0;
    }

    body > * {
      position: relative;
      z-index: 1;
    }


    @keyframes bob {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    .image-container {
      position: relative;
      perspective: 1000px;
      animation: bob 3s ease-in-out infinite;
      width: min(202px, 85vw);
      aspect-ratio: 629 / 839;
      margin-bottom: 20px;
    }

    .flip-card {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      filter: drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4));
    }
    .image-container:focus-visible {
      outline: 3px solid #ffeb3b;
      outline-offset: 6px;
      border-radius: 8px;
    }

    .flip-card-front,
    .flip-card-back {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .flip-card-back {
      transform: rotateY(180deg);
    }

    .flip-card img {
      max-width: 100%;
      height: 100%;
      object-fit: cover;
      box-shadow: 0 0 40px rgba(255, 235, 59, 0.5), 0 0 80px rgba(255, 152, 86, 0.3), inset 0 0 30px rgba(255, 235, 59, 0.2);
      border-radius: 8px;
    }

    h1 {
      font-family: 'Press Start 2P', cursive;
      font-size: clamp(1.2rem, 5vw, 2.5rem);
      font-weight: 400;
      margin: 20px 0 10px 0;
      color: #ffffff;
      letter-spacing: 2px;
      animation: titleScale 0.8s ease-out, titleGlow 3s ease-in-out infinite 0.8s;
      text-align: center;
      text-transform: uppercase;
    }

    a.big,
    button.big {
      position: relative;
      overflow: hidden;
      text-decoration: none;
      padding: 18px 26px;
      border-radius: 0;
      background: #1d2330;
      border: 1px solid #2a3245;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      font-size: clamp(20px, 4vw, 34px);
      letter-spacing: 0.3px;
      color: #ffffff;
      cursor: none;
      transition: transform 0.2s, box-shadow 0.2s;
      display: block;
      margin: 16px auto;
    }

    a.big:hover,
    button.big:hover {
      transform: translateY(-1px);
    }

    /* Diagonal shine sweep on hover — a light band slides across the
       button. content-only, ::before, so it never displaces the label or
       interferes with the neon glow variants below. */
    a.big::before,
    button.big::before {
      content: '';
      position: absolute;
      top: 0;
      left: -75%;
      width: 45%;
      height: 100%;
      background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.45), transparent);
      transform: skewX(-20deg);
      transition: left 0.55s ease;
      pointer-events: none;
    }
    a.big:hover::before,
    button.big:hover::before {
      left: 125%;
    }
    @media (prefers-reduced-motion: reduce) {
      a.big::before, button.big::before { display: none; }
    }

    /* Buttons wrap into a centered, evenly-gapped grid instead of one long
       vertical stack — 2 across once there's room, single column below
       that. Sizing/spacing here overrides the plain stacked defaults above
       for anything inside the grid. */
    .button-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: stretch;
      gap: 16px;
      max-width: 720px;
      width: 100%;
      margin: 18px auto 0;
      padding: 0 16px;
    }
    .button-grid > .big {
      margin: 0;
      flex: 1 1 260px;
      max-width: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: clamp(15px, 2.2vw, 21px);
    }
    .button-grid > .big:hover {
      transform: translateY(-2px);
    }

    /* Neon sign buttons */
    a.big.neon-yt {
      background: #200000;
      border: 2px solid #ff1a1a;
      color: #ffffff;
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff, 0 0 20px rgba(255, 255, 255, 0.6);
      box-shadow: 0 0 6px #ff1a1a, 0 0 16px #ff1a1a, 0 0 32px rgba(255, 26, 26, 0.5), inset 0 0 10px rgba(255, 26, 26, 0.2);
      text-transform: uppercase;
    }
    a.big.neon-yt:hover {
      text-shadow: 0 0 6px #ffffff, 0 0 14px #ffffff, 0 0 28px rgba(255, 255, 255, 0.7);
      box-shadow: 0 0 10px #ff1a1a, 0 0 24px #ff1a1a, 0 0 48px rgba(255, 26, 26, 0.6), inset 0 0 14px rgba(255, 26, 26, 0.3);
    }

    a.big.neon-gamble {
      background: #0a1128;
      border: 2px solid #2979ff;
      color: #ff0000;
      text-shadow: 0 0 5px #ff0000, 0 0 10px #ff0000, 0 0 20px #ff0000, 0 0 40px rgba(255, 0, 0, 0.6);
      box-shadow: 0 0 6px #2979ff, 0 0 16px #2979ff, 0 0 32px rgba(41, 121, 255, 0.5), inset 0 0 10px rgba(41, 121, 255, 0.15);
    }
    a.big.neon-gamble:hover {
      text-shadow: 0 0 6px #ff0000, 0 0 14px #ff0000, 0 0 28px #ff0000, 0 0 56px rgba(255, 0, 0, 0.7);
      box-shadow: 0 0 10px #2979ff, 0 0 24px #2979ff, 0 0 48px rgba(41, 121, 255, 0.6), inset 0 0 14px rgba(41, 121, 255, 0.2);
    }

    a.big.neon-never {
      background: #332800;
      border: 2px solid #fff176;
      color: #fff176;
      text-shadow: 0 0 5px #e6a700, 0 0 10px #e6a700, 0 0 20px #e6a700, 0 0 40px rgba(230, 167, 0, 0.6);
      box-shadow: 0 0 6px #e6a700, 0 0 16px #e6a700, 0 0 32px rgba(230, 167, 0, 0.5), inset 0 0 10px rgba(230, 167, 0, 0.15);
    }
    a.big.neon-never:hover {
      text-shadow: 0 0 6px #e6a700, 0 0 14px #e6a700, 0 0 28px #e6a700, 0 0 56px rgba(230, 167, 0, 0.7);
      box-shadow: 0 0 10px #e6a700, 0 0 24px #e6a700, 0 0 48px rgba(230, 167, 0, 0.6), inset 0 0 14px rgba(230, 167, 0, 0.2);
    }

    a.big.neon-mines {
      background: #041505;
      border: 2px solid #4caf50;
      color: #4caf50;
      text-shadow: 0 0 5px #4caf50, 0 0 10px #4caf50, 0 0 20px #4caf50, 0 0 40px rgba(76, 175, 80, 0.6);
      box-shadow: 0 0 6px #4caf50, 0 0 16px #4caf50, 0 0 32px rgba(76, 175, 80, 0.5), inset 0 0 10px rgba(76, 175, 80, 0.15);
    }
    a.big.neon-mines:hover {
      text-shadow: 0 0 6px #4caf50, 0 0 14px #4caf50, 0 0 28px #4caf50, 0 0 56px rgba(76, 175, 80, 0.7);
      box-shadow: 0 0 10px #4caf50, 0 0 24px #4caf50, 0 0 48px rgba(76, 175, 80, 0.6), inset 0 0 14px rgba(76, 175, 80, 0.2);
    }

    button.big.neon-daily {
      background: #221800;
      border: 2px solid #ffd700;
      color: #ffd700;
      text-shadow: 0 0 5px #ffd700, 0 0 10px #ffd700, 0 0 20px #ffd700, 0 0 40px rgba(255, 215, 0, 0.6);
      box-shadow: 0 0 6px #ffd700, 0 0 16px #ffd700, 0 0 32px rgba(255, 215, 0, 0.5), inset 0 0 10px rgba(255, 215, 0, 0.15);
      font-family: inherit;
      cursor: none;
    }
    button.big.neon-daily:hover:not(:disabled) {
      text-shadow: 0 0 6px #ffd700, 0 0 14px #ffd700, 0 0 28px #ffd700, 0 0 56px rgba(255, 215, 0, 0.7);
      box-shadow: 0 0 10px #ffd700, 0 0 24px #ffd700, 0 0 48px rgba(255, 215, 0, 0.6), inset 0 0 14px rgba(255, 215, 0, 0.2);
    }
    button.big.neon-daily:disabled { opacity: 0.4; cursor: none; }

    a.big.neon-tycoon {
      background: #001522;
      border: 2px solid #29b6f6;
      color: #29b6f6;
      text-shadow: 0 0 5px #29b6f6, 0 0 10px #29b6f6, 0 0 20px #29b6f6, 0 0 40px rgba(41, 182, 246, 0.6);
      box-shadow: 0 0 6px #29b6f6, 0 0 16px #29b6f6, 0 0 32px rgba(41, 182, 246, 0.5), inset 0 0 10px rgba(41, 182, 246, 0.15);
    }
    a.big.neon-tycoon:hover {
      text-shadow: 0 0 6px #29b6f6, 0 0 14px #29b6f6, 0 0 28px #29b6f6, 0 0 56px rgba(41, 182, 246, 0.7);
      box-shadow: 0 0 10px #29b6f6, 0 0 24px #29b6f6, 0 0 48px rgba(41, 182, 246, 0.6), inset 0 0 14px rgba(41, 182, 246, 0.2);
    }

    /* ---------- Hello Kitty theme ---------- */
    /* Overrides every button's colors while the Hello Kitty background is
       active, including the neon variants above — matched selector-for-
       selector against them (rather than !important) so it wins on
       specificity alone and stays easy to extend later. */
    body.theme-hello-kitty a.big,
    body.theme-hello-kitty button.big,
    body.theme-hello-kitty a.big.neon-yt,
    body.theme-hello-kitty a.big.neon-gamble,
    body.theme-hello-kitty a.big.neon-never,
    body.theme-hello-kitty a.big.neon-mines,
    body.theme-hello-kitty a.big.neon-tycoon,
    body.theme-hello-kitty button.big.neon-daily,
    body.theme-hello-kitty #inv-btn,
    body.theme-hello-kitty #bg-btn,
    body.theme-hello-kitty #cursor-btn,
    body.theme-hello-kitty #account-btn,
    body.theme-hello-kitty #now-playing,
    body.theme-hello-kitty #ending-link {
      background: #ffb6d9;
      border-color: #ff5fa8;
      color: #9c004f;
      text-shadow: none;
      box-shadow: 0 10px 24px rgba(255, 95, 168, 0.4);
    }
    body.theme-hello-kitty a.big:hover,
    body.theme-hello-kitty button.big:hover,
    body.theme-hello-kitty #inv-btn:hover,
    body.theme-hello-kitty #bg-btn:hover,
    body.theme-hello-kitty #cursor-btn:hover,
    body.theme-hello-kitty #account-btn:hover,
    body.theme-hello-kitty #now-playing:hover,
    body.theme-hello-kitty #ending-link:hover {
      background: #ffd1e8;
      box-shadow: 0 0 16px rgba(255, 95, 168, 0.6), 0 10px 24px rgba(255, 95, 168, 0.4);
    }

    /* Falling cherry blossom overlay — only visible while the Hello Kitty
       theme is active. Tiled so it covers the full viewport regardless of
       screen size, same technique as the inventory room's #leaf-overlay —
       except that gif's background is dark and transparent (screen blend
       hides black), while this one's is opaque white/pale blue, so it
       needs the opposite blend mode (multiply hides white) instead of
       actual transparency to avoid washing out everything underneath it. */
    #sakura-overlay {
      position: fixed; inset: 0; z-index: 2; pointer-events: none;
      display: none;
      background-image: url('/video/cherry-blossom.gif');
      background-repeat: repeat;
      background-size: 260px 115px;
      opacity: 0.55;
      mix-blend-mode: multiply;
    }
    body.theme-hello-kitty #sakura-overlay { display: block; }

    /* Spinning strubles image + Topia countdown recolored to match — same
       pink, static (no pulse; Hello Kitty's own motion is the falling
       petals, not a beat). */
    body.theme-hello-kitty .flip-card {
      filter: drop-shadow(0 0 30px rgba(255, 95, 168, 0.6)) drop-shadow(0 0 60px rgba(255, 209, 232, 0.4));
    }
    body.theme-hello-kitty #topia-timer {
      background: linear-gradient(135deg, #33001a 0%, #4d0033 100%);
      color: #ffb6d9;
      border-color: #ff5fa8;
      box-shadow: 0 0 20px rgba(255, 95, 168, 0.5), inset 0 0 10px rgba(255, 95, 168, 0.1);
    }

    /* ---------- Old People Slot theme ---------- */
    /* Same treatment as Hello Kitty above — static recolor, no motion —
       just yellow/gold instead of pink, matching the shared theme classes
       every other page also reacts to (see background-library.js). */
    body.theme-old-ppl-slot a.big,
    body.theme-old-ppl-slot button.big,
    body.theme-old-ppl-slot a.big.neon-yt,
    body.theme-old-ppl-slot a.big.neon-gamble,
    body.theme-old-ppl-slot a.big.neon-never,
    body.theme-old-ppl-slot a.big.neon-mines,
    body.theme-old-ppl-slot a.big.neon-tycoon,
    body.theme-old-ppl-slot button.big.neon-daily,
    body.theme-old-ppl-slot #inv-btn,
    body.theme-old-ppl-slot #bg-btn,
    body.theme-old-ppl-slot #cursor-btn,
    body.theme-old-ppl-slot #account-btn,
    body.theme-old-ppl-slot #now-playing,
    body.theme-old-ppl-slot #ending-link {
      background: #ffd700;
      border-color: #c9a227;
      color: #3a2a00;
      text-shadow: none;
      box-shadow: 0 10px 24px rgba(255, 215, 0, 0.45);
    }
    body.theme-old-ppl-slot a.big:hover,
    body.theme-old-ppl-slot button.big:hover,
    body.theme-old-ppl-slot #inv-btn:hover,
    body.theme-old-ppl-slot #bg-btn:hover,
    body.theme-old-ppl-slot #cursor-btn:hover,
    body.theme-old-ppl-slot #account-btn:hover,
    body.theme-old-ppl-slot #now-playing:hover,
    body.theme-old-ppl-slot #ending-link:hover {
      background: #ffe766;
      box-shadow: 0 0 16px rgba(255, 215, 0, 0.6), 0 10px 24px rgba(255, 215, 0, 0.4);
    }
    body.theme-old-ppl-slot .flip-card {
      filter: drop-shadow(0 0 30px rgba(255, 215, 0, 0.6)) drop-shadow(0 0 60px rgba(255, 231, 102, 0.4));
    }
    body.theme-old-ppl-slot #topia-timer {
      background: linear-gradient(135deg, #332b00 0%, #4d4000 100%);
      color: #ffd700;
      border-color: #c9a227;
      box-shadow: 0 0 20px rgba(255, 215, 0, 0.5), inset 0 0 10px rgba(255, 215, 0, 0.1);
    }

    /* ---------- Girl Like Me theme (PinkPantheress, 137 BPM) ---------- */
    /* Pulses via filter:brightness rather than transform:scale so it never
       fights the buttons' existing hover transform (translateY) — filter
       composites independently of transform, so hover still works exactly
       as normal while this runs continuously underneath it. 60/137bpm =
       0.4380s per beat. */
    @keyframes beat-pulse {
      0%, 100% { filter: brightness(1); }
      50%      { filter: brightness(1.28); }
    }
    body.theme-girl-like-me a.big,
    body.theme-girl-like-me button.big,
    body.theme-girl-like-me #inv-btn,
    body.theme-girl-like-me #bg-btn,
    body.theme-girl-like-me #cursor-btn,
    body.theme-girl-like-me #account-btn,
    body.theme-girl-like-me #now-playing,
    body.theme-girl-like-me #ending-link,
    body.theme-girl-like-me #topia-timer {
      animation: beat-pulse 0.438s ease-in-out infinite;
    }
    /* .flip-card already carries its own glow via `filter: drop-shadow(...)`
       — beat-pulse alone would clobber that (an element's `filter` keyframe
       fully replaces the property each frame, it doesn't merge with the
       base rule), so the spinning image gets its own keyframe that pulses
       brightness while keeping the same drop-shadow glow present throughout. */
    @keyframes beat-pulse-flip {
      0%, 100% { filter: brightness(1) drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4)); }
      50%      { filter: brightness(1.28) drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4)); }
    }
    body.theme-girl-like-me .flip-card {
      animation: beat-pulse-flip 0.438s ease-in-out infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      body.theme-girl-like-me a.big,
      body.theme-girl-like-me button.big,
      body.theme-girl-like-me #inv-btn,
      body.theme-girl-like-me #bg-btn,
      body.theme-girl-like-me #cursor-btn,
      body.theme-girl-like-me #account-btn,
      body.theme-girl-like-me #now-playing,
      body.theme-girl-like-me #ending-link,
      body.theme-girl-like-me #topia-timer,
      body.theme-girl-like-me .flip-card {
        animation: none;
      }
    }

    /* ---------- Waster / Evian Christ theme (deep UV purple, gentle glow) ---------- */
    /* Slow ambient breathing glow, not beat-locked like Girl Like Me below —
       "gentle" reads as atmospheric rather than a hard pulse, so this uses a
       long, soft ease-in-out cycle instead of a tempo-derived duration. */
    @keyframes uv-glow {
      0%, 100% { box-shadow: 0 10px 24px rgba(157, 78, 221, 0.35), 0 0 10px rgba(157, 78, 221, 0.25); }
      50%      { box-shadow: 0 10px 24px rgba(157, 78, 221, 0.55), 0 0 26px rgba(176, 38, 255, 0.65); }
    }
    body.theme-waster a.big,
    body.theme-waster button.big,
    body.theme-waster #inv-btn,
    body.theme-waster #bg-btn,
    body.theme-waster #cursor-btn,
    body.theme-waster #account-btn,
    body.theme-waster #now-playing,
    body.theme-waster #ending-link,
    body.theme-evian a.big,
    body.theme-evian button.big,
    body.theme-evian #inv-btn,
    body.theme-evian #bg-btn,
    body.theme-evian #cursor-btn,
    body.theme-evian #account-btn,
    body.theme-evian #now-playing,
    body.theme-evian #ending-link {
      background: #1a0533;
      border-color: #9d4edd;
      color: #e0aaff;
      text-shadow: 0 0 8px rgba(176, 38, 255, 0.6);
      animation: uv-glow 2.4s ease-in-out infinite;
    }
    body.theme-waster a.big:hover,
    body.theme-waster button.big:hover,
    body.theme-waster #inv-btn:hover,
    body.theme-waster #bg-btn:hover,
    body.theme-waster #cursor-btn:hover,
    body.theme-waster #account-btn:hover,
    body.theme-waster #now-playing:hover,
    body.theme-waster #ending-link:hover,
    body.theme-evian a.big:hover,
    body.theme-evian button.big:hover,
    body.theme-evian #inv-btn:hover,
    body.theme-evian #bg-btn:hover,
    body.theme-evian #cursor-btn:hover,
    body.theme-evian #account-btn:hover,
    body.theme-evian #now-playing:hover,
    body.theme-evian #ending-link:hover {
      background: #2d0a5c;
    }
    /* Spinning strubles image + Topia countdown, recolored and breathing the
       same way as the buttons above. #topia-timer already glows via
       `box-shadow` (not `filter`), so it can reuse the uv-glow keyframe
       directly — .flip-card glows via `filter: drop-shadow(...)` instead,
       which the same keyframe would clobber, so it gets its own filter-based
       version of the same breathing motion. */
    body.theme-waster #topia-timer,
    body.theme-evian #topia-timer {
      background: linear-gradient(135deg, #1a0533 0%, #2d0a5c 100%);
      color: #e0aaff;
      border-color: #9d4edd;
      animation: uv-glow 2.4s ease-in-out infinite;
    }
    @keyframes uv-glow-flip {
      0%, 100% { filter: drop-shadow(0 0 20px rgba(157, 78, 221, 0.5)) drop-shadow(0 0 40px rgba(176, 38, 255, 0.3)); }
      50%      { filter: drop-shadow(0 0 30px rgba(157, 78, 221, 0.75)) drop-shadow(0 0 55px rgba(176, 38, 255, 0.55)); }
    }
    body.theme-waster .flip-card,
    body.theme-evian .flip-card {
      animation: uv-glow-flip 2.4s ease-in-out infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      body.theme-waster a.big, body.theme-waster button.big,
      body.theme-waster #inv-btn, body.theme-waster #bg-btn,
      body.theme-waster #cursor-btn, body.theme-waster #account-btn,
      body.theme-waster #now-playing, body.theme-waster #ending-link,
      body.theme-waster #topia-timer,
      body.theme-evian a.big, body.theme-evian button.big,
      body.theme-evian #inv-btn, body.theme-evian #bg-btn,
      body.theme-evian #cursor-btn, body.theme-evian #account-btn,
      body.theme-evian #now-playing, body.theme-evian #ending-link,
      body.theme-evian #topia-timer {
        animation: none;
        box-shadow: 0 10px 24px rgba(157, 78, 221, 0.45), 0 0 16px rgba(176, 38, 255, 0.45);
      }
      body.theme-waster .flip-card, body.theme-evian .flip-card {
        animation: none;
        filter: drop-shadow(0 0 26px rgba(157, 78, 221, 0.6)) drop-shadow(0 0 48px rgba(176, 38, 255, 0.4));
      }
