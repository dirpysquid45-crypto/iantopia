      50%       { text-shadow: 0 0 20px rgba(255, 215, 0, 0.7), 0 0 40px rgba(255, 231, 102, 0.5), 0 0 60px rgba(255, 215, 0, 0.3); }
    }
    body.theme-old-ppl-slot h1 {
