      border: 2px solid #2979ff;
      color: #ff0000;
      text-shadow: 0 0 5px #ff0000, 0 0 10px #ff0000, 0 0 20px #ff0000, 0 0 40px rgba(255, 0, 0, 0.6);
      box-shadow: 0 0 6px #2979ff, 0 0 16px #2979ff, 0 0 32px rgba(41, 121, 255, 0.5), inset 0 0 10px rgba(41, 121, 255, 0.15);
    }
    a.big.neon-gamble:hover {
      text-shadow: 0 0 6px #ff0000, 0 0 14px #ff0000, 0 0 28px #ff0000, 0 0 56px rgba(255, 0, 0, 0.7);
      box-shadow: 0 0 10px #2979ff, 0 0 24px #2979ff, 0 0 48px rgba(41, 121, 255, 0.6), inset 0 0 14px rgba(41, 121, 255, 0.2);
    }

    a.big.neon-never {
      background: #332800;
      border: 2px solid #fff176;
      color: #fff176;
      text-shadow: 0 0 5px #e6a700, 0 0 10px #e6a700, 0 0 20px #e6a700, 0 0 40px rgba(230, 167, 0, 0.6);
      box-shadow: 0 0 6px #e6a700, 0 0 16px #e6a700, 0 0 32px rgba(230, 167, 0, 0.5), inset 0 0 10px rgba(230, 167, 0, 0.15);
    }
    a.big.neon-never:hover {
      text-shadow: 0 0 6px #e6a700, 0 0 14px #e6a700, 0 0 28px #e6a700, 0 0 56px rgba(230, 167, 0, 0.7);
      box-shadow: 0 0 10px #e6a700, 0 0 24px #e6a700, 0 0 48px rgba(230, 167, 0, 0.6), inset 0 0 14px rgba(230, 167, 0, 0.2);
    }

    /* Topia Timer */
    #topia-timer {
