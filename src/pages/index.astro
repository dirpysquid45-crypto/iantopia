  </div>

  <!-- Spin: continuous rotation, driven by JS so a click can smoothly
       speed it up then ease back to normal instead of a CSS animation
       hard-cutting between two fixed durations. -->
  <script is:inline>
    (() => {
      const imageContainer = document.getElementById('image-container');
      const flipCard = document.getElementById('flip-card');

      const NORMAL_SPEED = 360 / 4000; // deg/ms -- matches the old 4s-per-rotation
      const FAST_SPEED = 360 / 400;    // deg/ms -- matches the old 0.4s-per-rotation
      const HOLD_MS = 500;             // how long to stay at full speed after a click
      const DECEL_MS = 700;            // how long the ease back to normal takes

      let angle = 0;
      let speed = NORMAL_SPEED;
      let lastTime = null;
      let phase = 'normal'; // 'normal' | 'fast' | 'decelerating'
      let holdUntil = 0;
      let decelStart = 0;
      let decelFromSpeed = NORMAL_SPEED;

      function boostSpin() {
        phase = 'fast';
        speed = FAST_SPEED;
        holdUntil = performance.now() + HOLD_MS;
      }

      function tick(now) {
        if (lastTime === null) lastTime = now;
        const dt = now - lastTime;
        lastTime = now;

        if (phase === 'fast' && now >= holdUntil) {
          phase = 'decelerating';
          decelStart = now;
          decelFromSpeed = speed;
        }

        if (phase === 'decelerating') {
          const t = Math.min((now - decelStart) / DECEL_MS, 1);
          const eased = 1 - Math.pow(1 - t, 3); // ease-out cubic
          speed = decelFromSpeed + (NORMAL_SPEED - decelFromSpeed) * eased;
          if (t >= 1) {
            speed = NORMAL_SPEED;
            phase = 'normal';
          }
        }

        angle += speed * dt;
        flipCard.style.transform = `perspective(1000px) rotateY(${angle}deg)`;
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);

      imageContainer.addEventListener('click', boostSpin);
      imageContainer.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          boostSpin();
        }
      });
    })();
  </script>

