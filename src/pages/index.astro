<!DOCTYPE html>
<html lang="en">
<head>
<link rel="stylesheet" href="/lowfx.css?v=2">
<script is:inline src="/lowfx.js?v=2"></script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Haunted Iantopia</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="theme-color" content="#0a0c12">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <script is:inline src="/pwa.js?v=1" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <!--
    is:global is REQUIRED. Astro scopes <style> by stamping data-astro-cid-* on
    template elements and rewriting selectors to match. The modal rows here
    (.modal-track, .cursor-swatch) are all built at
    runtime via innerHTML, so they never get that attribute and every scoped
    rule silently skips them — the playlist, background and cursor
    pickers all render as unstyled text. This is a standalone document, so
    scoping buys nothing.
  -->
  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    /* Ghostly title: the whole heading drifts up and down, fading in and
       out, and a dimmer copy of the name trails behind it. The motion sits
       on the wrapper, not the h1, so no theme's h1 animation overrides it. */
    .ghost-title { animation: ghostFloat 3.2s ease-in-out infinite; }
    .ghost-title h1 { position: relative; isolation: isolate; }
    .ghost-title h1::before {
      content: attr(data-ghost);
      position: absolute; inset: 0;
      color: rgba(190, 255, 255, 0.55);
      -webkit-text-stroke: 0;
      text-shadow: none;
      filter: blur(3px);
      text-align: center;
      pointer-events: none;
      z-index: -1;
      animation: ghostTrace 3.2s ease-in-out infinite;
    }
    @keyframes ghostFloat {
      0%, 100% { transform: translateY(-10px); opacity: 0.55; }
      50%      { transform: translateY(10px);  opacity: 1; }
    }
    @keyframes ghostTrace {
      0%, 100% { transform: translateY(18px);  opacity: 0; }
      50%      { transform: translateY(-18px); opacity: 0.5; }
    }
    @keyframes titleGlow {
      0%, 100% {
        text-shadow: 0 0 10px rgba(255, 235, 59, 0.3), 0 0 20px rgba(255, 152, 86, 0.2);
      }
      50% {
        text-shadow: 0 0 20px rgba(255, 235, 59, 0.6), 0 0 40px rgba(255, 152, 86, 0.4), 0 0 60px rgba(255, 196, 0, 0.2);
      }
    }

    @keyframes titleScale {
      0% { transform: scale(0.95); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    @keyframes buttonPop {
      0% { transform: scale(1); }
      50% { transform: scale(1.08); }
      100% { transform: scale(1.1); }
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      /* safe center: centred when everything fits, but when the content is taller
         than the screen it starts at the top, so nothing is cut off above. */
      justify-content: safe center;
      padding: 48px 0 40px;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background-image: url('/video/taipei.gif');
      background-size: cover;
      background-position: center;
      /* A fixed background repaints on every scroll frame, which made scrolling
         stutter, so it scrolls with the page. */
      background-attachment: scroll;
      color: #ffffff;
      position: relative;
      overflow-x: hidden;
    }

    @media (max-width: 768px) {
      body {
        background-attachment: scroll;
      }
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.3);
      pointer-events: none;
      z-index: 0;
    }

    body > * {
      position: relative;
      z-index: 1;
    }


    @keyframes bob {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    .image-container {
      position: relative;
      perspective: 1000px;
      animation: bob 3s ease-in-out infinite;
      width: min(202px, 85vw);
      aspect-ratio: 629 / 839;
      margin-bottom: 20px;
    }

    .flip-card {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      filter: drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4));
    }
    .image-container:focus-visible {
      outline: 3px solid #ffeb3b;
      outline-offset: 6px;
      border-radius: 8px;
    }

    .flip-card-front,
    .flip-card-back {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .flip-card-back {
      transform: rotateY(180deg);
    }

    .flip-card img {
      max-width: 100%;
      height: 100%;
      object-fit: cover;
      box-shadow: 0 0 40px rgba(255, 235, 59, 0.5), 0 0 80px rgba(255, 152, 86, 0.3), inset 0 0 30px rgba(255, 235, 59, 0.2);
      border-radius: 8px;
    }

    h1 {
      font-family: 'Press Start 2P', cursive;
      font-size: clamp(1.2rem, 5vw, 2.5rem);
      font-weight: 400;
      margin: 20px 0 10px 0;
      color: #ffffff;
      letter-spacing: 2px;
      animation: titleScale 0.8s ease-out, titleGlow 3s ease-in-out infinite 0.8s;
      text-align: center;
      text-transform: uppercase;
    }
    /* Hidden outside the Minecraft theme -- every other theme just shows
       the plain "a" text next to it normally. */
    .letter-a-creeper { display: none; }

    a.big,
    button.big {
      position: relative;
      overflow: hidden;
      text-decoration: none;
      padding: 18px 26px;
      border-radius: 0;
      background: #1d2330;
      border: 1px solid #2a3245;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      font-size: clamp(20px, 4vw, 34px);
      letter-spacing: 0.3px;
      color: #ffffff;
      cursor: none;
      transition: transform 0.2s, box-shadow 0.2s;
      display: block;
      margin: 16px auto;
    }

    a.big:hover,
    button.big:hover {
      animation: buttonPop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    /* Diagonal shine sweep on hover — a light band slides across the
       button. content-only, ::before, so it never displaces the label or
       interferes with the neon glow variants below. */
    a.big::before,
    button.big::before {
      content: '';
      position: absolute;
      top: 0;
      left: -75%;
      width: 45%;
      height: 100%;
      background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.45), transparent);
      transform: skewX(-20deg);
      transition: left 0.55s ease;
      pointer-events: none;
    }
    a.big:hover::before,
    button.big:hover::before {
      left: 125%;
    }
    @media (prefers-reduced-motion: reduce) {
      a.big::before, button.big::before { display: none; }
    }

    /* The menu is one column of large buttons with room between them, so the
       page scrolls and nothing is crammed. Each button drops in one after
       another on load and lifts a little on hover. Reduced-motion visitors
       get the same layout without the animation. */
    .button-grid {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 30px;
      max-width: 560px;
      width: 100%;
      margin: 36px auto 0;
      padding: 0 16px 56px;
    }
    .button-grid > .big {
      position: relative;
      width: 100%;
      max-width: 520px;
      min-height: 92px;
      margin: 0;
      padding: 26px 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      line-height: 1.25;
      font-size: clamp(18px, 2.6vw, 26px);
      box-shadow: 0 12px 26px rgba(0, 0, 0, 0.4);
      transition: transform 0.25s cubic-bezier(0.34, 1.4, 0.64, 1);
      will-change: transform;
    }
    /* Hover: the button grows a little and wobbles once. It never fades or drops
       in, so it is always fully visible. */
    .button-grid > .big:hover {
      transform: scale(1.05);
      animation: buttonWobble 0.6s ease-in-out;
    }
    .button-grid > .big:active {
      transform: scale(0.98);
    }
    /* Spring Morning in the Han Palace: the menu buttons are carved jade, with a green glow. */
    body.theme-han a.big, body.theme-han button.big {
      background: #1d5c35 url('/textures/jade.jpg') center / cover no-repeat !important;
      border-color: #4cff7a !important; color: #e6ffe9 !important;
      text-shadow: 0 0 6px rgba(76, 255, 122, 0.8), 1px 1px 0 #0a2a16 !important;
      box-shadow: 0 0 18px rgba(76, 255, 122, 0.55), inset 0 0 12px rgba(120, 255, 170, 0.3) !important;
    }
    body.theme-han a.big:hover, body.theme-han button.big:hover {
      box-shadow: 0 0 28px rgba(76, 255, 122, 0.95), inset 0 0 14px rgba(150, 255, 190, 0.45) !important;
    }
    body.theme-han #inv-btn, body.theme-han #bg-btn, body.theme-han #cursor-btn, body.theme-han #account-btn,
    body.theme-han #patch-btn, body.theme-han #suggest-btn, body.theme-han #ending-link {
      border-color: #4cff7a !important; box-shadow: 0 0 12px rgba(76, 255, 122, 0.6) !important;
    }
    /* The picture and the counter glow green in the Han theme too. !important beats the
       gold glow animation on the flip card. */
    body.theme-han .flip-card {
      filter: drop-shadow(0 0 30px rgba(76, 255, 122, 0.6)) drop-shadow(0 0 60px rgba(150, 255, 190, 0.4)) !important;
    }
    body.theme-han #topia-timer {
      background: #1d5c35 url('/textures/jade.jpg') center / cover no-repeat !important;
      color: #8bffb0 !important; border-color: #4cff7a !important; box-shadow: 0 0 14px rgba(76, 255, 122, 0.6) !important;
      text-shadow: 0 0 8px rgba(76, 255, 122, 0.8) !important;
    }
    /* A gap between the Patch Notes and Suggest buttons in the top-left corner. */
    /* The top-left button stack: every button the same height, and each one 50px
       below the last, so the gaps between them are all equal. */
    #inv-btn, #bg-btn, #cursor-btn, #ending-link, #patch-btn, #suggest-btn {
      height: 40px !important; box-sizing: border-box !important; margin: 0 !important;
      display: flex !important; align-items: center !important;
    }
    /* The graphics mode row in the Background picker. */
    .graphics-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:14px 0 6px; padding-top:12px; border-top:1px solid rgba(255,255,255,0.15); font-size:12px; }
    .graphics-toggle { font:inherit; font-size:12px; padding:8px 12px; cursor:pointer; }
    @keyframes buttonWobble {
      0%   { transform: scale(1.05) rotate(0deg); }
      25%  { transform: scale(1.07) rotate(-1.2deg); }
      50%  { transform: scale(1.07) rotate(1deg); }
      75%  { transform: scale(1.05) rotate(-0.5deg); }
      100% { transform: scale(1.05) rotate(0deg); }
    }
    @media (prefers-reduced-motion: reduce) {
      .button-grid > .big:hover { animation: none; }
    }
    /* Looping glows and pulses repaint their element every frame. While the page
       is moving, pause them so scrolling stays smooth; they resume when it stops. */
    body.is-scrolling * { animation-play-state: paused !important; }

    /* Neon sign buttons */
    a.big.neon-yt {
      background: #200000;
      border: 2px solid #ff1a1a;
      color: #ffffff;
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff, 0 0 20px rgba(255, 255, 255, 0.6);
      box-shadow: 0 0 6px #ff1a1a, 0 0 16px #ff1a1a, 0 0 32px rgba(255, 26, 26, 0.5), inset 0 0 10px rgba(255, 26, 26, 0.2);
      text-transform: uppercase;
    }
    a.big.neon-yt:hover {
      text-shadow: 0 0 6px #ffffff, 0 0 14px #ffffff, 0 0 28px rgba(255, 255, 255, 0.7);
      box-shadow: 0 0 10px #ff1a1a, 0 0 24px #ff1a1a, 0 0 48px rgba(255, 26, 26, 0.6), inset 0 0 14px rgba(255, 26, 26, 0.3);
    }

    a.big.neon-gamble {
      background: #0a1128;
      border: 2px solid #2979ff;
      color: #ff0000;
      text-shadow: 0 0 5px #ff0000, 0 0 10px #ff0000, 0 0 20px #ff0000, 0 0 40px rgba(255, 0, 0, 0.6);
      box-shadow: 0 0 6px #2979ff, 0 0 16px #2979ff, 0 0 32px rgba(41, 121, 255, 0.5), inset 0 0 10px rgba(41, 121, 255, 0.15);
    }
    a.big.neon-gamble:hover {
      text-shadow: 0 0 6px #ff0000, 0 0 14px #ff0000, 0 0 28px #ff0000, 0 0 56px rgba(255, 0, 0, 0.7);
      box-shadow: 0 0 10px #2979ff, 0 0 24px #2979ff, 0 0 48px rgba(41, 121, 255, 0.6), inset 0 0 14px rgba(41, 121, 255, 0.2);
    }

    a.big.neon-never {
      background: #332800;
      border: 2px solid #fff176;
      color: #fff176;
      text-shadow: 0 0 5px #e6a700, 0 0 10px #e6a700, 0 0 20px #e6a700, 0 0 40px rgba(230, 167, 0, 0.6);
      box-shadow: 0 0 6px #e6a700, 0 0 16px #e6a700, 0 0 32px rgba(230, 167, 0, 0.5), inset 0 0 10px rgba(230, 167, 0, 0.15);
    }
    a.big.neon-never:hover {
      text-shadow: 0 0 6px #e6a700, 0 0 14px #e6a700, 0 0 28px #e6a700, 0 0 56px rgba(230, 167, 0, 0.7);
      box-shadow: 0 0 10px #e6a700, 0 0 24px #e6a700, 0 0 48px rgba(230, 167, 0, 0.6), inset 0 0 14px rgba(230, 167, 0, 0.2);
    }

    a.big.neon-mines {
      background: #041505;
      border: 2px solid #4caf50;
      color: #4caf50;
      text-shadow: 0 0 5px #4caf50, 0 0 10px #4caf50, 0 0 20px #4caf50, 0 0 40px rgba(76, 175, 80, 0.6);
      box-shadow: 0 0 6px #4caf50, 0 0 16px #4caf50, 0 0 32px rgba(76, 175, 80, 0.5), inset 0 0 10px rgba(76, 175, 80, 0.15);
    }
    a.big.neon-mines:hover {
      text-shadow: 0 0 6px #4caf50, 0 0 14px #4caf50, 0 0 28px #4caf50, 0 0 56px rgba(76, 175, 80, 0.7);
      box-shadow: 0 0 10px #4caf50, 0 0 24px #4caf50, 0 0 48px rgba(76, 175, 80, 0.6), inset 0 0 14px rgba(76, 175, 80, 0.2);
    }

    button.big.neon-daily {
      background: #221800;
      border: 2px solid #ffd700;
      color: #ffd700;
      text-shadow: 0 0 5px #ffd700, 0 0 10px #ffd700, 0 0 20px #ffd700, 0 0 40px rgba(255, 215, 0, 0.6);
      box-shadow: 0 0 6px #ffd700, 0 0 16px #ffd700, 0 0 32px rgba(255, 215, 0, 0.5), inset 0 0 10px rgba(255, 215, 0, 0.15);
      font-family: inherit;
      cursor: none;
    }
    button.big.neon-daily:hover:not(:disabled) {
      text-shadow: 0 0 6px #ffd700, 0 0 14px #ffd700, 0 0 28px #ffd700, 0 0 56px rgba(255, 215, 0, 0.7);
      box-shadow: 0 0 10px #ffd700, 0 0 24px #ffd700, 0 0 48px rgba(255, 215, 0, 0.6), inset 0 0 14px rgba(255, 215, 0, 0.2);
    }
    button.big.neon-daily:disabled { opacity: 0.4; cursor: none; }

    a.big.neon-tycoon {
      background: #001522;
      border: 2px solid #29b6f6;
      color: #29b6f6;
      text-shadow: 0 0 5px #29b6f6, 0 0 10px #29b6f6, 0 0 20px #29b6f6, 0 0 40px rgba(41, 182, 246, 0.6);
      box-shadow: 0 0 6px #29b6f6, 0 0 16px #29b6f6, 0 0 32px rgba(41, 182, 246, 0.5), inset 0 0 10px rgba(41, 182, 246, 0.15);
    }
    a.big.neon-tycoon:hover {
      text-shadow: 0 0 6px #29b6f6, 0 0 14px #29b6f6, 0 0 28px #29b6f6, 0 0 56px rgba(41, 182, 246, 0.7);
      box-shadow: 0 0 10px #29b6f6, 0 0 24px #29b6f6, 0 0 48px rgba(41, 182, 246, 0.6), inset 0 0 14px rgba(41, 182, 246, 0.2);
    }

    /* Temporary economy freeze -- see tycoon.astro's TYCOON_DISABLED.
       Fully non-interactive (pointer-events:none, no href on the element
       itself), not just dimmed, so there's no click or keyboard path to
       the page from here regardless of animation/hover overrides. */
    a.big.neon-tycoon.disabled {
      filter: grayscale(1);
      opacity: 0.4;
      pointer-events: none;
      animation: none !important;
      box-shadow: none;
      text-shadow: none;
      border-color: #555;
      color: #888;
      position: relative;
    }
    a.big.neon-tycoon.disabled::after {
      content: 'OUT OF ORDER';
      display: block;
      font-size: 10px;
      letter-spacing: 1px;
      margin-top: 4px;
      color: #ff6b6b;
    }

    a.big.neon-arena {
      background: #1a0800;
      border: 2px solid #ff6b1a;
      color: #ff6b1a;
      text-shadow: 0 0 5px #ff6b1a, 0 0 10px #ff6b1a, 0 0 20px #ff6b1a, 0 0 40px rgba(255, 107, 26, 0.6);
      box-shadow: 0 0 6px #ff6b1a, 0 0 16px #ff6b1a, 0 0 32px rgba(255, 107, 26, 0.5), inset 0 0 10px rgba(255, 107, 26, 0.15);
    }
    a.big.neon-arena:hover {
      text-shadow: 0 0 6px #ff6b1a, 0 0 14px #ff6b1a, 0 0 28px #ff6b1a, 0 0 56px rgba(255, 107, 26, 0.8);
      box-shadow: 0 0 10px #ff6b1a, 0 0 24px #ff6b1a, 0 0 48px rgba(255, 107, 26, 0.7), inset 0 0 14px rgba(255, 107, 26, 0.2);
    }

    a.big.neon-horse {
      background: #1a0f00;
      border: 2px solid #ff9d42;
      color: #ff9d42;
      text-shadow: 0 0 5px #ff9d42, 0 0 10px #ff9d42, 0 0 20px #ff9d42, 0 0 40px rgba(255, 157, 66, 0.6);
      box-shadow: 0 0 6px #ff9d42, 0 0 16px #ff9d42, 0 0 32px rgba(255, 157, 66, 0.5), inset 0 0 10px rgba(255, 157, 66, 0.15);
    }
    a.big.neon-horse:hover {
      text-shadow: 0 0 6px #ff9d42, 0 0 14px #ff9d42, 0 0 28px #ff9d42, 0 0 56px rgba(255, 157, 66, 0.7);
      box-shadow: 0 0 10px #ff9d42, 0 0 24px #ff9d42, 0 0 48px rgba(255, 157, 66, 0.6), inset 0 0 14px rgba(255, 157, 66, 0.2);
    }

    /* Deliberately NOT the neon-glow pattern every other button uses —
       a wooden sign bolted to the wall instead of a lit-up arcade cabinet,
       matching the Shop tile inside /lootbox's own case grid. Gold
       lettering (the site's existing --gold identity color) on oak,
       plus a diagonal glossy highlight streak for a lacquered-wood feel. */
    a.big.neon-shop {
      background:
        linear-gradient(115deg, rgba(255,255,255,.14) 0%, transparent 35%),
        repeating-linear-gradient(115deg, #4a2f1a 0 6px, #5c3b22 6px 12px, #3a2412 12px 18px);
      border: 2px solid #ffd700;
      color: #ffd700;
      text-shadow: 1px 1px 0 #000;
      box-shadow: 0 6px 14px rgba(0,0,0,.5), inset 0 0 10px rgba(255,215,0,.08);
    }
    a.big.neon-shop:hover {
      border-color: #ffe766;
      box-shadow: 0 8px 18px rgba(0,0,0,.6), inset 0 0 14px rgba(255,215,0,.16);
    }

    /* Also breaks from the neon-glow pattern — B&W newsprint instead of
       an arcade cabinet or a wooden sign, previewing the page's own Paper
       wing (Times New Roman, cool newspaper grey) right on the homepage. */
    a.big.neon-news {
      background: #d9d9d9;
      border: 2px solid #1a1a1a;
      color: #1a1a1a;
      font-family: 'Times New Roman', Times, serif;
      text-shadow: none;
      box-shadow: 0 6px 14px rgba(0,0,0,.35);
    }
    a.big.neon-news:hover {
      background: #e8e8e8;
      box-shadow: 0 8px 18px rgba(0,0,0,.45);
    }

    /* ---------- Hello Kitty theme ---------- */
    /* Overrides every button's colors while the Hello Kitty background is
       active, including the neon variants above — matched selector-for-
       selector against them (rather than !important) so it wins on
       specificity alone and stays easy to extend later. */
    body.theme-hello-kitty a.big,
    body.theme-hello-kitty button.big,
    body.theme-hello-kitty a.big.neon-yt,
    body.theme-hello-kitty a.big.neon-gamble,
    body.theme-hello-kitty a.big.neon-never,
    body.theme-hello-kitty a.big.neon-mines,
    body.theme-hello-kitty a.big.neon-tycoon,
    body.theme-hello-kitty a.big.neon-horse,
    body.theme-hello-kitty a.big.neon-shop,
    body.theme-hello-kitty a.big.neon-news,
    body.theme-hello-kitty button.big.neon-daily,
    body.theme-hello-kitty #inv-btn,
    body.theme-hello-kitty #bg-btn,
    body.theme-hello-kitty #cursor-btn,
    body.theme-hello-kitty #account-btn,
    body.theme-hello-kitty #patch-btn, body.theme-hello-kitty #suggest-btn,
    body.theme-hello-kitty #now-playing,
    body.theme-hello-kitty #ending-link {
      background: #ffb6d9;
      border-color: #ff5fa8;
      color: #9c004f;
      text-shadow: none;
      box-shadow: 0 10px 24px rgba(255, 95, 168, 0.4);
    }
    body.theme-hello-kitty a.big:hover,
    body.theme-hello-kitty button.big:hover,
    body.theme-hello-kitty #inv-btn:hover,
    body.theme-hello-kitty #bg-btn:hover,
    body.theme-hello-kitty #cursor-btn:hover,
    body.theme-hello-kitty #account-btn:hover,
    body.theme-hello-kitty #patch-btn:hover, body.theme-hello-kitty #suggest-btn:hover,
    body.theme-hello-kitty #now-playing:hover,
    body.theme-hello-kitty #ending-link:hover {
      background: #ffd1e8;
      box-shadow: 0 0 16px rgba(255, 95, 168, 0.6), 0 10px 24px rgba(255, 95, 168, 0.4);
    }

    /* Falling cherry blossom overlay — only visible while the Hello Kitty
       theme is active. Tiled so it covers the full viewport regardless of
       screen size, same technique as the inventory room's #leaf-overlay —
       except that gif's background is dark and transparent (screen blend
       hides black), while this one's is opaque white/pale blue, so it
       needs the opposite blend mode (multiply hides white) instead of
       actual transparency to avoid washing out everything underneath it. */
    #sakura-overlay {
      position: fixed; inset: 0; z-index: 2; pointer-events: none;
      display: none;
      background-image: url('/video/cherry-blossom.gif');
      background-repeat: repeat;
      background-size: 260px 115px;
      opacity: 0.55;
      mix-blend-mode: multiply;
    }
    body.theme-hello-kitty #sakura-overlay { display: block; }

    /* ---------- Halloween free-gift toast ---------- */
