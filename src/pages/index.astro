    /* ---------- Girl Like Me theme (PinkPantheress, 137 BPM) ---------- */
    /* Pulses via filter:brightness rather than transform:scale so it never
       fights the buttons' existing hover transform (translateY) — filter
       composites independently of transform, so hover still works exactly
       as normal while this runs continuously underneath it. 60/137bpm =
       0.4380s per beat. */
    @keyframes beat-pulse {
      0%, 100% { filter: brightness(1); }
      50%      { filter: brightness(1.28); }
    }
    body.theme-girl-like-me a.big,
    body.theme-girl-like-me button.big,
    body.theme-girl-like-me #inv-btn,
    body.theme-girl-like-me #bg-btn,
    body.theme-girl-like-me #cursor-btn,
    body.theme-girl-like-me #account-btn,
    body.theme-girl-like-me #patch-btn, body.theme-girl-like-me #suggest-btn,
    body.theme-girl-like-me #now-playing,
    body.theme-girl-like-me #ending-link,
    body.theme-girl-like-me #topia-timer {
      animation: beat-pulse 0.438s ease-in-out infinite;
    }
    /* .flip-card already carries its own glow via `filter: drop-shadow(...)`
       — beat-pulse alone would clobber that (an element's `filter` keyframe
       fully replaces the property each frame, it doesn't merge with the
       base rule), so the spinning image gets its own keyframe that pulses
       brightness while keeping the same drop-shadow glow present throughout. */
    @keyframes beat-pulse-flip {
      0%, 100% { filter: brightness(1) drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4)); }
      50%      { filter: brightness(1.28) drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4)); }
    }
    body.theme-girl-like-me .flip-card {
      animation: beat-pulse-flip 0.438s ease-in-out infinite;
    }
    /* h1's own default animation (titleScale + titleGlow) never touches
       `filter`, so beat-pulse layers on cleanly without needing a combined
       keyframe the way .flip-card above did. */
    body.theme-girl-like-me h1 {
      animation: titleScale 0.8s ease-out, titleGlow 3s ease-in-out infinite 0.8s, beat-pulse 0.438s ease-in-out infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      body.theme-girl-like-me a.big,
      body.theme-girl-like-me button.big,
      body.theme-girl-like-me #inv-btn,
      body.theme-girl-like-me #bg-btn,
      body.theme-girl-like-me #cursor-btn,
      body.theme-girl-like-me #account-btn,
      body.theme-girl-like-me #patch-btn, body.theme-girl-like-me #suggest-btn,
      body.theme-girl-like-me #now-playing,
      body.theme-girl-like-me #ending-link,
      body.theme-girl-like-me #topia-timer,
      body.theme-girl-like-me .flip-card {
        animation: none;
      }
      body.theme-girl-like-me h1 {
        animation: titleScale 0.8s ease-out, titleGlow 3s ease-in-out infinite 0.8s;
      }
    }

    /* ---------- Waster / Evian Christ theme (deep UV purple, gentle glow) ---------- */
    /* Slow ambient breathing glow, not beat-locked like Girl Like Me below —
       "gentle" reads as atmospheric rather than a hard pulse, so this uses a
       long, soft ease-in-out cycle instead of a tempo-derived duration. */
    @keyframes uv-glow {
      0%, 100% { box-shadow: 0 10px 24px rgba(157, 78, 221, 0.35), 0 0 10px rgba(157, 78, 221, 0.25); }
      50%      { box-shadow: 0 10px 24px rgba(157, 78, 221, 0.55), 0 0 26px rgba(176, 38, 255, 0.65); }
    }
    body.theme-waster a.big,
    body.theme-waster button.big,
    body.theme-waster #inv-btn,
    body.theme-waster #bg-btn,
    body.theme-waster #cursor-btn,
    body.theme-waster #account-btn,
    body.theme-waster #patch-btn, body.theme-waster #suggest-btn,
    body.theme-waster #now-playing,
    body.theme-waster #ending-link,
    body.theme-evian a.big,
    body.theme-evian button.big,
    body.theme-evian #inv-btn,
    body.theme-evian #bg-btn,
    body.theme-evian #cursor-btn,
    body.theme-evian #account-btn,
    body.theme-evian #patch-btn, body.theme-evian #suggest-btn,
    body.theme-evian #now-playing,
    body.theme-evian #ending-link {
      background: #1a0533;
      border-color: #9d4edd;
      color: #e0aaff;
      text-shadow: 0 0 8px rgba(176, 38, 255, 0.6);
      animation: uv-glow 2.4s ease-in-out infinite;
    }
    body.theme-waster a.big:hover,
    body.theme-waster button.big:hover,
    body.theme-waster #inv-btn:hover,
    body.theme-waster #bg-btn:hover,
    body.theme-waster #cursor-btn:hover,
    body.theme-waster #account-btn:hover,
    body.theme-waster #patch-btn:hover, body.theme-waster #suggest-btn:hover,
    body.theme-waster #now-playing:hover,
    body.theme-waster #ending-link:hover,
    body.theme-evian a.big:hover,
    body.theme-evian button.big:hover,
    body.theme-evian #inv-btn:hover,
    body.theme-evian #bg-btn:hover,
    body.theme-evian #cursor-btn:hover,
    body.theme-evian #account-btn:hover,
    body.theme-evian #patch-btn:hover, body.theme-evian #suggest-btn:hover,
    body.theme-evian #now-playing:hover,
    body.theme-evian #ending-link:hover {
      background: #2d0a5c;
    }
    /* Spinning strubles image + Topia countdown, recolored and breathing the
       same way as the buttons above. #topia-timer already glows via
       `box-shadow` (not `filter`), so it can reuse the uv-glow keyframe
       directly — .flip-card glows via `filter: drop-shadow(...)` instead,
       which the same keyframe would clobber, so it gets its own filter-based
       version of the same breathing motion. */
    body.theme-waster #topia-timer,
    body.theme-evian #topia-timer {
      background: linear-gradient(135deg, #1a0533 0%, #2d0a5c 100%);
      color: #e0aaff;
      border-color: #9d4edd;
      animation: uv-glow 2.4s ease-in-out infinite;
    }
    @keyframes uv-glow-flip {
      0%, 100% { filter: drop-shadow(0 0 20px rgba(157, 78, 221, 0.5)) drop-shadow(0 0 40px rgba(176, 38, 255, 0.3)); }
      50%      { filter: drop-shadow(0 0 30px rgba(157, 78, 221, 0.75)) drop-shadow(0 0 55px rgba(176, 38, 255, 0.55)); }
    }
    body.theme-waster .flip-card,
    body.theme-evian .flip-card {
      animation: uv-glow-flip 2.4s ease-in-out infinite;
    }
    @keyframes titleGlowPurple {
      0%, 100%  { text-shadow: 0 0 10px rgba(157, 78, 221, 0.4), 0 0 20px rgba(224, 170, 255, 0.3); }
      50%       { text-shadow: 0 0 20px rgba(176, 38, 255, 0.7), 0 0 40px rgba(224, 170, 255, 0.5), 0 0 60px rgba(157, 78, 221, 0.3); }
    }
    body.theme-waster h1, body.theme-evian h1 {
      color: #e0aaff;
      animation: titleScale 0.8s ease-out, titleGlowPurple 2.4s ease-in-out infinite 0.8s;
    }
    @media (prefers-reduced-motion: reduce) {
      body.theme-waster a.big, body.theme-waster button.big,
      body.theme-waster #inv-btn, body.theme-waster #bg-btn,
      body.theme-waster #cursor-btn, body.theme-waster #account-btn, body.theme-waster #patch-btn, body.theme-waster #suggest-btn,
      body.theme-waster #now-playing, body.theme-waster #ending-link,
      body.theme-waster #topia-timer,
      body.theme-evian a.big, body.theme-evian button.big,
      body.theme-evian #inv-btn, body.theme-evian #bg-btn,
      body.theme-evian #cursor-btn, body.theme-evian #account-btn, body.theme-evian #patch-btn, body.theme-evian #suggest-btn,
      body.theme-evian #now-playing, body.theme-evian #ending-link,
      body.theme-evian #topia-timer {
        animation: none;
        box-shadow: 0 10px 24px rgba(157, 78, 221, 0.45), 0 0 16px rgba(176, 38, 255, 0.45);
      }
      body.theme-waster .flip-card, body.theme-evian .flip-card {
        animation: none;
        filter: drop-shadow(0 0 26px rgba(157, 78, 221, 0.6)) drop-shadow(0 0 48px rgba(176, 38, 255, 0.4));
      }
      body.theme-waster h1, body.theme-evian h1 {
        animation: titleScale 0.8s ease-out;
        text-shadow: 0 0 16px rgba(176, 38, 255, 0.6), 0 0 32px rgba(224, 170, 255, 0.4);
      }
    }

    /* ---------- Clarity theme (Zedd ft. Foxes, 128 BPM) ---------- */
    /* Smooth continuous RGB hue-cycle rather than a discrete per-beat jump —
       "RGB style" reads as the gamer-peripheral rainbow sweep. Duration is
       still tempo-derived (one full 360° cycle every 4 beats, a normal
       musical phrase length) so it still visibly rides the track's pace:
       60/128bpm = 0.46875s/beat * 4 = 1.875s. */
    @keyframes rgb-cycle {
      0%   { filter: hue-rotate(0deg); }
      100% { filter: hue-rotate(360deg); }
    }
    body.theme-clarity a.big,
    body.theme-clarity button.big,
    body.theme-clarity #inv-btn,
    body.theme-clarity #bg-btn,
    body.theme-clarity #cursor-btn,
    body.theme-clarity #account-btn,
    body.theme-clarity #patch-btn, body.theme-clarity #suggest-btn,
    body.theme-clarity #now-playing,
    body.theme-clarity #ending-link,
    body.theme-clarity #topia-timer {
      animation: rgb-cycle 1.875s linear infinite;
    }
    /* #topia-timer has no `filter` of its own, so it can reuse rgb-cycle as-is
       (hue-rotate rotates its whole rendered box — bg, border, box-shadow,
       text — together). .flip-card already uses `filter` for its own glow,
       so like the other themes above it needs the hue-rotate combined into
       the same filter list as its drop-shadows, not a bare swap. */
    @keyframes rgb-cycle-flip {
      0%   { filter: hue-rotate(0deg) drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4)); }
      100% { filter: hue-rotate(360deg) drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4)); }
    }
    body.theme-clarity .flip-card {
      animation: rgb-cycle-flip 1.875s linear infinite;
    }
    /* h1 has no `filter` of its own either (titleGlow only sets
       text-shadow), so — like #topia-timer above — rgb-cycle just layers
       on as a second animation, no combined keyframe needed. */
    body.theme-clarity h1 {
      animation: titleScale 0.8s ease-out, titleGlow 3s ease-in-out infinite 0.8s, rgb-cycle 1.875s linear infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      body.theme-clarity a.big, body.theme-clarity button.big,
      body.theme-clarity #inv-btn, body.theme-clarity #bg-btn,
      body.theme-clarity #cursor-btn, body.theme-clarity #account-btn, body.theme-clarity #patch-btn, body.theme-clarity #suggest-btn,
      body.theme-clarity #now-playing, body.theme-clarity #ending-link,
      body.theme-clarity #topia-timer, body.theme-clarity .flip-card {
        animation: none;
      }
      body.theme-clarity h1 {
        animation: titleScale 0.8s ease-out, titleGlow 3s ease-in-out infinite 0.8s;
      }
    }

    /* ---------- Minecraft theme (stone GUI buttons, diamond-block countdown) ---------- */
    /* Static, like Hello Kitty / Old People Slot above -- the panorama loop
       and OST already carry all the motion/atmosphere this theme needs, so
       buttons don't also need their own pulse. Real polished-stone texture
       (was a hand-rolled radial-gradient speckle pattern before the actual
       asset existed), stretched to exactly fill each button's rectangle --
       same no-repeat/100% 100% treatment as the diamond-block countdown,
       since it's one texture swatch, not a repeating tile. Button label
       text is normal element content, which always paints above its own
       background by default, so it stays legible over the texture with no
       extra z-index/layering needed -- same as the countdown badge. */
    body.theme-minecraft a.big,
    body.theme-minecraft button.big,
    body.theme-minecraft #inv-btn,
    body.theme-minecraft #bg-btn,
    body.theme-minecraft #cursor-btn,
    body.theme-minecraft #account-btn,
    body.theme-minecraft #patch-btn, body.theme-minecraft #suggest-btn,
    body.theme-minecraft #now-playing,
    body.theme-minecraft #ending-link {
      background-color: #8b8b8b;
      background-image: url('/assets/decorations/polished-stone.png');
      background-size: 100% 100%;
      background-repeat: no-repeat;
      border-style: solid;
      border-width: 4px;
      border-top-color: #d8d8d8;
      border-left-color: #d8d8d8;
      border-bottom-color: #2b2b2b;
      border-right-color: #2b2b2b;
      color: #ffffff;
      text-shadow: 2px 2px 0 #3f3f3f;
      box-shadow: none;
      image-rendering: pixelated;
    }
    body.theme-minecraft a.big:hover,
    body.theme-minecraft button.big:hover,
    body.theme-minecraft #inv-btn:hover,
    body.theme-minecraft #bg-btn:hover,
    body.theme-minecraft #cursor-btn:hover,
    body.theme-minecraft #account-btn:hover,
    body.theme-minecraft #patch-btn:hover, body.theme-minecraft #suggest-btn:hover,
    body.theme-minecraft #now-playing:hover,
    body.theme-minecraft #ending-link:hover {
      /* background-color alone would go invisible now -- the opaque
         texture image sits on top of it and fully occludes it. A
         brightness filter lightens the actual visible texture instead,
         same lit-up-on-hover read as the old color swap gave. */
      filter: brightness(1.18);
      color: #ffff5c;
    }
    /* Pressed feedback: bevel inverts, like a real GUI button being pushed
       in, instead of the default lift-up translateY every other theme
       keeps -- flatter and truer to the source than a floaty hover. */
    body.theme-minecraft a.big:active,
    body.theme-minecraft button.big:active {
      border-top-color: #2b2b2b;
      border-left-color: #2b2b2b;
      border-bottom-color: #d8d8d8;
      border-right-color: #d8d8d8;
      transform: none;
    }
    body.theme-minecraft .flip-card {
      filter: drop-shadow(0 0 24px rgba(90, 165, 60, 0.65)) drop-shadow(0 0 48px rgba(63, 145, 48, 0.4));
    }
    /* Stone-block title, matching the real Minecraft logo's look. The
       first version used background-clip:text for the grey gradient --
       confirmed (via an actual screenshot) to silently fail in at least
       one real browser, falling back to solid black text with the shadow
       stacked on top instead of behind it. Rebuilt on `color` +
       `text-shadow` only, which every browser supports the same way: a
       flat mid-grey fill, a light 1-2px offset highlight (catching the
       light from the upper-left, same direction real beveled block
       lettering highlights from), then the hard black depth shadow
       stacked down-right. No background-clip anywhere, so there's no
       silent-failure mode left for it to fall into. Static, not pulsing
       -- the real logo doesn't animate either. */
    body.theme-minecraft h1 {
      color: #9c9c9c;
      text-shadow:
        -1px -1px 0 #d8d8d8,
        -2px -2px 0 #c2c2c2,
        3px 3px 0 #000,
        6px 6px 0 rgba(0,0,0,.75);
      animation: titleScale 0.8s ease-out;
    }
    /* The real Minecraft logo cuts an actual hole through the letter A,
       shaped like a creeper's face -- not a face drawn on top of it. That
       can't be done with live browser-rendered text (no way to punch an
       arbitrary hole out of one glyph's counter via CSS alone), so this
       swaps the two A's for a pre-rendered image instead: a solid stone
       "A" silhouette with the grey gradient and hard shadow baked in
       (composited in the correct paint order directly, sidestepping the
       background-clip fallback risk above) and the creeper silhouette
       genuinely cut out with real alpha transparency -- through it you
       see whatever's actually behind the heading, same as the reference. */
    /* Real diamond block texture now (was a hand-rolled conic-gradient
       facet pattern before the actual asset existed) -- stretched to
       exactly fill the badge's rectangle rather than tiled, since it's a
       single square swatch, not a repeating pattern. #topia-timer's text
       is normal element content, which browsers always paint above its
       own background by default, so no z-index/layering needed to keep
       the countdown readable over the texture -- the existing text-shadow
       is what carries readability against the busier image underneath. */
    body.theme-minecraft #topia-timer {
      background-color: #4a9c92;
      background-image: url('/assets/decorations/diamond-block.webp');
      background-size: 100% 100%;
      background-repeat: no-repeat;
      border-style: solid;
      border-width: 3px;
      border-color: #1f2321;
      color: #ffffff;
      text-shadow: 2px 2px 0 #14312d;
      box-shadow: none;
      image-rendering: pixelated;
    }

    /* ---------- Mongolia theme ---------- */
    /* Fur texture on every button, but `cover` + centered instead of the
       Minecraft treatment's 100% 100% stretch: buttons here have wildly
       different aspect ratios (long nav links vs. square icon buttons),
       and a real photographic fur texture warps badly when squashed to
       fit each one exactly. `cover` crops instead of distorting, so every
       button shows a clean, undistorted patch of the same texture. */
    body.theme-mongolia a.big,
    body.theme-mongolia button.big,
    body.theme-mongolia #inv-btn,
    body.theme-mongolia #bg-btn,
    body.theme-mongolia #cursor-btn,
    body.theme-mongolia #account-btn,
    body.theme-mongolia #patch-btn, body.theme-mongolia #suggest-btn,
    body.theme-mongolia #now-playing,
    body.theme-mongolia #ending-link {
      background-color: #6b4a2e;
      background-image: url('/assets/decorations/fur-texture.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      border-style: solid;
      border-width: 3px;
      border-color: #2c1c10;
      color: #ffffff;
      text-shadow: 0 0 6px rgba(224,52,44,.9), 0 0 14px rgba(224,52,44,.55), 2px 2px 0 rgba(0,0,0,.6);
      box-shadow: 0 0 16px rgba(224,52,44,.35);
    }
    body.theme-mongolia a.big:hover,
    body.theme-mongolia button.big:hover,
    body.theme-mongolia #inv-btn:hover,
    body.theme-mongolia #bg-btn:hover,
    body.theme-mongolia #cursor-btn:hover,
    body.theme-mongolia #account-btn:hover,
    body.theme-mongolia #patch-btn:hover, body.theme-mongolia #suggest-btn:hover,
    body.theme-mongolia #now-playing:hover,
    body.theme-mongolia #ending-link:hover {
      filter: brightness(1.2);
      box-shadow: 0 0 28px rgba(224,52,44,.65);
    }
    body.theme-mongolia .flip-card {
      filter: drop-shadow(0 0 24px rgba(224,52,44,.65)) drop-shadow(0 0 48px rgba(170,28,20,.4));
    }
    body.theme-mongolia h1 {
      color: #ffffff;
      text-shadow:
        0 0 8px rgba(224,52,44,.95),
        0 0 20px rgba(224,52,44,.7),
        0 0 42px rgba(224,52,44,.4),
        2px 2px 0 rgba(0,0,0,.55);
    }
    /* Same cover/crop treatment as the buttons, just with the grass swatch
       instead of fur, and a red-glow border/text to match the theme
       instead of Minecraft's diamond teal. */
    body.theme-mongolia #topia-timer {
      background-color: #3d5a2c;
      background-image: url('/assets/decorations/mongolia-grass-texture.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      border-style: solid;
      border-width: 3px;
      border-color: #e0342c;
      color: #ffffff;
      text-shadow: 0 0 6px rgba(224,52,44,.9), 2px 2px 0 rgba(0,0,0,.6);
      box-shadow: 0 0 18px rgba(224,52,44,.5);
    }

    /* ---------- Dreamer theme ---------- */
    /* Flat black everywhere, carried entirely by a strong white glow --
       no texture image this time (Storm's own footage already supplies
       all the visual noise), so the chrome reads as calm/graphic against
       it instead of competing with it. */
    body.theme-dreamer a.big,
    body.theme-dreamer button.big,
    body.theme-dreamer #inv-btn,
    body.theme-dreamer #bg-btn,
    body.theme-dreamer #cursor-btn,
    body.theme-dreamer #account-btn,
    body.theme-dreamer #patch-btn, body.theme-dreamer #suggest-btn,
    body.theme-dreamer #now-playing,
    body.theme-dreamer #ending-link {
      background-color: #000000;
      background-image: none;
      border-style: solid;
      border-width: 2px;
      border-color: #ffffff;
      color: #ffffff;
      text-shadow: 0 0 6px rgba(255,255,255,.95), 0 0 14px rgba(255,255,255,.6);
      box-shadow: 0 0 14px rgba(255,255,255,.55), 0 0 30px rgba(255,255,255,.3);
    }
    body.theme-dreamer a.big:hover,
    body.theme-dreamer button.big:hover,
    body.theme-dreamer #inv-btn:hover,
    body.theme-dreamer #bg-btn:hover,
    body.theme-dreamer #cursor-btn:hover,
    body.theme-dreamer #account-btn:hover,
    body.theme-dreamer #patch-btn:hover, body.theme-dreamer #suggest-btn:hover,
    body.theme-dreamer #now-playing:hover,
    body.theme-dreamer #ending-link:hover {
      box-shadow: 0 0 22px rgba(255,255,255,.85), 0 0 46px rgba(255,255,255,.5);
    }
    body.theme-dreamer .flip-card {
      filter: drop-shadow(0 0 22px rgba(255,255,255,.75)) drop-shadow(0 0 46px rgba(255,255,255,.4));
    }
    body.theme-dreamer h1 {
      color: #ffffff;
      text-shadow:
        0 0 8px rgba(255,255,255,1),
        0 0 20px rgba(255,255,255,.8),
        0 0 42px rgba(255,255,255,.5),
        2px 2px 0 rgba(0,0,0,.6);
    }
    body.theme-dreamer #topia-timer {
      background-color: #000000;
      background-image: none;
      border-style: solid;
      border-width: 3px;
      border-color: #ffffff;
      color: #ffffff;
      text-shadow: 0 0 6px rgba(255,255,255,.95), 0 0 14px rgba(255,255,255,.6);
      box-shadow: 0 0 20px rgba(255,255,255,.6), 0 0 40px rgba(255,255,255,.3);
    }

    /* ---------- Halloween (seasonal default for all of October — see
       isHalloweenSeason()/getActiveBgKey()/getActiveTrackKey()). Same
       body.theme-X pattern as every theme above; nothing here is reachable
       outside October since nothing ever adds this class then. */
    /* The Halloween title sits still: the ghost copy behind it doesn't flicker,
       and the Haunted word only lights up (white) when hovered. */
    body.theme-halloween .ghost-title h1::before { animation: none; opacity: 0; }
    body.theme-halloween .haunted-word:hover,
    body.theme-halloween .haunted-word:focus-visible {
      text-shadow: 0 0 6px #fff, 0 0 14px #fff, 0 0 24px #fff !important;
      color: #fff !important;
    }
    @keyframes halloweenTitleGlow {
      0%, 100% { text-shadow: 0 0 6px #000, 2px 2px 0 #000, -2px 2px 0 #000, 0 0 18px rgba(255,111,0,.7), 0 0 36px rgba(94,23,168,.5); }
      50%      { text-shadow: 0 0 10px #000, 2px 2px 0 #000, -2px 2px 0 #000, 0 0 26px rgba(255,111,0,1), 0 0 52px rgba(94,23,168,.8); }
    }
    body.theme-halloween h1 {
      color: #ff6f00;
      -webkit-text-stroke: 1.5px #ffffff;
      paint-order: stroke fill;
      animation: titleScale 0.8s ease-out;
    }
    body.theme-halloween .flip-card {
      filter: drop-shadow(0 0 26px rgba(94,23,168,.8)) drop-shadow(0 0 52px rgba(57,255,20,.35));
    }
    body.theme-halloween .flip-card img {
      box-shadow: 0 0 40px rgba(94,23,168,.65), 0 0 80px rgba(94,23,168,.4), inset 0 0 30px rgba(94,23,168,.3);
    }
    /* The clickable word "Haunted" in the title. */
    .haunted-word { cursor: pointer; border-radius: 2px; transition: text-shadow .2s; }
    .haunted-word:hover, .haunted-word:focus-visible { text-shadow: 0 0 14px rgba(255,111,0,.9); outline: none; }
    /* Crawling spider: a large spider that walks straight across the whole
       screen, over the UI, and is gone again. It starts and ends fully off
       screen, so it never pops in or gets cut off at an edge. Decorative only
       (pointer-events off, hidden from assistive tech); Halloween theme only,
       so it goes with the rest of the theme on November 1st. The JavaScript
       below drives the movement. */
    #spider-crawler { display: none; }
    body.theme-halloween #spider-crawler {
      display: block; position: fixed; left: 0; top: 0; z-index: 9000;
      width: clamp(240px, 34vw, 380px); pointer-events: none; opacity: 0;
      will-change: transform;
    }
    body.theme-halloween #spider-crawler img {
      display: block; width: 100%; height: auto;
      filter: drop-shadow(0 0 6px rgba(94,23,168,.9)) drop-shadow(0 0 14px rgba(255,111,0,.45));
    }
    /* Buttons cycle through the three theme colours rather than one flat
       recolour — the three-colour "pumpkin / witch / radioactive" palette
       is the point, a single colour would read as just another theme. */
    body.theme-halloween a.big.neon-gamble, body.theme-halloween a.big.neon-arena,
    body.theme-halloween button.big.neon-daily, body.theme-halloween a.big.neon-tycoon {
      background: #2a1206; border-color: #ff6f00; color: #ffb74d;
      box-shadow: 0 10px 24px rgba(255,111,0,.35);
    }
    body.theme-halloween a.big.neon-gamble:hover, body.theme-halloween a.big.neon-arena:hover,
    body.theme-halloween button.big.neon-daily:hover:not(:disabled), body.theme-halloween a.big.neon-tycoon:hover {
      background: #ff6f00; color: #1a0a00; box-shadow: 0 0 30px rgba(255,111,0,.7);
    }
    body.theme-halloween a.big.neon-mines, body.theme-halloween a.big.neon-shop,
    body.theme-halloween a.big.neon-yt {
      background: #1c0b2e; border-color: #5e17a8; color: #ce93d8;
      box-shadow: 0 10px 24px rgba(94,23,168,.4);
    }
    body.theme-halloween a.big.neon-mines:hover, body.theme-halloween a.big.neon-shop:hover,
    body.theme-halloween a.big.neon-yt:hover {
      background: #5e17a8; color: #fff; box-shadow: 0 0 30px rgba(94,23,168,.8);
    }
    body.theme-halloween a.big.neon-horse, body.theme-halloween a.big.neon-news,
    body.theme-halloween a.big.neon-never {
      background: #0d1f0a; border-color: #39ff14; color: #a5ff8f;
      box-shadow: 0 10px 24px rgba(57,255,20,.3);
    }
    body.theme-halloween a.big.neon-horse:hover, body.theme-halloween a.big.neon-news:hover,
    body.theme-halloween a.big.neon-never:hover {
      background: #39ff14; color: #072005; box-shadow: 0 0 30px rgba(57,255,20,.6);
    }
    /* Small utility chrome (inventory/background/cursor/account/patch notes/
       suggest/now-playing) gets one consistent accent rather than joining
       the three-way cycle — they're chrome, not the seasonal centrepiece. */
    body.theme-halloween #inv-btn, body.theme-halloween #bg-btn,
    body.theme-halloween #cursor-btn, body.theme-halloween #account-btn,
    body.theme-halloween #patch-btn, body.theme-halloween #suggest-btn,
    body.theme-halloween #now-playing, body.theme-halloween #ending-link {
      background: #1c0b2e; border-color: #5e17a8; color: #ce93d8;
      box-shadow: 0 10px 24px rgba(94,23,168,.4);
    }
    body.theme-halloween #inv-btn:hover, body.theme-halloween #bg-btn:hover,
    body.theme-halloween #cursor-btn:hover, body.theme-halloween #account-btn:hover,
    body.theme-halloween #patch-btn:hover, body.theme-halloween #suggest-btn:hover,
    body.theme-halloween #now-playing:hover, body.theme-halloween #ending-link:hover {
      background: #5e17a8; color: #fff; box-shadow: 0 0 30px rgba(94,23,168,.8);
    }
    body.theme-halloween #topia-timer {
      background-color: #1a0a00; background-image: none;
      border-style: solid; border-width: 3px; border-color: #ff6f00;
      color: #ffb74d; text-shadow: 0 0 6px rgba(255,111,0,.9);
      box-shadow: 0 0 20px rgba(255,111,0,.5), 0 0 40px rgba(94,23,168,.3);
    }

    /* ---------- Daily struble reel ---------- */
    #daily-reel-overlay {
      display:none; position:fixed; inset:0; z-index:60;
      align-items:center; justify-content:center; background:rgba(0,0,0,.85);
      padding:20px;
    }
    #daily-reel-overlay.open { display:flex; }
    .daily-reel-box {
      width:min(560px, 96vw); background:#0a0a0a; border:4px solid #ffd700;
      padding:24px; box-shadow:0 0 40px rgba(255,215,0,.35);
    }
    .daily-reel-title {
      text-align:center; color:#ffd700; font-size:13px; letter-spacing:2px;
      margin-bottom:18px; text-transform:uppercase;
    }
    .daily-reel-viewport {
      position:relative; overflow:hidden; border:3px solid #2a3242; background:#080a0f;
      padding:14px 0; margin-bottom:18px; height:96px;
      -webkit-mask-image:linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
      mask-image:linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
    }
    .daily-reel-strip { display:flex; gap:10px; will-change:transform; }
    .daily-reel-marker {
      position:absolute; top:0; bottom:0; left:50%; width:4px; margin-left:-2px;
      background:#ffd700; box-shadow:0 0 12px #ffd700, 0 0 24px #ffd700; z-index:5; pointer-events:none;
    }
    .daily-tile {
      flex:0 0 84px; width:84px; height:84px;
      display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
      background:#10141c; border:2px solid var(--tier-c, #2a3242); border-bottom-width:5px;
    }
    .daily-tile img { width:36px; height:36px; object-fit:contain; }
    .daily-tile .amt { font-size:9px; color:var(--tier-c, #9fb0cf); }
    .daily-tile.gold { animation: daily-gold-pulse 1s ease-in-out infinite; }
    @keyframes daily-gold-pulse {
      0%, 100% { box-shadow: 0 0 0 rgba(255,215,0,0); }
      50% { box-shadow: 0 0 18px rgba(255,215,0,.7); }
    }
    .daily-result {
      text-align:center; min-height:44px; display:flex; flex-direction:column;
      align-items:center; justify-content:center; gap:6px; margin-bottom:16px;
    }
    .daily-result .win-amt {
      font-size:22px; font-weight:400; opacity:0; transform:scale(.6);
      transition: opacity .3s ease, transform .3s cubic-bezier(.34,1.6,.64,1);
      color: #ffd700;
    }
    .daily-result .win-amt.show { opacity:1; transform:scale(1); }
    .daily-result .win-tier {
      font-size:9px; letter-spacing:2px; text-transform:uppercase; opacity:0; transition: opacity .3s ease .15s;
    }
    .daily-result .win-tier.show { opacity:1; }
    #daily-reel-close {
      all:unset; display:block; margin:0 auto; cursor:none; padding:10px 22px;
      border:3px solid #ffd700; background:#000; color:#ffd700;
      font-family: inherit; font-size:10px;
      text-transform:uppercase; letter-spacing:1px; text-align:center;
      opacity:0; pointer-events:none; transition: opacity .3s ease;
    }
    #daily-reel-close.show { opacity:1; pointer-events:auto; }
    #daily-reel-close:hover { background:#ffd700; color:#000; }

    /* Topia Timer */
    #topia-timer {
      position: fixed;
      top: calc(15px + env(safe-area-inset-top));
      right: calc(20px + env(safe-area-inset-right));
      font-size: 0.75rem;
      font-weight: 700;
      font-family: 'Press Start 2P', cursive;
      background: linear-gradient(135deg, #1a0a00 0%, #4d0000 100%);
      color: #ff3333;
      padding: 12px 16px;
      border-radius: 0;
      border: 2px solid #ff3333;
      box-shadow: 0 0 20px rgba(255, 51, 51, 0.5), inset 0 0 10px rgba(255, 51, 51, 0.1);
      text-transform: uppercase;
      letter-spacing: 1px;
      line-height: 1.4;
      max-width: min(280px, 60vw);
    }

    /* Strubles badge */
    #strubles-badge {
      position: fixed;
      top: calc(55px + env(safe-area-inset-top));
      left: calc(20px + env(safe-area-inset-left));
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 0, 0, 0.6);
      padding: 8px 12px;
      border-radius: 12px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      font-family: 'Press Start 2P', cursive;
      font-weight: 400;
      font-size: 0.75rem;
    }

    #strubles-badge img {
      width: 28px;
      height: 28px;
      border-radius: 6px;
    }

    #now-playing {
      position: fixed;
      top: calc(130px + env(safe-area-inset-top));
      right: calc(20px + env(safe-area-inset-right));
      z-index: 20;
      background: rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 235, 59, 0.5);
      border-radius: 12px;
      color: #fff;
      font-size: 10px;
      padding: 8px 12px;
      line-height: 1.4;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      cursor: none;
      max-width: 170px;
      text-align: right;
    }
    #now-playing #np-eyebrow {
      display: block;
      color: #ffeb3b;
      font-weight: 700;
      font-size: 8px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 3px;
    }
    #now-playing #np-label {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #now-playing:hover { transform: translateY(-1px); }

    #amsa-quote {
      position: fixed;
      top: calc(195px + env(safe-area-inset-top));
      right: calc(20px + env(safe-area-inset-right));
      z-index: 20;
      font-size: 7px;
      color: rgba(255, 255, 255, 0.45);
      text-align: right;
      max-width: 170px;
      font-style: italic;
      line-height: 1.4;
    }

    /* Volume + mute controls inside the Playlist popup */
    .volume-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(255, 215, 0, 0.3);
    }
    .volume-row input[type="range"] {
      flex: 1;
      accent-color: #ffeb3b;
      cursor: none;
      /* The visual track is only ~16px tall — comfortable for a mouse, easy
         for a finger to miss. Padding the element itself (not the track)
         gives it a real ~44px touch target without changing how thick the
         bar looks. touch-action:none stops a slightly-diagonal drag from
         being read as a page/modal scroll instead of a slider move, which
         is the actual failure mode on a real phone — a native range input
         handles horizontal drag itself once default touch panning is out
         of the way. */
      touch-action: none;
      padding: 14px 0;
    }
    .volume-mute-btn {
      all: unset;
      cursor: none;
      font-size: 16px;
      padding: 4px 8px;
      border: 1px solid #2a3245;
      border-radius: 8px;
      background: #1d2330;
    }

    /* Playlist / Inventory modal */
    .modal-overlay {
      display: none;
      position: fixed; inset: 0;
      background: rgba(0, 0, 0, 0.75);
      z-index: 100;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: #0a0a0f;
      border: 2px solid #ffd700;
      padding: 20px;
      width: min(380px, 90vw);
      max-height: 70vh;
      overflow-y: auto;
      box-shadow: 0 0 30px rgba(255, 215, 0, 0.4);
    }
    .suggest-tabs { display:flex; gap:6px; margin:0 0 12px; }
    .suggest-tab { flex:1; font-size:11px; padding:8px 6px; border:2px solid #555; background:#111; color:#aaa; cursor:pointer; }
    .suggest-tab.active { border-color:#ffd700; color:#ffd700; }
    .suggest-board { max-height:50vh; overflow-y:auto; display:flex; flex-direction:column; gap:10px; padding-right:4px; }
    .suggest-post { border:1px solid #444; background:#0c0c0c; padding:10px 12px; }
    .suggest-meta-row { display:flex; justify-content:space-between; gap:8px; font-size:11px; color:#888; margin-bottom:6px; }
    .suggest-meta-row b { color:#ffd700; font-size:12px; }
    .suggest-text { margin:0; font-size:13px; line-height:1.6; white-space:pre-wrap; word-break:break-word; color:#eee; }
    .suggest-empty { color:#888; font-size:12px; text-align:center; padding:20px; border:1px dashed #444; }
    .modal-box h2 {
      margin: 0 0 14px;
      color: #ffd700;
      font-size: 16px;
      font-family: 'Press Start 2P', cursive;
    }
    .modal-track {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 12px;
      border: 1px solid #333;
      margin-bottom: 8px;
      cursor: none;
      background: rgba(255, 255, 255, 0.03);
      font-size: 13px;
    }
    .modal-track.active { border-color: #4cff7a; background: rgba(76, 255, 122, 0.14); box-shadow: inset 0 0 0 2px #4cff7a; color: #4cff7a; }
    .modal-track:hover { background: rgba(255, 255, 255, 0.08); }
    .modal-empty { color: #888; font-size: 12px; padding: 8px 0 4px; }
    .modal-close {
      all: unset; cursor: none; margin-top: 14px; padding: 8px 16px;
      border: 1px solid #2a3245; background: #1d2330; color: #fff; display: inline-block;
    }

    /* Inventory button — a plain nav link to the dedicated Inventory Room
       page. Used to also be a CSS chest and a drag-to-stash target for
       collectibles rendered directly on home; that whole system moved to
       the Inventory Room so it's not the sole one still doing it. */
    #inv-btn {
      position: fixed;
      top: calc(120px + env(safe-area-inset-top));
      left: calc(20px + env(safe-area-inset-left));
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      border: 1px solid #2a3245;
      border-radius: 10px;
      padding: 6px 10px 6px 8px;
      font-weight: 600;
      cursor: none;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      z-index: 20;
    }

    #inv-btn:hover {
      transform: translateY(-1px);
    }

    #bg-btn {
      position: fixed;
      top: calc(170px + env(safe-area-inset-top));
      left: calc(20px + env(safe-area-inset-left));
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      border: 1px solid #2a3245;
      border-radius: 10px;
      padding: 6px 10px;
      font-weight: 600;
      cursor: none;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      z-index: 20;
    }
    #bg-btn:hover { transform: translateY(-1px); }

    #cursor-btn {
      position: fixed;
      top: calc(220px + env(safe-area-inset-top));
      left: calc(20px + env(safe-area-inset-left));
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      border: 1px solid #2a3245;
      border-radius: 10px;
      padding: 6px 10px;
      font-weight: 600;
      cursor: none;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      z-index: 20;
    }
    #cursor-btn:hover { transform: translateY(-1px); }

    #ending-link {
      position: fixed;
      top: calc(270px + env(safe-area-inset-top));
      left: calc(20px + env(safe-area-inset-left));
      background: rgba(0, 0, 0, 0.75);
      color: #ffd700;
      border: 1px solid #ffd700;
      border-radius: 10px;
      padding: 6px 10px;
      font-weight: 700;
      text-decoration: none;
      cursor: none;
      z-index: 20;
      box-shadow: 0 0 10px rgba(255, 215, 0, 0.35);
      animation: none;
    }
    #ending-link:hover { background: #ffd700; color: #000; }
    #ending-link[hidden] { display: none; }

    #account-btn {
      position: fixed;
      top: calc(15px + env(safe-area-inset-top));
      left: calc(20px + env(safe-area-inset-left));
      display: flex;
      align-items: center;
      gap: 5px;
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      border: 1px solid #2a3245;
