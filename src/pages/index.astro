<body>
  <!-- Defined first, before anything that needs it (the flip-card script
       right below, then the background/music resolution further down) --
       a single source of truth for "is it Halloween season right now"
       (all of October), reused everywhere instead of each place computing
       its own date check that could quietly drift out of sync. -->
  <script is:inline>
    window.isHalloweenSeason = function () { return new Date().getMonth() === 9; };
    // One-time reset for the 2026 Halloween season: clears any background or
    // track someone picked before October, so the seasonal default actually
    // shows for them. The flag makes it run once per browser; picks made
    // after this stick as usual.
    (function () {
      try {
        const FLAG = 'halloween_default_reset_2026_v1';
        if (!window.isHalloweenSeason() || localStorage.getItem(FLAG)) return;
        localStorage.removeItem('home_active_bg_v1');
        localStorage.removeItem('home_active_track_v1');
        localStorage.setItem(FLAG, '1');
      } catch {}
    })();
  </script>
  <div id="sakura-overlay" aria-hidden="true"></div>
  <div id="halloween-gift-toast" role="status" aria-live="polite"></div>
  <script is:inline>
    (function () {
      var timer = null;
      window.addEventListener('scroll', function () {
        document.body.classList.add('is-scrolling');
        clearTimeout(timer);
        timer = setTimeout(function () { document.body.classList.remove('is-scrolling'); }, 160);
      }, { passive: true });
    })();
  </script>
  <div id="spider-crawler" aria-hidden="true"><img src="/assets/decorations/spider-crawl.webp" alt="" /></div>
  <script is:inline>
    // The spider drops from the top of the screen to the bottom, straight down,
    // at a random horizontal position, fast (about 2 to 3 seconds), now and
    // then (every 20 to 55 seconds). It starts and ends fully off screen. Only
    // during the Halloween theme, and never for people who asked their system
    // for reduced motion.
    (function () {
      const el = document.getElementById('spider-crawler');
      if (!el) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let running = false;
      function crawl() {
        running = true;
        const w = el.offsetWidth || 300, h = el.offsetHeight || 414;
        const vw = window.innerWidth, vh = window.innerHeight;
        const x = Math.round((vw - w) * (0.05 + Math.random() * 0.9));
        el.style.opacity = '1';
        const anim = el.animate([
          { transform: `translate(${x}px, ${-h - 4}px)` },
          { transform: `translate(${x}px, ${vh + 4}px)` },
        ], { duration: 2400 + Math.random() * 1000, easing: 'linear', fill: 'forwards' });
        anim.onfinish = () => { el.style.opacity = '0'; anim.cancel(); running = false; };
      }
      function schedule() {
        if (reduced) return;
        setTimeout(() => {
          if (document.body.classList.contains('theme-halloween') && !running) crawl();
          schedule();
        }, 20000 + Math.random() * 35000);
      }
      schedule();
    })();
  </script>
  <!-- Free Halloween gift: everyone gets exactly one jack-o'-lantern, the
       first time they load the site in October. Not a case drop or a shop
       item (see case-data.js's comment on col_jackolantern) -- just
       appended straight to the inventory like any other granted item, same
       localStorage shape and inventory:changed event lootbox.js's own
       grants use, so Inventory/the desktop toys pick it up immediately
       with no extra wiring. Guarded by its own flag (not "do they own it
       yet") so re-granting can never happen just because someone later
       drags it into storage or it's lost some other way. -->
  <script is:inline>
    (() => {
      if (!window.isHalloweenSeason()) return;
      const FLAG_KEY = 'halloween_gift_2026_v1';
      try { if (localStorage.getItem(FLAG_KEY)) return; } catch { return; }
      try {
        const raw = localStorage.getItem('strubles_inventory_v1');
        const inv = raw ? JSON.parse(raw) : {};
        if (!Array.isArray(inv.items)) inv.items = [];
        if (!inv.items.includes('col_jackolantern')) inv.items.push('col_jackolantern');
        localStorage.setItem('strubles_inventory_v1', JSON.stringify(inv));
        localStorage.setItem(FLAG_KEY, '1');
        window.dispatchEvent(new CustomEvent('inventory:changed'));
        const toast = document.getElementById('halloween-gift-toast');
        toast.textContent = "🎃 A Jack-o'-Lantern appeared in your Inventory — happy Halloween!";
        requestAnimationFrame(() => toast.classList.add('show'));
        setTimeout(() => toast.classList.remove('show'), 6000);
      } catch {}
    })();
  </script>

  <div class="image-container" id="image-container" role="button" tabindex="0" aria-label="Spin the Iantopia image faster">
    <div class="flip-card" id="flip-card">
      <div class="flip-card-front">
        <img src="/Iantopia.webp" alt="Iantopia Image" />
      </div>
      <div class="flip-card-back">
        <img src="/Iantopia.webp" alt="Iantopia Image Back" />
