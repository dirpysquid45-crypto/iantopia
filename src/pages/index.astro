<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Glorious Iantopia</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="theme-color" content="#0a0c12">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <script is:inline src="/pwa.js?v=1" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <!--
    is:global is REQUIRED. Astro scopes <style> by stamping data-astro-cid-* on
    template elements and rewriting selectors to match. The modal rows here
    (.modal-track, .modal-item, .inv-category, .cursor-swatch) are all built at
    runtime via innerHTML, so they never get that attribute and every scoped
    rule silently skips them — the playlist, inventory, background and cursor
    pickers all render as unstyled text. This is a standalone document, so
    scoping buys nothing.
  -->
  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    @keyframes titleGlow {
      0%, 100% {
        text-shadow: 0 0 10px rgba(255, 235, 59, 0.3), 0 0 20px rgba(255, 152, 86, 0.2);
      }
      50% {
        text-shadow: 0 0 20px rgba(255, 235, 59, 0.6), 0 0 40px rgba(255, 152, 86, 0.4), 0 0 60px rgba(255, 196, 0, 0.2);
      }
    }

    @keyframes titleScale {
      0% { transform: scale(0.95); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background-image: url('/video/taipei.gif');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      color: #ffffff;
      position: relative;
      overflow: hidden;
    }

    @media (max-width: 768px) {
      body {
        background-attachment: scroll;
      }
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.3);
      pointer-events: none;
      z-index: 0;
    }

    body > * {
      position: relative;
      z-index: 1;
    }


    @keyframes bob {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    .image-container {
      position: relative;
      perspective: 1000px;
      animation: bob 3s ease-in-out infinite;
      width: min(202px, 85vw);
      aspect-ratio: 629 / 839;
      margin-bottom: 20px;
    }

    .flip-card {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      filter: drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4));
    }
    .image-container:focus-visible {
      outline: 3px solid #ffeb3b;
      outline-offset: 6px;
      border-radius: 8px;
    }

    .flip-card-front,
    .flip-card-back {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .flip-card-back {
      transform: rotateY(180deg);
    }

    .flip-card img {
      max-width: 100%;
      height: 100%;
      object-fit: cover;
      box-shadow: 0 0 40px rgba(255, 235, 59, 0.5), 0 0 80px rgba(255, 152, 86, 0.3), inset 0 0 30px rgba(255, 235, 59, 0.2);
      border-radius: 8px;
    }

    h1 {
      font-family: 'Press Start 2P', cursive;
      font-size: clamp(1.2rem, 5vw, 2.5rem);
      font-weight: 400;
      margin: 20px 0 10px 0;
      color: #ffffff;
      letter-spacing: 2px;
      animation: titleScale 0.8s ease-out, titleGlow 3s ease-in-out infinite 0.8s;
      text-align: center;
      text-transform: uppercase;
    }

    a.big,
    button.big {
      position: relative;
      overflow: hidden;
      text-decoration: none;
      padding: 18px 26px;
      border-radius: 0;
      background: #1d2330;
      border: 1px solid #2a3245;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      font-size: clamp(20px, 4vw, 34px);
      letter-spacing: 0.3px;
      color: #ffffff;
      cursor: none;
      transition: transform 0.2s, box-shadow 0.2s;
      display: block;
      margin: 16px auto;
    }

    a.big:hover,
    button.big:hover {
      transform: translateY(-1px);
    }

    /* Diagonal shine sweep on hover — a light band slides across the
       button. content-only, ::before, so it never displaces the label or
       interferes with the neon glow variants below. */
    a.big::before,
    button.big::before {
      content: '';
      position: absolute;
      top: 0;
      left: -75%;
      width: 45%;
      height: 100%;
      background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.45), transparent);
      transform: skewX(-20deg);
      transition: left 0.55s ease;
      pointer-events: none;
    }
    a.big:hover::before,
    button.big:hover::before {
      left: 125%;
    }
    @media (prefers-reduced-motion: reduce) {
      a.big::before, button.big::before { display: none; }
    }

    /* Buttons wrap into a centered, evenly-gapped grid instead of one long
       vertical stack — 2 across once there's room, single column below
       that. Sizing/spacing here overrides the plain stacked defaults above
       for anything inside the grid. */
    .button-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: stretch;
      gap: 16px;
      max-width: 720px;
      width: 100%;
      margin: 18px auto 0;
      padding: 0 16px;
    }
    .button-grid > .big {
      margin: 0;
      flex: 1 1 260px;
      max-width: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: clamp(15px, 2.2vw, 21px);
    }
    .button-grid > .big:hover {
      transform: translateY(-2px);
    }

    /* Neon sign buttons */
    a.big.neon-yt {
      background: #200000;
      border: 2px solid #ff1a1a;
      color: #ffffff;
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff, 0 0 20px rgba(255, 255, 255, 0.6);
      box-shadow: 0 0 6px #ff1a1a, 0 0 16px #ff1a1a, 0 0 32px rgba(255, 26, 26, 0.5), inset 0 0 10px rgba(255, 26, 26, 0.2);
      text-transform: uppercase;
    }
    a.big.neon-yt:hover {
      text-shadow: 0 0 6px #ffffff, 0 0 14px #ffffff, 0 0 28px rgba(255, 255, 255, 0.7);
      box-shadow: 0 0 10px #ff1a1a, 0 0 24px #ff1a1a, 0 0 48px rgba(255, 26, 26, 0.6), inset 0 0 14px rgba(255, 26, 26, 0.3);
    }

    a.big.neon-gamble {
      background: #0a1128;
      border: 2px solid #2979ff;
      color: #ff0000;
      text-shadow: 0 0 5px #ff0000, 0 0 10px #ff0000, 0 0 20px #ff0000, 0 0 40px rgba(255, 0, 0, 0.6);
      box-shadow: 0 0 6px #2979ff, 0 0 16px #2979ff, 0 0 32px rgba(41, 121, 255, 0.5), inset 0 0 10px rgba(41, 121, 255, 0.15);
    }
    a.big.neon-gamble:hover {
      text-shadow: 0 0 6px #ff0000, 0 0 14px #ff0000, 0 0 28px #ff0000, 0 0 56px rgba(255, 0, 0, 0.7);
      box-shadow: 0 0 10px #2979ff, 0 0 24px #2979ff, 0 0 48px rgba(41, 121, 255, 0.6), inset 0 0 14px rgba(41, 121, 255, 0.2);
    }

    a.big.neon-never {
      background: #332800;
      border: 2px solid #fff176;
      color: #fff176;
      text-shadow: 0 0 5px #e6a700, 0 0 10px #e6a700, 0 0 20px #e6a700, 0 0 40px rgba(230, 167, 0, 0.6);
      box-shadow: 0 0 6px #e6a700, 0 0 16px #e6a700, 0 0 32px rgba(230, 167, 0, 0.5), inset 0 0 10px rgba(230, 167, 0, 0.15);
    }
    a.big.neon-never:hover {
      text-shadow: 0 0 6px #e6a700, 0 0 14px #e6a700, 0 0 28px #e6a700, 0 0 56px rgba(230, 167, 0, 0.7);
      box-shadow: 0 0 10px #e6a700, 0 0 24px #e6a700, 0 0 48px rgba(230, 167, 0, 0.6), inset 0 0 14px rgba(230, 167, 0, 0.2);
    }

    a.big.neon-mines {
      background: #041505;
      border: 2px solid #4caf50;
      color: #4caf50;
      text-shadow: 0 0 5px #4caf50, 0 0 10px #4caf50, 0 0 20px #4caf50, 0 0 40px rgba(76, 175, 80, 0.6);
      box-shadow: 0 0 6px #4caf50, 0 0 16px #4caf50, 0 0 32px rgba(76, 175, 80, 0.5), inset 0 0 10px rgba(76, 175, 80, 0.15);
    }
    a.big.neon-mines:hover {
      text-shadow: 0 0 6px #4caf50, 0 0 14px #4caf50, 0 0 28px #4caf50, 0 0 56px rgba(76, 175, 80, 0.7);
      box-shadow: 0 0 10px #4caf50, 0 0 24px #4caf50, 0 0 48px rgba(76, 175, 80, 0.6), inset 0 0 14px rgba(76, 175, 80, 0.2);
    }

    button.big.neon-daily {
      background: #221800;
      border: 2px solid #ffd700;
      color: #ffd700;
      text-shadow: 0 0 5px #ffd700, 0 0 10px #ffd700, 0 0 20px #ffd700, 0 0 40px rgba(255, 215, 0, 0.6);
      box-shadow: 0 0 6px #ffd700, 0 0 16px #ffd700, 0 0 32px rgba(255, 215, 0, 0.5), inset 0 0 10px rgba(255, 215, 0, 0.15);
      font-family: inherit;
      cursor: none;
    }
    button.big.neon-daily:hover:not(:disabled) {
      text-shadow: 0 0 6px #ffd700, 0 0 14px #ffd700, 0 0 28px #ffd700, 0 0 56px rgba(255, 215, 0, 0.7);
      box-shadow: 0 0 10px #ffd700, 0 0 24px #ffd700, 0 0 48px rgba(255, 215, 0, 0.6), inset 0 0 14px rgba(255, 215, 0, 0.2);
    }
    button.big.neon-daily:disabled { opacity: 0.4; cursor: none; }

    /* ---------- Daily struble reel ---------- */
    #daily-reel-overlay {
      display:none; position:fixed; inset:0; z-index:60;
      align-items:center; justify-content:center; background:rgba(0,0,0,.85);
      padding:20px;
    }
    #daily-reel-overlay.open { display:flex; }
    .daily-reel-box {
      width:min(560px, 96vw); background:#0a0a0a; border:4px solid #ffd700;
      padding:24px; box-shadow:0 0 40px rgba(255,215,0,.35);
    }
    .daily-reel-title {
      text-align:center; color:#ffd700; font-size:13px; letter-spacing:2px;
      margin-bottom:18px; text-transform:uppercase;
    }
    .daily-reel-viewport {
      position:relative; overflow:hidden; border:3px solid #2a3242; background:#080a0f;
      padding:14px 0; margin-bottom:18px; height:96px;
      -webkit-mask-image:linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
      mask-image:linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
    }
    .daily-reel-strip { display:flex; gap:10px; will-change:transform; }
    .daily-reel-marker {
      position:absolute; top:0; bottom:0; left:50%; width:4px; margin-left:-2px;
      background:#ffd700; box-shadow:0 0 12px #ffd700, 0 0 24px #ffd700; z-index:5; pointer-events:none;
    }
    .daily-tile {
      flex:0 0 84px; width:84px; height:84px;
      display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
      background:#10141c; border:2px solid var(--tier-c, #2a3242); border-bottom-width:5px;
    }
    .daily-tile img { width:36px; height:36px; object-fit:contain; }
    .daily-tile .amt { font-size:9px; color:var(--tier-c, #9fb0cf); }
    .daily-tile.gold { animation: daily-gold-pulse 1s ease-in-out infinite; }
    @keyframes daily-gold-pulse {
      0%, 100% { box-shadow: 0 0 0 rgba(255,215,0,0); }
      50% { box-shadow: 0 0 18px rgba(255,215,0,.7); }
    }
    .daily-result {
      text-align:center; min-height:44px; display:flex; flex-direction:column;
      align-items:center; justify-content:center; gap:6px; margin-bottom:16px;
    }
    .daily-result .win-amt {
      font-size:22px; font-weight:400; opacity:0; transform:scale(.6);
      transition: opacity .3s ease, transform .3s cubic-bezier(.34,1.6,.64,1);
      color: #ffd700;
    }
    .daily-result .win-amt.show { opacity:1; transform:scale(1); }
    .daily-result .win-tier {
      font-size:9px; letter-spacing:2px; text-transform:uppercase; opacity:0; transition: opacity .3s ease .15s;
    }
    .daily-result .win-tier.show { opacity:1; }
    #daily-reel-close {
      all:unset; display:block; margin:0 auto; cursor:none; padding:10px 22px;
      border:3px solid #ffd700; background:#000; color:#ffd700;
      font-family: inherit; font-size:10px;
      text-transform:uppercase; letter-spacing:1px; text-align:center;
      opacity:0; pointer-events:none; transition: opacity .3s ease;
    }
    #daily-reel-close.show { opacity:1; pointer-events:auto; }
    #daily-reel-close:hover { background:#ffd700; color:#000; }

    /* Topia Timer */
    #topia-timer {
      position: fixed;
      top: calc(15px + env(safe-area-inset-top));
      right: calc(20px + env(safe-area-inset-right));
      font-size: 0.75rem;
      font-weight: 700;
      font-family: 'Press Start 2P', cursive;
      background: linear-gradient(135deg, #1a0a00 0%, #4d0000 100%);
      color: #ff3333;
      padding: 12px 16px;
      border-radius: 0;
      border: 2px solid #ff3333;
      box-shadow: 0 0 20px rgba(255, 51, 51, 0.5), inset 0 0 10px rgba(255, 51, 51, 0.1);
      text-transform: uppercase;
      letter-spacing: 1px;
      line-height: 1.4;
      max-width: min(280px, 60vw);
    }

    /* Strubles badge */
    #strubles-badge {
      position: fixed;
      top: calc(55px + env(safe-area-inset-top));
      left: calc(20px + env(safe-area-inset-left));
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 0, 0, 0.6);
      padding: 8px 12px;
      border-radius: 12px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      font-family: 'Press Start 2P', cursive;
      font-weight: 400;
      font-size: 0.75rem;
    }

    #strubles-badge img {
      width: 28px;
      height: 28px;
      border-radius: 6px;
    }

    #now-playing {
      position: fixed;
      top: calc(130px + env(safe-area-inset-top));
      right: calc(20px + env(safe-area-inset-right));
      z-index: 20;
      background: rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 235, 59, 0.5);
      border-radius: 12px;
      color: #fff;
      font-size: 10px;
      padding: 8px 12px;
      line-height: 1.4;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      cursor: none;
      max-width: 170px;
      text-align: right;
    }
    #now-playing #np-eyebrow {
      display: block;
      color: #ffeb3b;
      font-weight: 700;
      font-size: 8px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 3px;
    }
    #now-playing #np-label {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #now-playing:hover { transform: translateY(-1px); }

    #amsa-quote {
      position: fixed;
      top: calc(195px + env(safe-area-inset-top));
      right: calc(20px + env(safe-area-inset-right));
      z-index: 20;
      font-size: 7px;
      color: rgba(255, 255, 255, 0.45);
      text-align: right;
      max-width: 170px;
      font-style: italic;
      line-height: 1.4;
    }

    /* Volume + mute controls inside the Playlist popup */
    .volume-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(255, 215, 0, 0.3);
    }
    .volume-row input[type="range"] {
      flex: 1;
      accent-color: #ffeb3b;
      cursor: none;
    }
    .volume-mute-btn {
      all: unset;
      cursor: none;
      font-size: 16px;
      padding: 4px 8px;
      border: 1px solid #2a3245;
      border-radius: 8px;
      background: #1d2330;
    }

    /* Playlist / Inventory modal */
    .modal-overlay {
      display: none;
      position: fixed; inset: 0;
      background: rgba(0, 0, 0, 0.75);
      z-index: 100;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: #0a0a0f;
      border: 2px solid #ffd700;
      padding: 20px;
      width: min(380px, 90vw);
      max-height: 70vh;
      overflow-y: auto;
      box-shadow: 0 0 30px rgba(255, 215, 0, 0.4);
    }
    .modal-box h2 {
      margin: 0 0 14px;
      color: #ffd700;
      font-size: 16px;
      font-family: 'Press Start 2P', cursive;
    }
    .modal-track, .modal-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 12px;
      border: 1px solid #333;
      margin-bottom: 8px;
      cursor: none;
      background: rgba(255, 255, 255, 0.03);
      font-size: 13px;
    }
    .modal-track.active { border-color: #ffeb3b; background: rgba(255, 235, 59, 0.1); }
    .modal-track:hover { background: rgba(255, 255, 255, 0.08); }
    .modal-empty { color: #888; font-size: 12px; padding: 8px 0 4px; }
    .modal-close {
      all: unset; cursor: none; margin-top: 14px; padding: 8px 16px;
      border: 1px solid #2a3245; background: #1d2330; color: #fff; display: inline-block;
    }
    .inv-category { color: #ffeb3b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; margin: 14px 0 6px; }
    .inv-category:first-child { margin-top: 0; }

    /* Inventory button — a small CSS chest with a hinged lid. The lid opens
       on hover, and also gets the .drag-near class while a desktop item is
       being dragged close by (see the desktop-items script), so the chest
       reads as an open drop target before the item is actually released. */
    #inv-btn {
      position: fixed;
      top: calc(120px + env(safe-area-inset-top));
      left: calc(20px + env(safe-area-inset-left));
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      border: 1px solid #2a3245;
      border-radius: 10px;
      padding: 6px 10px 6px 8px;
      font-weight: 600;
      cursor: none;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      z-index: 20;
    }

    #inv-btn:hover {
      transform: translateY(-1px);
    }

    .chest {
      position: relative;
      width: 26px;
      height: 20px;
      flex-shrink: 0;
      perspective: 60px;
    }
    .chest-base {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      height: 13px;
      background: linear-gradient(180deg, #7a4a1e 0%, #5c3614 100%);
      border: 1.5px solid #ffd700;
      border-top: none;
      border-radius: 0 0 4px 4px;
    }
    .chest-base::after {
      content: '';
      position: absolute;
      left: 50%; top: -1px;
      width: 5px; height: 5px;
      transform: translate(-50%, -50%);
      background: #ffd700;
      border-radius: 50%;
      box-shadow: 0 0 3px rgba(255, 215, 0, 0.8);
    }
    .chest-lid {
      position: absolute;
      left: 0; right: 0; top: 0;
      height: 11px;
      background: linear-gradient(180deg, #a8681f 0%, #7a4a1e 100%);
      border: 1.5px solid #ffd700;
      border-bottom: none;
      border-radius: 4px 4px 1px 1px;
      transform-origin: 50% 100%;
      transform: rotateX(0deg);
      transition: transform 0.28s cubic-bezier(0.34, 1.4, 0.64, 1);
    }

    #inv-btn:hover .chest-lid,
    #inv-btn.drag-near .chest-lid {
      transform: rotateX(-115deg) translateY(-1px);
    }
    #inv-btn.drag-near {
      border-color: #ffd700;
      box-shadow: 0 0 10px rgba(255, 215, 0, 0.5), 0 2px 6px rgba(0, 0, 0, 0.25);
    }

    @media (prefers-reduced-motion: reduce) {
      .chest-lid { transition: none; }
    }


    /* Movable item toys — see desktop-items.js */
    #desktop-items {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 15;
    }
    .desktop-item-wrap {
      position: fixed;
      pointer-events: none;
      border: 2px solid transparent;
      border-radius: 4px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .desktop-item-wrap.selected {
      border-color: rgba(255, 215, 0, 0.6);
      box-shadow: 0 0 12px rgba(255, 215, 0, 0.4);
    }
    .desktop-item {
      position: static;
      display: block;
      width: 56px;
      height: 56px;
      object-fit: contain;
      pointer-events: auto;
      cursor: none;
      touch-action: none;
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.5));
      transition: filter 0.15s ease, transform 0.15s ease;
      user-select: none;
      -webkit-user-drag: none;
    }
    .desktop-item.pixel-art { image-rendering: pixelated; }
    .desktop-item:hover {
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.5)) drop-shadow(0 0 8px rgba(255, 215, 0, 0.5));
      transform: scale(1.06);
    }
    .desktop-item.dragging {
      transition: none;
