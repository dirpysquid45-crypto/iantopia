    /* ---------- Clarity theme (Zedd ft. Foxes, 128 BPM) ---------- */
    /* Smooth continuous RGB hue-cycle rather than a discrete per-beat jump —
       "RGB style" reads as the gamer-peripheral rainbow sweep. Duration is
       still tempo-derived (one full 360° cycle every 4 beats, a normal
       musical phrase length) so it still visibly rides the track's pace:
       60/128bpm = 0.46875s/beat * 4 = 1.875s. */
    @keyframes rgb-cycle {
      0%   { filter: hue-rotate(0deg); }
      100% { filter: hue-rotate(360deg); }
    }
    body.theme-clarity a.big,
    body.theme-clarity button.big,
    body.theme-clarity #inv-btn,
    body.theme-clarity #bg-btn,
    body.theme-clarity #cursor-btn,
    body.theme-clarity #account-btn,
    body.theme-clarity #now-playing,
    body.theme-clarity #ending-link,
    body.theme-clarity #topia-timer {
      animation: rgb-cycle 1.875s linear infinite;
    }
    /* #topia-timer has no `filter` of its own, so it can reuse rgb-cycle as-is
       (hue-rotate rotates its whole rendered box — bg, border, box-shadow,
       text — together). .flip-card already uses `filter` for its own glow,
       so like the other themes above it needs the hue-rotate combined into
       the same filter list as its drop-shadows, not a bare swap. */
    @keyframes rgb-cycle-flip {
      0%   { filter: hue-rotate(0deg) drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4)); }
      100% { filter: hue-rotate(360deg) drop-shadow(0 0 30px rgba(255, 235, 59, 0.6)) drop-shadow(0 0 60px rgba(255, 152, 86, 0.4)); }
    }
    body.theme-clarity .flip-card {
      animation: rgb-cycle-flip 1.875s linear infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      body.theme-clarity a.big, body.theme-clarity button.big,
      body.theme-clarity #inv-btn, body.theme-clarity #bg-btn,
      body.theme-clarity #cursor-btn, body.theme-clarity #account-btn,
      body.theme-clarity #now-playing, body.theme-clarity #ending-link,
