<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Thanksgiving - Iantopia</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="theme-color" content="#2d1810">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <script is:inline src="/pwa.js?v=1" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: safe center;
      padding: 48px 20px 40px;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: linear-gradient(135deg, #2d1810 0%, #4a2f1a 50%, #3a2412 100%);
      color: #ffffff;
      position: relative;
      overflow-x: hidden;
    }

    /* Subtle autumn leaf pattern overlay */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image:
        radial-gradient(circle at 15% 50%, rgba(255, 215, 0, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 85% 30%, rgba(255, 140, 0, 0.03) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    body > * {
      position: relative;
      z-index: 1;
    }

    h1 {
      font-family: 'Press Start 2P', cursive;
      font-size: clamp(1.5rem, 6vw, 3rem);
      font-weight: 400;
      margin: 20px 0 30px 0;
      color: #ffd700;
      letter-spacing: 2px;
      text-align: center;
      text-transform: uppercase;
      text-shadow:
        0 0 10px rgba(255, 215, 0, 0.5),
        0 0 20px rgba(255, 140, 0, 0.3),
        2px 2px 0 rgba(45, 24, 16, 0.8);
      animation: titlePulse 3s ease-in-out infinite;
    }

    @keyframes titlePulse {
      0%, 100% {
        text-shadow:
          0 0 10px rgba(255, 215, 0, 0.5),
          0 0 20px rgba(255, 140, 0, 0.3),
          2px 2px 0 rgba(45, 24, 16, 0.8);
      }
      50% {
        text-shadow:
          0 0 20px rgba(255, 215, 0, 0.7),
          0 0 40px rgba(255, 140, 0, 0.5),
          2px 2px 0 rgba(45, 24, 16, 0.8);
      }
    }

    .container {
      width: 100%;
      max-width: 900px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 30px;
    }

    .pumpkin-section {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      animation: bobbing 3s ease-in-out infinite;
    }

    @keyframes bobbing {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-15px);
      }
    }

    .pumpkin-container {
      position: relative;
      width: min(320px, 85vw);
      height: auto;
      filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.4)) drop-shadow(0 0 40px rgba(255, 140, 0, 0.2));
      border-radius: 12px;
      overflow: hidden;
    }

    .pumpkin-container img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 12px;
    }

    .music-player {
      width: 100%;
      max-width: 420px;
      background: linear-gradient(135deg, #4a2f1a 0%, #3a2412 100%);
      border: 3px solid #ffd700;
      border-radius: 12px;
      padding: 20px;
      box-shadow:
        0 0 30px rgba(255, 215, 0, 0.3),
        inset 0 0 20px rgba(255, 215, 0, 0.05);
    }

    .music-label {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #ffd700;
      margin-bottom: 12px;
      display: block;
      text-align: center;
      text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.5);
    }

    audio {
      width: 100%;
      height: 36px;
      accent-color: #ff8c00;
    }

    audio::-webkit-media-controls-panel {
      background-color: rgba(45, 24, 16, 0.7);
    }

    .button-group {
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
      max-width: 420px;
    }

    .action-button {
      position: relative;
      overflow: hidden;
      text-decoration: none;
      padding: 16px 24px;
      border-radius: 8px;
      background: linear-gradient(135deg, #2d1810 0%, #4a2f1a 100%);
      border: 2px solid #ffd700;
      box-shadow:
        0 0 15px rgba(255, 215, 0, 0.3),
        0 6px 16px rgba(0, 0, 0, 0.35);
      font-size: clamp(16px, 3vw, 18px);
      font-weight: 600;
      letter-spacing: 1px;
      color: #ffd700;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      text-transform: uppercase;
      font-family: 'Press Start 2P', cursive;
      font-size: 11px;
    }

    .action-button:hover {
      transform: translateY(-3px);
      box-shadow:
        0 0 25px rgba(255, 215, 0, 0.6),
        0 10px 24px rgba(0, 0, 0, 0.5);
      background: linear-gradient(135deg, #4a2f1a 0%, #5c3b22 100%);
    }

    .action-button:active {
      transform: translateY(-1px);
    }

    .action-button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -75%;
      width: 45%;
      height: 100%;
      background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.35), transparent);
      transform: skewX(-20deg);
      transition: left 0.55s ease;
      pointer-events: none;
    }

    .action-button:hover::before {
      left: 125%;
    }

    .subtitle {
      text-align: center;
      font-size: clamp(12px, 2vw, 14px);
      color: #f5deb3;
      letter-spacing: 0.5px;
      margin-top: -10px;
      font-style: italic;
    }

    @media (max-width: 768px) {
      body {
        padding: 40px 16px 32px;
      }

      h1 {
        margin: 16px 0 24px 0;
      }

      .container {
        gap: 24px;
      }

      .action-button {
        padding: 14px 20px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      h1, .pumpkin-section {
        animation: none;
      }

      .action-button, .action-button:hover {
        transition: none;
        transform: none;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div>
      <h1>🦃 Thanksgiving 🦃</h1>
      <p class="subtitle">Harvest Time at Iantopia</p>
    </div>

    <div class="pumpkin-section">
      <div class="pumpkin-container">
        <img
          src="/snoopy-pumpkin-pie-1991854611.gif"
          alt="Snoopy and Pumpkin Pie - Thanksgiving GIF"
          loading="lazy"
        />
      </div>
    </div>

    <div class="music-player">
      <label class="music-label">🎵 Thanksgiving Theme</label>
      <audio controls>
        <source src="/Thanksgiving Theme (Reprise).mp3" type="audio/mpeg">
        Your browser does not support the audio element.
      </audio>
    </div>

    <div class="button-group">
      <a href="/" class="action-button">
        🏠 Home
      </a>
      <a href="/puzzles" class="action-button">
        🧩 Play Puzzles
      </a>
      <a href="/horse-web-game" class="action-button">
        🐴 Play Games
      </a>
      <a href="/lootbox" class="action-button">
        🎁 Loot Box
      </a>
    </div>
  </div>
</body>
</html>
