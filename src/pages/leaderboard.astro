<!DOCTYPE html>
<html lang="en">
<head>
<link rel="stylesheet" href="/lowfx.css?v=1">
<script is:inline src="/lowfx.js?v=1"></script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Iantopia Leaderboards</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0a0c12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script is:inline src="/pwa.js?v=1" defer></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style is:global>
  :root { --bg:#0f1115; --panel:#161c27; --ink:#e9eef9; --muted:#9fb0cf; --gold:#ffd700; }
  * { box-sizing:border-box; }
  html, body { margin:0; height:100%; }
  body {
    height:100dvh;
    display:flex; flex-direction:column;
    color:var(--ink);
    font-family: 'Press Start 2P', ui-monospace, 'Courier New', monospace;
    cursor:none;
    position:relative;
    overflow-x:hidden; overflow-y:auto;
    background:#0f1115;
  }

  main {
    position:relative; z-index:2; max-width:1200px; width:100%; margin:0 auto;
    padding:20px 24px;
    flex:1 1 auto; min-height:0;
    display:flex; flex-direction:column;
  }

  header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:4px solid #000; padding-bottom:10px; gap:10px; }
  header a { color:var(--gold); text-decoration:none; border:3px solid #000; padding:8px 12px; font-weight:700; background:#000; transition:background 0.2s; font-size:10px; cursor:none; }
  header a:hover { background:var(--gold); color:#000; }

  h1 {
    margin:0; font-size:clamp(13px,2.6vw,20px); letter-spacing:1px; color:var(--gold); font-weight:400;
    text-shadow: 2px 2px 0 #000; text-align:center; width:100%;
  }

  #leaderboard-list {
    flex:1 1 auto; min-height:0;
    display:flex; flex-direction:column;
    gap:0;
    border:2px solid var(--gold);
    background:rgba(0,0,0,.4);
    overflow-y:auto;
  }

  .leaderboard-loading {
    display:flex; align-items:center; justify-content:center; padding:40px 20px;
    color:var(--muted); font-size:12px;
  }

  .leaderboard-empty {
    display:flex; align-items:center; justify-content:center; padding:40px 20px;
    color:var(--muted); font-size:11px; text-align:center;
  }

  .leaderboard-error {
    display:flex; align-items:center; justify-content:center; padding:40px 20px;
    color:#ff6b6b; font-size:11px; text-align:center;
  }

  .leaderboard-row {
    display:grid; grid-template-columns:40px 1fr 150px; gap:10px; align-items:center;
    padding:12px 16px; border-bottom:1px solid rgba(255,215,0,0.2); font-size:11px;
    transition:background 0.2s;
  }
  .leaderboard-row:hover { background:rgba(255,215,0,.08); }
  .leaderboard-row.current-user { background:rgba(255,215,0,.15); border-left:4px solid var(--gold); padding-left:12px; }

  .leaderboard-rank { color:var(--gold); font-weight:700; text-align:center; }
  .leaderboard-name { color:var(--ink); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .specialty-badge { margin-right:4px; }
  .leaderboard-row.visitable { cursor:pointer; }
  .leaderboard-row.visitable:hover { background:rgba(255,215,0,.16); }
  .visit-hint { display:inline-block; margin-left:6px; color:var(--gold); opacity:0; transition:opacity .15s; }
  .leaderboard-row.visitable:hover .visit-hint { opacity:0.85; }
  .leaderboard-score { color:var(--muted); text-align:right; display:flex; flex-direction:column; gap:2px; line-height:1.3; }
  .leaderboard-score small { color:#6a7690; font-size:0.8em; }

  #board-tabs { display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; }
  .board-tab {
    flex:1; min-width:130px; background:#000; color:var(--gold); border:3px solid var(--gold);
    padding:12px 10px; font-family:inherit; font-size:10px; font-weight:700; cursor:pointer;
    touch-action:manipulation; transition:background .15s, color .15s;
  }
  .board-tab:hover { background:rgba(255,215,0,.15); }
  .board-tab.active { background:var(--gold); color:#000; }

  @media (max-width:768px) {
    main { padding-left:12px; padding-right:12px; }
    .leaderboard-row { grid-template-columns:30px 1fr 110px; font-size:9px; padding:10px 12px; }
    header a { font-size:9px; padding:6px 10px; }
    .board-tab { font-size:9px; padding:11px 8px; }
  }
</style>
</head>
<body>
  <main>
    <header>
      <a href="/" title="Back to Iantopia">← Home</a>
      <h1>LEADERBOARDS</h1>
      <div style="width:80px;"></div>
    </header>

    <div id="board-tabs">
      <button class="board-tab active" type="button" data-board="horse">🐎 Horse Run</button>
      <button class="board-tab" type="button" data-board="mines_beginner">💣 Beginner</button>
      <button class="board-tab" type="button" data-board="mines_intermediate">💣 Intermediate</button>
      <button class="board-tab" type="button" data-board="mines_expert">💣 Expert</button>
      <button class="board-tab" type="button" data-board="mines_hormuz">🌊 Hormuz</button>
    </div>

    <div id="leaderboard-list">
      <div class="leaderboard-loading">Loading leaderboard...</div>
    </div>
  </main>

<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<script is:inline src="/game-stats.js?v=1"></script>
<script is:inline src="/cloud-sync.js?v=13"></script>

<script is:inline>
(() => {
  const listEl = document.getElementById('leaderboard-list');
  const currentUserId = window.CloudSync?.currentUser?.uid;

  function renderLoading() {
    listEl.innerHTML = '<div class="leaderboard-loading">Loading leaderboard...</div>';
  }

  // Village boards (GDP, Efficiency) are off until tycoon is live.
  const BOARDS = {
    horse: {
      collection: 'horse_leaderboard', field: 'best',
      empty: 'No riders ranked yet — go clear some hurdles!',
      fallbackName: 'Anonymous Rider',
      format: (v) => `${Number(v || 0).toLocaleString()} hurdles`,
    },
  };
  // Minesweeper: one board per difficulty, ranked by boards won. Each player's
  // doc keeps { beginner: {w, l}, intermediate: {w, l}, expert: {w, l}, hormuz: {w, l} }.
  const MINE_DIFFS = { beginner: 'Beginner', intermediate: 'Intermediate', expert: 'Expert', hormuz: 'Strait of Hormuz' };
  function mineBoard(diff) {
    return {
      collection: 'minesweeper_leaderboard', field: diff + '.w', visitable: false,
      empty: `No ${MINE_DIFFS[diff]} boards cleared or lost yet — play one to get on here!`,
      fallbackName: 'Anonymous Sweeper',
      format: (v) => `${Number(v || 0).toLocaleString()} won`,
      sub: (d) => {
        const r = d[diff] || {};
        const w = Number(r.w || 0), l = Number(r.l || 0);
        const pct = w + l ? Math.round((w / (w + l)) * 100) + '%' : '—';
        return `${l.toLocaleString()} lost · ${pct} win rate`;
      },
    };
  }
  for (const diff of Object.keys(MINE_DIFFS)) BOARDS['mines_' + diff] = mineBoard(diff);
  let activeBoard = 'horse';
  // Firestore field paths like "beginner.w" point into nested maps.
  const fieldValue = (data, path) => path.split('.').reduce((o, k) => (o == null ? undefined : o[k]), data);
  const SPECIALTY_ICON = { residential: '🏘️', commercial: '🏬', industrial: '🏭' };

  function renderEmpty() {
    listEl.innerHTML = `<div class="leaderboard-empty">${BOARDS[activeBoard].empty}</div>`;
  }

  function renderError(message) {
    listEl.innerHTML = `<div class="leaderboard-error">${message}</div>`;
  }

  function renderList(docs) {
    if (docs.length === 0) {
      renderEmpty();
      return;
    }
    const board = BOARDS[activeBoard];
    listEl.innerHTML = docs.map((doc, idx) => {
      const data = doc.data();
      const rank = idx + 1;
      const isCurrentUser = doc.id === currentUserId;
      const name = String(data.displayName || board.fallbackName)
        .replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c]));
      const sub = board.sub ? `<small>${board.sub(data)}</small>` : '';
      // A village with a committed majority zone shows its specialty as a
      // little badge next to its name — see computeSpecialty() in tycoon.astro.
      const badge = data.specialty && SPECIALTY_ICON[data.specialty]
        ? `<span class="specialty-badge" title="${data.specialty[0].toUpperCase()}${data.specialty.slice(1)} specialty">${SPECIALTY_ICON[data.specialty]}</span>` : '';
      // Rows link to a read-only visit only for boards that have a village
      // behind them; the horse and minesweeper boards stay unclickable.
      const visitable = board.visitable && !isCurrentUser;
      return `
        <div class="leaderboard-row ${isCurrentUser ? 'current-user' : ''}${visitable ? ' visitable' : ''}" ${visitable ? `data-uid="${doc.id}"` : ''}>
          <div class="leaderboard-rank">#${rank}</div>
          <div class="leaderboard-name">${badge}${name}${visitable ? ' <small class=\"visit-hint\">👁️ visit</small>' : ''}</div>
          <div class="leaderboard-score">${board.format(fieldValue(data, board.field))}${sub}</div>
        </div>
      `;
    }).join('');
  }
  listEl.addEventListener('click', (e) => {
    const row = e.target.closest('.leaderboard-row[data-uid]');
    if (row) location.href = '/visit?uid=' + encodeURIComponent(row.dataset.uid);
  });

  function loadBoard(key) {
    activeBoard = key;
    document.querySelectorAll('.board-tab').forEach((t) => {
      t.classList.toggle('active', t.dataset.board === key);
    });
    const board = BOARDS[key];
    renderLoading();
    // requireQualified (Efficiency) needs docs where `qualified` is true, but
    // that's a second field — a Firestore orderBy+where on different fields
    // needs a composite index we'd have to hand-configure in the Firebase
    // console. Simpler: over-fetch past the display limit and filter here.
    const LIMIT = 50;
    firebase.firestore().collection(board.collection)
      .orderBy(board.field, 'desc').limit(board.requireQualified ? LIMIT * 4 : LIMIT).get()
      .then((snap) => {
        if (activeBoard !== key) return; // a later tab click already won
        const docs = board.requireQualified
          ? snap.docs.filter((d) => d.data().qualified !== false).slice(0, LIMIT)
          : snap.docs;
        if (docs.length === 0) renderEmpty();
        else renderList(docs);
      })
      .catch((err) => {
        console.error('[leaderboard] query failed:', err);
        if (activeBoard !== key) return;
        if (err.code === 'permission-denied') {
          renderError('This leaderboard is not available yet — check back soon!');
        } else {
          renderError('Failed to load leaderboard. Please try again later.');
        }
      });
  }

  document.querySelectorAll('.board-tab').forEach((tab) => {
    tab.addEventListener('click', () => loadBoard(tab.dataset.board));
  });
  // /leaderboard?board=horse deep-links straight to a tab (the horse game
  // links here); anything unrecognised falls back to the village board.
  const wanted = new URLSearchParams(location.search).get('board');
  loadBoard(BOARDS[wanted] ? wanted : 'horse');
})();
</script>
</body>
</html>
