<!DOCTYPE html>
<html lang="en">
<head>
<link rel="stylesheet" href="/lowfx.css?v=2">
<script is:inline src="/lowfx.js?v=2"></script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Iantopia Leaderboards</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0a0c12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script is:inline src="/pwa.js?v=1" defer></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style is:global>
  :root { --bg:#0f1115; --panel:#161c27; --ink:#e9eef9; --muted:#9fb0cf; --gold:#ffd700; }
  * { box-sizing:border-box; }
  html, body { margin:0; height:100%; }
  body {
    height:100dvh;
    display:flex; flex-direction:column;
    color:var(--ink);
    font-family: 'Press Start 2P', ui-monospace, 'Courier New', monospace;
    cursor:none;
    position:relative;
    overflow-x:hidden; overflow-y:auto;
    background:#0f1115;
  }

  main {
    position:relative; z-index:2; max-width:1200px; width:100%; margin:0 auto;
    padding:20px 24px;
    flex:1 1 auto; min-height:0;
    display:flex; flex-direction:column;
  }

  header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:4px solid #000; padding-bottom:10px; gap:10px; }
  header a { color:var(--gold); text-decoration:none; border:3px solid #000; padding:8px 12px; font-weight:700; background:#000; transition:background 0.2s; font-size:10px; cursor:none; }
  header a:hover { background:var(--gold); color:#000; }

  h1 {
    margin:0; font-size:clamp(13px,2.6vw,20px); letter-spacing:1px; color:var(--gold); font-weight:400;
    text-shadow: 2px 2px 0 #000; text-align:center; width:100%;
  }

  #leaderboard-list {
    flex:1 1 auto; min-height:0;
    display:flex; flex-direction:column;
    gap:0;
    border:2px solid var(--gold);
    background:rgba(0,0,0,.4);
    overflow-y:auto;
  }

  .leaderboard-loading {
    display:flex; align-items:center; justify-content:center; padding:40px 20px;
    color:var(--muted); font-size:12px;
  }

  .leaderboard-empty {
    display:flex; align-items:center; justify-content:center; padding:40px 20px;
    color:var(--muted); font-size:11px; text-align:center;
  }

  .leaderboard-error {
    display:flex; align-items:center; justify-content:center; padding:40px 20px;
    color:#ff6b6b; font-size:11px; text-align:center;
  }

  .leaderboard-row {
    display:grid; grid-template-columns:40px minmax(0,1fr) minmax(150px,50%); gap:10px; align-items:center;
    padding:12px 16px; border-bottom:1px solid rgba(255,215,0,0.2); font-size:11px;
    transition:background 0.2s;
  }
  .leaderboard-row:hover { background:rgba(255,215,0,.08); }
  .leaderboard-row.current-user { background:rgba(255,215,0,.15); border-left:4px solid var(--gold); padding-left:12px; }

  .leaderboard-rank { color:var(--gold); font-weight:700; text-align:center; }
  .leaderboard-name { color:var(--ink); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .specialty-badge { margin-right:4px; }
  .leaderboard-row.visitable { cursor:pointer; }
  .leaderboard-row.visitable:hover { background:rgba(255,215,0,.16); }
  .visit-hint { display:inline-block; margin-left:6px; color:var(--gold); opacity:0; transition:opacity .15s; }
  .leaderboard-row.visitable:hover .visit-hint { opacity:0.85; }
  .leaderboard-score { color:var(--muted); text-align:right; display:flex; flex-direction:column; gap:2px; line-height:1.3; }
  .leaderboard-score small { color:#6a7690; font-size:0.8em; }
  .score-main { white-space:nowrap; }

  #board-tabs { display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; }
  .board-tab {
    flex:1; min-width:130px; background:#000; color:var(--gold); border:3px solid var(--gold);
    padding:12px 10px; font-family:inherit; font-size:10px; font-weight:700; cursor:pointer;
    touch-action:manipulation; transition:background .15s, color .15s;
  }
  .board-tab:hover { background:rgba(255,215,0,.15); }
  .board-tab.active { background:var(--gold); color:#000; }

  #mine-diffs { display:flex; gap:8px; margin:-6px 0 16px; flex-wrap:wrap; }
  #mine-diffs[hidden] { display:none; }
  .mine-chip {
    background:#000; color:var(--gold); border:2px solid var(--gold); padding:8px 12px;
    font-family:inherit; font-size:9px; font-weight:700; cursor:pointer; touch-action:manipulation;
    transition:background .15s, color .15s;
  }
  .mine-chip:hover { background:rgba(255,215,0,.15); }
  .mine-chip.active { background:var(--gold); color:#000; }

  @media (max-width:768px) {
    main { padding-left:12px; padding-right:12px; }
    .leaderboard-row { grid-template-columns:30px minmax(0,1fr) minmax(110px,46%); font-size:9px; padding:10px 12px; }
    header a { font-size:9px; padding:6px 10px; }
    .board-tab { font-size:9px; padding:11px 8px; }
  }
</style>
</head>
<body>
  <main>
    <header>
      <a href="/" title="Back to Iantopia">← Home</a>
      <h1>LEADERBOARDS</h1>
      <div style="width:80px;"></div>
    </header>

    <div id="board-tabs">
      <button class="board-tab active" type="button" data-board="horse">🐎 Horse Run</button>
      <button class="board-tab" type="button" data-board="minesweeper">💣 Minesweeper</button>
      <button class="board-tab" type="button" data-board="strubles">💰 Strubles</button>
    </div>
    <!-- Minesweeper has one board. This picks which difficulty it ranks; All adds them up. -->
    <div id="mine-diffs" hidden>
      <button class="mine-chip active" type="button" data-diff="all">All</button>
      <button class="mine-chip" type="button" data-diff="beginner">Beginner</button>
      <button class="mine-chip" type="button" data-diff="intermediate">Intermediate</button>
      <button class="mine-chip" type="button" data-diff="expert">Expert</button>
      <button class="mine-chip" type="button" data-diff="hormuz">Hormuz</button>
    </div>

    <div id="leaderboard-list">
      <div class="leaderboard-loading">Loading leaderboard...</div>
    </div>
  </main>

<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<script is:inline src="/game-stats.js?v=1"></script>
<script is:inline src="/cloud-sync.js?v=14"></script>

<script is:inline>
(() => {
  const listEl = document.getElementById('leaderboard-list');
  const currentUserId = window.CloudSync?.currentUser?.uid;

  // The Strubles board comes from the arena server (same address rule as strubles.js).
  const API = location.protocol === 'https:' ? '/arena-api' : 'http://' + (location.hostname || 'localhost') + ':4001';
  const esc = (v) => String(v).replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]));
  const num = (v) => Number(v || 0).toLocaleString();

  // Minesweeper has ONE board. Each player's doc keeps { beginner: {w, l}, intermediate: {w, l},
  // expert: {w, l}, hormuz: {w, l} }. "All" ranks by boards won across every difficulty; a single
  // difficulty ranks by that one.
  const MINE_DIFFS = { beginner: 'Beginner', intermediate: 'Intermediate', expert: 'Expert', hormuz: 'Hormuz' };
  const MINE_ALL_FETCH = 500;   // "All" is summed here, so it reads up to this many players
  const BOARDS = {
    horse: { empty: 'No riders ranked yet — go clear some hurdles!' },
    minesweeper: { empty: 'No Minesweeper boards cleared or lost yet — play one to get on here!' },
    strubles: { empty: 'Nobody is on the Strubles board yet.' },
  };
  let activeBoard = 'horse';
  let mineDiff = 'all';
  const wl = (d, diff) => { const r = (d && d[diff]) || {}; return { w: Number(r.w || 0), l: Number(r.l || 0) }; };
  const pctText = (w, l) => (w + l ? Math.round((w / (w + l)) * 100) + '% win rate' : '—');

  function renderLoading() {
    listEl.innerHTML = '<div class="leaderboard-loading">Loading leaderboard...</div>';
  }
  function renderError(message) {
    listEl.innerHTML = `<div class="leaderboard-error">${message}</div>`;
  }
  // rows: [{ id, name, score, sub }], already ranked. The same markup serves every board.
  function renderRows(rows, empty) {
    if (!rows.length) {
      listEl.innerHTML = `<div class="leaderboard-empty">${empty}</div>`;
      return;
    }
    listEl.innerHTML = rows.map((r, idx) => `
      <div class="leaderboard-row ${r.id && r.id === currentUserId ? 'current-user' : ''}">
        <div class="leaderboard-rank">#${idx + 1}</div>
        <div class="leaderboard-name">${esc(r.name)}</div>
        <div class="leaderboard-score"><span class="score-main">${esc(r.score)}</span>${r.sub ? `<small>${esc(r.sub)}</small>` : ''}</div>
      </div>`).join('');
  }

  const LIMIT = 50;
  // Each loader resolves to { rows } for its board.
  function loadHorse() {
    return firebase.firestore().collection('horse_leaderboard').orderBy('best', 'desc').limit(LIMIT).get()
      .then((snap) => ({ rows: snap.docs.map((doc) => {
        const d = doc.data();
        return { id: doc.id, name: d.displayName || 'Anonymous Rider', score: `${num(d.best)} hurdles` };
      }) }));
  }
  function loadMines() {
    const col = firebase.firestore().collection('minesweeper_leaderboard');
    const name = (d) => d.displayName || 'Anonymous Sweeper';
    if (mineDiff !== 'all') {
      return col.orderBy(mineDiff + '.w', 'desc').limit(LIMIT).get().then((snap) => ({ rows: snap.docs.map((doc) => {
        const d = doc.data();
        const { w, l } = wl(d, mineDiff);
        return { id: doc.id, name: name(d), score: `${num(w)} won`, sub: `${num(l)} lost · ${pctText(w, l)}` };
      }) }));
    }
    return col.limit(MINE_ALL_FETCH).get().then((snap) => {
      const players = snap.docs.map((doc) => {
        const d = doc.data();
        let w = 0, l = 0;
        const parts = [];
        for (const k of Object.keys(MINE_DIFFS)) {
          const r = wl(d, k);
          w += r.w; l += r.l;
          parts.push(`${MINE_DIFFS[k]} ${num(r.w)}`);
        }
        return { id: doc.id, name: name(d), w, l, parts };
      }).filter((p) => p.w + p.l > 0)
        .sort((a, b) => b.w - a.w || a.l - b.l)
        .slice(0, LIMIT);
      return { rows: players.map((p) => ({ id: p.id, name: p.name, score: `${num(p.w)} won`, sub: `${p.parts.join(' · ')} · ${num(p.l)} lost · ${pctText(p.w, p.l)}` })) };
    });
  }
  function loadStrubles() {
    return fetch(API + '/leaderboard/strubles').then((res) => {
      if (!res.ok) throw new Error('strubles board HTTP ' + res.status);
      return res.json();
    }).then((body) => ({
      rows: (body.rows || []).map((r) => ({ id: null, name: r.name || 'Player', score: `${num(r.balance)} Strubles` })),
      note: body.updated ? `Updated ${new Date(body.updated).toLocaleTimeString()}. The board refreshes every few minutes.` : '',
    }));
  }
  const LOADERS = { horse: loadHorse, minesweeper: loadMines, strubles: loadStrubles };

  function loadBoard(key) {
    activeBoard = key;
    document.querySelectorAll('.board-tab').forEach((t) => {
      t.classList.toggle('active', t.dataset.board === key);
    });
    document.getElementById('mine-diffs').hidden = key !== 'minesweeper';
    document.querySelectorAll('.mine-chip').forEach((c) => {
      c.classList.toggle('active', c.dataset.diff === mineDiff);
    });
    renderLoading();
    LOADERS[key]()
      .then((out) => {
        if (activeBoard !== key) return; // a later click already won
        renderRows(out.rows, BOARDS[key].empty);
        if (out.note && out.rows.length) listEl.insertAdjacentHTML('beforeend', `<div class="leaderboard-empty" style="padding:12px">${esc(out.note)}</div>`);
      })
      .catch((err) => {
        console.error('[leaderboard] load failed:', err);
        if (activeBoard !== key) return;
        if (key === 'strubles') {
          renderError('The Strubles board is not available right now. Please try again later.');
        } else if (err && err.code === 'permission-denied') {
          renderError('This leaderboard is not available yet — check back soon!');
        } else {
          renderError('Failed to load leaderboard. Please try again later.');
        }
      });
  }

  document.querySelectorAll('.board-tab').forEach((tab) => {
    tab.addEventListener('click', () => loadBoard(tab.dataset.board));
  });
  document.querySelectorAll('.mine-chip').forEach((chip) => {
    chip.addEventListener('click', () => { mineDiff = chip.dataset.diff; loadBoard('minesweeper'); });
  });
  // /leaderboard?board=horse (or minesweeper, strubles) opens straight on that tab. The old
  // per-difficulty links (?board=mines_expert) open Minesweeper on that difficulty.
  const wanted = new URLSearchParams(location.search).get('board') || '';
  if (wanted.startsWith('mines_') && MINE_DIFFS[wanted.slice(6)]) {
    mineDiff = wanted.slice(6);
    loadBoard('minesweeper');
  } else {
    loadBoard(BOARDS[wanted] ? wanted : 'horse');
  }
})();
</script>
</body>
</html>
