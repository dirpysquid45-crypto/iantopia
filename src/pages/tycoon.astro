<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Iantopia Tycoon</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0a0c12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script is:inline src="/pwa.js?v=1" defer></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<!--
  is:global is REQUIRED. Astro scopes <style> by stamping data-astro-cid-* on
  elements in the template and rewriting selectors to match. The grid and
  every building/worker element are built at runtime via createElement, so
  they never receive that attribute and every scoped rule silently skips
  them. Same trap as every other page in this project.
-->
<style is:global>
  :root { --bg:#0f1115; --panel:#161c27; --ink:#e9eef9; --muted:#9fb0cf; --gold:#ffd700; }
  * { box-sizing:border-box; }
  html, body { margin:0; height:100%; }
  body {
    /* A flex column filling exactly one screen, not vh-sized content
       stacked in normal flow — vh units for the buildings don't know
       about the header/stats-bar/CTA taking up their own space above,
       so on a real (short-ish) viewport the grass strip and even the
       building labels ended up below the fold entirely. Flex instead
       gives the grid whatever space is ACTUALLY left after everything
       else takes what it needs, so the full skyline (labels and grass
       included) always fits on screen without scrolling, on any
       viewport size. */
    height:100dvh;
    display:flex; flex-direction:column;
    color:var(--ink);
    font-family: 'Press Start 2P', ui-monospace, 'Courier New', monospace;
    cursor:none;
    position:relative;
    /* y-scroll as a safety net, not the plan — on a very short viewport
       (phone landscape) the grid still gets a min-height floor below, so
       the flex column can end up taller than 100dvh; scrolling then is
       far better than collapsed, unclickable slots. */
    overflow-x:hidden; overflow-y:auto;
  }

  /* Fixed sky behind everything — this page's background is thematic, not
     user-selectable (no bg-btn/picker here), so it's just plain CSS rather
     than going through background-library.js. */
  #sky-bg {
    position:fixed; inset:0; z-index:-2;
    background-image:url('/tycoon/sky-background.gif');
    background-size:cover; background-position:center;
  }
  #sky-bg::after {
    content:''; position:absolute; inset:0; background:rgba(0,0,0,.15);
  }

  /* Silly airplane — purely decorative, drifts across the upper sky every
     so often. Fixed like the sky itself (not tied to the grid/grass) so it
     reads as "way up there" regardless of scroll or how tall the skyline
     grid ends up. */
  #airplane-layer {
    position:fixed; inset:0; z-index:-1; pointer-events:none; overflow:hidden;
  }
  .airplane {
    position:absolute; height:56px; width:auto; object-fit:contain;
    animation-timing-function:linear; animation-fill-mode:forwards;
  }
  @keyframes fly-right { from { left:-100px; } to { left:calc(100% + 100px); } }
  @keyframes fly-left  { from { left:calc(100% + 100px); } to { left:-100px; } }
  .airplane.fly-right { animation-name: fly-right; }
  .airplane.fly-left  { animation-name: fly-left; transform:scaleX(-1); }
  /* Grass sits directly below the grid in normal document flow, NOT fixed
     to the viewport — a fixed strip stays glued to the bottom of the
     screen regardless of scroll, while the building row lives in the
     document and moves as the page scrolls, so the two would only ever
     line up by coincidence. In-flow means the grass line is always
     exactly where the buildings' feet are, at any scroll position or
     page height. */
  #grass-fg {
    flex:0 0 130px;
    width:100%; pointer-events:none;
    background-image:url('/tycoon/grass-foreground.png');
    background-repeat:repeat-x; background-position:bottom left; background-size:auto 100%;
    /* Comes after the grid in the DOM, so it paints in front of the
       buildings — this negative margin pulls it up so the blades actually
       cover the bottom of each building's feet, not just touch the grid's
       border like before. */
    margin-top:-55px;
    position:relative; z-index:1;
  }

  /* Pedestrians wander along the grass line, layered BEHIND it (z-index:0 <
     grass's 1) so they read as walking through the grass, partially
     hidden by the blades, rather than standing in front of the strip.
     Positioned relative to <main> (position:relative already), bottom-
     anchored so it always lines up with the grass regardless of viewport
     height. Split into a wrapper (handles horizontal walk + the static
     left/right flip) and an inner image (handles its own independent
     bob) so the two transforms never fight over the same property the
     way a single combined animation would. */
  #pedestrian-layer {
    /* Tall enough for the biggest sprite (112px) at its highest spawn point
       (bottom:80px) plus the bob's -7px lift, with a little headroom —
       130px used to clip the top of anything spawning near the high/tall
       end of that range, since overflow:hidden cut off right at the grass
       strip's own height instead of the sprites' actual reach. */
    position:absolute; left:0; right:0; bottom:0; height:210px;
    pointer-events:none; overflow:hidden; z-index:0;
  }
  .pedestrian-wrap {
    position:absolute;
    animation-timing-function:linear; animation-fill-mode:forwards;
  }
  .pedestrian-wrap.walk-right { animation-name: walk-right; }
  .pedestrian-wrap.walk-left  { animation-name: walk-left; }
  /* Mirrors the sprite — applied per-pedestrian by JS based on which way
     its art actually faces by default, not hardcoded to one travel
     direction (see facesRight in tycoon-buildings.js). */
  .pedestrian-wrap.flipped { transform:scaleX(-1); }
  @keyframes walk-right { from { left:-80px; } to { left:calc(100% + 80px); } }
  @keyframes walk-left  { from { left:calc(100% + 80px); } to { left:-80px; } }
  .pedestrian {
    display:block; object-fit:contain;
    filter:drop-shadow(0 3px 4px rgba(0,0,0,.4));
    animation: pedestrian-bob .5s ease-in-out infinite;
  }
  @keyframes pedestrian-bob {
    0%, 100% { transform:translateY(0); }
    50%      { transform:translateY(-7px); }
  }

  #strubles-badge{
    position:fixed; top:calc(15px + env(safe-area-inset-top)); left:calc(20px + env(safe-area-inset-left)); display:flex; align-items:center; gap:8px;
    background:#000; padding:8px 12px; border:3px solid var(--gold);
    font-weight:700; z-index:20;
  }
  #strubles-badge img{ width:28px; height:28px; }

  main {
    position:relative; z-index:2; max-width:1200px; width:100%; margin:0 auto;
    padding:16px 24px 0; padding-top:calc(80px + env(safe-area-inset-top));
    flex:1 1 auto; min-height:0;
    display:flex; flex-direction:column;
  }

  header { flex:0 0 auto; display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; border-bottom:4px solid #000; padding-bottom:10px; flex-wrap:wrap; gap:10px; }
  header a { color:var(--gold); text-decoration:none; border:3px solid #000; padding:8px 12px; font-weight:700; background:#000; transition:background 0.2s; font-size:10px; cursor:none; }
  header a:hover { background:var(--gold); color:#000; }
  header button { color:var(--gold); background:#000; border:2px solid var(--gold); padding:4px 6px; cursor:none; transition:background 0.2s; }
  header button:hover { background:var(--gold); color:#000; }

  h1 {
    margin:0; font-size:clamp(13px,2.6vw,20px); letter-spacing:1px; color:var(--gold); font-weight:400;
    text-shadow: 2px 2px 0 #000; text-align:center; width:100%;
  }

  #stats-bar {
    flex:0 0 auto;
    display:flex; justify-content:center; gap:18px; flex-wrap:wrap;
    background:rgba(0,0,0,.55); border:2px solid var(--gold); padding:8px 14px;
    margin-bottom:12px; font-size:9px; color:#fff;
  }
  #stats-bar b { color:var(--gold); }

  #cta-row {
    flex:0 0 auto;
    display:flex; justify-content:center; align-items:center; gap:10px; flex-wrap:wrap;
    margin-bottom:14px;
  }
  #lootbox-cta {
    display:block; text-align:center; width:fit-content;
    color:#000; background:var(--gold); text-decoration:none; border:3px solid #000;
    padding:10px 18px; font-size:11px; font-weight:700;
  }
  #lootbox-cta:hover { background:#ffe766; }
  #guide-btn {
    color:var(--gold); background:#000; border:3px solid var(--gold);
    padding:10px 14px; font-size:11px; font-weight:700; cursor:none;
    font-family:inherit; transition:background .2s, color .2s;
  }
  #guide-btn:hover { background:var(--gold); color:#000; }

  /* ---------- The skyline: a single row of 5 ---------- */
  /* flex:1 + min-height:0 gives this whatever vertical space is actually
     left after header/stats-bar/CTA/grass take theirs — NOT a share of
     the raw viewport. Building heights below are then percentages of
     THIS element's real height, so the tallest (skyscraper) always fits
     with room to spare, on any screen. */
  #tycoon-grid {
    flex:1 1 auto; min-height:140px;
    display:grid;
    /* No column minimum — a floor here forces 5×min > available width on
       narrow phones, which pushes the last building off-screen behind a
       horizontal scroll instead of shrinking it to fit like everything
       else on this page does. 1fr alone still splits the space evenly. */
    grid-template-columns: repeat(5, 1fr);
    gap:0 6px;
    overflow-x:auto;
  }
  .tycoon-slot {
    position:relative;
    display:flex; align-items:flex-end; justify-content:center;
    border-bottom:3px solid rgba(255,215,0,.35);
    /* Grid items get an implicit min-height:auto that floors them to their
       content's intrinsic size unless overflow is non-visible -- and
       .building-visual's height:66% can't resolve against THIS element
       until ITS OWN height is settled, so during that circular pass the
       browser falls back to sizing the img by its raw intrinsic/content
       size instead. On a tall viewport that fallback happens to be
       smaller than the grid row's real height and nothing looks wrong;
       on a short one (a real laptop window, not just a phone) the
       fallback is BIGGER than the row's actual computed height, and
       without this the slot refuses to shrink to match -- it silently
       overflows past #tycoon-grid's bottom into the grass strip below,
       burying the shorter buildings behind it almost entirely. Zeroing
       the floor lets the row's real height win, which is what makes the
       percentage below resolve correctly at any viewport size.
     */
    min-height:0;
  }
  .tycoon-slot.empty .empty-plus {
    width:100%; height:60%; max-height:100px; display:flex; align-items:center; justify-content:center;
    border:2px dashed rgba(255,215,0,.4); color:rgba(255,215,0,.6); font-size:28px;
    transition:background .15s, border-color .15s;
  }
  .tycoon-slot.empty:hover .empty-plus {
    border-color:var(--gold); background:rgba(255,215,0,.08);
  }
  /* Percentage of the SLOT's own height, which stretches to match
     #tycoon-grid's real (flex-computed) height by grid's default
     align-items:stretch — this is what makes the sizing adapt to
     whatever room is actually available instead of raw vh. Regular
     buildings sit at ~70% of what a skyscraper gets, echoing the
     spec's "half the page" vs. "70% of the page" ratio, just resolved
     against the grid's real height rather than the whole viewport.
     This has to live here (not on the img) — a percentage height only
     resolves against a definite ancestor, and .tycoon-slot's own
     align-items:flex-end means only a flex item positioned directly
     against IT (this element) gets that definite height; a plain child
     of an auto-sized box would just fall back to intrinsic size and
     ignore the percentage entirely. Sizing it here also means the
     label/badge/workers below (all position:absolute inside this box)
     hug exactly this building's own tier height instead of the row's
     shared height. */
  .building-visual {
    position:relative;
    height:66%;
    transition: height .2s ease;
  }
  .building-visual.skyscraper { height:82%; }
  .building-visual.prestige { height:98%; }
  .tycoon-building-img {
    display:block; width:auto; max-width:100%; height:100%;
    object-fit:contain;
    /* When max-width kicks in (narrow columns vs. a wide/square source
       image), height and width stop matching the image's own aspect
       ratio — contain then letterboxes it, and by default that centers
       the visible picture in the box, leaving empty space below it
       instead of the top. Anchoring to the bottom keeps the building's
       actual feet touching the slot's bottom edge regardless of which
       dimension ends up constrained. */
    object-position: center bottom;
    filter: drop-shadow(0 6px 10px rgba(0,0,0,.5));
    transition: filter .3s ease;
  }
  /* Some source art (Generic Building, Generic Skyscraper) is proportionally
     wider than the portrait-shaped box `contain` has to fit it into, so it
     was only using ~50-60% of its allotted height with empty space above —
     making a "regular" building look shorter than Shabby Apartment despite
     having the exact same box. `cover` fills the full height instead and
     crops the sides, which reads fine for a building facade. */
  .tycoon-building-img.fit-cover { object-fit: cover; }
  .tycoon-slot.building .tycoon-building-img {
    filter: brightness(0.5) saturate(0.6) drop-shadow(0 6px 10px rgba(0,0,0,.5));
  }
  .tycoon-slot .label-tag {
    /* Above the building, not below — bottom used to sit right where the
       taller/overlapping grass now covers it, making every label
       unreadable. */
    position:absolute; top:-2px; left:50%; transform:translateX(-50%);
    background:#000; color:var(--gold); border:2px solid var(--gold);
    font-size:7px; padding:3px 6px; text-align:center;
    /* Full label can be wider than a narrow mobile column — nowrap alone
       let neighboring labels run into and overlap each other; capping the
       width to the slot itself and truncating keeps each one inside its
       own lane. */
    max-width: 100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }

  .construction-pct {
    /* Sits below the label-tag now that the label moved to top:-2px (was
       bottom, hidden by the taller grass) — the two would otherwise stack
       right on top of each other during construction, when both show at
       once. */
    position:absolute; top:22px; left:50%; transform:translateX(-50%);
    background:rgba(0,0,0,.8); color:var(--gold); padding:3px 8px;
    font-size:9px; border:2px solid var(--gold); white-space:nowrap;
  }
  .construction-workers {
    position:absolute; bottom:6px; left:50%; transform:translateX(-50%);
    display:flex; gap:2px; pointer-events:none;
  }
  .construction-worker {
    height:44px; width:auto; object-fit:contain;
    animation: worker-wiggle .7s ease-in-out infinite;
    filter: drop-shadow(0 3px 4px rgba(0,0,0,.6));
  }
  .construction-worker.driller { animation-delay: .25s; }
  @keyframes worker-wiggle {
    0%, 100% { transform: rotate(-6deg) translateY(0); }
    50%      { transform: rotate(6deg) translateY(-4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .construction-worker { animation:none; }
  }

  /* ---------- Placement / picker overlays (same system as every other page) ---------- */
  .overlay{
    position:fixed; inset:0; background:rgba(0,0,0,.85); z-index:100;
    display:none; align-items:center; justify-content:center; padding:20px;
  }
  .overlay.open{ display:flex; }
  .modal{
    width:min(420px,90vw); max-height:75vh; overflow-y:auto;
    background:#0a0a0a; border:3px solid var(--gold); padding:20px;
    box-shadow:0 0 20px rgba(255,215,0,.4);
  }
  .modal-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; gap:10px; }
  .modal-head h2{ margin:0; font-size:12px; color:var(--gold); font-weight:400; }
  .btn{
    color:var(--gold); text-decoration:none; border:3px solid var(--gold); padding:8px 12px;
    background:#000; font-size:9px; transition:background .2s, color .2s; cursor:none;
    font-family:inherit; letter-spacing:1px; text-transform:uppercase;
  }
  .btn:hover{ background:var(--gold); color:#000; }
  .picker-row { display:flex; align-items:center; padding:8px 0; border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:10px; gap:10px; cursor:pointer; }
  .picker-row:last-child { border-bottom:none; }
  .picker-row:hover { background:rgba(255,215,0,.08); }
  .picker-row img { width:36px; height:36px; object-fit:contain; flex-shrink:0; }
  .picker-row .row-info { flex:1; line-height:1.6; }
  .picker-row .row-info small { color:var(--muted); display:block; font-size:8px; }
  .picker-row .row-info small.row-desc { font-style:italic; margin-top:3px; }
  .picker-empty { color:var(--muted); font-size:10px; padding:10px 0; line-height:1.8; text-align:center; }

  /* ---------- Building Guide (legend) ---------- */
  .guide-row {
    display:flex; align-items:center; gap:10px; padding:10px 0;
    border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:10px;
  }
  .guide-row:last-child { border-bottom:none; }
  .guide-row img { width:40px; height:40px; object-fit:contain; flex-shrink:0; }
  .guide-row .row-info { flex:1; line-height:1.6; }
  .guide-row .row-info small { color:var(--muted); display:block; font-size:8px; }
  .guide-row .row-info small.row-desc { font-style:italic; margin-top:3px; }

  .volume-row{
    display:flex; align-items:center; gap:10px; margin-bottom:16px;
    padding-bottom:14px; border-bottom:1px solid rgba(255,215,0,0.3);
  }
  .volume-row input[type="range"]{ flex:1; accent-color:var(--gold); cursor:none; touch-action:none; padding:14px 0; }
  .volume-mute-btn{
    all:unset; cursor:none; font-size:16px; padding:4px 8px;
    border:1px solid var(--gold); background:#000;
  }

  @media (max-width:768px) {
    /* Building heights are already percentages of the grid's own real
       (flex-computed) height, so they adapt on their own — no vh
       overrides needed here anymore. */
    #stats-bar { font-size:8px; gap:10px; }
    main { padding-left:12px; padding-right:12px; }
  }
</style>
</head>
<body>
  <div id="sky-bg"></div>
  <div id="airplane-layer" aria-hidden="true"></div>

  <div id="strubles-badge">
    <img src="/strubles.png" alt="Struble">
    <span id="bal">0</span>
  </div>

  <main>
    <header>
      <a href="/" title="Back to Iantopia">← Home</a>
      <h1>IANTOPIA TYCOON</h1>
      <div style="display:flex; gap:4px;">
        <button id="now-playing" title="Music options">🎵</button>
        <button id="cursor-btn" title="Change cursor">🖱️</button>
      </div>
    </header>

    <div id="stats-bar">
      <span>Production: <b id="stat-production">0</b>/min</span>
      <span>Placed: <b id="stat-placed">0</b>/5</span>
      <span>Under construction: <b id="stat-building">0/3</b></span>
    </div>

    <div id="cta-row">
      <a id="lootbox-cta" href="/lootbox">🏗️ Get an Iantopia Lootbox Basic</a>
      <button id="guide-btn" type="button">📖 Building Guide</button>
    </div>

    <div id="tycoon-grid"></div>
    <div id="grass-fg"></div>
    <div id="pedestrian-layer" aria-hidden="true"></div>
  </main>

  <!-- Placement picker: which owned-but-unplaced building to build here -->
  <div class="overlay" id="place-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Build here</h2>
        <button class="btn" id="place-close" type="button">Close</button>
      </div>
      <div id="place-list"></div>
    </div>
  </div>

  <!-- Manage an already-placed building: remove it, or swap for a different one -->
  <div class="overlay" id="manage-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2 id="manage-title">Manage</h2>
        <button class="btn" id="manage-close" type="button">Close</button>
      </div>
      <div id="manage-info"></div>
      <div id="manage-actions" style="display:flex; gap:10px; margin-top:14px; flex-wrap:wrap;">
        <button class="btn" id="manage-swap" type="button">🔁 Swap</button>
        <button class="btn" id="manage-remove" type="button">🗑️ Remove</button>
      </div>
    </div>
  </div>

  <!-- Building Guide: every tier's stats + description, regardless of ownership -->
  <div class="overlay" id="guide-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Building Guide</h2>
        <button class="btn" id="guide-close" type="button">Close</button>
      </div>
      <div id="guide-list"></div>
    </div>
  </div>

  <!-- Music Playlist Modal -->
  <div class="overlay" id="playlist-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Now Playing</h2>
        <button class="btn" id="playlist-close" type="button">Close</button>
      </div>
      <div class="volume-row">
        <button class="volume-mute-btn" id="mute-btn" aria-label="Toggle sound" title="Toggle sound">🔊</button>
        <input type="range" id="volume-slider" min="0" max="100" value="30" aria-label="Music volume" />
      </div>
      <div id="playlist-list"></div>
    </div>
  </div>

  <!-- Cursor Picker Modal -->
  <div class="overlay" id="cursor-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Cursors</h2>
        <button class="btn" id="cursor-close" type="button">Close</button>
      </div>
      <div id="cursor-list"></div>
    </div>
  </div>

  <audio id="theme-music" src="/audio/music/home-theme.mp3" preload="none" loop></audio>

<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<!-- Headless here (no account UI on this page) — see blackjack.astro for
     why every page needs this now, not just home. -->
<script is:inline src="/cloud-sync.js?v=7"></script>
<script is:inline src="/music-library.js?v=10"></script>
<script is:inline src="/music-position.js?v=1"></script>
<script is:inline src="/cursor-library.js?v=4"></script>
<script is:inline src="/case-data.js?v=16"></script>
<script is:inline src="/tycoon-buildings.js?v=5"></script>
<script is:inline src="/cursor.js?v=3"></script>
<script is:inline src="/strubles.js?v=2"></script>
<script is:inline src="/pickers.js?v=11"></script>
<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const GRID_SIZE = 5;
  const GRID_KEY = 'tycoon_grid_v1';
  const LAST_SEEN_KEY = 'tycoon_last_seen_v1';
  const INV_KEY = 'strubles_inventory_v1';
  const ORDER = window.TYCOON_BUILDING_ORDER || [];
  const DEFS = window.TYCOON_BUILDINGS || {};
  const MAX_PER_TYPE = window.TYCOON_MAX_PER_TYPE || 5;
  const MAX_CONCURRENT = window.TYCOON_MAX_CONCURRENT_BUILDS || 3;
  const OFFLINE_CAP_MS = window.TYCOON_OFFLINE_CAP_MS || 8 * 60 * 60 * 1000;
  const RARITY = window.CASE_RARITIES || {};

  function loadJSON(k, fb) { try { const v = localStorage.getItem(k); return v != null ? JSON.parse(v) : fb; } catch { return fb; } }
  function saveJSON(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} }

  function loadGrid() {
    const raw = loadJSON(GRID_KEY, null);
    if (Array.isArray(raw) && raw.length === GRID_SIZE) return raw;
    return new Array(GRID_SIZE).fill(null);
  }
  function saveGrid(grid) {
    saveJSON(GRID_KEY, grid);
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
  }

  function ownedCounts() {
    const inv = loadJSON(INV_KEY, {});
    const buildings = Array.isArray(inv.buildings) ? inv.buildings : [];
    const counts = {};
    ORDER.forEach((k) => { counts[k] = 0; });
    buildings.forEach((k) => { if (counts[k] != null) counts[k]++; });
    return counts;
  }
  function placedCounts(grid) {
    const counts = {};
    ORDER.forEach((k) => { counts[k] = 0; });
    grid.forEach((slot) => { if (slot && counts[slot.key] != null) counts[slot.key]++; });
    return counts;
  }
  function availableCounts(grid) {
    const owned = ownedCounts(), placed = placedCounts(grid);
    const avail = {};
    ORDER.forEach((k) => { avail[k] = Math.max(0, owned[k] - placed[k]); });
    return avail;
  }
  function buildingCount(grid) {
    return grid.filter((s) => s && s.status === 'building').length;
  }

  // Reconciles construction completion + production accrual since the last
  // check-in, capped at OFFLINE_CAP_MS so a long absence doesn't retroactively
  // finish/produce forever — the excess time beyond the cap is simply lost,
  // not banked for later ("construction pauses" per the spec).
  function tick(grid) {
    const now = Date.now();
    const lastSeen = Number(localStorage.getItem(LAST_SEEN_KEY)) || now;
    const cappedNow = Math.min(now, lastSeen + OFFLINE_CAP_MS);
    let earned = 0;
    let changed = false;
    grid.forEach((slot) => {
      if (!slot) return;
      const def = DEFS[slot.key];
      if (!def) return;
      if (slot.status === 'building' && cappedNow >= slot.completesAt) {
        slot.status = 'complete';
        slot.lastProductionAt = slot.completesAt;
        changed = true;
      }
      if (slot.status === 'complete') {
        const elapsedMin = Math.max(0, cappedNow - slot.lastProductionAt) / 60000;
        const gain = Math.floor(elapsedMin * def.production);
        if (gain > 0) {
          earned += gain;
          slot.lastProductionAt += (gain / def.production) * 60000;
          changed = true;
        }
      }
    });
    localStorage.setItem(LAST_SEEN_KEY, String(now));
    if (earned > 0) { try { Strubles.add(earned); } catch {} }
    return changed;
  }

  function syncBalance() { try { $('bal').textContent = Strubles.get().toLocaleString(); } catch {} }

  function fmtRemaining(ms) {
    const s = Math.max(0, Math.ceil(ms / 1000));
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
    if (h > 0) return `${h}h ${m}m left`;
    if (m > 0) return `${m}m ${sec}s left`;
    return `${sec}s left`;
  }

  let grid = loadGrid();
  let renderTimer = null;

  function render() {
    const gridEl = $('tycoon-grid');
    gridEl.innerHTML = '';
    const now = Date.now();
    let totalProduction = 0;

    grid.forEach((slot, i) => {
      const cell = document.createElement('div');
      cell.className = 'tycoon-slot';
      cell.dataset.slot = i;

      if (!slot) {
        cell.classList.add('empty');
        const plus = document.createElement('div');
        plus.className = 'empty-plus';
        plus.textContent = '+';
        cell.appendChild(plus);
        cell.addEventListener('click', () => openPlacePicker(i));
        gridEl.appendChild(cell);
        return;
      }

      const def = DEFS[slot.key];
      if (!def) { gridEl.appendChild(cell); return; }
      const rarity = RARITY[def.tier] || {};

      // Wraps just the image (shrinks to its actual rendered size, not the
      // slot/row's full height) so the label/badge below position relative
      // to THIS building's own top edge — a short building sharing a row
      // with a tall one used to leave its label floating way up near the
      // row's top, since it was positioned relative to the slot instead.
      const visual = document.createElement('div');
      visual.className = 'building-visual' + (def.prestige ? ' prestige' : (def.skyscraper ? ' skyscraper' : ''));

      const img = document.createElement('img');
      img.className = 'tycoon-building-img' + (def.fillMode === 'cover' ? ' fit-cover' : '');
      img.src = def.img;
      img.alt = def.label;
      visual.appendChild(img);

      const tag = document.createElement('div');
      tag.className = 'label-tag';
      tag.style.color = rarity.color || 'var(--gold)';
      tag.style.borderColor = rarity.color || 'var(--gold)';

      if (slot.status === 'building') {
        cell.classList.add('building');
        const pct = Math.min(100, Math.round(((now - slot.startedAt) / (slot.completesAt - slot.startedAt)) * 100));
        const badge = document.createElement('div');
        badge.className = 'construction-pct';
        badge.textContent = `${pct}% — ${fmtRemaining(slot.completesAt - now)}`;
        visual.appendChild(badge);

        const workers = document.createElement('div');
        workers.className = 'construction-workers';
        const w1 = document.createElement('img');
        w1.className = 'construction-worker';
        w1.src = '/tycoon/worker-pointing.png';
        w1.alt = '';
        const w2 = document.createElement('img');
        w2.className = 'construction-worker driller';
        w2.src = '/tycoon/worker-driller.png';
        w2.alt = '';
        workers.appendChild(w1);
        workers.appendChild(w2);
        visual.appendChild(workers);

        tag.textContent = def.label;
      } else {
        totalProduction += def.production;
        tag.textContent = `${def.label} · +${def.production}/min`;
      }
      visual.appendChild(tag);
      cell.appendChild(visual);
      cell.addEventListener('click', () => openManagePicker(i));
      gridEl.appendChild(cell);
    });

    $('stat-production').textContent = totalProduction;
    $('stat-placed').textContent = grid.filter(Boolean).length;
    $('stat-building').textContent = buildingCount(grid) + '/' + MAX_CONCURRENT;
    syncBalance();
  }

  function scheduleReconcile() {
    if (tick(grid)) saveGrid(grid);
    render();
    if (renderTimer) clearInterval(renderTimer);
    // Re-render often enough for the percentage/timer to feel live and for
    // production to land promptly, without hammering localStorage.
    renderTimer = setInterval(() => {
      const changed = tick(grid);
      if (changed) saveGrid(grid);
      render();
    }, 10000);
  }

  // --- Placement flow ---
  const placeOverlay = $('place-overlay');
  const placeList = $('place-list');
  let targetSlot = null;

  function openPlacePicker(slotIndex) {
    targetSlot = slotIndex;
    const avail = availableCounts(grid);
    const owned = ownedCounts();
    placeList.innerHTML = '';
    const anyAvailable = ORDER.some((k) => avail[k] > 0);
    if (!anyAvailable) {
      const empty = document.createElement('div');
      empty.className = 'picker-empty';
      empty.textContent = "You don't have any unplaced buildings — open an Iantopia Lootbox Basic on the Lootbox page to win one.";
      placeList.appendChild(empty);
      placeOverlay.classList.add('open');
      return;
    }
    ORDER.forEach((key) => {
      if (avail[key] <= 0) return;
      const def = DEFS[key];
      const rarity = RARITY[def.tier] || {};
      const row = document.createElement('div');
      row.className = 'picker-row';
      const img = document.createElement('img');
      img.src = def.img;
      img.alt = def.label;
      const info = document.createElement('div');
      info.className = 'row-info';
      info.innerHTML = `${def.label} <small style="color:${rarity.color || ''}">${rarity.label || ''} · own ${owned[key]}/${MAX_PER_TYPE} · ${avail[key]} unplaced</small><small>Cost ${def.cost.toLocaleString()} Strubles · builds in ${fmtDuration(def.buildMinutes)} · +${def.production}/min when done</small>${def.description ? `<small class="row-desc">${def.description}</small>` : ''}`;
      row.appendChild(img);
      row.appendChild(info);
      row.addEventListener('click', () => placeBuilding(key));
      placeList.appendChild(row);
    });
    placeOverlay.classList.add('open');
  }
  function fmtDuration(min) {
    if (min >= 1440) return (min / 1440).toFixed(min % 1440 === 0 ? 0 : 1) + 'd';
    if (min >= 60) return (min / 60).toFixed(min % 60 === 0 ? 0 : 1) + 'h';
    return min + 'm';
  }

  function placeBuilding(key) {
    const def = DEFS[key];
    if (!def || targetSlot == null) return;
    if (buildingCount(grid) >= MAX_CONCURRENT) {
      alert(`Only ${MAX_CONCURRENT} buildings can be under construction at once — wait for one to finish first.`);
      return;
    }
    if (!Strubles.spend(def.cost)) {
      alert(`Not enough Strubles for the permit (need ${def.cost.toLocaleString()}).`);
      return;
    }
    const now = Date.now();
    grid[targetSlot] = {
      key,
      status: 'building',
      startedAt: now,
      completesAt: now + def.buildMinutes * 60000,
      lastProductionAt: now,
    };
    saveGrid(grid);
    placeOverlay.classList.remove('open');
    render();
  }

  document.querySelectorAll('#place-overlay, #place-close').forEach((el) => {
    el.addEventListener('click', (e) => {
      if (e.target.id === 'place-overlay' || e.target.id === 'place-close') {
        placeOverlay.classList.remove('open');
      }
    });
  });

  // --- Manage an occupied slot: remove it, or swap it for something else.
  // Swap reuses openPlacePicker as-is — placeBuilding() already just
  // overwrites whatever's in the target slot unconditionally, so the old
  // occupant naturally becomes "unplaced" again (ownership is owned minus
  // placed, scanned fresh from the current grid) with no separate
  // bookkeeping needed. ---
  const manageOverlay = $('manage-overlay');
  let manageSlot = null;

  function openManagePicker(slotIndex) {
    const slot = grid[slotIndex];
    if (!slot) return;
    manageSlot = slotIndex;
    const def = DEFS[slot.key];
    const rarity = RARITY[def.tier] || {};
    $('manage-title').textContent = def.label;
    const statusLine = slot.status === 'building'
      ? 'Currently under construction — removing forfeits progress, no refund.'
      : `Producing +${def.production}/min.`;
    $('manage-info').innerHTML = `
      <div class="guide-row">
        <img src="${def.img}" alt="${def.label}">
        <div class="row-info">
          ${def.label} <small style="color:${rarity.color || ''}">${rarity.label || ''}</small>
          <small>${statusLine}</small>
          ${def.description ? `<small class="row-desc">${def.description}</small>` : ''}
        </div>
      </div>`;
    manageOverlay.classList.add('open');
  }

  $('manage-swap').addEventListener('click', () => {
    if (manageSlot == null) return;
    manageOverlay.classList.remove('open');
    openPlacePicker(manageSlot);
  });
  $('manage-remove').addEventListener('click', () => {
    if (manageSlot == null) return;
    grid[manageSlot] = null;
    saveGrid(grid);
    manageOverlay.classList.remove('open');
    render();
  });
  document.querySelectorAll('#manage-overlay, #manage-close').forEach((el) => {
    el.addEventListener('click', (e) => {
      if (e.target.id === 'manage-overlay' || e.target.id === 'manage-close') {
        manageOverlay.classList.remove('open');
      }
    });
  });

  // --- Building Guide: every tier, regardless of ownership — the "no
  // legend" gap. Rendered fresh each open so owned-count stays current if
  // you check it again mid-session. ---
  const guideOverlay = $('guide-overlay');
  const guideList = $('guide-list');
  $('guide-btn').addEventListener('click', () => {
    const owned = ownedCounts();
    guideList.innerHTML = '';
    ORDER.forEach((key) => {
      const def = DEFS[key];
      const rarity = RARITY[def.tier] || {};
      const row = document.createElement('div');
      row.className = 'guide-row';
      const img = document.createElement('img');
      img.src = def.img;
      img.alt = def.label;
      const info = document.createElement('div');
      info.className = 'row-info';
      info.innerHTML = `${def.label} <small style="color:${rarity.color || ''}">${rarity.label || ''} · own ${owned[key]}/${MAX_PER_TYPE}</small><small>Cost ${def.cost.toLocaleString()} Strubles · builds in ${fmtDuration(def.buildMinutes)} · +${def.production}/min when done</small>${def.description ? `<small class="row-desc">${def.description}</small>` : ''}`;
      row.appendChild(img);
      row.appendChild(info);
      guideList.appendChild(row);
    });
    guideOverlay.classList.add('open');
  });
  document.querySelectorAll('#guide-overlay, #guide-close').forEach((el) => {
    el.addEventListener('click', (e) => {
      if (e.target.id === 'guide-overlay' || e.target.id === 'guide-close') {
        guideOverlay.classList.remove('open');
      }
    });
  });

  window.addEventListener('inventory:changed', () => { grid = loadGrid(); render(); });
  window.addEventListener('strubles:change', syncBalance);
  window.addEventListener('storage', (e) => {
    if (e.key === GRID_KEY) { grid = loadGrid(); render(); }
    if (e.key === INV_KEY) render();
  });

  // --- Sound (same pattern as every other page) ---
  let audioEnabled = true;
  const themeMusic = $('theme-music');
  const VOLUME_KEY = 'music_volume_v1';
  const volumeSlider = $('volume-slider');
  const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
  themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.3;
  volumeSlider.value = Math.round(themeMusic.volume * 100);
  volumeSlider.addEventListener('input', () => {
    themeMusic.volume = volumeSlider.value / 100;
    localStorage.setItem(VOLUME_KEY, themeMusic.volume);
  });
  function tryPlayTheme() { if (audioEnabled) themeMusic.play().catch(() => {}); }
  tryPlayTheme();
  const unlockTheme = () => {
    tryPlayTheme();
    window.removeEventListener('pointerdown', unlockTheme);
    window.removeEventListener('keydown', unlockTheme);
  };
  window.addEventListener('pointerdown', unlockTheme);
  window.addEventListener('keydown', unlockTheme);
  $('mute-btn').addEventListener('click', () => {
    audioEnabled = !audioEnabled;
    $('mute-btn').textContent = audioEnabled ? '🔊' : '🔇';
    if (audioEnabled) tryPlayTheme(); else themeMusic.pause();
  });

  scheduleReconcile();

  // --- Pedestrians: purely decorative, but their frequency scales with
  // how developed the city is (complete buildings), so a fresh empty grid
  // feels quiet and a full skyline feels lively. ---
  const PEDESTRIANS = window.TYCOON_PEDESTRIANS || [];
  const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function spawnPedestrian() {
    const layer = $('pedestrian-layer');
    if (!layer || !PEDESTRIANS.length) return;
    const p = PEDESTRIANS[Math.floor(Math.random() * PEDESTRIANS.length)];
    const wrap = document.createElement('div');
    // Higher and with bigger sprites than before — enough was getting
    // swallowed by the grass that "walking through it" read as "barely
    // visible." Still dips low enough on the bob to graze the blades.
    wrap.style.bottom = (25 + Math.random() * 55) + 'px';
    const duration = 9 + Math.random() * 6; // 9-15s to cross
    wrap.style.animationDuration = duration + 's';
    const goingRight = Math.random() < 0.5;
    const facesRight = p.facesRight !== false;
    const needsFlip = goingRight ? !facesRight : facesRight;
    wrap.className = 'pedestrian-wrap ' + (goingRight ? 'walk-right' : 'walk-left') + (needsFlip ? ' flipped' : '');
    const el = document.createElement('img');
    el.src = p.img;
    el.alt = '';
    el.style.height = p.height + 'px';
    el.className = 'pedestrian';
    wrap.appendChild(el);
    layer.appendChild(wrap);
    setTimeout(() => wrap.remove(), duration * 1000 + 200);
  }
  function scheduleNextPedestrian() {
    // 0 complete buildings -> ~8-9.5s between walkers; a full skyline (5
    // complete) -> ~2-3.5s. Complete only, not under-construction — a
    // building site isn't foot traffic yet.
    const completedCount = grid.filter((s) => s && s.status === 'complete').length;
    const base = Math.max(2000, 8000 - completedCount * 1200);
    setTimeout(() => {
      spawnPedestrian();
      scheduleNextPedestrian();
    }, base + Math.random() * 1500);
  }
  if (!reduceMotion) scheduleNextPedestrian();

  // --- Silly airplane: rare, purely for fun, doesn't scale with anything ---
  function spawnAirplane() {
    const layer = $('airplane-layer');
    if (!layer) return;
    const el = document.createElement('img');
    el.src = '/tycoon/silly-airplane.gif';
    el.alt = '';
    el.style.top = (6 + Math.random() * 18) + '%';
    const duration = 16 + Math.random() * 10; // 16-26s, a leisurely drift
    el.style.animationDuration = duration + 's';
    el.className = 'airplane ' + (Math.random() < 0.5 ? 'fly-right' : 'fly-left');
    layer.appendChild(el);
    setTimeout(() => el.remove(), duration * 1000 + 200);
  }
  function scheduleNextAirplane() {
    setTimeout(() => {
      spawnAirplane();
      scheduleNextAirplane();
    }, 45000 + Math.random() * 45000); // one every 45-90s
  }
  if (!reduceMotion) scheduleNextAirplane();

  if (window.initPickers) setTimeout(window.initPickers, 100);
})();
</script>
</body>
</html>
