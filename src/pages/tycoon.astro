<!-- Pinned exact version: Phaser 4 is new (Apr 2026), don't float it. -->
<script is:inline src="https://cdn.jsdelivr.net/npm/phaser@4.0.0/dist/phaser.min.js"></script>
<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);

  // Economy stays frozen outside dev mode until the server-authoritative
  // village save lands (see the rework plan, phase 3). Placing/moving still
  // works so the new map can be tried; production/tax/construction do not.
  const TYCOON_DISABLED = !localStorage.getItem('tycoon_dev_mode');
  $('out-of-order-banner').style.display = TYCOON_DISABLED ? 'block' : 'none';

  // ---------- Constants / data ----------
  const T = 16;                 // pixels per tile (world units)
  const MAP = 16;               // map is MAP x MAP tiles
  const BASE_SLOTS = 5;         // buildings allowed before buying more slots
  const VILLAGE_KEY = 'tycoon_village_v2';
  const LEGACY_GRID_KEY = 'tycoon_grid_v1';
  const LAST_SEEN_KEY = 'tycoon_last_seen_v1';
  const INV_KEY = 'strubles_inventory_v1';
  const SLOTS_KEY = 'tycoon_slots_owned_v1';
  const ORDER = window.TYCOON_BUILDING_ORDER || [];
  const DEFS = window.TYCOON_BUILDINGS || {};
  const MAX_PER_TYPE = window.TYCOON_MAX_PER_TYPE || 5;
  const MAX_CONCURRENT = window.TYCOON_MAX_CONCURRENT_BUILDS || 3;
  const RARITY = window.CASE_RARITIES || {};
  const EXPAND_BASE_COST = 200000;
  const EXPAND_GROWTH = 3;

  // Tile footprint + emoji for pickers (the old PNG art is no longer used).
  const LAYOUT = {
    shabby_apartment:   { w: 1, h: 1, icon: '🏚️' },
    generic_building:   { w: 2, h: 1, icon: '🏢' },
    pagoda:             { w: 2, h: 2, icon: '⛩️' },
    generic_skyscraper: { w: 2, h: 2, icon: '🏙️' },
    taipei_101:         { w: 3, h: 3, icon: '🗼' },
  };
  const foot = (key) => LAYOUT[key] || { w: 1, h: 1, icon: '🏠' };

  // ---------- Persistence ----------
  function loadJSON(k, fb) { try { const v = localStorage.getItem(k); return v != null ? JSON.parse(v) : fb; } catch { return fb; } }
  function saveJSON(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} }

  function slotsOwned() { return Math.max(0, Number(localStorage.getItem(SLOTS_KEY)) || 0); }
  function slotCap() { return BASE_SLOTS + slotsOwned(); }
  function expandCostForSlot(n) { return n <= 0 ? 0 : EXPAND_BASE_COST * Math.pow(EXPAND_GROWTH, n - 1); }

  // Village state: { v:2, nextId, b:[{id,key,x,y,status,startedAt,completesAt,lastProductionAt,lastTaxAt,taxDebt}] }
  function freshVillage() { return { v: 2, nextId: 1, b: [] }; }

  // First load after the rework: carry the old one-row skyline's buildings
  // over (same construction progress, same keys) into a row on the new map
  // instead of silently dropping what players already built. The legacy key
  // is left untouched.
  function migrateLegacy() {
    const v = freshVillage();
    const old = loadJSON(LEGACY_GRID_KEY, null);
    if (!Array.isArray(old)) return v;
    let cx = 1;
    old.forEach((slot) => {
      if (!slot || !DEFS[slot.key]) return;
      const f = foot(slot.key);
      if (cx + f.w > MAP) return;
      v.b.push(Object.assign({}, slot, { id: v.nextId++, x: cx, y: MAP - 1 - f.h - 1 }));
      cx += f.w + 1;
    });
    return v;
  }

  function loadVillage() {
    const raw = loadJSON(VILLAGE_KEY, null);
    if (raw && raw.v === 2 && Array.isArray(raw.b)) return raw;
    const v = migrateLegacy();
    saveJSON(VILLAGE_KEY, v);
    return v;
  }
  function saveVillage() {
    saveJSON(VILLAGE_KEY, village);
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
  }

  let village = loadVillage();

  // ---------- Inventory / counts ----------
  function ownedCounts() {
    const inv = loadJSON(INV_KEY, {});
    const list = Array.isArray(inv.buildings) ? inv.buildings : [];
    const counts = {};
    ORDER.forEach((k) => { counts[k] = 0; });
    list.forEach((k) => { if (counts[k] != null) counts[k]++; });
    return counts;
  }
  function placedCounts(excludeId) {
    const counts = {};
    ORDER.forEach((k) => { counts[k] = 0; });
    village.b.forEach((s) => { if (s.id !== excludeId && counts[s.key] != null) counts[s.key]++; });
    return counts;
  }
  function availableCounts() {
    const owned = ownedCounts(), placed = placedCounts();
    const avail = {};
    ORDER.forEach((k) => { avail[k] = Math.max(0, owned[k] - placed[k]); });
    return avail;
  }
  const buildingCount = () => village.b.filter((s) => s.status === 'building').length;

  // ---------- Economy tick (same math as the old skyline) ----------
  function tick() {
    if (TYCOON_DISABLED) return false;
    const now = Date.now();
    let earned = 0, changed = false;
    village.b.forEach((slot) => {
      const def = DEFS[slot.key];
      if (!def) return;
      if (slot.status === 'building' && now >= slot.completesAt) {
        slot.status = 'complete';
        slot.lastProductionAt = slot.completesAt;
        slot.lastTaxAt = slot.completesAt;
        slot.taxDebt = slot.taxDebt || 0;
        changed = true;
      }
      if (slot.status === 'complete') {
        if (slot.lastTaxAt == null) { slot.lastTaxAt = now; slot.taxDebt = 0; changed = true; }
        const neglected = slot.taxDebt > 0;
        const elapsedMin = Math.max(0, now - slot.lastProductionAt) / 60000;
        const eff = def.production * (neglected ? 0.5 : 1);
        const gain = Math.floor(elapsedMin * eff);
        if (gain > 0) {
          earned += gain;
          slot.lastProductionAt += (gain / eff) * 60000;
          changed = true;
        }
        const dailyUpkeep = def.cost * (def.upkeepPct || 0);
        const elapsedTax = Math.max(0, now - slot.lastTaxAt) / 60000;
        const perMin = dailyUpkeep / 1440;
        const taxOwed = perMin > 0 ? Math.floor(elapsedTax * perMin) : 0;
        if (taxOwed > 0) {
          slot.taxDebt = (slot.taxDebt || 0) + taxOwed;
          slot.lastTaxAt += (taxOwed / perMin) * 60000;
          changed = true;
        }
      }
    });
    localStorage.setItem(LAST_SEEN_KEY, String(now));
    if (earned > 0) { try { Strubles.add(earned); } catch {} }
    village.b.forEach((slot) => {
      if (slot.status === 'complete' && slot.taxDebt > 0 && Strubles.spend(slot.taxDebt)) {
        slot.taxDebt = 0;
        changed = true;
      }
    });
    return changed;
  }

  // ---------- Map helpers ----------
  function inBounds(x, y, f) { return x >= 0 && y >= 0 && x + f.w <= MAP && y + f.h <= MAP; }
  function overlaps(a, b) {
    return a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;
  }
  // ignoreId lets a building being moved ignore its own old footprint.
  function canPlace(key, x, y, ignoreId) {
    const f = foot(key);
    if (!inBounds(x, y, f)) return false;
    const rect = { x, y, w: f.w, h: f.h };
    return !village.b.some((s) => {
      if (s.id === ignoreId) return false;
      const sf = foot(s.key);
      return overlaps(rect, { x: s.x, y: s.y, w: sf.w, h: sf.h });
    });
  }
  function buildingAt(tx, ty) {
    return village.b.find((s) => {
      const f = foot(s.key);
      return tx >= s.x && tx < s.x + f.w && ty >= s.y && ty < s.y + f.h;
    }) || null;
  }

  function syncBalance() { try { $('bal').textContent = Strubles.get().toLocaleString(); } catch {} }
  function fmtDuration(min) {
    if (min >= 1440) return (min / 1440).toFixed(min % 1440 === 0 ? 0 : 1) + 'd';
    if (min >= 60) return (min / 60).toFixed(min % 60 === 0 ? 0 : 1) + 'h';
    return min + 'm';
  }

  // ---------- Procedural pixel art (1 world px per art px, T=16 per tile) ----------
  const hex = (s) => parseInt(s.replace('#', ''), 16);
  function rect(g, color, x, y, w, h, alpha) {
    g.fillStyle(hex(color), alpha == null ? 1 : alpha);
    g.fillRect(x, y, w, h);
  }

  const ART = {
    shabby_apartment(g, ox, oy) {
      rect(g, '#2b1a10', ox + 1, oy + 2, 14, 13);
      rect(g, '#a8845a', ox + 2, oy + 5, 12, 9);
      rect(g, '#7a3b2e', ox + 1, oy + 2, 14, 4);
      rect(g, '#8f4a3a', ox + 1, oy + 2, 14, 1);
      rect(g, '#ffe08a', ox + 3, oy + 8, 3, 3);
      rect(g, '#ffe08a', ox + 10, oy + 8, 3, 3);
      rect(g, '#4a2c17', ox + 7, oy + 10, 3, 4);
      rect(g, '#6b6b6b', ox + 11, oy, 2, 3);
    },
    generic_building(g, ox, oy) {
      rect(g, '#2a2f38', ox + 1, oy + 1, 30, 14);
      rect(g, '#8a93a0', ox + 2, oy + 3, 28, 11);
      rect(g, '#5d6672', ox + 1, oy + 1, 30, 3);
      rect(g, '#9aa3b0', ox + 4, oy + 1, 5, 2);
      for (let i = 0; i < 6; i++) rect(g, '#bfe3ff', ox + 4 + i * 4, oy + 6, 3, 3);
      rect(g, '#4a2c17', ox + 14, oy + 10, 4, 4);
    },
    pagoda(g, ox, oy) {
      rect(g, '#5a432c', ox + 4, oy + 28, 24, 3);
      const tiers = [
        { y: 20, w: 24, wall: 6 },
        { y: 12, w: 18, wall: 6 },
        { y: 4,  w: 12, wall: 5 },
      ];
      tiers.forEach((t) => {
        const x = ox + 16 - t.w / 2;
        rect(g, '#e8d9b0', x + 2, oy + t.y + 3, t.w - 4, t.wall);
        rect(g, '#7a1f16', x - 3, oy + t.y, t.w + 6, 3);
        rect(g, '#c0392b', x - 2, oy + t.y, t.w + 4, 2);
        rect(g, '#ffd700', x - 3, oy + t.y + 2, t.w + 6, 1);
      });
      rect(g, '#ffd700', ox + 15, oy, 2, 5);
      rect(g, '#4a2c17', ox + 14, oy + 23, 4, 5);
    },
    generic_skyscraper(g, ox, oy) {
      rect(g, '#1b2a3a', ox + 5, oy + 3, 22, 28);
      rect(g, '#4a7fb5', ox + 6, oy + 4, 20, 26);
      rect(g, '#2f4a66', ox + 6, oy + 4, 20, 3);
      for (let r = 0; r < 5; r++) {
        for (let c = 0; c < 4; c++) rect(g, r % 2 ? '#bfe3ff' : '#8fc2ea', ox + 8 + c * 5, oy + 9 + r * 4, 3, 2);
      }
      rect(g, '#cfd6de', ox + 15, oy, 2, 4);
      rect(g, '#ff4444', ox + 15, oy, 2, 1);
    },
    taipei_101(g, ox, oy) {
      rect(g, '#1c3b2a', ox + 10, oy + 40, 28, 7);
      for (let i = 0; i < 8; i++) {
        const w = i === 0 ? 14 : 12 + (i % 2 ? 4 : 0);
        const x = ox + 24 - w / 2;
        const y = oy + 36 - i * 4;
        rect(g, '#2e8b57', x, y, w, 4);
        rect(g, '#3fae70', x, y, w, 1);
        rect(g, '#ffd700', x - 1, y + 3, w + 2, 1);
        rect(g, '#bfe3ff', x + 2, y + 1, 2, 2);
        rect(g, '#bfe3ff', x + w - 4, y + 1, 2, 2);
      }
      rect(g, '#2e8b57', ox + 18, oy + 2, 12, 3);
      rect(g, '#cfd6de', ox + 23, oy, 2, 3);
    },
  };

  // Scaffold look while a building is under construction.
  function drawScaffold(g, ox, oy, w, h, pct) {
    rect(g, '#000000', ox + 1, oy + 2, w - 2, h - 2, 0.35);
    for (let i = 0; i < w - 2; i += 4) rect(g, i % 8 === 0 ? '#ffd23f' : '#262626', ox + 1 + i, oy + 2, 4, 2);
    rect(g, '#262626', ox + 1, oy + 2, 2, h - 2);
    rect(g, '#262626', ox + w - 3, oy + 2, 2, h - 2);
    const fillH = Math.max(1, Math.floor(((h - 6) * pct) / 100));
    rect(g, '#b99b6b', ox + 3, oy + h - 2 - fillH, w - 6, fillH);
    rect(g, '#000000', ox + 1, oy + h - 1, w - 2, 1, 0.6);
  }

  function drawTerrain(g) {
    for (let y = 0; y < MAP; y++) {
      for (let x = 0; x < MAP; x++) {
        const n = ((x * 73856093) ^ (y * 19349663)) >>> 0;
        const shade = (x + y) % 2 ? '#3f7d3a' : '#3a7635';
        rect(g, shade, x * T, y * T, T, T);
        if (n % 5 === 0) rect(g, '#4f9247', x * T + (n >> 3) % 12 + 1, y * T + (n >> 6) % 12 + 1, 2, 1);
        if (n % 11 === 0) rect(g, '#2f6a2c', x * T + (n >> 4) % 11 + 2, y * T + (n >> 7) % 11 + 2, 1, 2);
      }
    }
    // Dirt border so the buildable area reads as a plot, not an endless field.
    g.lineStyle(2, hex('#6b4a2e'), 1);
    g.strokeRect(-1, -1, MAP * T + 2, MAP * T + 2);
  }

  // ---------- Phaser scene ----------
  let scene = null, cam = null;
  let camCX = (MAP * T) / 2, camCY = (MAP * T) / 2;
  let selectedId = null;
  // Placement mode: { key, moveId|null, tx, ty, restore|null }
  let placing = null;
  let layer, ghostG, gridG, labels = [];

  function clampCam() {
    const vw = cam.width / cam.zoom, vh = cam.height / cam.zoom;
    const wW = MAP * T, wH = MAP * T, pad = 24;
    camCX = vw >= wW + pad * 2 ? wW / 2 : Math.max(vw / 2 - pad, Math.min(wW + pad - vw / 2, camCX));
    camCY = vh >= wH + pad * 2 ? wH / 2 : Math.max(vh / 2 - pad, Math.min(wH + pad - vh / 2, camCY));
    cam.centerOn(camCX, camCY);
  }
  function fitZoom() {
    const z = Math.min(cam.width / (MAP * T + 48), cam.height / (MAP * T + 48));
    return Math.max(0.5, z);
  }
  function recenter() {
    camCX = (MAP * T) / 2; camCY = (MAP * T) / 2;
    cam.setZoom(fitZoom());
    clampCam();
  }
  function setZoom(z) {
    const min = fitZoom() * 0.75;
    cam.setZoom(Math.max(min, Math.min(8, z)));
    clampCam();
  }

  function refresh() {
    if (!scene) return;
    layer.clear();
    labels.forEach((t) => t.destroy());
    labels = [];
    const now = Date.now();
    let totalProduction = 0, totalUpkeep = 0;

    // Draw back-to-front so taller buildings overlap the ones behind them.
    const sorted = village.b.slice().sort((a, b) => (a.y + foot(a.key).h) - (b.y + foot(b.key).h));
    sorted.forEach((s) => {
      if (placing && placing.moveId === s.id) return;
      const def = DEFS[s.key];
      if (!def) return;
      const f = foot(s.key);
      const ox = s.x * T, oy = s.y * T, w = f.w * T, h = f.h * T;
      // Ground shadow
      rect(layer, '#000000', ox + 2, oy + h - 3, w - 2, 4, 0.28);
      let tag = '';
      if (s.status === 'building') {
        const pct = Math.min(100, Math.round(((now - s.startedAt) / (s.completesAt - s.startedAt)) * 100));
        drawScaffold(layer, ox, oy, w, h, pct);
        tag = `${pct}%`;
      } else {
        (ART[s.key] || ART.shabby_apartment)(layer, ox, oy);
        const neglected = s.taxDebt > 0;
        const prod = def.production * (neglected ? 0.5 : 1);
        totalProduction += prod;
        totalUpkeep += def.cost * (def.upkeepPct || 0);
        if (neglected) {
          rect(layer, '#000000', ox, oy, w, h, 0.45);
          rect(layer, '#ff4444', ox + w - 5, oy + 1, 4, 4);
        }
      }
      if (s.id === selectedId) {
        layer.lineStyle(1, hex('#ffd700'), 1);
        layer.strokeRect(ox - 0.5, oy - 0.5, w + 1, h + 1);
      }
      if (tag) {
        const t = scene.add.text(ox + w / 2, oy + h / 2, tag, { fontFamily: 'monospace', fontSize: '8px', color: '#ffffff', stroke: '#000000', strokeThickness: 2 });
        t.setOrigin(0.5);
        t.setResolution(4);
        labels.push(t);
      }
    });

    drawGhost();

    $('stat-production').textContent = Math.floor(totalProduction);
    $('stat-placed').textContent = village.b.length + '/' + slotCap();
    $('stat-building').textContent = buildingCount() + '/' + MAX_CONCURRENT;
    $('stat-upkeep').textContent = Math.floor(totalUpkeep);
    syncBalance();
    maybePushLeaderboardScore(totalProduction - (totalUpkeep / 1440));
  }

  function drawGhost() {
    ghostG.clear();
    gridG.clear();
    if (!placing) return;
    // Faint tile grid while aiming.
    gridG.lineStyle(1, 0xffffff, 0.12);
    for (let i = 0; i <= MAP; i++) {
      gridG.lineBetween(i * T, 0, i * T, MAP * T);
      gridG.lineBetween(0, i * T, MAP * T, i * T);
    }
    if (placing.tx == null) return;
    const f = foot(placing.key);
    const ok = canPlace(placing.key, placing.tx, placing.ty, placing.moveId);
    const ox = placing.tx * T, oy = placing.ty * T;
    ghostG.setAlpha(0.8);
    if (ok) (ART[placing.key] || ART.shabby_apartment)(ghostG, ox, oy);
    rect(ghostG, ok ? '#00ff6a' : '#ff3b3b', ox, oy, f.w * T, f.h * T, ok ? 0.22 : 0.45);
    ghostG.lineStyle(1, hex(ok ? '#00ff6a' : '#ff3b3b'), 1);
    ghostG.strokeRect(ox + 0.5, oy + 0.5, f.w * T - 1, f.h * T - 1);
    const txt = $('place-bar-text');
    const inb = inBounds(placing.tx, placing.ty, f);
    txt.textContent = ok ? `${DEFS[placing.key].label} — tap ✓ to place` : (inb ? 'Something is in the way' : 'Out of bounds');
    txt.classList.toggle('bad', !ok);
    $('place-confirm').disabled = !ok;
  }

  function tileFromPointer(pointer) {
    const wp = cam.getWorldPoint(pointer.x, pointer.y);
    return { tx: Math.floor(wp.x / T), ty: Math.floor(wp.y / T) };
  }

  function aimGhost(tx, ty) {
    if (!placing) return;
    const f = foot(placing.key);
    // The tapped tile becomes the building's centre-ish anchor, clamped inside the map.
    placing.tx = Math.max(0, Math.min(MAP - f.w, tx - Math.floor((f.w - 1) / 2)));
    placing.ty = Math.max(0, Math.min(MAP - f.h, ty - Math.floor((f.h - 1) / 2)));
    refresh();
  }

  function create() {
    scene = this;
    cam = this.cameras.main;
    const terrain = this.add.graphics();
    drawTerrain(terrain);
    gridG = this.add.graphics();
    layer = this.add.graphics();
    ghostG = this.add.graphics();
    ghostG.setDepth(10);
    this.input.addPointer(1);

    let down = null;
    this.input.on('pointerdown', (p) => { down = { x: p.x, y: p.y, t: performance.now(), moved: false }; });
    this.input.on('pointermove', (p) => {
      if (!p.isDown || !down) return;
      const p1 = this.input.pointer1, p2 = this.input.pointer2;
      if (p1.isDown && p2.isDown) {
        // Pinch zoom
        const d = Phaser.Math.Distance.Between(p1.x, p1.y, p2.x, p2.y);
        if (down.pinch) setZoom(cam.zoom * (d / down.pinch));
        down.pinch = d;
        down.moved = true;
        return;
      }
      down.pinch = null;
      const dx = p.x - p.prevPosition.x, dy = p.y - p.prevPosition.y;
      if (!down.moved && Math.hypot(p.x - down.x, p.y - down.y) < 6) return;
      down.moved = true;
      camCX -= dx / cam.zoom;
      camCY -= dy / cam.zoom;
      clampCam();
    });
    this.input.on('pointerup', (p) => {
      if (!down) return;
      const wasTap = !down.moved && performance.now() - down.t < 600;
      down = null;
      if (!wasTap) return;
      const { tx, ty } = tileFromPointer(p);
      if (placing) { aimGhost(tx, ty); return; }
      const b = buildingAt(tx, ty);
      selectedId = b ? b.id : null;
      refresh();
      if (b) openManage(b.id);
    });
    this.input.on('wheel', (p, objs, dx, dy) => setZoom(cam.zoom * (dy > 0 ? 0.9 : 1.1)));
    this.scale.on('resize', () => clampCam());

    recenter();
    refresh();
  }

  new Phaser.Game({
    type: Phaser.AUTO,
    parent: 'game-stage',
    backgroundColor: '#1d3b22',
    pixelArt: true,
    antialias: false,
    roundPixels: true,
    scale: { mode: Phaser.Scale.RESIZE, width: '100%', height: '100%' },
    scene: { create },
  });

  // ---------- Placement flow ----------
  const placeOverlay = $('place-overlay');
  const placeList = $('place-list');

  function startPlacing(key, moveId) {
    placing = { key, moveId: moveId || null, tx: null, ty: null };
    $('place-bar').classList.add('open');
    $('place-confirm').disabled = true;
    $('place-bar-text').textContent = `Tap the map to aim your ${DEFS[key].label}`;
    $('place-bar-text').classList.remove('bad');
    refresh();
  }
  function stopPlacing() {
    placing = null;
    $('place-bar').classList.remove('open');
    refresh();
  }

  function openPlacePicker() {
    const avail = availableCounts();
    const owned = ownedCounts();
    placeList.innerHTML = '';
    if (!ORDER.some((k) => avail[k] > 0)) {
      const empty = document.createElement('div');
      empty.className = 'picker-empty';
      empty.textContent = "You don't have any unplaced buildings — open an Iantopia Lootbox Basic on the Lootbox page to win one.";
      placeList.appendChild(empty);
      placeOverlay.classList.add('open');
      return;
    }
    ORDER.forEach((key) => {
      if (avail[key] <= 0) return;
      const def = DEFS[key];
      const rarity = RARITY[def.tier] || {};
      const f = foot(key);
      const row = document.createElement('div');
      row.className = 'picker-row';
      row.innerHTML = `<div class="row-icon">${f.icon}</div><div class="row-info">${def.label} <small style="color:${rarity.color || ''}">${rarity.label || ''} · own ${owned[key]}/${MAX_PER_TYPE} · ${avail[key]} unplaced · ${f.w}x${f.h} tiles</small><small>Cost ${def.cost.toLocaleString()} Strubles · builds in ${fmtDuration(def.buildMinutes)} · +${def.production}/min when done</small>${def.description ? `<small class="row-desc">${def.description}</small>` : ''}</div>`;
      row.addEventListener('click', () => {
        if (village.b.length >= slotCap()) {
          alert(`Your village is full (${slotCap()} buildings). Buy more slots, or remove a building first.`);
          return;
        }
        if (buildingCount() >= MAX_CONCURRENT) {
          alert(`Only ${MAX_CONCURRENT} buildings can be under construction at once — wait for one to finish first.`);
          return;
        }
        placeOverlay.classList.remove('open');
        startPlacing(key, null);
      });
      placeList.appendChild(row);
    });
    placeOverlay.classList.add('open');
  }

  function confirmPlacing() {
    if (!placing || placing.tx == null) return;
    const { key, moveId, tx, ty } = placing;
    if (!canPlace(key, tx, ty, moveId)) return;
    if (moveId != null) {
      const b = village.b.find((s) => s.id === moveId);
      if (b) { b.x = tx; b.y = ty; }
    } else {
      const def = DEFS[key];
      if (!Strubles.spend(def.cost)) {
        alert(`Not enough Strubles for the permit (need ${def.cost.toLocaleString()}).`);
        return;
      }
      const now = Date.now();
      village.b.push({
        id: village.nextId++, key, x: tx, y: ty,
        status: 'building', startedAt: now,
        completesAt: now + def.buildMinutes * 60000,
        lastProductionAt: now,
      });
    }
    saveVillage();
    stopPlacing();
  }

  $('build-btn').addEventListener('click', openPlacePicker);
  $('place-confirm').addEventListener('click', confirmPlacing);
  $('place-cancel').addEventListener('click', stopPlacing);
  $('recenter-btn').addEventListener('click', () => { if (cam) recenter(); });
  window.addEventListener('keydown', (e) => {
    if (!placing) return;
    if (e.key === 'Enter') { e.preventDefault(); confirmPlacing(); }
    else if (e.key === 'Escape') { e.preventDefault(); stopPlacing(); }
    else if (placing.tx != null && e.key.startsWith('Arrow')) {
      e.preventDefault();
      const dx = e.key === 'ArrowLeft' ? -1 : e.key === 'ArrowRight' ? 1 : 0;
      const dy = e.key === 'ArrowUp' ? -1 : e.key === 'ArrowDown' ? 1 : 0;
      const f = foot(placing.key);
      placing.tx = Math.max(0, Math.min(MAP - f.w, placing.tx + dx));
      placing.ty = Math.max(0, Math.min(MAP - f.h, placing.ty + dy));
      refresh();
    }
  });
  function wireClose(overlayId, closeId) {
    document.querySelectorAll(`#${overlayId}, #${closeId}`).forEach((el) => {
      el.addEventListener('click', (e) => {
        if (e.target.id === overlayId || e.target.id === closeId) $(overlayId).classList.remove('open');
      });
    });
  }
  wireClose('place-overlay', 'place-close');

  // ---------- Manage a placed building ----------
  const manageOverlay = $('manage-overlay');
  let manageId = null;

  function openManage(id) {
    const s = village.b.find((x) => x.id === id);
    if (!s) return;
    manageId = id;
    const def = DEFS[s.key];
    const rarity = RARITY[def.tier] || {};
    const f = foot(s.key);
    const dailyUpkeep = def.cost * (def.upkeepPct || 0);
    $('manage-title').textContent = def.label;
    const statusLine = s.status === 'building'
      ? 'Under construction — removing forfeits progress, no refund.'
      : `Producing +${def.production}/min.`;
    let upkeepLine = '';
    if (s.status === 'complete') {
      upkeepLine = s.taxDebt > 0
        ? `<small style="color:#ff6b6b;">⚠ Neglected — owes ${Math.floor(s.taxDebt)} Strubles (half production until paid). Upkeep ${Math.floor(dailyUpkeep)}/day.</small>`
        : `<small>Upkeep ${Math.floor(dailyUpkeep)}/day, auto-paid from balance.</small>`;
    }
    $('manage-info').innerHTML = `<div class="guide-row"><div class="row-icon">${f.icon}</div><div class="row-info">${def.label} <small style="color:${rarity.color || ''}">${rarity.label || ''}</small><small>${statusLine}</small>${upkeepLine}${def.description ? `<small class="row-desc">${def.description}</small>` : ''}</div></div>`;
    manageOverlay.classList.add('open');
  }
  function closeManage() {
    manageOverlay.classList.remove('open');
    selectedId = null;
    refresh();
  }
  $('manage-move').addEventListener('click', () => {
    const s = village.b.find((x) => x.id === manageId);
    manageOverlay.classList.remove('open');
    if (!s) return;
    selectedId = null;
    startPlacing(s.key, s.id);
    placing.tx = s.x; placing.ty = s.y;
    refresh();
  });
  $('manage-remove').addEventListener('click', () => {
    village.b = village.b.filter((x) => x.id !== manageId);
    saveVillage();
    closeManage();
  });
  document.querySelectorAll('#manage-overlay, #manage-close').forEach((el) => {
    el.addEventListener('click', (e) => {
      if (e.target.id === 'manage-overlay' || e.target.id === 'manage-close') closeManage();
    });
  });

  // ---------- Building Guide ----------
  $('guide-btn').addEventListener('click', () => {
    const owned = ownedCounts();
    const list = $('guide-list');
    list.innerHTML = '';
    ORDER.forEach((key) => {
      const def = DEFS[key];
      const rarity = RARITY[def.tier] || {};
      const f = foot(key);
      const dailyUpkeep = def.cost * (def.upkeepPct || 0);
      const row = document.createElement('div');
      row.className = 'guide-row';
      row.innerHTML = `<div class="row-icon">${f.icon}</div><div class="row-info">${def.label} <small style="color:${rarity.color || ''}">${rarity.label || ''} · own ${owned[key]}/${MAX_PER_TYPE} · ${f.w}x${f.h} tiles</small><small>Cost ${def.cost.toLocaleString()} Strubles · builds in ${fmtDuration(def.buildMinutes)} · +${def.production}/min when done · Upkeep ${Math.floor(dailyUpkeep)}/day</small>${def.description ? `<small class="row-desc">${def.description}</small>` : ''}</div>`;
      list.appendChild(row);
    });
    $('guide-overlay').classList.add('open');
  });
  wireClose('guide-overlay', 'guide-close');

  // ---------- Bank (unchanged behaviour: raises the wallet cap) ----------
  function renderBank() {
    const TB = window.TycoonBank;
    const level = TB.currentLevel();
    const bankCap = TB.capForLevel(level);
    const taipei = TB.taipeiBonus();
    $('bank-cap-breakdown').innerHTML = `
      <div class="bank-cap-row"><span>Bank (level ${level})</span><span>${bankCap.toLocaleString()} Strubles</span></div>
      <div class="bank-cap-row"><span>Taipei 101 bonus</span><span>+${taipei.toLocaleString()} Strubles</span></div>
      <div class="bank-cap-row"><span><b>Total cap</b></span><span><b>${(bankCap + taipei).toLocaleString()} Strubles</b></span></div>`;
    $('bank-next-info').textContent = `Next: Level ${level + 1} — costs ${TB.costForLevel(level + 1).toLocaleString()}, raises the cap by ${TB.capGainForLevel(level + 1).toLocaleString()}.`;
  }
  $('bank-btn').addEventListener('click', () => { renderBank(); $('bank-overlay').classList.add('open'); });
  $('bank-buy').addEventListener('click', () => {
    const TB = window.TycoonBank;
    const level = TB.currentLevel();
    const cost = TB.costForLevel(level + 1);
    if (!Strubles.spend(cost)) {
      alert(`Not enough Strubles for the next level (need ${cost.toLocaleString()}).`);
      return;
    }
    localStorage.setItem(TB.BANK_LEVEL_KEY, String(level + 1));
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
    renderBank();
    syncBalance();
  });
  wireClose('bank-overlay', 'bank-close');

  // ---------- Building slots ----------
  function renderExpand() {
    const owned = slotsOwned();
    $('expand-info-breakdown').innerHTML = `
      <div class="bank-cap-row"><span>Building slots</span><span>${BASE_SLOTS + owned}</span></div>
      <div class="bank-cap-row"><span>Slots purchased</span><span>${owned}</span></div>`;
    $('expand-next-info').textContent = `Next: slot ${BASE_SLOTS + owned + 1} — costs ${expandCostForSlot(owned + 1).toLocaleString()} Strubles.`;
  }
  $('expand-btn').addEventListener('click', () => { renderExpand(); $('expand-overlay').classList.add('open'); });
  $('expand-buy').addEventListener('click', () => {
    const owned = slotsOwned();
    const cost = expandCostForSlot(owned + 1);
    if (!Strubles.spend(cost)) {
      alert(`Not enough Strubles for the next slot (need ${cost.toLocaleString()}).`);
      return;
    }
    localStorage.setItem(SLOTS_KEY, String(owned + 1));
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
    renderExpand();
    refresh();
    syncBalance();
  });
  wireClose('expand-overlay', 'expand-close');

  window.addEventListener('inventory:changed', () => refresh());
  window.addEventListener('strubles:change', syncBalance);
  window.addEventListener('storage', (e) => {
    if (e.key === VILLAGE_KEY) { village = loadVillage(); refresh(); }
    if (e.key === INV_KEY) refresh();
  });
  // Cloud pull reloads the page itself, so no extra reconcile hook is needed.

  // ---------- Sound (same pattern as every other page) ----------
  let audioEnabled = true;
  const themeMusic = $('theme-music');
  const VOLUME_KEY = 'music_volume_v1';
  const volumeSlider = $('volume-slider');
  const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
  themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.3;
  volumeSlider.value = Math.round(themeMusic.volume * 100);
  volumeSlider.addEventListener('input', () => {
    themeMusic.volume = volumeSlider.value / 100;
    localStorage.setItem(VOLUME_KEY, themeMusic.volume);
  });
  function tryPlayTheme() { if (audioEnabled) themeMusic.play().catch(() => {}); }
  tryPlayTheme();
  const unlockTheme = () => {
    tryPlayTheme();
    window.removeEventListener('pointerdown', unlockTheme);
    window.removeEventListener('keydown', unlockTheme);
  };
  window.addEventListener('pointerdown', unlockTheme);
  window.addEventListener('keydown', unlockTheme);
  $('mute-btn').addEventListener('click', () => {
    audioEnabled = !audioEnabled;
    $('mute-btn').textContent = audioEnabled ? '🔊' : '🔇';
    if (audioEnabled) tryPlayTheme(); else themeMusic.pause();
  });

  // ---------- Reconcile loop ----------
  if (tick()) saveVillage();
  setInterval(() => {
    if (tick()) saveVillage();
    refresh();
  }, 1000);

  // ---------- Leaderboard score push (unchanged) ----------
  let lastPushedNetProduction = null;
  let leaderboardPushInFlight = false;
  function maybePushLeaderboardScore(netProduction) {
    if (!window.CloudSync || !CloudSync.isSignedIn()) return;
    if (netProduction === lastPushedNetProduction || leaderboardPushInFlight) return;
    const user = CloudSync.currentUser;
    if (!user) return;
    leaderboardPushInFlight = true;
    firebase.firestore().collection('leaderboard').doc(user.uid).set({
      displayName: user.displayName || 'Anonymous Tycoon',
      netProduction: Math.round(netProduction * 1000) / 1000,
      updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
    }, { merge: true })
      .then(() => { lastPushedNetProduction = netProduction; })
      .catch((err) => console.error('[leaderboard] push failed:', err))
      .finally(() => { leaderboardPushInFlight = false; });
  }

  // Read-only introspection for QA (same idea as window.HorseGame).
  window.TycoonGame = {
    getState: () => ({ village, slotCap: slotCap(), placing, zoom: cam && cam.zoom }),
  };

  if (window.initPickers) setTimeout(window.initPickers, 100);
})();
</script>
</body>
</html>
