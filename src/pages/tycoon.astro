<!DOCTYPE html>
<html lang="en">
<head>
<link rel="stylesheet" href="/lowfx.css?v=2">
<script is:inline src="/lowfx.js?v=2"></script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
<title>My Iantopia</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0a0c12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script is:inline src="/pwa.js?v=1" defer></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<!--
  is:global is REQUIRED here for the same reason as every other page: the
  overlay rows and the stage contents are built at runtime, so Astro's
  scoped data-astro-cid-* selectors would silently skip them.

  Rewritten (was a side-view PNG skyline in a one-row DOM grid) as a
  top-down pixel village on a Phaser 4 tile map. Every sprite is drawn
  procedurally with Graphics -- no image assets -- so the old /tycoon/*.png
  art is no longer used by this page.
-->
<style is:global>
  :root { --bg:#0f1115; --panel:#161c27; --ink:#e9eef9; --muted:#9fb0cf; --gold:#ffd700; }
  * { box-sizing:border-box; }
  html, body { margin:0; height:100%; }
  body {
    height:100dvh;
    display:flex; flex-direction:column;
    /* Resting default; pickers.js overwrites background-image when a
       background is chosen from the picker (saved per page). */
    background:#10261a url('/tycoon/sky-background.gif') center / cover no-repeat fixed;
    color:var(--ink);
    font-family: 'Press Start 2P', ui-monospace, 'Courier New', monospace;
    cursor:none; position:relative;
    overflow-x:hidden; overflow-y:auto;
    -webkit-user-select:none; user-select:none; -webkit-touch-callout:none;
    -webkit-tap-highlight-color:transparent;
  }

  /* Keeps the chrome readable over whatever background is picked, same as
     the dimming layer on the other pages. */
  body::before { content:''; position:fixed; inset:0; z-index:-1; background:rgba(0,0,0,.32); pointer-events:none; }
  /* pickers.js only toggles .show on this element; without a rule to match,
     a video-type background gets the class and never appears. */
  #bg-video { display:none; position:fixed; inset:0; width:100%; height:100%; object-fit:cover; z-index:-2; }
  #bg-video.show { display:block; }

  #strubles-badge{
    position:fixed; top:calc(15px + env(safe-area-inset-top)); left:calc(20px + env(safe-area-inset-left)); display:flex; align-items:center; gap:8px;
    background:#000; padding:8px 12px; border:3px solid var(--gold);
    font-weight:700; z-index:20;
  }
  #strubles-badge img{ width:28px; height:28px; }

  main {
    position:relative; z-index:2; max-width:1200px; width:100%; margin:0 auto;
    padding:16px 24px 16px; padding-top:calc(80px + env(safe-area-inset-top));
    flex:1 1 auto; min-height:0;
    display:flex; flex-direction:column;
  }

  header { flex:0 0 auto; display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; border-bottom:4px solid #000; padding-bottom:10px; flex-wrap:wrap; gap:10px; }
  header a { color:var(--gold); text-decoration:none; border:3px solid #000; padding:8px 12px; font-weight:700; background:#000; transition:background 0.2s; font-size:10px; cursor:none; }
  header a:hover { background:var(--gold); color:#000; }
  header button { color:var(--gold); background:#000; border:2px solid var(--gold); padding:4px 6px; cursor:none; transition:background 0.2s; }
  header button:hover { background:var(--gold); color:#000; }

  h1 {
    margin:0; font-size:clamp(13px,2.6vw,20px); letter-spacing:1px; color:var(--gold); font-weight:400;
    text-shadow: 2px 2px 0 #000; text-align:center; width:100%;
  }

  #stats-bar {
    flex:0 0 auto;
    display:flex; justify-content:center; gap:18px; flex-wrap:wrap;
    background:rgba(0,0,0,.55); border:2px solid var(--gold); padding:8px 14px;
    margin-bottom:12px; font-size:9px; color:#fff;
  }
  #stats-bar b { color:var(--gold); }

  #cta-row {
    flex:0 0 auto;
    display:flex; justify-content:center; align-items:center; gap:10px; flex-wrap:wrap;
    margin-bottom:12px;
  }
  .cta {
    color:var(--gold); background:#000; border:3px solid var(--gold);
    padding:10px 14px; font-size:11px; font-weight:700; cursor:none;
    font-family:inherit; text-decoration:none; transition:background .2s, color .2s;
    touch-action:manipulation;
  }
  .cta:hover { background:var(--gold); color:#000; }
  .cta:disabled, .bar-btn:disabled { opacity:.4; pointer-events:none; }
  #toast { position:absolute; left:50%; bottom:14px; transform:translateX(-50%); z-index:6; display:none; max-width:92%; background:#000; color:var(--gold); border:2px solid var(--gold); padding:8px 12px; font-size:9px; line-height:1.6; text-align:center; pointer-events:none; }
  #toast.bad { color:#ff6b6b; border-color:#ff6b6b; }
  .cta.primary { background:var(--gold); color:#000; border-color:#000; }
  .cta.primary:hover { background:#ffe766; }

  .bank-cap-row { display:flex; justify-content:space-between; gap:10px; padding:8px 0; border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:10px; }
  .bank-cap-row:last-child { border-bottom:none; }
  .bank-cap-row span:last-child { color:var(--muted); }
  .bank-buy-row { margin-top:16px; display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
  .bank-buy-row p { margin:0; font-size:10px; color:var(--ink); line-height:1.7; }

  /* Bank teller window. Checkered marble floor, a wood counter with a brass
     rail, a pixel teller behind it and two service windows on the counter. */
  .modal.bank-modal { width:min(680px,94vw); max-height:88vh; padding:0; background:#120a05; box-shadow:0 0 0 2px #000, 0 0 26px rgba(255,215,0,.35); }
  .bank-sign {
    display:flex; justify-content:space-between; align-items:center; gap:10px;
    padding:12px 14px; border-bottom:4px solid #000;
    background:repeating-linear-gradient(90deg,#1f6b3a 0 14px,#185630 14px 28px);
  }
  .bank-sign h2 { margin:0; font-size:13px; font-weight:400; color:var(--gold); text-shadow:2px 2px 0 #000; letter-spacing:1px; }
  .bank-hall {
    --fig-cs:8px; /* one pixel of the teller art on screen */
    position:relative; padding:18px 16px 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0) 60%, rgba(0,0,0,.35)),
      conic-gradient(#2c1d12 25%, #3a2615 0 50%, #2c1d12 0 75%, #3a2615 0) 0 0 / 28px 28px;
    border-bottom:2px solid #000;
  }
  .bank-teller { display:flex; align-items:flex-end; gap:14px; }
  /* The teller is two canvases: the head breathes (one art pixel down and
     back, in steps so it stays crisp), the body stays put. The figure's
     bottom edge is the counter's top edge, so he stands on the counter. */
  .bank-figure {
    --px:8px; /* one art pixel on screen */
    position:relative; flex:none; width:96px;
    filter:drop-shadow(3px 3px 0 #000);
  }
  .bank-figure canvas { display:block; width:96px; image-rendering:pixelated; image-rendering:crisp-edges; }
  #bank-teller-head { height:56px; position:relative; z-index:1; animation:bank-breathe 3.2s steps(1,end) infinite; }
  #bank-teller-body { height:48px; }
  @keyframes bank-breathe {
    0%, 49% { transform:translateY(0); }
    50%, 100% { transform:translateY(var(--px)); }
  }
  @media (prefers-reduced-motion: reduce) { #bank-teller-head { animation:none; } }
  .bank-bubble {
    position:relative; flex:1; margin:0 0 50px; padding:10px 12px; /* clears the arm and bill on the counter */
    background:#fff8e1; color:#1a0f08; border:3px solid #000; box-shadow:3px 3px 0 #000;
    font-size:9px; line-height:1.8;
  }
  .bank-bubble::before {
    content:''; position:absolute; left:-12px; bottom:14px; width:0; height:0;
    border-top:7px solid transparent; border-bottom:7px solid transparent; border-right:9px solid #000;
  }
  .bank-bubble::after {
    content:''; position:absolute; left:-6px; bottom:15px; width:0; height:0;
    border-top:5px solid transparent; border-bottom:5px solid transparent; border-right:7px solid #fff8e1;
  }
  .bank-counter {
    position:relative; height:44px; margin:0 -16px;
    border-top:6px solid #d9a243; border-bottom:4px solid #000;
    background:
      linear-gradient(90deg, rgba(0,0,0,.18) 1px, transparent 1px) 0 0 / 46px 100%,
      repeating-linear-gradient(176deg, rgba(255,220,160,.07) 0 2px, transparent 2px 7px),
      repeating-linear-gradient(90deg, #8b5530 0 46px, #74442a 46px 48px);
    box-shadow:inset 0 -6px 0 rgba(0,0,0,.35);
  }
  /* The arm is drawn flush against his right shoulder, on the same pixel grid
     as the figure, so it stays attached. Only the bill moves: it slides in
     under the hand once in a while, as if being counted. */
  .bank-arm, .bank-bill {
    position:absolute; bottom:44px; /* the counter's height: sits on the counter top */
    width:calc(var(--fig-cs) * 6); height:calc(var(--fig-cs) * 5);
    image-rendering:pixelated; image-rendering:crisp-edges; pointer-events:none;
  }
  .bank-arm { left:calc(16px + var(--fig-cs) * 11); z-index:2; }
  .bank-bill {
    left:calc(16px + var(--fig-cs) * 15); width:calc(var(--fig-cs) * 10); opacity:0;
    animation:bank-count 14s steps(1,end) infinite;
  }
  @keyframes bank-count {
    0%, 79% { opacity:0; transform:translateX(0); }
    80% { opacity:1; transform:translateX(calc(var(--fig-cs) * 3)); }
    81% { transform:translateX(calc(var(--fig-cs) * 2)); }
    82% { transform:translateX(var(--fig-cs)); }
    83%, 84% { transform:translateX(0); }
    85%, 100% { opacity:0; transform:translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) { .bank-bill { animation:none; opacity:0; } }
  .bank-counter::before {
    content:''; position:absolute; left:0; right:0; top:0; height:4px;
    background:linear-gradient(#ffe9a8,#c58a2b); border-bottom:2px solid #000;
  }
  .bank-balance {
    display:flex; justify-content:space-between; align-items:center; gap:10px;
    margin:0; padding:10px 14px; background:#000; border-bottom:2px solid #ffd700;
    font-size:10px; color:var(--muted);
  }
  .bank-balance b { color:var(--gold); font-weight:400; font-size:12px; }
  .bank-windows {
    display:grid; grid-template-columns:1fr 1fr; gap:12px; padding:14px;
    background:#1b110a; max-height:none;
  }
  .bank-window {
    margin:0; padding:12px; background:#0a0a0a; border:3px solid #ffd700;
    box-shadow:inset 0 0 0 2px #000, 3px 3px 0 #000; min-width:0;
    /* Both windows stretch to the same height, and their button rows sit on the
       bottom edge, so Upgrade and Buy slot line up whatever the text above says. */
    display:flex; flex-direction:column;
  }
  .bank-window h3 { margin:0 0 8px; font-size:11px; font-weight:400; color:var(--gold); }
  .bank-note { margin:0 0 10px; font-size:9px; line-height:1.7; color:var(--muted); }
  .bank-window .bank-cap-row { font-size:9px; gap:6px; }
  .bank-window .bank-buy-row { flex-direction:column; align-items:stretch; margin-top:auto; padding-top:12px; }
  .bank-window .bank-buy-row p { font-size:9px; min-height:46px; }
  /* Room for three lines of explanation and three rows of figures in every window,
     so a short description doesn't leave a gap the other window doesn't have. */
  .bank-window .bank-note { min-height:46px; }
  #bank-cap-breakdown, #expand-info-breakdown { min-height:84px; }
  .bank-action { width:100%; text-align:center; }
  .visit-modal { width:min(480px,94vw); max-height:88vh; overflow-y:auto; }
  .visit-optin { display:flex; align-items:center; gap:10px; font-size:10px; color:var(--ink); line-height:1.7; margin:4px 0 10px; cursor:pointer; }
  .visit-optin input { width:16px; height:16px; accent-color:var(--gold); }
  .stats-modal { width:min(560px,94vw); max-height:88vh; overflow-y:auto; }
  .stats-tabs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }
  .stats-pane[hidden] { display:none; }
  .stats-heading { margin:14px 0 4px; font-size:9px; color:var(--gold); letter-spacing:1px; text-transform:uppercase; }
  .bank-gifts { grid-column:1 / -1; }
  .gift-row { display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid rgba(255,215,0,0.2); font-size:9px; line-height:1.7; color:var(--ink); }
  .gift-row:last-child { border-bottom:none; }
  .gift-row .gift-body { flex:1; min-width:0; }
  .gift-row small { display:block; color:var(--muted); }
  .gift-stickers { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }
  .gift-sticker { width:52px; height:52px; font-size:24px; background:#000; border:2px solid var(--gold); cursor:pointer; }
  .gift-sticker.active { background:var(--gold); }
  .gift-field { display:flex; flex-direction:column; gap:6px; font-size:9px; color:var(--gold); margin-bottom:12px; }
  .gift-field textarea, .gift-field input { font-family:inherit; font-size:10px; background:#000; color:var(--ink); border:2px solid var(--gold); padding:8px; }
  .gift-actions { display:flex; justify-content:flex-end; }
  #visit-bar {
    position:absolute; left:50%; top:12px; transform:translateX(-50%);
    display:none; align-items:center; gap:10px; flex-wrap:wrap; justify-content:center;
    background:rgba(0,0,0,.85); border:3px solid var(--gold); padding:10px 12px; z-index:5; max-width:calc(100% - 16px);
  }
  #visit-bar.open { display:flex; }
  #visit-bar-text { font-size:9px; color:var(--gold); line-height:1.6; }
  .bank-gate { margin:10px 0 0; font-size:8px; line-height:1.8; color:#ffb36b; }
  @media (max-width:520px) { .bank-windows { grid-template-columns:1fr; } .bank-teller { gap:10px; } .bank-figure { width:72px; --px:6px; } .bank-figure canvas { width:72px; } #bank-teller-head { height:42px; } #bank-teller-body { height:36px; } .bank-hall { --fig-cs:6px; } }

  /* ---------- The village stage (Phaser canvas lives in here) ---------- */
  #game-stage {
    position:relative; flex:1 1 auto; min-height:300px;
    border:3px solid #000; outline:2px solid var(--gold); outline-offset:-2px;
    background:rgba(4,12,8,.34); overflow:hidden; touch-action:none;
  }
  #game-stage canvas { display:block; touch-action:none; }

  /* Appears while placing or moving a building: tap a tile to aim the
     ghost, then confirm. Same two-step flow on mouse and touch so a
     fat-finger tap can never drop a building somewhere unintended. */
  #place-bar {
    position:absolute; left:50%; bottom:12px; transform:translateX(-50%);
    display:none; align-items:center; gap:10px; flex-wrap:wrap; justify-content:center;
    background:rgba(0,0,0,.85); border:3px solid var(--gold); padding:10px 12px;
    z-index:5; max-width:calc(100% - 16px);
  }
  #place-bar.open { display:flex; }
  #place-bar-text { font-size:9px; color:var(--gold); line-height:1.6; }
  #place-bar-text.bad { color:#ff6b6b; }
  /* Same bar, pinned to the top of the stage so a brush stroke along the
     bottom edge of the map never lands on it. */
  #brush-bar {
    position:absolute; left:50%; top:12px; transform:translateX(-50%);
    display:none; align-items:center; gap:10px; flex-wrap:wrap; justify-content:center;
    background:rgba(0,0,0,.85); border:3px solid var(--gold); padding:10px 12px;
    z-index:5; max-width:calc(100% - 16px);
  }
  #brush-bar.open { display:flex; }
  #brush-bar-text { font-size:9px; color:var(--gold); line-height:1.6; }
  #brush-bar-text.bad { color:#ff6b6b; }
  /* One-tap brush palette. The active brush is filled gold, so it reads at a glance. */
  #brush-palette { display:flex; gap:6px; flex-wrap:wrap; justify-content:center; width:100%; }
  .brush-chip {
    display:inline-flex; align-items:center; gap:6px; background:#000; color:var(--gold);
    border:2px solid var(--gold); padding:6px 8px; font-size:9px; font-family:inherit; font-weight:700;
    cursor:none; touch-action:manipulation; line-height:1;
  }
  .brush-chip i { display:inline-block; width:12px; height:12px; border:1px solid #ffe9a8; }
  .brush-chip:hover { background:rgba(255,215,0,.2); }
  .brush-chip.active { background:var(--gold); color:#000; }
  .brush-chip.active i { border-color:#000; }
  .bar-btn {
    background:#000; color:var(--gold); border:3px solid var(--gold); padding:12px 14px;
    font-size:11px; font-weight:700; cursor:none; font-family:inherit; touch-action:manipulation;
  }
  .bar-btn:hover { background:var(--gold); color:#000; }
  .bar-btn.ok { border-color:#00ff6a; color:#00ff6a; }
  .bar-btn.ok:hover { background:#00ff6a; color:#000; }
  .bar-btn.ok:disabled { opacity:.35; pointer-events:none; }
  .bar-btn.no { border-color:#ff5555; color:#ff5555; }
  .bar-btn.no:hover { background:#ff5555; color:#000; }

  /* ---------- Overlays / modals (same system as every other page) ---------- */
  .overlay{
    position:fixed; inset:0; background:rgba(0,0,0,.85); z-index:100;
    display:none; align-items:center; justify-content:center; padding:20px;
  }
  .overlay.open{ display:flex; }
  .modal{
    width:min(420px,90vw); max-height:75vh; overflow-y:auto;
    background:#0a0a0a; border:3px solid var(--gold); padding:20px;
    box-shadow:0 0 20px rgba(255,215,0,.4);
  }
  .modal-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; gap:10px; }
  .modal-head h2{ margin:0; font-size:12px; color:var(--gold); font-weight:400; }
  .btn{
    color:var(--gold); text-decoration:none; border:3px solid var(--gold); padding:8px 12px;
    background:#000; font-size:9px; transition:background .2s, color .2s; cursor:none;
    font-family:inherit; letter-spacing:1px; text-transform:uppercase; touch-action:manipulation;
  }
  .btn:hover{ background:var(--gold); color:#000; }
  .picker-row { display:flex; align-items:center; padding:8px 0; border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:10px; gap:10px; cursor:pointer; }
  .picker-row:last-child { border-bottom:none; }
  .picker-row:hover { background:rgba(255,215,0,.08); }
  .row-icon { font-size:26px; width:40px; text-align:center; flex-shrink:0; }
  /* Same colour the zone is painted on the map, so the panel explains it. */
  .zone-swatch { width:40px; height:24px; flex-shrink:0; border:2px solid #ffe9a8; box-shadow:inset 0 0 0 2px rgba(0,0,0,.35); }
  .picker-row .row-info, .guide-row .row-info { flex:1; line-height:1.6; }
  .row-info small { color:var(--muted); display:block; font-size:8px; line-height:1.8; }
  .row-info small.row-desc { font-style:italic; margin-top:3px; }
  .picker-empty { color:var(--muted); font-size:10px; padding:10px 0; line-height:1.8; text-align:center; }
  .picker-group { font-size:9px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; margin:14px 0 4px; }
  .picker-group:first-child { margin-top:0; }
  .picker-row.disabled { opacity:.4; cursor:default; }
  .picker-row.disabled:hover { background:none; }
  /* Row thumbnails: the optimised building PNGs, or the building's own pixel
     art (hence image-rendering) where there is no PNG. */
  .row-img { width:44px; height:44px; object-fit:contain; flex-shrink:0; }
  .row-img.pix { image-rendering:pixelated; }
  /* Press Start 2P is drawn on an 8px grid, so 8px is the smallest size that stays crisp. */
  .zone-chip { display:inline-block; padding:0 5px; border:1px solid currentColor; border-radius:2px; text-transform:uppercase; font-size:8px; letter-spacing:.5px; }
  .zone-residential { color:#7db6ff; } .zone-commercial { color:#ffb457; } .zone-industrial { color:#c99bf0; }

  .guide-row {
    display:flex; align-items:center; gap:10px; padding:10px 0;
    border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:10px;
  }
  .guide-row:last-child { border-bottom:none; }

  .volume-row{
    display:flex; align-items:center; gap:10px; margin-bottom:16px;
    padding-bottom:14px; border-bottom:1px solid rgba(255,215,0,0.3);
  }
  .volume-row input[type="range"]{ flex:1; accent-color:var(--gold); cursor:none; touch-action:none; padding:14px 0; }
  .volume-mute-btn{
    all:unset; cursor:none; font-size:16px; padding:4px 8px;
    border:1px solid var(--gold); background:#000;
  }

  @media (max-width:768px) {
    main { padding-left:12px; padding-right:12px; }
    /* On a phone the map sat below the fold: a three-line stats bar and three
       rows of wrapped buttons used the whole first screen. One swipeable row
       of buttons and a compact stats bar give the map the space back. */
    #stats-bar { font-size:8px; gap:6px 12px; padding:6px 8px; margin-bottom:8px; line-height:1.6; }
    #cta-row { flex-wrap:nowrap; justify-content:flex-start; overflow-x:auto; gap:8px; margin-bottom:8px; padding-bottom:4px; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
    #cta-row::-webkit-scrollbar { display:none; }
    .cta { font-size:9px; padding:9px 10px; white-space:nowrap; flex:0 0 auto; border-width:2px; }
    header { margin-bottom:6px; padding-bottom:6px; }
    main { padding-top:calc(64px + env(safe-area-inset-top)); }
  }
</style>
</head>
<body>
  <video id="bg-video" autoplay muted loop playsinline></video>
  <div id="strubles-badge">
    <img src="/strubles.png" alt="Struble">
