  wireClose('guide-overlay', 'guide-close');

  // ---------- Bank (raises the wallet cap; sells land slots) ----------
  // The teller is a 12x13 pixel grid in the villagers' palette, so the bank
  // reads as part of the village. Drawn once per open; the art never changes.
  const TELLER_ART = [
    '...HHHHHH...',
    '..HHHHHHHH..',
    '..HSSSSSSH..',
    '..SSESSESS..',
    '..SSSSSSSS..',
    '...SSRRSS...',
    '....SSSS....',
    '...WWTTWW...',
    '..VVVTTVVV..',
    '.VVVVTTVVVV.',
    '.VVVGTTGVVV.',
    '.VVVVVVVVVV.',
    '.VVVVVVVVVV.',
  ];
  const TELLER_PAL = { H: '#3b2a1a', S: '#d9a877', E: '#1a1a1a', R: '#8a4b3a', W: '#f4f4f4', V: '#2a4f8a', T: '#b3262e', G: '#ffd700' };
  // Right arm (sleeve, forearm, hand) and the bill it counts. The arm's sleeve
  // meets the body's right edge, so the two read as one figure.
  const ARM_ART = [
    '......',
    '......',
    '..SSSS',
    'VVSSSS',
    'VV....',
  ];
  const BILL_ART = [
    'KKKKKKKKKK',
    'KBBBBBBBBK',
    'KBGGGGGGBK',
    'KBBBBBBBBK',
    'KKKKKKKKKK',
  ];
  const PROP_PAL = { K: '#0f2a18', B: '#6fbf73', G: '#2f7a3e', S: '#d9a877', V: '#2a4f8a' };
  // Rows 0-6 are the head, 7-12 the body. Each canvas is drawn from its own rows.
  function drawRows(canvas, rows, pal = TELLER_PAL) {
    const g = canvas.getContext('2d');
    g.clearRect(0, 0, canvas.width, canvas.height);
    rows.forEach((row, y) => [...row].forEach((ch, x) => {
      if (!pal[ch]) return;
      g.fillStyle = pal[ch];
      g.fillRect(x, y, 1, 1);
    }));
  }
  // The eyes sit on head row 3 at columns 4 and 7. `look` shifts both by -1..1
  // so he glances left or right; the rest of the head is unchanged.
  function drawHead(look) {
    const rows = TELLER_ART.slice(0, 7).map((r) => r.replace(/E/g, 'S'));
    const row = [...rows[3]];
    row[4 + look] = 'E';
    row[7 + look] = 'E';
    rows[3] = row.join('');
    drawRows($('bank-teller-head'), rows);
  }
  // A slow glance: left, back, right, back. Runs only while the bank is open.
  const GLANCE = [0, -1, -1, 0, 0, 1, 1, 0];
  const GLANCE_MS = 1100;
  let glanceStep = 0, glanceTimer = null;
  function startGlance() {
    if (glanceTimer || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    glanceTimer = setInterval(() => {
      if (!$('bank-overlay').classList.contains('open')) { clearInterval(glanceTimer); glanceTimer = null; return; }
      drawHead(GLANCE[glanceStep++ % GLANCE.length]);
    }, GLANCE_MS);
  }
  function drawTeller() {
    drawHead(0);
    drawRows($('bank-teller-body'), TELLER_ART.slice(7));
    drawRows($('bank-arm'), ARM_ART, PROP_PAL);
    drawRows($('bank-bill'), BILL_ART, PROP_PAL);
  }
  function bankSay(line) { $('bank-say').textContent = line; }

  function renderBank() {
    const TB = window.TycoonBank;
    const level = TB.currentLevel();
    const bankCap = TB.capForLevel(level);
    const taipei = TB.taipeiBonus();
    $('bank-cap-breakdown').innerHTML = `
      <div class="bank-cap-row"><span>Bank (level ${level})</span><span>${bankCap.toLocaleString()}</span></div>
      <div class="bank-cap-row"><span>Taipei 101 bonus</span><span>+${taipei.toLocaleString()}</span></div>
      <div class="bank-cap-row"><span><b>Total cap</b></span><span><b>${(bankCap + taipei).toLocaleString()}</b></span></div>`;
    $('bank-next-info').textContent = `Level ${level + 1}: ${TB.costForLevel(level + 1).toLocaleString()} for +${TB.capGainForLevel(level + 1).toLocaleString()} cap.`;
    // Raising the wallet cap needs a Bank building standing. Slots (below) stay
    // available regardless, otherwise a full village with no bank could never
    // free up the space to build one.
    const has = hasBank();
    $('bank-buy').disabled = !has;
    $('bank-buy').style.opacity = has ? '' : '0.4';
    $('bank-gate').style.display = has ? 'none' : 'block';
    try { $('bank-bal').textContent = Strubles.get().toLocaleString(); } catch {}
  }
  function openBank() {
    drawTeller();
    startGlance();
    bankSay('Welcome to the Iantopia Bank! Need more room in your wallet, or land for another building?');
    renderBank();
    renderExpand();
    $('bank-overlay').classList.add('open');
  }
  $('bank-btn').addEventListener('click', openBank);
  $('bank-buy').addEventListener('click', () => {
    if (visitLocked()) return;
    if (!hasBank()) return;
    const TB = window.TycoonBank;
    const level = TB.currentLevel();
    const cost = TB.costForLevel(level + 1);
    if (!Strubles.spend(cost)) {
      bankSay(`Come back when you have ${cost.toLocaleString()}. The vault doesn't extend credit.`);
      return;
    }
    localStorage.setItem(TB.BANK_LEVEL_KEY, String(level + 1));
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
    renderBank();
    bankSay(`Done! Your cap is now ${(TB.capForLevel(level + 1) + TB.taipeiBonus()).toLocaleString()}. Pleasure doing business.`);
    syncBalance();
  });
  wireClose('bank-overlay', 'bank-close');

  // ---------- Visit ----------
  // Opt-in, off by default. While it is on, the village snapshot is published
  // (see maybePushVillageSnapshot); turning it off deletes the snapshot. The
  // visit itself is the /visit page, shown in a window so you never leave Tycoon.
  function currentUid() {
    return window.CloudSync && CloudSync.currentUser ? CloudSync.currentUser.uid : null;
  }
  function setVisitStatus(text) { $('visit-status').textContent = text; }
  // A takedown stays pending until it succeeds, so an opt-out made while signed
  // out (or a snapshot published before opt-in existed) is removed on the next
  // signed-in tick.
  let unpublishInFlight = false;
  function unpublishVillage() {
    const uid = currentUid();
    if (!uid || !window.firebase) { village.unpublishPending = true; saveVillage(); setVisitStatus('Sign in and your village will be hidden.'); return; }
    if (unpublishInFlight) return;
    unpublishInFlight = true;
    firebase.firestore().collection('village_snapshots').doc(uid).delete()
      .then(() => {
        village.unpublishPending = false; saveVillage();
        lastSnapshotKey = null;
        setVisitStatus('Your village is hidden from visitors.');
      })
      .catch((err) => { console.error('[village-snapshot] unpublish failed:', err.message || err); setVisitStatus("Couldn't hide your village. Try again in a moment."); })
      .finally(() => { unpublishInFlight = false; });
  }
  $('visit-optin').addEventListener('change', (e) => {
    village.visitable = e.target.checked;
    saveVillage();
    if (village.visitable) {
      // Publish on the next tick instead of waiting out the throttle.
      lastSnapshotPush = 0; lastSnapshotKey = null;
      setVisitStatus(currentUid() ? 'Your village is open to visitors.' : 'Sign in to publish your village.');
    } else {
      unpublishVillage();
    }
    loadVisitList();
  });
  function loadVisitList() {
    const list = $('visit-list');
    list.innerHTML = '';
    if (!window.firebase) { list.innerHTML = '<p class="bank-note">Visiting needs a connection.</p>'; return; }
    const me = currentUid();
    firebase.firestore().collection('village_snapshots').where('visitable', '==', true).limit(20).get()
      .then((snap) => {
        list.innerHTML = '';
        const rows = snap.docs.filter((d) => d.id !== me);
        if (!rows.length) { list.innerHTML = '<p class="bank-note">No villages have let visitors in yet.</p>'; return; }
        rows.forEach((doc) => {
          const d = doc.data();
          const row = document.createElement('div');
          row.className = 'picker-row';
          const info = document.createElement('div');
          info.className = 'row-info';
          // Names come from other players: set as text, never as HTML.
          info.textContent = `${d.displayName || 'Anonymous Tycoon'} · ${d.population || 0} people · ${d.gdp || 0} Strubles/min`;
          const go = document.createElement('button');
          go.className = 'btn';
          go.type = 'button';
          go.textContent = 'Visit';
          go.addEventListener('click', () => openVisit(doc.id, d.displayName || 'Anonymous Tycoon'));
          row.append(info, go);
          list.appendChild(row);
        });
      })
      .catch((err) => {
        console.error('[visit] list failed:', err.message || err);
        list.innerHTML = '<p class="bank-note">Couldn\'t load villages right now.</p>';
      });
  }
  function openVisit(uid, name) {
    closeStats();
    enterVisit(uid, name);
  }
  // ---------- Stats window: you, the village leaderboards, and visiting ----------
  // Your numbers are the stats bar, so this window reads it rather than doing
  // the maths twice. While you are visiting, the bar shows the village on screen,
  // so "You" says so instead of showing the wrong numbers.
  const BOARD_CFG = {
    gdp: { field: 'gdp', format: (v) => `${Number(v || 0).toLocaleString()} Strubles/min`, empty: 'No villages ranked yet.' },
    efficiency: { field: 'efficiency', requireQualified: true, format: (v) => `${Number(v || 0).toLocaleString()} per building`, empty: 'No villages ranked yet. A village needs a few standing buildings to qualify.' },
  };
  let statsTab = 'you';
  let boardKey = 'gdp';
  function openStats(tab) {
    $('stats-overlay').classList.add('open');
    showStatsTab(tab || 'you');
  }
  function closeStats() { $('stats-overlay').classList.remove('open'); }
  function showStatsTab(name) {
    statsTab = name;
    document.querySelectorAll('[data-stats-tab]').forEach((b) => b.classList.toggle('active', b.dataset.statsTab === name));
    document.querySelectorAll('[data-stats-pane]').forEach((p) => { p.hidden = p.dataset.statsPane !== name; });
    if (name === 'you') renderYourStats();
    if (name === 'board') loadBoard(boardKey);
    if (name === 'visit') {
      // The opt-in belongs to your own village, so it can't change while you are visiting.
      $('visit-optin').checked = !!village.visitable && !visiting;
      $('visit-optin').disabled = !!visiting;
      setVisitStatus(visiting ? 'Head home to change this.' : '');
      loadVisitList();
    }
  }
  function renderYourStats() {
    const box = $('stats-you');
    box.innerHTML = '';
    const add = (label, value) => {
      const row = document.createElement('div');
      row.className = 'gift-row';
      const l = document.createElement('div');
      l.className = 'gift-body';
      l.textContent = label;
      const v = document.createElement('b');
      v.textContent = value;
      row.append(l, v);
      box.appendChild(row);
    };
    if (visiting) {
      const note = document.createElement('p');
      note.className = 'bank-note';
      note.textContent = `You're visiting ${visiting.name}. Head home to see your own numbers.`;
      box.appendChild(note);
    } else {
      document.querySelectorAll('#stats-bar > span').forEach((s) => {
        if (s.style.display === 'none') return;
        // "GDP: 2/min" is a label, a colon, then the value (which can include a unit).
        const label = (s.firstChild ? s.firstChild.textContent : '').replace(/:\s*$/, '').trim();
        const value = s.textContent.slice(label.length).replace(/^\s*:\s*/, '').trim();
        add(label, value);
      });
      add('Lifetime earned', `${Number(village.lifetimeEarned || 0).toLocaleString()} Strubles`);
      try { add('Strubles', Number(Strubles.get() || 0).toLocaleString()); } catch {}
    }
    renderProfit(add);
  }
  // Daily profit: income - spent + refunds, for today and the last few days.
  function profitOf(row) { return (row.income || 0) - (row.spent || 0) + (row.refunds || 0); }
  function renderProfit(add) {
    const all = loadProfit();
    const today = profitDay();
    const row = all[today] || { income: 0, spent: 0, refunds: 0 };
    const sign = (n) => (n > 0 ? '+' : n < 0 ? '−' : '') + Math.abs(n).toLocaleString();
    const heading = document.createElement('div');
    heading.className = 'stats-heading';
    heading.textContent = 'Today (this browser, Tycoon only)';
    $('stats-you').appendChild(heading);
    add('Income', `+${(row.income || 0).toLocaleString()}`);
    add('Spent', `−${(row.spent || 0).toLocaleString()}`);
    add('Refunds', `+${(row.refunds || 0).toLocaleString()}`);
    add('Profit today', sign(profitOf(row)) + ' Strubles');
    const past = Object.keys(all).sort().reverse().filter((k) => k !== today).slice(0, 6);
    if (past.length) {
      const h2 = document.createElement('div');
      h2.className = 'stats-heading';
      h2.textContent = 'Recent days';
      $('stats-you').appendChild(h2);
      past.forEach((k) => add(k, sign(profitOf(all[k])) + ' Strubles'));
    }
  }
  function loadBoard(key) {
    boardKey = key;
    document.querySelectorAll('[data-board]').forEach((b) => b.classList.toggle('active', b.dataset.board === key));
    const box = $('stats-board');
    box.textContent = 'Loading…';
    if (!window.firebase) { box.textContent = 'Leaderboards need a connection.'; return; }
    const cfg = BOARD_CFG[key];
    const LIMIT = 20;
    // Efficiency filters on `qualified`, a second field, so it is filtered here
    // rather than with a composite index (the same trick as /leaderboard).
    firebase.firestore().collection('leaderboard')
      .orderBy(cfg.field, 'desc').limit(cfg.requireQualified ? LIMIT * 4 : LIMIT).get()
      .then((snap) => {
        if (boardKey !== key || statsTab !== 'board') return;
        let docs = snap.docs;
        if (cfg.requireQualified) docs = docs.filter((d) => d.data().qualified !== false);
        docs = docs.slice(0, LIMIT);
        box.innerHTML = '';
        if (!docs.length) { box.innerHTML = `<p class="bank-note">${cfg.empty}</p>`; return; }
        const me = currentUid();
        docs.forEach((doc, i) => {
          const d = doc.data();
          const isMe = doc.id === me;
          const row = document.createElement('div');
          row.className = 'gift-row';
          const rank = document.createElement('div');
          rank.textContent = `#${i + 1}`;
          const who = document.createElement('div');
          who.className = 'gift-body';
          // Names come from other players: set as text, never as HTML.
          who.textContent = (d.displayName || 'Anonymous Tycoon') + (isMe ? ' (you)' : '');
          const val = document.createElement('b');
          val.textContent = cfg.format(d[cfg.field]);
          row.append(rank, who, val);
          if (!isMe) {
            const go = document.createElement('button');
            go.className = 'btn';
            go.type = 'button';
            go.textContent = 'Visit';
            go.addEventListener('click', () => openVisit(doc.id, d.displayName || 'Anonymous Tycoon'));
            row.appendChild(go);
          }
          box.appendChild(row);
        });
      })
      .catch((err) => {
        console.error('[leaderboard] query failed:', err.message || err);
        box.innerHTML = '<p class="bank-note">Couldn\'t load the leaderboard right now.</p>';
      });
  }
  $('stats-btn').addEventListener('click', () => openStats('you'));
  wireClose('stats-overlay', 'stats-close');
  document.querySelectorAll('[data-stats-tab]').forEach((b) => {
    b.addEventListener('click', () => showStatsTab(b.dataset.statsTab));
  });
  document.querySelectorAll('[data-board]').forEach((b) => {
    b.addEventListener('click', () => loadBoard(b.dataset.board));
  });

  // ---------- Visiting a neighbour's village, in the same scene ----------
  // Their village is swapped in for yours, read-only. While it is out, every
  // path that would spend, refund, earn or publish is blocked (visitLocked, tick,
  // saveVillage and the snapshot pushes), so nothing of theirs is saved or paid.
  function visitLocked() {
    if (!visiting) return false;
    toast("You're visiting. Head home to build or spend.", true);
    return true;
  }
  function clearBuildingSprites() {
    for (const sp of bSprites.values()) { if (sp && sp.destroy) sp.destroy(); }
    for (const lb of bLabels.values()) { if (lb && lb.destroy) lb.destroy(); }
    bSprites.clear(); bLabels.clear();
  }
  // Draw everything from a village object. Sprites are keyed by building id, so
  // they are cleared on every swap: a neighbour's id must not reuse ours.
  function showVillage(v) {
    village = v;
    clearBuildingSprites();
    rebuildTileGrid();
    onBuildingsChanged();
    refresh();
  }
  async function enterVisit(uid, name) {
    if (!window.firebase) { toast("Visiting needs a connection.", true); return; }
    let snap;
    try { snap = await firebase.firestore().collection('village_snapshots').doc(uid).get(); }
    catch (err) { console.error('[visit] load failed:', err.message || err); toast("Couldn't reach that village right now.", true); return; }
    if (!snap.exists || snap.data().visitable !== true) { toast('That village is closed to visitors now.', true); return; }
    loadVisit(uid, snap.data(), name);
  }
  // Shows a village from its snapshot. Split from enterVisit so it can be tested
  // without Firestore (see TycoonTest.loadVisit).
  function loadVisit(uid, d, name) {
    stopPlacing();
    setBrush(null);
    selectedId = null;
    if (!visiting) homeVillage = village;
    visiting = { uid, name: name || d.displayName || 'Anonymous Tycoon' };
    const b = (Array.isArray(d.buildings) ? d.buildings : [])
      .filter((s) => s && DEFS[s.key] && Number.isFinite(s.x) && Number.isFinite(s.y))
      .map((s, i) => ({
        id: Number.isFinite(s.id) ? s.id : i + 1, key: s.key, x: s.x, y: s.y,
        status: 'complete', startedAt: 0, completesAt: 0, lastProductionAt: 0, paid: 0,
      }));
    const tiles = {};
    Object.entries(d.tiles || {}).forEach(([k, t]) => { if (TILE_ID_KNOWN.has(t)) tiles[k] = t; });
    showVillage({ v: 2, nextId: 1, name: visiting.name, b, tiles, paid: {}, founderKit: true });
    $('visit-bar-text').textContent = `🏘️ Visiting ${visiting.name}`;
    $('visit-bar').classList.add('open');
    if (cam) recenter();
  }
  function exitVisit() {
    if (!visiting) return;
    visiting = null;
    $('visit-bar').classList.remove('open');
    closeGiftWindow();
    const home = homeVillage;
    homeVillage = null;
    showVillage(home);
    if (cam) recenter();
  }
  $('visit-home').addEventListener('click', exitVisit);
  $('visit-gift').addEventListener('click', () => openGiftWindow());

  // ---------- Gifts ----------
  // A sticker and a note are free. Strubles go through the server: it debits the
  // sender and holds the amount in a pending gift until the owner collects it.
  // Until the server and rules for gifts are live, these calls fail and the
  // window says so.
  const GIFT_API = location.protocol === 'https:'
    ? '/arena-api'
    : 'http://' + (location.hostname || 'localhost') + ':4001';
  const GIFT_MAX_AMOUNT = 1000;
  const GIFT_STICKERS = [
    { id: 'sunflower', emoji: '🌻', label: 'Sunflower' },
    { id: 'balloon', emoji: '🎈', label: 'Balloon' },
    { id: 'cake', emoji: '🍰', label: 'Cake' },
    { id: 'star', emoji: '⭐', label: 'Star' },
    { id: 'cat', emoji: '🐈', label: 'Cat' },
    { id: 'letter', emoji: '📮', label: 'Letter' },
  ];
  const GIFT_ERRORS = {
    sign_in: 'Sign in to send gifts.',
    insufficient: "You don't have that many Strubles.",
    cap: "They're at their wallet cap, so the gift can't land yet.",
    limit: "You've already sent a gift today. Try again tomorrow.",
    not_visitable: 'That village is closed to visitors now.',
    self: "You can't send a gift to yourself.",
    blocked_text: "That note has a word we can't send. Try different words.",
    bad_request: "That gift wasn't valid. Check the amount and note.",
    not_found: 'That gift is gone.',
    already_collected: 'That gift was already collected.',
  };
  let giftSticker = GIFT_STICKERS[0].id;
  function setGiftStatus(text) { $('gift-status').textContent = text; }
  async function giftPost(path, body) {
    const user = window.CloudSync && CloudSync.currentUser;
    if (!user) return { ok: false, error: 'sign_in' };
    try {
      const res = await fetch(GIFT_API + path, {
        method: 'POST',
        headers: { Authorization: 'Bearer ' + await user.getIdToken(), 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) return Object.assign({ ok: true }, data);
      if (res.status === 404) return { ok: false, error: 'not_switched_on' };
      return { ok: false, error: data.error || 'http_' + res.status };
    } catch {
      return { ok: false, error: 'network' };
    }
  }
  function giftErrorText(code) {
    if (code === 'not_switched_on') return "Gifts aren't switched on yet.";
    return GIFT_ERRORS[code] || "Something went wrong. Try again.";
  }
  function openGiftWindow() {
    if (!visiting) return;
    $('gift-title').textContent = `Leave a gift for ${visiting.name}`;
    $('gift-note').value = '';
    $('gift-amount').value = '0';
    setGiftStatus('');
    renderGiftStickers();
    $('gift-overlay').classList.add('open');
  }
  // Only the sticker row is redrawn on a pick, so a note already typed survives.
  function renderGiftStickers() {
    const box = $('gift-stickers');
    box.innerHTML = '';
    GIFT_STICKERS.forEach((s) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'gift-sticker' + (s.id === giftSticker ? ' active' : '');
      b.title = s.label;
      b.setAttribute('aria-label', s.label);
      b.textContent = s.emoji;
      b.addEventListener('click', () => { giftSticker = s.id; renderGiftStickers(); });
      box.appendChild(b);
    });
  }
  function closeGiftWindow() { $('gift-overlay').classList.remove('open'); }
  wireClose('gift-overlay', 'gift-close');
  $('gift-send').addEventListener('click', async () => {
    if (!visiting) return;
    const user = window.CloudSync && CloudSync.currentUser;
    if (!user) { setGiftStatus('Sign in to send gifts.'); return; }
    const toUid = visiting.uid;
    if (user.uid === toUid) { setGiftStatus(giftErrorText('self')); return; }
    const note = $('gift-note').value.trim().slice(0, 140);
    const amount = Math.floor(Number($('gift-amount').value) || 0);
    if (amount < 0 || amount > GIFT_MAX_AMOUNT) { setGiftStatus(`Strubles must be between 0 and ${GIFT_MAX_AMOUNT}.`); return; }
    $('gift-send').disabled = true;
    setGiftStatus('Sending…');
    let result;
    if (amount > 0) {
      result = await giftPost('/gifts/strubles', { toUid, amount, stickerId: giftSticker, note });
      if (result.ok) { try { Strubles.refresh(); } catch {} }
    } else {
      // A note alone moves no money. The server checks it for blocked words and
      // writes it to the owner's gift list; clients can't write there directly.
      result = await giftPost('/gifts/note', { toUid, stickerId: giftSticker, note });
    }
    $('gift-send').disabled = false;
    if (!result.ok) { setGiftStatus(giftErrorText(result.error)); return; }
    setGiftStatus('Sent! 🎁');
    $('gift-note').value = '';
    $('gift-amount').value = '0';
  });

  // The owner's inbox, inside the bank. Notes are read-only; Strubles gifts
  // collect into the balance on the server, which checks the wallet cap.
  function loadGiftInbox() {
    const box = $('gift-inbox');
    box.innerHTML = '';
    const uid = currentUid();
    if (!uid || !window.firebase) { box.innerHTML = '<p class="bank-note">Sign in to see the gifts your visitors leave.</p>'; return; }
    firebase.firestore().collection('village_snapshots').doc(uid).collection('gifts')
      .orderBy('createdAt', 'desc').limit(20).get()
      .then((snap) => {
        box.innerHTML = '';
        if (snap.empty) { box.innerHTML = '<p class="bank-note">No gifts yet.</p>'; return; }
        snap.docs.forEach((doc) => {
          const g = doc.data();
          const row = document.createElement('div');
          row.className = 'gift-row';
          const sticker = GIFT_STICKERS.find((s) => s.id === g.stickerId);
          const mark = document.createElement('div');
          mark.textContent = sticker ? sticker.emoji : '🎁';
          const body = document.createElement('div');
          body.className = 'gift-body';
          const from = document.createElement('strong');
          from.textContent = g.fromName || 'Anonymous Tycoon';
          const note = document.createElement('small');
          note.textContent = g.note || '';
          body.append(from, note);
          row.append(mark, body);
          if (g.kind === 'strubles') {
            const amt = document.createElement('div');
            amt.textContent = `${(g.amount || 0).toLocaleString()} Strubles`;
            row.appendChild(amt);
            if (g.status === 'pending') {
              const btn = document.createElement('button');
              btn.className = 'btn';
              btn.type = 'button';
              btn.textContent = 'Collect';
              btn.addEventListener('click', () => collectGift(doc.id, btn));
              row.appendChild(btn);
            } else {
              const done = document.createElement('small');
              done.textContent = 'collected';
              row.appendChild(done);
            }
          }
          box.appendChild(row);
        });
      })
      .catch((err) => {
        console.error('[gift] inbox failed:', err.message || err);
        box.innerHTML = '<p class="bank-note">Couldn\'t load your gifts right now.</p>';
      });
  }
  async function collectGift(giftId, btn) {
    btn.disabled = true;
    const result = await giftPost('/gifts/collect', { giftId });
    if (result.ok) {
      try { Strubles.refresh(); } catch {}
      toast(`🎁 Collected ${(result.applied || 0).toLocaleString()} Strubles`);
      loadGiftInbox();
      return;
    }
    btn.disabled = false;
    toast(result.error === 'cap' ? 'Make room under your wallet cap first.' : giftErrorText(result.error), true);
  }
  $('bank-btn').addEventListener('click', () => { setTimeout(loadGiftInbox, 0); });

  // ---------- Building slots ----------
  function renderExpand() {
    const owned = slotsOwned();
    $('expand-info-breakdown').innerHTML = `
      <div class="bank-cap-row"><span>Building slots</span><span>${BASE_SLOTS + owned}</span></div>
      <div class="bank-cap-row"><span>Slots purchased</span><span>${owned}</span></div>`;
    $('expand-next-info').textContent = `Next: slot ${BASE_SLOTS + owned + 1} — costs ${expandCostForSlot(owned + 1).toLocaleString()} Strubles.`;
  }
  $('expand-buy').addEventListener('click', () => {
    if (visitLocked()) return;
    const owned = slotsOwned();
    const cost = expandCostForSlot(owned + 1);
    if (!Strubles.spend(cost)) {
      bankSay(`A slot is ${cost.toLocaleString()}, and I can only take cash I can see in your wallet.`);
      return;
    }
    localStorage.setItem(SLOTS_KEY, String(owned + 1));
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
    renderExpand();
    renderBank();
    bankSay(`Slot ${BASE_SLOTS + owned + 1} is yours. Plenty of room for something new.`);
    refresh();
    syncBalance();
  });

  window.addEventListener('inventory:changed', () => refresh());
  window.addEventListener('strubles:change', syncBalance);
  // Tile prices track the balance, so keep the price in the brush bar current
  // between strokes (mid-stroke it is deliberately held steady).
  window.addEventListener('strubles:change', () => { if (brushMode && strokeBasis == null) setBrushLabel(); });
  window.addEventListener('storage', (e) => {
    if (e.key === VILLAGE_KEY) {
      // Another tab changed your village. While visiting, keep it aside until you go home.
      if (visiting) homeVillage = loadVillage();
      else showVillage(loadVillage());
    }
    if (e.key === INV_KEY) refresh();
  });
  // Cloud pull reloads the page itself, so no extra reconcile hook is needed.
  // A brush stroke defers its write; make sure a hidden tab or closing page
  // doesn't strand it.
  document.addEventListener('visibilitychange', () => { if (document.hidden) flushSave(); });
  window.addEventListener('pagehide', flushSave);

  // ---------- Sound (same pattern as every other page) ----------
  let audioEnabled = true;
  const themeMusic = $('theme-music');
  const VOLUME_KEY = 'music_volume_v1';
  const volumeSlider = $('volume-slider');
  const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
  themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.3;
  volumeSlider.value = Math.round(themeMusic.volume * 100);
  volumeSlider.addEventListener('input', () => {
    themeMusic.volume = volumeSlider.value / 100;
    localStorage.setItem(VOLUME_KEY, themeMusic.volume);
  });
  function tryPlayTheme() { if (audioEnabled) themeMusic.play().catch(() => {}); }
  tryPlayTheme();
  const unlockTheme = () => {
    tryPlayTheme();
    window.removeEventListener('pointerdown', unlockTheme);
    window.removeEventListener('keydown', unlockTheme);
  };
  window.addEventListener('pointerdown', unlockTheme);
  window.addEventListener('keydown', unlockTheme);
  $('mute-btn').addEventListener('click', () => {
    audioEnabled = !audioEnabled;
    $('mute-btn').textContent = audioEnabled ? '🔊' : '🔇';
    if (audioEnabled) tryPlayTheme(); else themeMusic.pause();
  });

  // ---------- Reconcile loop ----------
  grantFounderKit();
  if (tick()) saveVillage();
  setInterval(() => {
    if (tick()) saveVillage();
    maybeTriggerEvent();
    refresh();
    syncVillageName();
  }, 1000);

  // ---------- Leaderboard score push ----------
  // A one-Taipei-101 village would otherwise top the Efficiency board on a
  // single building's output; qualified requires a minimum village size so
  // the board rewards running many buildings well, not owning just one.
  const EFFICIENCY_MIN_BUILDINGS = 3;
  let lastPushedKey = null;
  let leaderboardPushInFlight = false;
  let leaderboardCooldownUntil = 0;
  function maybePushLeaderboardScore(stats) {
    if (visiting) return;   // a visited village's numbers are not yours to report
    if (!window.CloudSync || !CloudSync.isSignedIn()) return;
    if (Date.now() < leaderboardCooldownUntil) return;
    const key = JSON.stringify(stats);
    if (key === lastPushedKey || leaderboardPushInFlight) return;
    const user = CloudSync.currentUser;
    if (!user) return;
    leaderboardPushInFlight = true;
    firebase.firestore().collection('leaderboard').doc(user.uid).set({
      displayName: user.displayName || 'Anonymous Tycoon',
      gdp: Math.round(stats.gdp * 1000) / 1000,
      efficiency: Math.round(stats.efficiency * 1000) / 1000,
      buildings: stats.buildings,
      population: stats.population,
      specialty: stats.specialty,
      qualified: stats.buildings >= EFFICIENCY_MIN_BUILDINGS,
      updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
    }, { merge: true })
      .then(() => { lastPushedKey = key; })
      .catch((err) => {
        // Almost always missing Firestore rules for this collection, not a
        // transient blip — retrying every second forever just floods the
        // console without ever succeeding, so back off instead.
        leaderboardCooldownUntil = Date.now() + 60000;
        console.error('[leaderboard] push failed, retrying in 60s:', err.message || err);
      })
      .finally(() => { leaderboardPushInFlight = false; });
  }

  // ---------- Neighbor visits ----------
  // A read-only snapshot of the village (same trust model as the leaderboard
  // push above: the client reports it, nobody validates it — this site
  // already works that way end to end). /visit renders it with the same
  // terrain/building art, no interaction. Throttled hard: this payload
  // carries the whole tile map, not just a couple of numbers, so it pushes
  // at most once every 30s and only when something actually changed.
  const SNAPSHOT_MIN_INTERVAL_MS = 30000;
  let lastSnapshotPush = 0, lastSnapshotKey = null, snapshotPushInFlight = false, snapshotCooldownUntil = 0;
  function maybePushVillageSnapshot(stats) {
    if (visiting) return;   // never publish a neighbour's village as yours
    if (!window.CloudSync || !CloudSync.isSignedIn()) return;
    if (Date.now() < snapshotCooldownUntil) return;
    const user = CloudSync.currentUser;
    if (!user) return;
    // Opted out: nothing is published, and any snapshot left from before opt-in
    // existed (or from an opt-out made while signed out) is taken down.
    if (!village.visitable) {
      if (village.visitable === undefined) { village.visitable = false; village.unpublishPending = true; saveVillage(); }
      if (village.unpublishPending) unpublishVillage();
      return;
    }
    const buildings = village.b.map((s) => ({ id: s.id, key: s.key, x: s.x, y: s.y, status: s.status, fireUntil: s.fireUntil || 0 }));
    const payload = { tiles: village.tiles, buildings, ...stats };
    const key = JSON.stringify(payload);
    if (key === lastSnapshotKey) return;
    const now = Date.now();
    if (now - lastSnapshotPush < SNAPSHOT_MIN_INTERVAL_MS || snapshotPushInFlight) return;
    snapshotPushInFlight = true;
    firebase.firestore().collection('village_snapshots').doc(user.uid).set({
      displayName: user.displayName || 'Anonymous Tycoon',
      visitable: true,
      tiles: payload.tiles,
      buildings: payload.buildings,
      gdp: Math.round(stats.gdp * 1000) / 1000,
      efficiency: Math.round(stats.efficiency * 1000) / 1000,
      population: stats.population,
      mood: Math.round(stats.mood),
      specialty: stats.specialty,
      updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
    }, { merge: true })   // merge, so a push never wipes fields set elsewhere (such as the opt-in)
      .then(() => { lastSnapshotKey = key; lastSnapshotPush = Date.now(); })
      .catch((err) => {
        // Same reasoning as the leaderboard push: a missing-rules error
        // never resolves itself, so stop retrying every tick.
        snapshotCooldownUntil = Date.now() + 60000;
        console.error('[village-snapshot] push failed, retrying in 60s:', err.message || err);
      })
      .finally(() => { snapshotPushInFlight = false; });
  }

  // Read-only introspection for QA (same idea as window.HorseGame).
  window.TycoonGame = {
    getState: () => ({
      village, slotCap: slotCap(), placing, brushMode, mood,
      zoom: cam && cam.zoom, villagers: villagers.length,
      villagerPos: villagers.map((v) => [v.x, v.y]),
      cost: { road: tileCost('road'), residential: tileCost('residential') },
      connected: village.b.filter((s) => s.status === 'complete' && isRoadConnected(s)).length,
    }),
  };

  if (window.initPickers) setTimeout(window.initPickers, 100);

  // Test hook for the browser suites; only exists in dev mode.
  if (!TYCOON_DISABLED && window.IANTOPIA_IS_DEV) window.TycoonTest = { villagers, get village() { return village; }, foodStats, housingTotal, insideCount, homeCount, planRect, get cam() { return cam; }, T, MAP, tileFromPointer, setBrush, tileCost, gameHour, parkPull, workPull, setClockHour(h) { clockShiftMs = ((h / 24) * DAY_REAL_MS - (Date.now() % DAY_REAL_MS) + DAY_REAL_MS) % DAY_REAL_MS; }, get parkJoy() { return parkJoy; }, computeSpecialty, isWorkplace, jobCount, computeStaffing, isRoadConnected, productionFor, computeMood, triggerFire, triggerCaravan, triggerAudit, estimateGDP, loadVisit, exitVisit, get visiting() { return visiting; }, get homeVillage() { return homeVillage; } };
})();
</script>
</body>
</html>
