<script is:inline>
  // What the page shows until a background is picked, and what "default" in
  // the picker resets to.
  window.PAGE_DEFAULT_BG = { type: 'gif', src: '/tycoon/sky-background.gif', label: 'Skyline', position: 'center' };
</script>
<script is:inline src="/pickers.js?v=11"></script>
<!-- Pinned exact version: Phaser 4 is new (Apr 2026), don't float it. -->
<script is:inline src="https://cdn.jsdelivr.net/npm/phaser@4.0.0/dist/phaser.min.js"></script>
<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);

  // Economy stays frozen outside dev mode until the server-authoritative
  // village save lands (see the rework plan, phase 3). Placing/moving still
  // works so the new map can be tried; production/tax/construction do not.
  const TYCOON_DISABLED = !localStorage.getItem('tycoon_dev_mode');
  $('out-of-order-banner').style.display = TYCOON_DISABLED ? 'block' : 'none';

  // ---------- Constants / data ----------
  const T = TycoonArt.T;        // pixels per tile (world units)
  const MAP = 16;               // map is MAP x MAP tiles
  const BASE_SLOTS = 5;         // buildings allowed before buying more slots
  const VILLAGE_KEY = 'tycoon_village_v2';
  const LEGACY_GRID_KEY = 'tycoon_grid_v1';
  const LAST_SEEN_KEY = 'tycoon_last_seen_v1';
  const INV_KEY = 'strubles_inventory_v1';
  const SLOTS_KEY = 'tycoon_slots_owned_v1';
  const ORDER = window.TYCOON_BUILDING_ORDER || [];       // every building, rarity ascending
  const ALL_KEYS = ORDER;
  const DEFS = window.TYCOON_BUILDINGS || {};
  const MAX_PER_TYPE = window.TYCOON_MAX_PER_TYPE || 5;
  const MAX_CONCURRENT = window.TYCOON_MAX_CONCURRENT_BUILDS || 3;
  const RARITY = window.CASE_RARITIES || {};
  // Building slots. The first one used to cost 200,000 and each tripled the
  // last -- ten times the base wallet cap, so it could never be bought at all.
  // Now 1,500 and 1.5x per slot, which lands the first six well inside the
  // base 20,000 cap and makes the later ones a genuine late-game spend.
  const EXPAND_BASE_COST = 1500;
  const EXPAND_GROWTH = 1.5;

  // Footprint lives on the definition (tycoon-buildings.js), the one source of
  // truth for every building stat.
  const foot = (key) => { const d = DEFS[key]; return { w: (d && d.w) || 1, h: (d && d.h) || 1 }; };
  const zoneOf = (key) => (DEFS[key] && DEFS[key].zone) || null;

  // ---------- Persistence ----------
  function loadJSON(k, fb) { try { const v = localStorage.getItem(k); return v != null ? JSON.parse(v) : fb; } catch { return fb; } }
  function saveJSON(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} }

  function slotsOwned() { return Math.max(0, Number(localStorage.getItem(SLOTS_KEY)) || 0); }
  function slotCap() { return BASE_SLOTS + slotsOwned(); }
  function expandCostForSlot(n) { return n <= 0 ? 0 : Math.round((EXPAND_BASE_COST * Math.pow(EXPAND_GROWTH, n - 1)) / 10) * 10; }

  // Village state: { v:2, nextId, b:[...buildings], tiles:{tx_ty: type} }
  // tiles map: "x_y" -> "residential"/"commercial"/"industrial"/"agricultural"/"road"/"water"
  // paid map:  "x_y" -> Strubles paid for that tile (refunded when it is erased or replaced)
  function freshVillage() { return { v: 2, nextId: 1, b: [], tiles: {}, paid: {} }; }

  // First load after the rework: carry the old one-row skyline's buildings
  // over (same construction progress, same keys) into a row on the new map
  // instead of silently dropping what players already built. The legacy key
  // is left untouched.
  function migrateLegacy() {
    const v = freshVillage();
    const old = loadJSON(LEGACY_GRID_KEY, null);
    if (!Array.isArray(old)) return v;
    let cx = 1;
    old.forEach((slot) => {
      if (!slot || !DEFS[slot.key]) return;
      const f = foot(slot.key);
      if (cx + f.w > MAP) return;
      v.b.push(Object.assign({}, slot, { id: v.nextId++, x: cx, y: MAP - 1 - f.h - 1 }));
      cx += f.w + 1;
    });
    return v;
  }

  function loadVillage() {
    const raw = loadJSON(VILLAGE_KEY, null);
    if (raw && raw.v === 2 && Array.isArray(raw.b)) {
      // Saves from before roads/zones existed have no `tiles` map at all, and
      // the first paint would throw on it.
      if (!raw.tiles || typeof raw.tiles !== 'object') raw.tiles = {};
      // What each tile cost when it was painted, so erasing it can refund the same.
      if (!raw.paid || typeof raw.paid !== 'object') raw.paid = {};
      if (!Number.isFinite(raw.nextId)) raw.nextId = raw.b.reduce((m, s) => Math.max(m, s.id || 0), 0) + 1;
      return raw;
    }
    const v = migrateLegacy();
    saveJSON(VILLAGE_KEY, v);
    return v;
  }
  // A brush stroke paints a tile per pointer-move, and each used to stringify
  // and write the whole village. During a stroke the write is deferred and
  // flushed once when the pointer lifts; every other change saves immediately.
  let savePending = false;
  function saveVillage(defer) {
    if (defer) { savePending = true; return; }
    savePending = false;
    saveJSON(VILLAGE_KEY, village);
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
  }
  function flushSave() { if (savePending) saveVillage(); }

  let village = loadVillage();
  let brushMode = null;  // "residential" | "commercial" | "industrial" | "road" | "water" | null

  // ---------- Grids ----------
  // Hot paths (every villager every frame, every road/zone check) read typed
  // arrays instead of the string-keyed save format: no key concatenation, no
  // allocation, O(1). village.tiles stays the persisted form; these mirror it.
  const TILE_NAMES = [null, 'residential', 'commercial', 'industrial', 'road', 'water', 'agricultural'];
  const TILE_ID = { residential: 1, commercial: 2, industrial: 3, road: 4, water: 5, agricultural: 6 };
  const tileGrid = new Uint8Array(MAP * MAP);   // TILE_ID, 0 = bare grass
  const occGrid = new Int32Array(MAP * MAP);    // id of the building covering the tile, 0 = none
  const bById = new Map();
  let terrainDirty = true;                      // ground layer needs recomposing
  let waterDirty = true;                        // water tile set changed

  function rebuildTileGrid() {
    tileGrid.fill(0);
    for (const k in village.tiles) {
      const i = k.indexOf('_');
      const x = +k.slice(0, i), y = +k.slice(i + 1);
      const id = TILE_ID[village.tiles[k]];
      if (id && x >= 0 && y >= 0 && x < MAP && y < MAP) tileGrid[y * MAP + x] = id;
    }
    terrainDirty = waterDirty = true;
  }
  // Call after ANY change to village.b (place, move, remove, load). A zone's
  // colour hides under a building, so a footprint change also means the ground
  // has to be recomposed.
  function onBuildingsChanged() {
    occGrid.fill(0);
    bById.clear();
    village.b.forEach((s) => {
      bById.set(s.id, s);
      const f = foot(s.key);
      for (let y = s.y; y < s.y + f.h; y++) {
        for (let x = s.x; x < s.x + f.w; x++) {
          if (x >= 0 && y >= 0 && x < MAP && y < MAP) occGrid[y * MAP + x] = s.id;
        }
      }
    });
    terrainDirty = true;
  }
  rebuildTileGrid();
  onBuildingsChanged();

  // Zoning is the layout puzzle. Every building has a zone it must be built on
  // (its footprint has to be painted with it first), and it earns nothing
  // without a road touching it. Industrial is the dirty option: it pays
  // everything nearby, and tanks village mood.
  // Tile prices scale with how many Strubles you're holding, so laying out a
  // district stays a real spend whether you have 500 or 500,000. Each type has
  // a floor (what a broke player pays) and a share of your balance per tile;
  // the price is whichever is higher. Water and erasing are always free.
  const TILE_BASE = { residential: 50, commercial: 50, industrial: 50, agricultural: 30, road: 100 };
  const TILE_RATE = { residential: 0.004, commercial: 0.004, industrial: 0.004, agricultural: 0.0025, road: 0.008 };
  // Fixed for the length of one drag (see the pointerdown handler), so a
  // stroke is priced as a whole instead of getting cheaper tile by tile as
  // your balance drops underneath it.
  let strokeBasis = null;
  function tileCost(type) {
    if (!TILE_BASE[type]) return 0;
    let basis = strokeBasis;
    if (basis == null) { try { basis = Strubles.get(); } catch { basis = 0; } }
    const scaled = Math.round((basis * TILE_RATE[type]) / 5) * 5; // tidy multiples of 5
    return Math.max(TILE_BASE[type], scaled);
  }
  const INDUSTRIAL_BONUS = 0.15; // adjacent industrial, at a mood cost

  // ---------- Inventory / counts ----------
  // You start with no buildings. Every one is an owned copy in the inventory,
  // won from the Iantopia Lootbox Basic or bought in the Shop's Real Estate
  // section; placing one uses a copy up.
  function ownedCounts() {
    const inv = loadJSON(INV_KEY, {});
    const list = Array.isArray(inv.buildings) ? inv.buildings : [];
    const counts = {};
    ORDER.forEach((k) => { counts[k] = 0; });
    list.forEach((k) => { if (counts[k] != null) counts[k]++; });
    return counts;
  }
  function placedCounts(excludeId) {
    const counts = {};
    ALL_KEYS.forEach((k) => { counts[k] = 0; });
    village.b.forEach((s) => { if (s.id !== excludeId && counts[s.key] != null) counts[s.key]++; });
    return counts;
  }
  function availableCounts() {
    const owned = ownedCounts(), placed = placedCounts();
    const avail = {};
    ALL_KEYS.forEach((k) => { avail[k] = Math.max(0, owned[k] - placed[k]); });
    return avail;
  }
  const hasBank = () => village.b.some((s) => s.key === 'bank' && s.status === 'complete');
  const buildingCount = () => village.b.filter((s) => s.status === 'building').length;

  // ---------- Economy tick ----------
  // The freeze bounds PAYOUT, not the passage of time. Returning early for
  // everything meant a building never left 'building' once its timer ran
  // out: it rendered at 100% forever, still counted against the 3 concurrent
  // builds, and after three of them no further building could be started at
  // all. Construction now always settles; only earning is gated.
  function tick() {
    const now = Date.now();
    const mood = computeMood();
    let earned = 0, changed = false;
    village.b.forEach((slot) => {
      const def = DEFS[slot.key];
      if (!def) return;
      if (slot.status === 'building' && now >= slot.completesAt) {
        slot.status = 'complete';
        slot.lastProductionAt = slot.completesAt;
        slot.lastTaxAt = slot.completesAt;
        slot.taxDebt = slot.taxDebt || 0;
        changed = true;
      }
      if (slot.status === 'complete' && TYCOON_DISABLED) {
        // Keep the clocks pinned while frozen, so lifting the freeze doesn't
        // pay out everything that "accrued" with the economy switched off.
        if (now - slot.lastProductionAt > 60000) {
          slot.lastProductionAt = now;
          slot.lastTaxAt = now;
          changed = true;
        }
      } else if (slot.status === 'complete') {
        if (slot.lastTaxAt == null) { slot.lastTaxAt = now; slot.taxDebt = 0; changed = true; }
        const eff = productionFor(slot, mood);
        if (eff <= 0) {
          // Unproductive time is forfeited, not banked — otherwise cutting a
          // building off the road network and reconnecting it a day later
          // would pay out that whole day at once.
          if (now - slot.lastProductionAt > 60000) { slot.lastProductionAt = now; changed = true; }
        } else {
          const elapsedMin = Math.max(0, now - slot.lastProductionAt) / 60000;
          const gain = Math.floor(elapsedMin * eff);
          if (gain > 0) {
            earned += gain;
            slot.lastProductionAt += (gain / eff) * 60000;
            changed = true;
          }
        }
        const dailyUpkeep = def.cost * (def.upkeepPct || 0);
        const elapsedTax = Math.max(0, now - slot.lastTaxAt) / 60000;
        const perMin = dailyUpkeep / 1440;
        const taxOwed = perMin > 0 ? Math.floor(elapsedTax * perMin) : 0;
        if (taxOwed > 0) {
          slot.taxDebt = (slot.taxDebt || 0) + taxOwed;
          slot.lastTaxAt += (taxOwed / perMin) * 60000;
          changed = true;
        }
      }
    });
    localStorage.setItem(LAST_SEEN_KEY, String(now));
    if (TYCOON_DISABLED) return changed;
    if (earned > 0) { try { Strubles.add(earned); } catch {} }
    village.b.forEach((slot) => {
      if (slot.status === 'complete' && slot.taxDebt > 0 && Strubles.spend(slot.taxDebt)) {
        slot.taxDebt = 0;
        changed = true;
      }
    });
    return changed;
  }

  // ---------- Map helpers ----------
  function inBounds(x, y, f) { return x >= 0 && y >= 0 && x + f.w <= MAP && y + f.h <= MAP; }

  // Why a footprint can't go here, or null if it can. The reason is returned
  // (not just a boolean) so the placement bar can say what to fix. `ignoreId`
  // lets a building being moved ignore its own old footprint.
  //
  // Zoning is a hard requirement: every tile under the footprint must already
  // be painted with the zone the building belongs to.
  function placementIssue(key, x, y, ignoreId) {
    const f = foot(key);
    if (!inBounds(x, y, f)) return 'bounds';
    const want = TILE_ID[zoneOf(key)];
    let zoned = true;
    for (let ty = y; ty < y + f.h; ty++) {
      for (let tx = x; tx < x + f.w; tx++) {
        const i = ty * MAP + tx;
        const occ = occGrid[i];
        if (occ && occ !== ignoreId) return 'blocked';
        const t = tileGrid[i];
        if (t === TILE_ID.water) return 'water';
        if (want && t !== want) zoned = false;
      }
    }
    return zoned ? null : 'zone';
  }
  const canPlace = (key, x, y, ignoreId) => placementIssue(key, x, y, ignoreId) === null;
  function issueText(issue, key) {
    const f = foot(key);
    switch (issue) {
      case 'bounds': return 'Out of bounds';
      case 'blocked': return 'Something is in the way';
      case 'water': return "Can't build on water";
      case 'zone': return `Needs ${f.w}×${f.h} ${zoneOf(key)} zoning here`;
      default: return '';
    }
  }

  // --- Layout rules. Every one of these is read by productionFor(), which is
  // the only place production is computed, so the stat bar and the payout can
  // never disagree. ---

  // Any tile of `type` orthogonally touching the footprint's edge.
  // Strictly orthogonal — a tile meeting only a diagonal corner does not count.
  function touchesTile(s, type) {
    const f = foot(s.key);
    for (let x = s.x; x < s.x + f.w; x++) {
      if (getTileType(x, s.y - 1) === type) return true;
      if (getTileType(x, s.y + f.h) === type) return true;
    }
    for (let y = s.y; y < s.y + f.h; y++) {
      if (getTileType(s.x - 1, y) === type) return true;
      if (getTileType(s.x + f.w, y) === type) return true;
    }
    return false;
  }
  const isRoadConnected = (s) => touchesTile(s, 'road');

  // Fraction of the footprint standing on the zone this building belongs to.
  // New placements are always 1 (zoning is required to build); only buildings
  // saved before that rule can come back lower, which costs village mood.
  function zoneMatch(s) {
    const want = TILE_ID[zoneOf(s.key)];
    if (!want) return 0;
    const f = foot(s.key);
    let hit = 0;
    for (let y = s.y; y < s.y + f.h; y++) {
      for (let x = s.x; x < s.x + f.w; x++) if (tileGrid[y * MAP + x] === want) hit++;
    }
    return hit / (f.w * f.h);
  }

  function countZones(type) {
    const id = TILE_ID[type];
    let c = 0;
    for (let i = 0; i < tileGrid.length; i++) if (tileGrid[i] === id) c++;
    return c;
  }

  // ---------- People, capacity and food ----------
  // Every residential building houses `housing` residents; every building has a
  // `capacity` of people who can be inside it at once. Farms grow food and
  // groceries / 7-Elevens distribute it: residents are fed only as far as
  // BOTH can reach them (and both need a road).
  const FOOD_PER_PERSON = 1;
  const MAX_VILLAGERS = 40;                      // sprites drawn at once, a performance ceiling
  const housingOf = (s) => (s.status === 'complete' && DEFS[s.key] && DEFS[s.key].housing) || 0;
  const housingTotal = () => village.b.reduce((a, s) => a + housingOf(s), 0);
  const capacityOf = (key) => (DEFS[key] && DEFS[key].capacity) || 0;
  function foodStats() {
    let supply = 0, dist = 0;
    village.b.forEach((s) => {
      if (s.status !== 'complete') return;
      const d = DEFS[s.key];
      if (!d || !(d.food || d.distribution) || !isRoadConnected(s)) return;
      supply += d.food || 0; dist += d.distribution || 0;
    });
    const pop = housingTotal();
    const demand = pop * FOOD_PER_PERSON;
    const fed = Math.min(supply, dist);
    return { pop, demand, supply, dist, fed, satisfaction: demand > 0 ? Math.min(1, fed / demand) : 1 };
  }

  // Village mood, derived entirely from the layout — it is a readout of the
  // player's decisions, not an independent simulation.
  function computeMood() {
    const done = village.b.filter((s) => s.status === 'complete');
    if (!done.length) return 50;
    let m = 50;
    m += 30 * (done.filter(isRoadConnected).length / done.length);
    m += 20 * (done.reduce((a, s) => a + zoneMatch(s), 0) / done.length);
    const ind = countZones('industrial');
    const zoned = countZones('residential') + countZones('commercial') + ind;
    if (zoned > 0) m -= 25 * (ind / zoned);
    if (countZones('water') > 0) m += 8;
    // Hungry residents are unhappy residents; a fully fed village gets a small lift.
    const fs = foodStats();
    if (fs.demand > 0) m += fs.satisfaction >= 1 ? 4 : -12 * (1 - fs.satisfaction);
    // Each building's own footprint on the village: a coal plant is a smell, a
    // bank is reassuring. See `moodEffect` in tycoon-buildings.js.
    done.forEach((s) => { m += (DEFS[s.key] && DEFS[s.key].moodEffect) || 0; });
    return Math.max(0, Math.min(100, m));
  }
  const moodMultiplier = (mood) => 0.75 + (mood / 100) * 0.4; // 0.75x .. 1.15x

  // No zone bonus any more: zoning is a requirement to build, so paying extra
  // for it would just be a flat raise on everything.
  function productionFor(s, mood) {
    const def = DEFS[s.key];
    if (!def || s.status !== 'complete') return 0;
    if (!isRoadConnected(s)) return 0; // no road, no business
    let p = def.production;
    if (touchesTile(s, 'industrial')) p *= 1 + INDUSTRIAL_BONUS;
    if (s.taxDebt > 0) p *= 0.5;
    return p * moodMultiplier(mood);
  }

  function buildingAt(tx, ty) {
    if (tx < 0 || ty < 0 || tx >= MAP || ty >= MAP) return null;
    const id = occGrid[ty * MAP + tx];
    return id ? (bById.get(id) || null) : null;
  }

  function syncBalance() { try { $('bal').textContent = Strubles.get().toLocaleString(); } catch {} }
  function fmtDuration(min) {
    if (min >= 1440) return (min / 1440).toFixed(min % 1440 === 0 ? 0 : 1) + 'd';
    if (min >= 60) return (min / 60).toFixed(min % 60 === 0 ? 0 : 1) + 'h';
    return min + 'm';
  }

  // ---------- Tiles ----------
  // Pixel art, the baking of it, and the grass/road/water compositing all live
  // in /tycoon-art.js. What stays here is the small amount that touches state.
  const { hex, rect } = TycoonArt;

  function getTileType(x, y) {
    if (x < 0 || y < 0 || x >= MAP || y >= MAP) return null;
    return TILE_NAMES[tileGrid[y * MAP + x]];
  }
  function setTileType(x, y, type) {
    if (x < 0 || y < 0 || x >= MAP || y >= MAP) return;
    const k = x + '_' + y;
    if (type) { village.tiles[k] = type; tileGrid[y * MAP + x] = TILE_ID[type]; }
    else { delete village.tiles[k]; tileGrid[y * MAP + x] = 0; }
    terrainDirty = true;
    waterDirty = true;
  }

  // ---------- Phaser scene ----------
  let scene = null, cam = null;
  let camCX = (MAP * T) / 2, camCY = (MAP * T) / 2;
  let selectedId = null;
  // Placement mode: { key, moveId|null, tx, ty, restore|null }
  let placing = null;
  let layer, ghostG, gridG;

  // Ground layers and building sprites. Everything static is composed once and
  // only recomposed when it changes; the per-frame work is villagers and (if
  // there is any) water.
  const art = TycoonArt.preload();           // grass/road/water start downloading now, overlapping Phaser's startup
  const TERRAIN_PX = 64;                     // canvas px per tile: crisp photo textures when zoomed in
  const WATER_PX = 32;                       // water is softer and animated, so it gets a smaller canvas
  const WATER_STEP_MS = 120;                 // ~8 fps; the source GIF is 10 and nobody can tell
  const bSprites = new Map();                // building id -> baked sprite
  const bLabels = new Map();                 // building id -> construction progress text
  let terrainPainter = null, waterPainter = null, terrainTex = null, waterTex = null, waterImg = null;
  let ghostImg = null;
  let waterClock = 0, waterFrame = 0;

  // Buildings flagged `cover` (the bank, the 7-Eleven) have real cover art. The pixel art is baked first so there is never
  // a blank frame; once the picture arrives it is drawn over the same canvas
  // (scaled to the footprint, sitting on the ground line) and the texture refreshed.
  // Cover buildings are baked at COVER_RES x the pixel-art size with smooth
  // filtering, so a photographic picture stays sharp instead of being squeezed
  // into a 32px canvas; their sprites are scaled back down by the same factor.
  const COVER_RES = 4;
  const coverScale = (key) => (DEFS[key] && DEFS[key].cover ? 1 / COVER_RES : 1);
  function paintCover(canvas, tex, small, src) {
    const ctx = canvas.getContext('2d');
    // Until the picture arrives, show the pixel art scaled up so there is never a blank frame.
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(small, 0, 0, canvas.width, canvas.height);
    tex.refresh();
    const img = new Image();
    img.onload = () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      const k = Math.min(canvas.width / img.width, canvas.height / img.height);
      const w = img.width * k, h = img.height * k;
      ctx.drawImage(img, (canvas.width - w) / 2, canvas.height - h, w, h);
      tex.refresh();
    };
    img.src = src;
  }

  // Bakes a building's art to a texture the first time it is needed, then
  // reuses it forever. The art code issues hundreds of 1px fillRects (that's
  // what the gradients are), and drawing them live every refresh was the
  // single biggest per-second cost.
  function ensureBaked(key) {
    const tk = 'bld_' + key;
    if (!scene.textures.exists(tk)) {
      const f = foot(key);
      const small = TycoonArt.bake(key, f.w, f.h);
      if (DEFS[key].cover) {
        const big = document.createElement('canvas');
        big.width = small.width * COVER_RES; big.height = small.height * COVER_RES;
        const tex = scene.textures.addCanvas(tk, big);
        tex.setFilter(Phaser.Textures.FilterMode.LINEAR);
        paintCover(big, tex, small, DEFS[key].img);
      } else {
        scene.textures.addCanvas(tk, small);
      }
    }
    return tk;
  }

  // Villagers are the village's thermometer, not simulated citizens: how many
  // there are and what they wear is read off the economy. They wander, and
  // they prefer roads. Driven by Phaser's own update() at ~60fps — the old
  // version stepped off the 1s economy interval, which is what made every
  // movement look like a stutter.
  const villagers = [];
  let villagerG = null;
  let mood = 50;
  const WALK = 1.3; // tiles per second

  const villagerCap = () => Math.min(MAX_VILLAGERS, housingTotal());
  let simT = 0;                                  // simulation seconds, drives dwell times
  const insideCount = (id) => { let n = 0; for (const v of villagers) if (v.inside === id) n++; return n; };
  const homeCount = (id) => { let n = 0; for (const v of villagers) if (v.home === id) n++; return n; };
  const walkable = (tx, ty) =>
    tx >= 0 && ty >= 0 && tx < MAP && ty < MAP &&
    occGrid[ty * MAP + tx] === 0 && tileGrid[ty * MAP + tx] !== TILE_ID.water;

  // A villager has width, so standing is judged on the corners of a small
  // footprint rather than the single centre point. Checking only the centre
  // let them walk right up to a shoreline with half their body over the
  // water, and straddle building edges.
  const FOOT_X = 0.2, FOOT_Y = 0.12;
  const canStand = (x, y) =>
    walkable(Math.floor(x - FOOT_X), Math.floor(y - FOOT_Y)) &&
    walkable(Math.floor(x + FOOT_X), Math.floor(y - FOOT_Y)) &&
    walkable(Math.floor(x - FOOT_X), Math.floor(y + FOOT_Y)) &&
    walkable(Math.floor(x + FOOT_X), Math.floor(y + FOOT_Y));

  // How attractive a tile is to wander onto. Deliberately mild — it only
  // tilts the odds of a random heading, so they still drift about sporadically
  // instead of marching along streets.
  const ZONES = { residential: 1, commercial: 1, industrial: 1, agricultural: 1 };
  function tileAppeal(tx, ty) {
    const t = getTileType(tx, ty);
    if (t === 'road') return 3.0;
    if (ZONES[t]) return 2.0;
    // Grass beside a road or a district still counts for something: that's the
    // verge people actually walk along.
    for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
      const n = getTileType(tx + dx, ty + dy);
      if (n === 'road') return 1.4;
      if (ZONES[n]) return 0.9;
    }
    return 0;
  }

  // Picks a new heading at random, weighting each direction by what lies a
  // couple of tiles that way. Anything that would put them in water or a
  // building gets zero weight; if every direction is blocked they just pick
  // one at random and wait it out.
  // `drift` keeps the candidates within the same ±0.7 rad wobble the old
  // random walk used, so the movement reads the same; without it (blocked, or
  // a fresh spawn) any direction is on the table.
  function pickHeading(v, drift) {
    const options = [];
    let total = 0;
    const base = Math.atan2(v.vy, v.vx);
    const here = tileAppeal(Math.floor(v.x), Math.floor(v.y));
    for (let i = 0; i < 10; i++) {
      const a = drift ? base + (Math.random() - 0.5) * 1.4 : Math.random() * Math.PI * 2;
      const cx = Math.cos(a), cy = Math.sin(a);
      const near = canStand(v.x + cx * 0.6, v.y + cy * 0.6);
      const far = canStand(v.x + cx * 1.6, v.y + cy * 1.6);
      if (!near) continue;
      // Appeal is read at two distances so a road a step away counts as well
      // as one two tiles off, and averaged so neither dominates.
      const appeal = (tileAppeal(Math.floor(v.x + cx * 0.9), Math.floor(v.y + cy * 0.9)) +
                      tileAppeal(Math.floor(v.x + cx * 1.8), Math.floor(v.y + cy * 1.8))) / 2;
      let w = (far ? 1 : 0.35) + appeal;
      // Once on a road or in a district, heading for bare grass is less
      // likely — enough that they hang around streets, not so much that they
      // stop wandering.
      if (here > 0.8 && appeal === 0) w *= 0.45;
      // A power curve widens the gap between "on a road" and "bare grass"
      // without touching the ordering, which a straight sum barely did.
      w = Math.pow(w, 1.5);
      options.push({ cx, cy, w });
      total += w;
    }
    if (!options.length) {
      const a = Math.random() * Math.PI * 2;
      return { cx: Math.cos(a), cy: Math.sin(a), stuck: true };
    }
    let r = Math.random() * total;
    for (const o of options) { r -= o.w; if (r <= 0) return o; }
    return options[options.length - 1];
  }

  // ---- Getting around: shortest path over walkable tiles, roads preferred ----
  // The map is 16x16, so a plain Dijkstra over 256 nodes is instant and is only
  // run when a villager sets off on a trip (every several seconds each).
  const stepCost = (i) => (tileGrid[i] === TILE_ID.road ? 1 : 2.2);
  function findPath(sx, sy, goals) {
    const N = MAP * MAP;
    const start = sy * MAP + sx;
    if (!walkable(sx, sy)) return null;
    const dist = new Float32Array(N).fill(Infinity), prev = new Int16Array(N).fill(-1), done = new Uint8Array(N);
    dist[start] = 0;
    for (;;) {
      let u = -1, best = Infinity;
      for (let i = 0; i < N; i++) if (!done[i] && dist[i] < best) { best = dist[i]; u = i; }
      if (u < 0) return null;
      if (goals.has(u)) {
        const path = [];
        for (let c = u; c !== -1; c = prev[c]) path.push(c);
        return path.reverse();                       // starts on the villager's own tile
      }
      done[u] = 1;
      const ux = u % MAP, uy = (u / MAP) | 0;
      for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
        const nx = ux + dx, ny = uy + dy;
        if (!walkable(nx, ny)) continue;
        const n = ny * MAP + nx;
        if (done[n]) continue;
        const d = dist[u] + stepCost(n);
        if (d < dist[n]) { dist[n] = d; prev[n] = u; }
      }
    }
  }

  // The doorstep: any walkable tile edge-adjacent to the building.
  function entranceTiles(s) {
    const f = foot(s.key), out = [];
    const add = (x, y) => { if (walkable(x, y)) out.push({ x, y }); };
    for (let x = s.x; x < s.x + f.w; x++) { add(x, s.y - 1); add(x, s.y + f.h); }
    for (let y = s.y; y < s.y + f.h; y++) { add(s.x - 1, y); add(s.x + f.w, y); }
    return out;
  }

  // Where a villager would like to go next, weighted by what it is: home is a
  // regular stop, shops and food are popular, work is steady. Full buildings
  // (at capacity) are not options.
  function chooseDestination(v) {
    const opts = [];
    let total = 0;
    village.b.forEach((s) => {
      if (s.status !== 'complete' || s.id === v.lastVisited) return;
      const d = DEFS[s.key], cap = capacityOf(s.key);
      if (!cap || insideCount(s.id) >= cap) return;
      let w = 1.5;
      if (s.id === v.home) w = 2.2;
      else if (d.housing) w = 0.3;                       // other people's homes: rarely
      else if (d.distribution) w = 3;
      else if (d.zone === 'commercial') w = 2.5;
      else if (d.zone === 'industrial') w = 1.8;
      opts.push({ s, w }); total += w;
    });
    if (!opts.length) return null;
    let r = Math.random() * total;
    for (const o of opts) { r -= o.w; if (r <= 0) return o.s; }
    return opts[opts.length - 1].s;
  }

  function startTrip(v) {
    const s = chooseDestination(v);
    if (!s) return false;
    const goals = new Set(entranceTiles(s).map((t) => t.y * MAP + t.x));
    if (!goals.size) return false;
    const path = findPath(Math.floor(v.x), Math.floor(v.y), goals);
    if (!path) return false;
    v.trip = { id: s.id, path, i: 0 };
    return true;
  }

  // Which home a new resident takes: any finished residential building that
  // still has a free bed.
  function freeHome() {
    for (const s of village.b) {
      const h = housingOf(s);
      if (h && homeCount(s.id) < h) return s;
    }
    return null;
  }

  function spawnVillager() {
    const home = freeHome();
    if (!home) return;
    const door = entranceTiles(home);
    if (!door.length) return;
    const t = door[Math.floor(Math.random() * door.length)];
    const v = { x: t.x + 0.5, y: t.y + 0.5, vx: 0, vy: 0, pause: 0.2, home: home.id, inside: null, until: 0, trip: null, tripCool: 2 + Math.random() * 5, lastVisited: null };
    const h = pickHeading(v);
    v.vx = h.cx; v.vy = h.cy;
    villagers.push(v);
  }

  // Called whenever tiles or buildings change. A villager standing where water
  // (or a building) has just been painted would otherwise stay there, so move
  // each affected one to the nearest spot they can actually stand.
  function relocateVillagers() {
    for (let i = villagers.length - 1; i >= 0; i--) {
      const v = villagers[i];
      if (v.inside && !bById.get(v.inside)) v.inside = null;     // their building was removed: they step out
      if (v.trip && !bById.get(v.trip.id)) v.trip = null;
      if (v.inside || canStand(v.x, v.y)) continue;
      let found = null;
      search:
      for (let r = 1; r <= 8; r++) {
        for (let k = 0; k < 16; k++) {
          const a = (k / 16) * Math.PI * 2;
          const x = v.x + Math.cos(a) * r * 0.5, y = v.y + Math.sin(a) * r * 0.5;
          if (canStand(x, y)) { found = { x, y }; break search; }
        }
      }
      if (found) { v.x = found.x; v.y = found.y; v.pause = 0.3; v.trip = null; }
      else villagers.splice(i, 1);
    }
  }

  let spawnClock = 0;
  function stepVillagers(dt) {
    simT += dt;
    const want = villagerCap();
    // A home that is gone (or not finished) no longer houses anyone.
    villagers.forEach((v) => {
      if (v.home && !housingOf(bById.get(v.home) || {})) v.home = null;
      if (!v.home && Math.random() < dt) { const h = freeHome(); if (h) v.home = h.id; }
    });
    spawnClock += dt;
    if (villagers.length < want && spawnClock > 0.8) { spawnClock = 0; spawnVillager(); }
    while (villagers.length > want) {
      // Homeless first, then whoever is last; people inside leave with them.
      let idx = villagers.findIndex((v) => !v.home);
      if (idx < 0) idx = villagers.length - 1;
      villagers.splice(idx, 1);
    }

    villagers.forEach((v) => {
      // Inside a building: nothing moves until the stay is over, then they come
      // back out at the door.
      if (v.inside) {
        if (simT >= v.until) { v.lastVisited = v.inside; v.inside = null; v.pause = 0.25; v.tripCool = 3 + Math.random() * 6; }
        return;
      }
      if (v.pause > 0) { v.pause -= dt; return; }

      // On a trip: follow the path tile by tile, then go in.
      if (v.trip) {
        const t = v.trip;
        const target = bById.get(t.id);
        if (!target) { v.trip = null; return; }
        const wp = t.path[t.i];
        const wx = (wp % MAP) + 0.5, wy = ((wp / MAP) | 0) + 0.5;
        if (!walkable(wp % MAP, (wp / MAP) | 0)) { v.trip = null; return; }   // the way was blocked
        const dx = wx - v.x, dy = wy - v.y, d = Math.hypot(dx, dy);
        const step = WALK * 1.15 * dt;
        if (d <= step) {
          v.x = wx; v.y = wy;
          t.i++;
          if (t.i >= t.path.length) {
            v.trip = null;
            if (insideCount(target.id) < capacityOf(target.key)) {
              v.inside = target.id;
              v.until = simT + (target.id === v.home ? 8 + Math.random() * 12 : 4 + Math.random() * 8);
            } else v.pause = 0.4;   // it filled up while they walked: turn away
          }
        } else { v.x += (dx / d) * step; v.y += (dy / d) * step; v.vx = dx / d; v.vy = dy / d; }
        return;
      }

      // Otherwise wander, and every so often decide to go somewhere.
      v.tripCool -= dt;
      if (v.tripCool <= 0) {
        v.tripCool = 5 + Math.random() * 9;
        if (startTrip(v)) return;
      }
      // Roads are the nice place to be, so walking one is slower (lingering).
      const onRoad = getTileType(Math.floor(v.x), Math.floor(v.y)) === 'road';
      const speed = WALK * (onRoad ? 0.7 : 1);
      const nx = v.x + v.vx * speed * dt;
      const ny = v.y + v.vy * speed * dt;
      if (!canStand(nx, ny)) {
        // Turn and wait rather than reversing velocity, which used to leave
        // them vibrating against a wall forever.
        const h = pickHeading(v);
        v.vx = h.cx; v.vy = h.cy;
        v.pause = 0.2 + Math.random() * 0.5;
        return;
      }
      v.x = nx; v.y = ny;
      if (Math.random() < dt * 0.35) v.pause = 0.4 + Math.random() * 1.2;
      else if (Math.random() < dt * 0.55) {
        // Same sporadic drift as before, but the new heading is a weighted
        // pick, so it leans toward roads and districts rather than being
        // uniformly random.
        const h = pickHeading(v, true);
        if (!h.stuck) { v.vx = h.cx; v.vy = h.cy; }
      }
    });
  }

  // Tan head, a couple of pixels of clothing underneath. The coat color is the
  // only thing mood changes — the head stays skin-toned.
  function drawVillagers() {
    villagerG.clear();
    const coat = mood > 66 ? '#3f6fa8' : mood > 33 ? '#6b5a3f' : '#3a3a3a';
    villagers.forEach((v) => {
      if (v.inside) return;                        // indoors: not on the map
      const px = Math.round(v.x * T), py = Math.round(v.y * T);
      rect(villagerG, '#000000', px - 1, py + 4, 3, 1, 0.3);
      rect(villagerG, '#d9a877', px - 1, py - 2, 3, 3);
      rect(villagerG, coat, px - 1, py + 1, 3, 2);
    });
  }

  function clampCam() {
    const vw = cam.width / cam.zoom, vh = cam.height / cam.zoom;
    const wW = MAP * T, wH = MAP * T, pad = 24;
    camCX = vw >= wW + pad * 2 ? wW / 2 : Math.max(vw / 2 - pad, Math.min(wW + pad - vw / 2, camCX));
    camCY = vh >= wH + pad * 2 ? wH / 2 : Math.max(vh / 2 - pad, Math.min(wH + pad - vh / 2, camCY));
    cam.centerOn(camCX, camCY);
  }
  function fitZoom() {
    const z = Math.min(cam.width / (MAP * T + 48), cam.height / (MAP * T + 48));
    return Math.max(0.5, z);
  }
  function recenter() {
    camCX = (MAP * T) / 2; camCY = (MAP * T) / 2;
    cam.setZoom(fitZoom());
    clampCam();
  }
  function setZoom(z) {
    const min = fitZoom() * 0.75;
    cam.setZoom(Math.max(min, Math.min(8, z)));
    clampCam();
  }

  function refresh() {
    if (!scene) return;
    const now = Date.now();
    mood = computeMood();
    // Tiles or buildings may have just changed under someone's feet.
    relocateVillagers();
    // Only the cheap dynamic overlays are redrawn here (scaffolds, warning
    // badges, selection). The buildings themselves are persistent sprites.
    layer.clear();
    let totalProduction = 0, totalUpkeep = 0, onRoadCount = 0;
    const live = new Set();

    village.b.forEach((s) => {
      const def = DEFS[s.key];
      if (!def) return;
      live.add(s.id);
      const f = foot(s.key);
      const ox = s.x * T, oy = s.y * T, w = f.w * T, h = f.h * T;
      const moving = !!(placing && placing.moveId === s.id);

      let sp = bSprites.get(s.id);
      if (!sp) {
        sp = scene.add.image(0, 0, ensureBaked(s.key)).setOrigin(0, 0).setScale(coverScale(s.key));
        bSprites.set(s.id, sp);
      }
      sp.setPosition(ox, oy - TycoonArt.PAD_TOP);
      sp.setDepth(10 + s.y + f.h);               // lower buildings overlap the ones behind them

      let tag = '';
      let tint = 0xffffff;
      if (s.status === 'building') {
        sp.setVisible(false);
        if (!moving) {
          const pct = Math.min(100, Math.round(((now - s.startedAt) / (s.completesAt - s.startedAt)) * 100));
          rect(layer, '#000000', ox + 2, oy + h - 3, w - 2, 4, 0.28);
          TycoonArt.drawScaffold(layer, ox, oy, w, h, pct);
          tag = `${pct}%`;
        }
      } else {
        sp.setVisible(!moving);
        totalProduction += productionFor(s, mood);
        totalUpkeep += def.cost * (def.upkeepPct || 0);
        const connected = isRoadConnected(s);
        if (connected) onRoadCount++;
        if (!moving) {
          if (s.taxDebt > 0) {
            tint = 0x7a7a7a;
            rect(layer, '#ff4444', ox + w - 5, oy + 1, 4, 4);
          }
          // The single most important piece of feedback on the map: a building
          // with no road touching it earns nothing, and says so.
          if (!connected) {
            tint = tint === 0xffffff ? 0xb0b0b0 : 0x606060;
            const bx = ox + w / 2 - 5, by = oy + h / 2 - 3;
            rect(layer, '#ff3b3b', bx, by, 10, 6);
            rect(layer, '#000000', bx + 2, by + 2, 6, 2);
          }
        }
      }
      if (tint !== 0xffffff) sp.setTint(tint); else sp.clearTint();

      if (!moving && s.id === selectedId) {
        layer.lineStyle(1, hex('#ffd700'), 1);
        layer.strokeRect(ox - 0.5, oy - 0.5, w + 1, h + 1);
      }

      // Progress text is pooled: one per constructing building, created once.
      let lb = bLabels.get(s.id);
      if (tag) {
        if (!lb) {
          lb = scene.add.text(0, 0, '', { fontFamily: 'monospace', fontSize: '8px', color: '#ffffff', stroke: '#000000', strokeThickness: 2 });
          lb.setOrigin(0.5).setResolution(4).setDepth(45);
          bLabels.set(s.id, lb);
        }
        lb.setPosition(ox + w / 2, oy + h / 2).setText(tag).setVisible(true);
      } else if (lb) {
        lb.setVisible(false);
      }
    });

    // Drop sprites and labels for buildings that no longer exist.
    for (const [id, sp] of bSprites) if (!live.has(id)) { sp.destroy(); bSprites.delete(id); }
    for (const [id, lb] of bLabels) if (!live.has(id)) { lb.destroy(); bLabels.delete(id); }

    drawGhost();

    const doneCount = village.b.filter((s) => s.status === 'complete').length;
    $('stat-production').textContent = Math.floor(totalProduction);
    $('stat-placed').textContent = village.b.length + '/' + slotCap();
    $('stat-building').textContent = buildingCount() + '/' + MAX_CONCURRENT;
    $('stat-road').textContent = onRoadCount + '/' + doneCount;
    $('stat-road').style.color = doneCount && onRoadCount < doneCount ? '#ff6b6b' : '';
    $('stat-mood').textContent = Math.round(mood) + '%';
    const fs = foodStats();
    $('stat-pop').textContent = fs.pop;
    $('stat-food').textContent = fs.demand ? `${Math.floor(fs.fed)}/${fs.demand}` : '—';
    $('stat-food').style.color = fs.demand && fs.satisfaction < 1 ? '#ff6b6b' : '';
    $('stat-upkeep').textContent = Math.floor(totalUpkeep);
    syncBalance();
    maybePushLeaderboardScore(totalProduction - (totalUpkeep / 1440));
  }

  const BOX_COLOR = { residential: '#2f6fd0', commercial: '#e08a1f', industrial: '#7b3fa0', agricultural: '#9aa32a', water: '#2b7fd4', erase: '#ff4444' };
  function drawGhost() {
    ghostG.clear();
    gridG.clear();
    if (rectDrag && brushMode) {
      // Faint grid so the box snaps visibly to tiles, then the box itself.
      gridG.lineStyle(1, 0xffffff, 0.14);
      for (let i = 0; i <= MAP; i++) {
        gridG.lineBetween(i * T, 0, i * T, MAP * T);
        gridG.lineBetween(0, i * T, MAP * T, i * T);
      }
      const plan = planRect(brushMode, rectDrag);
      const col = BOX_COLOR[brushMode] || '#ffffff';
      rect(ghostG, col, plan.x0 * T, plan.y0 * T, plan.w * T, plan.h * T, 0.38);
      ghostG.lineStyle(1.5, hex(col), 1);
      ghostG.strokeRect(plan.x0 * T + 0.5, plan.y0 * T + 0.5, plan.w * T - 1, plan.h * T - 1);
      ghostG.setDepth(61);
      return;
    }
    if (!placing) { if (ghostImg) ghostImg.setVisible(false); return; }
    // Faint tile grid while aiming.
    gridG.lineStyle(1, 0xffffff, 0.14);
    for (let i = 0; i <= MAP; i++) {
      gridG.lineBetween(i * T, 0, i * T, MAP * T);
      gridG.lineBetween(0, i * T, MAP * T, i * T);
    }
    if (placing.tx == null) { if (ghostImg) ghostImg.setVisible(false); return; }
    const f = foot(placing.key);
    const issue = placementIssue(placing.key, placing.tx, placing.ty, placing.moveId);
    const ok = issue === null;
    const ox = placing.tx * T, oy = placing.ty * T;
    if (!ghostImg) ghostImg = scene.add.image(0, 0, ensureBaked(placing.key)).setOrigin(0, 0).setDepth(60);
    ghostImg.setTexture(ensureBaked(placing.key)).setScale(coverScale(placing.key));
    ghostImg.setPosition(ox, oy - TycoonArt.PAD_TOP).setAlpha(ok ? 0.85 : 0.4).setVisible(true);
    ghostG.setDepth(61);
    rect(ghostG, ok ? '#00ff6a' : '#ff3b3b', ox, oy, f.w * T, f.h * T, ok ? 0.2 : 0.45);
    ghostG.lineStyle(1, hex(ok ? '#00ff6a' : '#ff3b3b'), 1);
    ghostG.strokeRect(ox + 0.5, oy + 0.5, f.w * T - 1, f.h * T - 1);
    const txt = $('place-bar-text');
    txt.textContent = ok ? `${DEFS[placing.key].label} — tap ✓ to place` : issueText(issue, placing.key);
    txt.classList.toggle('bad', !ok);
    $('place-confirm').disabled = !ok;
  }

  function tileFromPointer(pointer) {
    const wp = cam.getWorldPoint(pointer.x, pointer.y);
    return { tx: Math.floor(wp.x / T), ty: Math.floor(wp.y / T) };
  }

  function aimGhost(tx, ty) {
    if (!placing) return;
    const f = foot(placing.key);
    // The tapped tile becomes the building's centre-ish anchor, clamped inside the map.
    placing.tx = Math.max(0, Math.min(MAP - f.w, tx - Math.floor((f.w - 1) / 2)));
    placing.ty = Math.max(0, Math.min(MAP - f.h, ty - Math.floor((f.h - 1) / 2)));
    refresh();
  }

  function create() {
    scene = this;
    cam = this.cameras.main;

    // Ground: one canvas for grass + zones + roads (recomposed only when a tile
    // or footprint changes), and a separate small one for animated water.
    // Linear filtering here, unlike the pixel-art sprites, because these are
    // photographic textures.
    terrainTex = this.textures.createCanvas('terrain', MAP * TERRAIN_PX, MAP * TERRAIN_PX);
    terrainTex.setFilter(Phaser.Textures.FilterMode.LINEAR);
    this.add.image(0, 0, 'terrain').setOrigin(0, 0).setScale(T / TERRAIN_PX).setDepth(0);
    waterTex = this.textures.createCanvas('water', MAP * WATER_PX, MAP * WATER_PX);
    waterTex.setFilter(Phaser.Textures.FilterMode.LINEAR);
    waterImg = this.add.image(0, 0, 'water').setOrigin(0, 0).setScale(T / WATER_PX).setDepth(1).setVisible(false);
    terrainPainter = TycoonArt.createTerrainPainter({
      canvas: terrainTex.getCanvas(), map: MAP, px: TERRAIN_PX, images: art.images,
      getTile: getTileType, isCovered: (x, y) => occGrid[y * MAP + x] !== 0,
    });
    waterPainter = TycoonArt.createWaterPainter({
      canvas: waterTex.getCanvas(), map: MAP, px: WATER_PX, images: art.images, getTile: getTileType,
    });
    // First paint uses flat fallbacks so the plot is never blank; recompose with
    // the real textures as soon as they arrive.
    art.promise.then(() => { terrainDirty = true; waterDirty = true; });

    gridG = this.add.graphics().setDepth(2);
    layer = this.add.graphics().setDepth(40);
    villagerG = this.add.graphics().setDepth(50);
    ghostG = this.add.graphics().setDepth(61);
    this.input.addPointer(1);

    let down = null;
    this.input.on('pointerdown', (p) => {
      down = { x: p.x, y: p.y, t: performance.now(), moved: false };
      // Price the whole stroke off the balance at the moment it starts.
      if (brushMode && brushMode !== 'erase') { try { strokeBasis = Strubles.get(); } catch { strokeBasis = null; } }
      if (brushMode && RECT_BRUSHES.has(brushMode) && !placing && !this.input.pointer2.isDown) {
        const t = tileFromPointer(p);
        rectDrag = { x0: clampTile(t.tx), y0: clampTile(t.ty), x1: clampTile(t.tx), y1: clampTile(t.ty) };
        updateRect(t.tx, t.ty);
      }
    });
    this.input.on('pointermove', (p) => {
      if (!p.isDown || !down) return;
      // Dragging with a brush selected paints a stroke instead of panning —
      // tile-by-tile tapping to lay a road was unusable.
      if (brushMode && !this.input.pointer2.isDown) {
        down.moved = true;
        const t = tileFromPointer(p);
        if (RECT_BRUSHES.has(brushMode)) updateRect(t.tx, t.ty);
        else paintRoadTile(t.tx, t.ty);
        return;
      }
      if (rectDrag) { rectDrag = null; drawGhost(); } // a second finger turns it into a pinch
      const p1 = this.input.pointer1, p2 = this.input.pointer2;
      if (p1.isDown && p2.isDown) {
        // Pinch zoom
        const d = Phaser.Math.Distance.Between(p1.x, p1.y, p2.x, p2.y);
        if (down.pinch) setZoom(cam.zoom * (d / down.pinch));
        down.pinch = d;
        down.moved = true;
        return;
      }
      down.pinch = null;
      const dx = p.x - p.prevPosition.x, dy = p.y - p.prevPosition.y;
      if (!down.moved && Math.hypot(p.x - down.x, p.y - down.y) < 6) return;
      down.moved = true;
      camCX -= dx / cam.zoom;
      camCY -= dy / cam.zoom;
      clampCam();
    });
    const endStroke = () => { strokeBasis = null; flushSave(); if (brushMode) setBrushLabel(); };
    this.input.on('pointerupoutside', () => { rectDrag = null; drawGhost(); endStroke(); });
    this.input.on('pointerup', (p) => {
      try { handleUp(p); } finally { endStroke(); }
    });
    const handleUp = (p) => {
      if (rectDrag) {
        // Let go: apply the box (a plain tap is a one-tile box).
        const r = rectDrag;
        rectDrag = null; down = null;
        commitRect(r);
        refresh();
        return;
      }
      if (!down) return;
      const wasTap = !down.moved && performance.now() - down.t < 600;
      down = null;
      if (!wasTap) return;
      const { tx, ty } = tileFromPointer(p);
      if (placing) { aimGhost(tx, ty); return; }
      if (brushMode) { paintRoadTile(tx, ty); return; }
      const b = buildingAt(tx, ty);
      selectedId = b ? b.id : null;
      refresh();
      if (b) openManage(b.id);
    };
    this.input.on('wheel', (p, objs, dx, dy) => setZoom(cam.zoom * (dy > 0 ? 0.9 : 1.1)));
    this.scale.on('resize', () => clampCam());

    recenter();
    refresh();
  }

  // Phaser's own render loop. Only villagers animate here; village state is
  // never touched, so this can run every frame without saving anything.
  function update(time, delta) {
    if (!villagerG) return;

    // Recompose the ground at most once per frame, however many tiles were
    // painted since the last one -- a drag used to redraw per pointer-move.
    if (terrainDirty) {
      terrainDirty = false;
      terrainPainter.redraw();
      terrainTex.refresh();
    }
    if (waterDirty) {
      waterDirty = false;
      waterPainter.rescan();
      waterImg.setVisible(waterPainter.hasWater());
      waterClock = WATER_STEP_MS;            // draw a frame immediately
    }
    // Water is the only thing that animates on the ground, and only while a
    // water tile exists: no canvas redraw or GPU upload otherwise.
    if (waterPainter.hasWater()) {
      waterClock += delta;
      if (waterClock >= WATER_STEP_MS) {
        waterClock = 0;
        waterFrame = (waterFrame + 1) % waterPainter.frames;
        waterPainter.draw(waterFrame);
        waterTex.refresh();
      }
    }

    stepVillagers(Math.min(0.05, delta / 1000));
    drawVillagers();
  }

  new Phaser.Game({
    type: Phaser.AUTO,
    parent: 'game-stage',
    transparent: true,
    pixelArt: true,
    antialias: false,
    roundPixels: true,
    scale: { mode: Phaser.Scale.RESIZE, width: '100%', height: '100%' },
    scene: { create, update },
  });

  // ---------- Placement flow ----------
  const placeOverlay = $('place-overlay');
  const placeList = $('place-list');

  function startPlacing(key, moveId) {
    placing = { key, moveId: moveId || null, tx: null, ty: null };
    $('place-bar').classList.add('open');
    $('place-confirm').disabled = true;
    $('place-bar-text').textContent = `Tap the map to aim your ${DEFS[key].label}`;
    $('place-bar-text').classList.remove('bad');
    refresh();
  }
  function stopPlacing() {
    placing = null;
    $('place-bar').classList.remove('open');
    refresh();
  }

  // ---------- Icons ----------
  // Rows show the optimised thumbnail generated from the source art (see
  // scripts/build-tycoon-assets.py). A building without one -- the bank --
  // falls back to its own pixel art, rendered to a data URL once.
  const iconCache = {};
  function iconSrc(key) {
    const d = DEFS[key];
    if (d.icon) return d.icon;
    if (!iconCache[key]) { const f = foot(key); iconCache[key] = TycoonArt.bake(key, f.w, f.h).toDataURL(); }
    return iconCache[key];
  }
  const iconImg = (key) =>
    `<img class="row-img${DEFS[key].icon ? '' : ' pix'}" src="${iconSrc(key)}" alt="" width="44" height="44" decoding="async">`;
  const metaLine = (key) => {
    const d = DEFS[key];
    return `Cost ${d.cost.toLocaleString()} Strubles · builds in ${fmtDuration(d.buildMinutes)} · +${d.production}/min when done · Upkeep ${Math.floor(d.cost * (d.upkeepPct || 0))}/day`;
  };
  const zoneLine = (key) => {
    const f = foot(key), z = zoneOf(key);
    return `Needs ${f.w}×${f.h} <span class="zone-chip zone-${z}">${z}</span> zoning to build`;
  };
  function kindLabel(key, status) {
    const r = RARITY[DEFS[key].tier] || {};
    return `<small style="color:${r.color || ''}">${r.label || ''} · ${status}</small>`;
  }
  const modLine = (key) => {
    const m = DEFS[key].moodEffect || 0;
    return m ? `<small style="color:${m < 0 ? '#ff9b6b' : '#8be08b'}">${m < 0 ? '☁ Village mood ' : '♥ Village mood +'}${m}</small>` : '';
  };

  function pickBuilding(key) {
    if (village.b.length >= slotCap()) {
      alert(`Your village is full (${slotCap()} buildings). Buy more slots at the Bank, or remove a building first.`);
      return;
    }
    if (buildingCount() >= MAX_CONCURRENT) {
      alert(`Only ${MAX_CONCURRENT} buildings can be under construction at once — wait for one to finish first.`);
      return;
    }
    placeOverlay.classList.remove('open');
    startPlacing(key, null);
  }

  function openPlacePicker() {
    const avail = availableCounts(), owned = ownedCounts();
    placeList.innerHTML = '';
    const heading = (text) => {
      const h = document.createElement('div');
      h.className = 'picker-group';
      h.textContent = text;
      placeList.appendChild(h);
    };
    const addRow = (key, status, enabled) => {
      const def = DEFS[key];
      const row = document.createElement('div');
      row.className = 'picker-row' + (enabled ? '' : ' disabled');
      row.innerHTML = `${iconImg(key)}<div class="row-info">${def.label}${kindLabel(key, status)}<small>${metaLine(key)}</small><small>${zoneLine(key)}</small>${modLine(key)}${def.description ? `<small class="row-desc">${def.description}</small>` : ''}</div>`;
      if (enabled) row.addEventListener('click', () => pickBuilding(key));
      placeList.appendChild(row);
    };

    const own = ORDER.filter((k) => avail[k] > 0);
    if (!own.length) {
      const empty = document.createElement('div');
      empty.className = 'picker-empty';
      empty.innerHTML = "You don't own any unplaced buildings yet.<br>Win them from the <a href=\"/lootbox\" style=\"color:var(--gold)\">Iantopia Lootbox Basic</a>, or buy one in the Shop's Real Estate section.";
      placeList.appendChild(empty);
    } else {
      heading('Your buildings');
      own.forEach((k) => addRow(k, `own ${owned[k]}/${MAX_PER_TYPE} · ${avail[k]} unplaced`, true));
    }
    placeOverlay.classList.add('open');
  }

  function confirmPlacing() {
    if (!placing || placing.tx == null) return;
    const { key, moveId, tx, ty } = placing;
    if (placementIssue(key, tx, ty, moveId)) return;
    if (moveId != null) {
      const b = village.b.find((s) => s.id === moveId);
      if (b) { b.x = tx; b.y = ty; }
    } else {
      const def = DEFS[key];
      if (availableCounts()[key] <= 0) { alert(`You can't build any more of those.`); return; }
      if (!Strubles.spend(def.cost)) {
        alert(`Not enough Strubles for the permit (need ${def.cost.toLocaleString()}).`);
        return;
      }
      const now = Date.now();
      village.b.push({
        id: village.nextId++, key, x: tx, y: ty,
        status: 'building', startedAt: now,
        completesAt: now + def.buildMinutes * 60000,
        lastProductionAt: now,
        paid: def.cost,           // permit paid, refunded if the building is removed
      });
    }
    onBuildingsChanged();
    saveVillage();
    stopPlacing();
  }

  $('build-btn').addEventListener('click', () => { setBrush(null); openPlacePicker(); });
  $('place-confirm').addEventListener('click', confirmPlacing);
  $('place-cancel').addEventListener('click', stopPlacing);
  $('recenter-btn').addEventListener('click', () => { if (cam) recenter(); });

  // --- Brush: paint zones, roads and water. Zones are what a building is built
  // ON (its footprint must be zoned first) and hide once it is placed; roads
  // and water may not go under a building. ---
  const BRUSH_LABEL = {
    residential: 'Residential', commercial: 'Commercial', industrial: 'Industrial',
    agricultural: 'Farmland', road: 'Road', water: 'Water', erase: 'Erase',
  };
  let brushMsgTimer = null;
  // While a refusal ("Need 400 Strubles", "Can't go under a building") is
  // showing, nothing else may reset the label. endStroke() and the balance
  // listener both did, which wiped the message the instant a tap finished, so
  // it never actually appeared.
  let brushMsgActive = false;
  function brushMsg(text, bad) {
    const el = $('brush-bar-text');
    el.textContent = text;
    el.classList.toggle('bad', !!bad);
    brushMsgActive = true;
    clearTimeout(brushMsgTimer);
    brushMsgTimer = setTimeout(() => { brushMsgActive = false; setBrushLabel(); }, 1600);
  }
  // Zones, water and the eraser are dragged out as a box (see rectDrag below);
  // a road is laid freehand, tile by tile, because roads are lines.
  const RECT_BRUSHES = new Set(['residential', 'commercial', 'industrial', 'agricultural', 'water', 'erase']);
  function setBrushLabel() {
    if (!brushMode || brushMsgActive) return;
    const cost = tileCost(brushMode);
    const el = $('brush-bar-text');
    el.classList.remove('bad');
    if (brushMode === 'erase') el.textContent = 'Erase — drag a box over tiles to clear them. You get back what you paid.';
    else if (brushMode === 'road') el.textContent = `Road — ${cost.toLocaleString()} each, drag to lay a road`;
    else el.textContent = `${BRUSH_LABEL[brushMode]} — ${cost ? cost.toLocaleString() + ' per tile' : 'free'}, drag a box to fill an area`;
  }

  // What a painted tile cost, so erasing or replacing it can pay it back. Tiles
  // painted before this was tracked refund the base price.
  function refundForTile(x, y, type) {
    if (!TILE_BASE[type]) return 0;
    const v = village.paid && village.paid[x + '_' + y];
    return Number.isFinite(v) ? v : TILE_BASE[type];
  }
  const setPaid = (x, y, amount) => {
    const k = x + '_' + y;
    if (amount > 0) village.paid[k] = amount; else delete village.paid[k];
  };

  // Single road tile (freehand). Replacing a zone refunds that zone's price.
  function paintRoadTile(tx, ty) {
    if (brushMode !== 'road' || tx < 0 || ty < 0 || tx >= MAP || ty >= MAP) return;
    const existing = getTileType(tx, ty);
    if (existing === 'road') return;
    if (occGrid[ty * MAP + tx]) { brushMsg("Can't go under a building", true); return; }
    const cost = tileCost('road');
    const refund = existing ? refundForTile(tx, ty, existing) : 0;
    const net = cost - refund;
    if (net > 0 && !Strubles.spend(net)) { brushMsg(`Need ${net.toLocaleString()} Strubles`, true); return; }
    if (net < 0) Strubles.add(-net);
    setTileType(tx, ty, 'road');
    setPaid(tx, ty, cost);
    saveVillage(true); refresh();
  }

  // The box being dragged out: corners in tile coordinates, or null.
  let rectDrag = null;
  const clampTile = (v) => Math.max(0, Math.min(MAP - 1, v));

  // Works out what a box would do before it does it: the tiles that change,
  // what it costs, what comes back, and how many sit under a building (those
  // are never touched -- the zone beneath a building is what lets it stand).
  function planRect(mode, r) {
    const x0 = Math.min(r.x0, r.x1), x1 = Math.max(r.x0, r.x1);
    const y0 = Math.min(r.y0, r.y1), y1 = Math.max(r.y0, r.y1);
    const unit = (mode === 'erase' || mode === 'water') ? 0 : tileCost(mode);
    const plan = { changes: [], cost: 0, refund: 0, blocked: 0, w: x1 - x0 + 1, h: y1 - y0 + 1, x0, y0, x1, y1 };
    for (let y = y0; y <= y1; y++) {
      for (let x = x0; x <= x1; x++) {
        const cur = getTileType(x, y);
        if (mode === 'erase' ? !cur : cur === mode) continue;
        if (occGrid[y * MAP + x]) { plan.blocked++; continue; }
        if (cur) plan.refund += refundForTile(x, y, cur);
        if (mode === 'erase') plan.changes.push([x, y, null, 0]);
        else { plan.cost += unit; plan.changes.push([x, y, mode, unit]); }
      }
    }
    plan.net = plan.cost - plan.refund;
    return plan;
  }
  function describePlan(mode, plan) {
    const money = plan.net > 0 ? `${plan.net.toLocaleString()} Strubles`
      : plan.net < 0 ? `refund ${(-plan.net).toLocaleString()}` : 'free';
    const n = plan.changes.length;
    const extra = plan.blocked ? ` · ${plan.blocked} under buildings skipped` : '';
    return `${BRUSH_LABEL[mode]} — ${plan.w}×${plan.h} box · ${n} tile${n === 1 ? '' : 's'} · ${money}${extra}`;
  }
  function updateRect(tx, ty) {
    if (!rectDrag) return;
    rectDrag.x1 = clampTile(tx); rectDrag.y1 = clampTile(ty);
    const plan = planRect(brushMode, rectDrag);
    const el = $('brush-bar-text');
    el.classList.toggle('bad', plan.net > 0 && plan.net > Strubles.get());
    el.textContent = describePlan(brushMode, plan);
    brushMsgActive = false;
    drawGhost();
  }
  function commitRect(r) {
    const mode = brushMode;
    if (!mode || !r) return;
    const plan = planRect(mode, r);
    if (!plan.changes.length) {
      if (plan.blocked) brushMsg("Can't change tiles under a building", true);
      return;
    }
    if (plan.net > 0 && !Strubles.spend(plan.net)) { brushMsg(`Need ${plan.net.toLocaleString()} Strubles`, true); return; }
    if (plan.net < 0) Strubles.add(-plan.net);
    plan.changes.forEach(([x, y, type, paid]) => { setTileType(x, y, type); setPaid(x, y, paid); });
    saveVillage();
    brushMsg(plan.net < 0 ? `Refunded ${(-plan.net).toLocaleString()} Strubles` : describePlan(mode, plan));
  }

  function setBrush(mode) {
    brushMode = mode;
    rectDrag = null;
    document.querySelectorAll('[data-brush]').forEach((b) => {
      b.style.opacity = (mode && b.dataset.brush === mode) ? '0.55' : '1';
    });
    $('brush-bar').classList.toggle('open', !!mode);
    if (mode) { stopPlacing(); selectedId = null; setBrushLabel(); }
    refresh();
  }
  $('brush-done').addEventListener('click', () => setBrush(null));

  // Grouped so the three zone colours read as a category with a shared
  // purpose, instead of three unexplained buttons sitting next to Road.
  const ZONING_GROUPS = [
    { title: 'Infrastructure', rows: [
      { brush: 'road', icon: '🛣️', name: 'Road',
        blurb: 'Required. A building with no road touching one of its sides earns nothing at all. Roads also carry your villagers.' },
    ]},
    { title: 'Zones', rows: [
      { brush: 'residential', icon: '🏘️', name: 'Residential',
        blurb: 'Homes. Shabby Apartments, Generic Buildings and Pagodas can only be built on residential zoning.' },
      { brush: 'commercial', icon: '🏬', name: 'Commercial',
        blurb: 'Shops and offices. Skyscrapers, Taipei 101, Banks, Office Buildings, Grocery Stores and 7-Elevens can only be built on commercial zoning.' },
      { brush: 'agricultural', icon: '🌾', name: 'Farmland',
        blurb: 'Farms can only be built on farmland. They grow the food your residents eat; a Grocery Store or 7-Eleven then has to carry it to them.' },
      { brush: 'industrial', icon: '🏭', name: 'Industrial',
        blurb: 'Sweatshops, Factories and Power Plants can only be built on industrial zoning. It adds +15% to any building it touches, but drags village mood down — and mood scales all production from 0.75x to 1.15x.' },
    ]},
    { title: 'Terrain', rows: [
      { brush: 'water', icon: '💧', name: 'Water',
        blurb: 'Scenery. Lifts mood a little, and permanently blocks building on that tile until erased.' },
      { brush: 'erase', icon: '🧽', name: 'Erase',
        blurb: 'Drag a box to clear painted tiles. You get back what you paid for them. Tiles under a building are left alone.' },
    ]},
  ];

  function openZoning() {
    const list = $('zoning-list');
    list.innerHTML = '';
    ZONING_GROUPS.forEach((group) => {
      const h = document.createElement('div');
      h.style.cssText = 'font-size:9px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; margin:12px 0 4px;';
      h.textContent = group.title;
      list.appendChild(h);
      group.rows.forEach((r) => {
        const cost = tileCost(r.brush);
        const row = document.createElement('div');
        row.className = 'picker-row';
        row.innerHTML = `<div class="row-icon">${r.icon}</div><div class="row-info">${r.name}
          <small style="color:var(--gold)">${r.brush === 'erase' ? 'refunds what you paid' : !cost ? 'free' : cost.toLocaleString() + ' Strubles per tile · scales with your balance'}</small>
          <small class="row-desc">${r.blurb}</small></div>`;
        row.addEventListener('click', () => {
          $('zoning-overlay').classList.remove('open');
          setBrush(r.brush);
        });
        list.appendChild(row);
      });
    });
    $('zoning-overlay').classList.add('open');
  }
  $('zoning-btn').addEventListener('click', openZoning);
  wireClose('zoning-overlay', 'zoning-close');
  window.addEventListener('keydown', (e) => {
    if (!placing) return;
    if (e.key === 'Enter') { e.preventDefault(); confirmPlacing(); }
    else if (e.key === 'Escape') { e.preventDefault(); stopPlacing(); }
    else if (placing.tx != null && e.key.startsWith('Arrow')) {
      e.preventDefault();
      const dx = e.key === 'ArrowLeft' ? -1 : e.key === 'ArrowRight' ? 1 : 0;
      const dy = e.key === 'ArrowUp' ? -1 : e.key === 'ArrowDown' ? 1 : 0;
      const f = foot(placing.key);
      placing.tx = Math.max(0, Math.min(MAP - f.w, placing.tx + dx));
      placing.ty = Math.max(0, Math.min(MAP - f.h, placing.ty + dy));
      refresh();
    }
  });
  function wireClose(overlayId, closeId) {
    document.querySelectorAll(`#${overlayId}, #${closeId}`).forEach((el) => {
      el.addEventListener('click', (e) => {
        if (e.target.id === overlayId || e.target.id === closeId) $(overlayId).classList.remove('open');
      });
    });
  }
  wireClose('place-overlay', 'place-close');

  // ---------- Manage a placed building ----------
  const manageOverlay = $('manage-overlay');
  let manageId = null;

  function openManage(id) {
    const s = bById.get(id);
    if (!s) return;
    manageId = id;
    const def = DEFS[s.key];
    const dailyUpkeep = def.cost * (def.upkeepPct || 0);
    $('manage-title').textContent = def.label;
    const statusLine = s.status === 'building'
      ? 'Under construction — removing it loses the progress but refunds the permit.'
      : isRoadConnected(s) ? `Producing +${def.production}/min.` : 'No road touching it — not producing. Lay a road alongside.';
    let upkeepLine = '';
    if (s.status === 'complete') {
      upkeepLine = s.taxDebt > 0
        ? `<small style="color:#ff6b6b;">⚠ Neglected — owes ${Math.floor(s.taxDebt)} Strubles (half production until paid). Upkeep ${Math.floor(dailyUpkeep)}/day.</small>`
        : `<small>Upkeep ${Math.floor(dailyUpkeep)}/day, auto-paid from balance.</small>`;
    }
    $('manage-info').innerHTML = `<div class="guide-row">${iconImg(s.key)}<div class="row-info">${def.label} ${kindLabel(s.key, `${foot(s.key).w}×${foot(s.key).h} tiles`)}<small>${statusLine}</small>${upkeepLine}${modLine(s.key)}${def.description ? `<small class="row-desc">${def.description}</small>` : ''}</div></div>`;
    $('manage-info').innerHTML += peopleInfo(s, def);
    $('manage-bank').style.display = def.special === 'bank' && s.status === 'complete' ? '' : 'none';
    manageOverlay.classList.add('open');
  }
  // Residents / who is inside, and food, for the manage panel.
  function peopleInfo(s, def) {
    if (s.status !== 'complete') return '';
    const bits = [];
    if (def.housing) bits.push(`Residents ${homeCount(s.id)}/${def.housing} · inside now ${insideCount(s.id)}`);
    else if (def.capacity) bits.push(`Inside now ${insideCount(s.id)}/${def.capacity}`);
    const road = isRoadConnected(s);
    if (def.food) bits.push(`Grows ${def.food} food/min${road ? '' : ' — needs a road to deliver'}`);
    if (def.distribution) bits.push(`Distributes up to ${def.distribution} food/min${road ? '' : ' — needs a road'}`);
    return bits.length ? `<div class="guide-row"><div class="row-info">${bits.map((b) => `<small>${b}</small>`).join('')}</div></div>` : '';
  }
  function closeManage() {
    manageOverlay.classList.remove('open');
    selectedId = null;
    refresh();
  }
  $('manage-move').addEventListener('click', () => {
    const s = bById.get(manageId);
    manageOverlay.classList.remove('open');
    if (!s) return;
    selectedId = null;
    startPlacing(s.key, s.id);
    placing.tx = s.x; placing.ty = s.y;
    refresh();
  });
  // Mil-Spec is this game's Common tier. Anything rarer asks first, because
  // getting another one back means another crate or a Real Estate purchase.
  $('manage-remove').addEventListener('click', () => {
    const s = bById.get(manageId);
    if (!s) return;
    const def = DEFS[s.key];
    const refund = Number.isFinite(s.paid) ? s.paid : def.cost;
    if (def.tier && def.tier !== 'mil_spec') {
      const rar = (RARITY[def.tier] || {}).label || def.tier;
      const ok = confirm(`Remove your ${def.label}?\n\nIt is a ${rar} building. You get ${refund.toLocaleString()} Strubles back and the building returns to your inventory, but you will need to zone and build it all over again.`);
      if (!ok) return;
    }
    village.b = village.b.filter((x) => x.id !== manageId);
    if (refund > 0) { try { Strubles.add(refund); } catch {} }
    onBuildingsChanged();
    saveVillage();
    closeManage();
  });
  $('manage-bank').addEventListener('click', () => { closeManage(); openBank(); });
  document.querySelectorAll('#manage-overlay, #manage-close').forEach((el) => {
    el.addEventListener('click', (e) => {
      if (e.target.id === 'manage-overlay' || e.target.id === 'manage-close') closeManage();
    });
  });

  // ---------- Building Guide ----------
  $('guide-btn').addEventListener('click', () => {
    const owned = ownedCounts();
    const list = $('guide-list');
    // The layout rules have to be stated somewhere — they're invisible
    // otherwise, and they're the whole game.
    list.innerHTML = `
      <div class="guide-row" style="align-items:flex-start;">
        <div class="row-icon">🗺️</div>
        <div class="row-info"><b>Zone first, then build.</b>
          <small>Every building must be built on the zoning it belongs to, and its whole footprint has to be painted with it before you can place it — Taipei 101 needs 3×3 commercial, a Pagoda 2×2 residential. Zones cost ${tileCost('residential').toLocaleString()} a tile right now, scaling with your balance. Once a building stands, the colour underneath disappears.</small></div>
      </div>
      <div class="guide-row" style="align-items:flex-start;">
        <div class="row-icon">🌾</div>
        <div class="row-info"><b>People and food.</b>
          <small>Residential buildings house residents; every building has a capacity for how many people can be inside at once. Villagers walk the roads to shops, work and home, and step inside while they are there. Each resident eats 1 food a minute: Farms grow it and Grocery Stores and 7-Elevens carry it to your residents, so you need both (and roads). A fed village is happier; a hungry one drags every building's output down through mood.</small></div>
      </div>
      <div class="guide-row" style="align-items:flex-start;">
        <div class="row-icon">↩️</div>
        <div class="row-info"><b>Drag to zone, refunds on removal.</b>
          <small>Pick a zone and drag a box across the map to fill an area; the price is shown before you let go. Erasing a zone, or removing a building, pays back what you paid. Removing anything above Mil-Spec asks you to confirm first.</small></div>
      </div>
      <div class="guide-row" style="align-items:flex-start;">
        <div class="row-icon">🛣️</div>
        <div class="row-info"><b style="color:#ff6b6b">Roads are required.</b>
          <small>A building with no road touching one of its sides earns nothing at all. Roads cost ${tileCost('road').toLocaleString()} Strubles a tile right now — the price rises as your balance does.</small></div>
      </div>
      <div class="guide-row" style="align-items:flex-start;">
        <div class="row-icon">🏭</div>
        <div class="row-info"><b>Industry is the dirty option.</b>
          <small>Industrial next door adds +${Math.round(INDUSTRIAL_BONUS * 100)}% to any building. Sweatshops, factories and power plants all drag village mood down — and mood scales everything from 0.75x to 1.15x.</small></div>
      </div>
      <div class="guide-row" style="align-items:flex-start;">
        <div class="row-icon">💧</div>
        <div class="row-info"><b>Water is scenery you can't build on.</b>
          <small>Free to paint, lifts mood a little, and permanently blocks that tile until you erase it.</small></div>
      </div>`;
    ALL_KEYS.forEach((key) => {
      const def = DEFS[key];
      const row = document.createElement('div');
      row.className = 'guide-row';
      const status = `own ${owned[key]}/${MAX_PER_TYPE}`;
      row.innerHTML = `${iconImg(key)}<div class="row-info">${def.label} ${kindLabel(key, status)}<small>${metaLine(key)}</small><small>${zoneLine(key)}</small>${modLine(key)}${def.description ? `<small class="row-desc">${def.description}</small>` : ''}</div>`;
      list.appendChild(row);
    });
    $('guide-overlay').classList.add('open');
  });
  wireClose('guide-overlay', 'guide-close');

  // ---------- Bank (unchanged behaviour: raises the wallet cap) ----------
  function renderBank() {
    const TB = window.TycoonBank;
    const level = TB.currentLevel();
    const bankCap = TB.capForLevel(level);
    const taipei = TB.taipeiBonus();
    $('bank-cap-breakdown').innerHTML = `
      <div class="bank-cap-row"><span>Bank (level ${level})</span><span>${bankCap.toLocaleString()} Strubles</span></div>
      <div class="bank-cap-row"><span>Taipei 101 bonus</span><span>+${taipei.toLocaleString()} Strubles</span></div>
      <div class="bank-cap-row"><span><b>Total cap</b></span><span><b>${(bankCap + taipei).toLocaleString()} Strubles</b></span></div>`;
    $('bank-next-info').textContent = `Next: Level ${level + 1} — costs ${TB.costForLevel(level + 1).toLocaleString()}, raises the cap by ${TB.capGainForLevel(level + 1).toLocaleString()}.`;
    // Raising the wallet cap needs a Bank building standing. Slots (below) stay
    // available regardless, otherwise a full village with no bank could never
    // free up the space to build one.
    const has = hasBank();
    $('bank-buy').disabled = !has;
    $('bank-buy').style.opacity = has ? '' : '0.4';
    $('bank-gate').style.display = has ? 'none' : 'block';
  }
  function openBank() { renderBank(); renderExpand(); $('bank-overlay').classList.add('open'); }
  $('bank-btn').addEventListener('click', openBank);
  $('bank-buy').addEventListener('click', () => {
    if (!hasBank()) return;
    const TB = window.TycoonBank;
    const level = TB.currentLevel();
    const cost = TB.costForLevel(level + 1);
    if (!Strubles.spend(cost)) {
      alert(`Not enough Strubles for the next level (need ${cost.toLocaleString()}).`);
      return;
    }
    localStorage.setItem(TB.BANK_LEVEL_KEY, String(level + 1));
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
    renderBank();
    syncBalance();
  });
  wireClose('bank-overlay', 'bank-close');

  // ---------- Building slots ----------
  function renderExpand() {
    const owned = slotsOwned();
    $('expand-info-breakdown').innerHTML = `
      <div class="bank-cap-row"><span>Building slots</span><span>${BASE_SLOTS + owned}</span></div>
      <div class="bank-cap-row"><span>Slots purchased</span><span>${owned}</span></div>`;
    $('expand-next-info').textContent = `Next: slot ${BASE_SLOTS + owned + 1} — costs ${expandCostForSlot(owned + 1).toLocaleString()} Strubles.`;
  }
  $('expand-buy').addEventListener('click', () => {
    const owned = slotsOwned();
    const cost = expandCostForSlot(owned + 1);
    if (!Strubles.spend(cost)) {
      alert(`Not enough Strubles for the next slot (need ${cost.toLocaleString()}).`);
      return;
    }
    localStorage.setItem(SLOTS_KEY, String(owned + 1));
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
    renderExpand();
    refresh();
    syncBalance();
  });

  window.addEventListener('inventory:changed', () => refresh());
  window.addEventListener('strubles:change', syncBalance);
  // Tile prices track the balance, so keep the price in the brush bar current
  // between strokes (mid-stroke it is deliberately held steady).
  window.addEventListener('strubles:change', () => { if (brushMode && strokeBasis == null) setBrushLabel(); });
  window.addEventListener('storage', (e) => {
    if (e.key === VILLAGE_KEY) { village = loadVillage(); rebuildTileGrid(); onBuildingsChanged(); refresh(); }
    if (e.key === INV_KEY) refresh();
  });
  // Cloud pull reloads the page itself, so no extra reconcile hook is needed.
  // A brush stroke defers its write; make sure a hidden tab or closing page
  // doesn't strand it.
  document.addEventListener('visibilitychange', () => { if (document.hidden) flushSave(); });
  window.addEventListener('pagehide', flushSave);

  // ---------- Sound (same pattern as every other page) ----------
  let audioEnabled = true;
  const themeMusic = $('theme-music');
  const VOLUME_KEY = 'music_volume_v1';
  const volumeSlider = $('volume-slider');
  const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
  themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.3;
  volumeSlider.value = Math.round(themeMusic.volume * 100);
  volumeSlider.addEventListener('input', () => {
    themeMusic.volume = volumeSlider.value / 100;
    localStorage.setItem(VOLUME_KEY, themeMusic.volume);
  });
  function tryPlayTheme() { if (audioEnabled) themeMusic.play().catch(() => {}); }
  tryPlayTheme();
  const unlockTheme = () => {
    tryPlayTheme();
    window.removeEventListener('pointerdown', unlockTheme);
    window.removeEventListener('keydown', unlockTheme);
  };
  window.addEventListener('pointerdown', unlockTheme);
  window.addEventListener('keydown', unlockTheme);
  $('mute-btn').addEventListener('click', () => {
    audioEnabled = !audioEnabled;
    $('mute-btn').textContent = audioEnabled ? '🔊' : '🔇';
    if (audioEnabled) tryPlayTheme(); else themeMusic.pause();
  });

  // ---------- Reconcile loop ----------
  if (tick()) saveVillage();
  setInterval(() => {
    if (tick()) saveVillage();
    refresh();
  }, 1000);

  // ---------- Leaderboard score push (unchanged) ----------
  let lastPushedNetProduction = null;
  let leaderboardPushInFlight = false;
  function maybePushLeaderboardScore(netProduction) {
    if (!window.CloudSync || !CloudSync.isSignedIn()) return;
    if (netProduction === lastPushedNetProduction || leaderboardPushInFlight) return;
    const user = CloudSync.currentUser;
    if (!user) return;
    leaderboardPushInFlight = true;
    firebase.firestore().collection('leaderboard').doc(user.uid).set({
      displayName: user.displayName || 'Anonymous Tycoon',
      netProduction: Math.round(netProduction * 1000) / 1000,
      updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
    }, { merge: true })
      .then(() => { lastPushedNetProduction = netProduction; })
      .catch((err) => console.error('[leaderboard] push failed:', err))
      .finally(() => { leaderboardPushInFlight = false; });
  }

  // Read-only introspection for QA (same idea as window.HorseGame).
  window.TycoonGame = {
    getState: () => ({
      village, slotCap: slotCap(), placing, brushMode, mood,
      zoom: cam && cam.zoom, villagers: villagers.length,
      villagerPos: villagers.map((v) => [v.x, v.y]),
      cost: { road: tileCost('road'), residential: tileCost('residential') },
      connected: village.b.filter((s) => s.status === 'complete' && isRoadConnected(s)).length,
    }),
  };

  if (window.initPickers) setTimeout(window.initPickers, 100);

  // Test hook for the browser suites; only exists in dev mode.
  if (!TYCOON_DISABLED) window.TycoonTest = { villagers, get village() { return village; }, foodStats, housingTotal, insideCount, homeCount, planRect, get cam() { return cam; }, T, MAP, tileFromPointer, setBrush, tileCost };
})();
</script>
</body>
</html>
