<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
<title>My Iantopia</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0a0c12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script is:inline src="/pwa.js?v=1" defer></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<!--
  is:global is REQUIRED here for the same reason as every other page: the
  overlay rows and the stage contents are built at runtime, so Astro's
  scoped data-astro-cid-* selectors would silently skip them.

  Rewritten (was a side-view PNG skyline in a one-row DOM grid) as a
  top-down pixel village on a Phaser 4 tile map. Every sprite is drawn
  procedurally with Graphics -- no image assets -- so the old /tycoon/*.png
  art is no longer used by this page.
-->
<style is:global>
  :root { --bg:#0f1115; --panel:#161c27; --ink:#e9eef9; --muted:#9fb0cf; --gold:#ffd700; }
  * { box-sizing:border-box; }
  html, body { margin:0; height:100%; }
  body {
    height:100dvh;
    display:flex; flex-direction:column;
    /* Resting default; pickers.js overwrites background-image when a
       background is chosen from the picker (saved per page). */
    background:#10261a url('/tycoon/sky-background.gif') center / cover no-repeat fixed;
    color:var(--ink);
    font-family: 'Press Start 2P', ui-monospace, 'Courier New', monospace;
    cursor:none; position:relative;
    overflow-x:hidden; overflow-y:auto;
    -webkit-user-select:none; user-select:none; -webkit-touch-callout:none;
    -webkit-tap-highlight-color:transparent;
  }

  /* Keeps the chrome readable over whatever background is picked, same as
     the dimming layer on the other pages. */
  body::before { content:''; position:fixed; inset:0; z-index:-1; background:rgba(0,0,0,.32); pointer-events:none; }
  /* pickers.js only toggles .show on this element; without a rule to match,
     a video-type background gets the class and never appears. */
  #bg-video { display:none; position:fixed; inset:0; width:100%; height:100%; object-fit:cover; z-index:-2; }
  #bg-video.show { display:block; }

  #strubles-badge{
    position:fixed; top:calc(15px + env(safe-area-inset-top)); left:calc(20px + env(safe-area-inset-left)); display:flex; align-items:center; gap:8px;
    background:#000; padding:8px 12px; border:3px solid var(--gold);
    font-weight:700; z-index:20;
  }
  #strubles-badge img{ width:28px; height:28px; }

  main {
    position:relative; z-index:2; max-width:1200px; width:100%; margin:0 auto;
    padding:16px 24px 16px; padding-top:calc(80px + env(safe-area-inset-top));
    flex:1 1 auto; min-height:0;
    display:flex; flex-direction:column;
  }

  header { flex:0 0 auto; display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; border-bottom:4px solid #000; padding-bottom:10px; flex-wrap:wrap; gap:10px; }
  header a { color:var(--gold); text-decoration:none; border:3px solid #000; padding:8px 12px; font-weight:700; background:#000; transition:background 0.2s; font-size:10px; cursor:none; }
  header a:hover { background:var(--gold); color:#000; }
  header button { color:var(--gold); background:#000; border:2px solid var(--gold); padding:4px 6px; cursor:none; transition:background 0.2s; }
  header button:hover { background:var(--gold); color:#000; }

  h1 {
    margin:0; font-size:clamp(13px,2.6vw,20px); letter-spacing:1px; color:var(--gold); font-weight:400;
    text-shadow: 2px 2px 0 #000; text-align:center; width:100%;
  }

  #stats-bar {
    flex:0 0 auto;
    display:flex; justify-content:center; gap:18px; flex-wrap:wrap;
    background:rgba(0,0,0,.55); border:2px solid var(--gold); padding:8px 14px;
    margin-bottom:12px; font-size:9px; color:#fff;
  }
  #stats-bar b { color:var(--gold); }

  #cta-row {
    flex:0 0 auto;
    display:flex; justify-content:center; align-items:center; gap:10px; flex-wrap:wrap;
    margin-bottom:12px;
  }
  .cta {
    color:var(--gold); background:#000; border:3px solid var(--gold);
    padding:10px 14px; font-size:11px; font-weight:700; cursor:none;
    font-family:inherit; text-decoration:none; transition:background .2s, color .2s;
    touch-action:manipulation;
  }
  .cta:hover { background:var(--gold); color:#000; }
  .cta.primary { background:var(--gold); color:#000; border-color:#000; }
  .cta.primary:hover { background:#ffe766; }

  .bank-cap-row { display:flex; justify-content:space-between; gap:10px; padding:8px 0; border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:10px; }
  .bank-cap-row:last-child { border-bottom:none; }
  .bank-cap-row span:last-child { color:var(--muted); }
  .bank-buy-row { margin-top:16px; display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
  .bank-buy-row p { margin:0; font-size:10px; color:var(--ink); line-height:1.7; }

  /* ---------- The village stage (Phaser canvas lives in here) ---------- */
  #game-stage {
    position:relative; flex:1 1 auto; min-height:300px;
    border:3px solid #000; outline:2px solid var(--gold); outline-offset:-2px;
    background:rgba(4,12,8,.34); overflow:hidden; touch-action:none;
  }
  #game-stage canvas { display:block; touch-action:none; }

  /* Appears while placing or moving a building: tap a tile to aim the
     ghost, then confirm. Same two-step flow on mouse and touch so a
     fat-finger tap can never drop a building somewhere unintended. */
  #place-bar {
    position:absolute; left:50%; bottom:12px; transform:translateX(-50%);
    display:none; align-items:center; gap:10px; flex-wrap:wrap; justify-content:center;
    background:rgba(0,0,0,.85); border:3px solid var(--gold); padding:10px 12px;
    z-index:5; max-width:calc(100% - 16px);
  }
  #place-bar.open { display:flex; }
  #place-bar-text { font-size:9px; color:var(--gold); line-height:1.6; }
  #place-bar-text.bad { color:#ff6b6b; }
  /* Same bar, pinned to the top of the stage so a brush stroke along the
     bottom edge of the map never lands on it. */
  #brush-bar {
    position:absolute; left:50%; top:12px; transform:translateX(-50%);
    display:none; align-items:center; gap:10px; flex-wrap:wrap; justify-content:center;
    background:rgba(0,0,0,.85); border:3px solid var(--gold); padding:10px 12px;
    z-index:5; max-width:calc(100% - 16px);
  }
  #brush-bar.open { display:flex; }
  #brush-bar-text { font-size:9px; color:var(--gold); line-height:1.6; }
  #brush-bar-text.bad { color:#ff6b6b; }
  .bar-btn {
    background:#000; color:var(--gold); border:3px solid var(--gold); padding:12px 14px;
    font-size:11px; font-weight:700; cursor:none; font-family:inherit; touch-action:manipulation;
  }
  .bar-btn:hover { background:var(--gold); color:#000; }
  .bar-btn.ok { border-color:#00ff6a; color:#00ff6a; }
  .bar-btn.ok:hover { background:#00ff6a; color:#000; }
  .bar-btn.ok:disabled { opacity:.35; pointer-events:none; }
  .bar-btn.no { border-color:#ff5555; color:#ff5555; }
  .bar-btn.no:hover { background:#ff5555; color:#000; }

  /* ---------- Overlays / modals (same system as every other page) ---------- */
  .overlay{
    position:fixed; inset:0; background:rgba(0,0,0,.85); z-index:100;
    display:none; align-items:center; justify-content:center; padding:20px;
  }
  .overlay.open{ display:flex; }
  .modal{
    width:min(420px,90vw); max-height:75vh; overflow-y:auto;
    background:#0a0a0a; border:3px solid var(--gold); padding:20px;
    box-shadow:0 0 20px rgba(255,215,0,.4);
  }
  .modal-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; gap:10px; }
  .modal-head h2{ margin:0; font-size:12px; color:var(--gold); font-weight:400; }
  .btn{
    color:var(--gold); text-decoration:none; border:3px solid var(--gold); padding:8px 12px;
    background:#000; font-size:9px; transition:background .2s, color .2s; cursor:none;
    font-family:inherit; letter-spacing:1px; text-transform:uppercase; touch-action:manipulation;
  }
  .btn:hover{ background:var(--gold); color:#000; }
  .picker-row { display:flex; align-items:center; padding:8px 0; border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:10px; gap:10px; cursor:pointer; }
  .picker-row:last-child { border-bottom:none; }
  .picker-row:hover { background:rgba(255,215,0,.08); }
  .row-icon { font-size:26px; width:40px; text-align:center; flex-shrink:0; }
  .picker-row .row-info, .guide-row .row-info { flex:1; line-height:1.6; }
  .row-info small { color:var(--muted); display:block; font-size:8px; }
  .row-info small.row-desc { font-style:italic; margin-top:3px; }
  .picker-empty { color:var(--muted); font-size:10px; padding:10px 0; line-height:1.8; text-align:center; }

  .guide-row {
    display:flex; align-items:center; gap:10px; padding:10px 0;
    border-bottom:1px solid rgba(255,215,0,0.2); color:var(--gold); font-size:10px;
  }
  .guide-row:last-child { border-bottom:none; }

  .volume-row{
    display:flex; align-items:center; gap:10px; margin-bottom:16px;
    padding-bottom:14px; border-bottom:1px solid rgba(255,215,0,0.3);
  }
  .volume-row input[type="range"]{ flex:1; accent-color:var(--gold); cursor:none; touch-action:none; padding:14px 0; }
  .volume-mute-btn{
    all:unset; cursor:none; font-size:16px; padding:4px 8px;
    border:1px solid var(--gold); background:#000;
  }

  @media (max-width:768px) {
    #stats-bar { font-size:8px; gap:10px; }
    main { padding-left:12px; padding-right:12px; }
    .cta { font-size:10px; padding:10px 10px; }
  }
</style>
</head>
<body>
  <video id="bg-video" autoplay muted loop playsinline></video>
  <div id="strubles-badge">
    <img src="/strubles.png" alt="Struble">
    <span id="bal">0</span>
  </div>

  <main>
    <header>
      <a href="/" title="Back to Iantopia">← Home</a>
      <h1>MY IANTOPIA</h1>
      <div style="display:flex; gap:4px;">
        <button id="now-playing" title="Music options">🎵</button>
        <button id="bg-btn" title="Change background">🖼️</button>
        <button id="cursor-btn" title="Change cursor">🖱️</button>
      </div>
    </header>

    <div id="out-of-order-banner" style="background:rgba(180,30,30,0.9); border:2px solid #ff4444; color:#fff; padding:12px 16px; margin-bottom:14px; text-align:center; font-weight:700; letter-spacing:0.5px; display:none; font-size:9px; line-height:1.8;">
      🚧 Village economy is paused while it's being rebuilt. To test it, run in console:<br><code style="background:#000; padding:4px 8px; border-radius:2px;">localStorage.setItem('tycoon_dev_mode','true'); location.reload();</code>
    </div>

    <div id="stats-bar">
      <span>Production: <b id="stat-production">0</b>/min</span>
      <span>Buildings: <b id="stat-placed">0/5</b></span>
      <span>Building: <b id="stat-building">0/3</b></span>
      <span>On a road: <b id="stat-road">0/0</b></span>
      <span>Mood: <b id="stat-mood">50%</b></span>
      <span>Upkeep: <b id="stat-upkeep">0</b>/day</span>
    </div>

    <!-- Five controls, not thirteen. The zoning brushes moved behind one
         Zoning panel that names and explains each one, and Slots folded into
         the Bank since both are "upgrades you buy". -->
    <div id="cta-row">
      <button id="build-btn" class="cta primary" type="button">🏗️ Build</button>
      <button id="zoning-btn" class="cta" type="button">🗺️ Zoning</button>
      <button id="bank-btn" class="cta" type="button">🏦 Bank</button>
      <button id="guide-btn" class="cta" type="button">📖 Guide</button>
      <button id="recenter-btn" class="cta" type="button">🎯 Center</button>
      <a id="lootbox-cta" class="cta" href="/lootbox">🎁 Buildings</a>
      <a id="leaderboard-cta" class="cta" href="/leaderboard">🏆 Ranks</a>
    </div>

    <div id="game-stage">
      <div id="brush-bar">
        <span id="brush-bar-text"></span>
        <button class="bar-btn no" id="brush-done" type="button">✕ Done</button>
      </div>
      <div id="place-bar">
        <span id="place-bar-text"></span>
        <button class="bar-btn ok" id="place-confirm" type="button">✓ Place</button>
        <button class="bar-btn no" id="place-cancel" type="button">✕ Cancel</button>
      </div>
    </div>
  </main>

  <!-- Placement picker: which owned-but-unplaced building to build -->
  <div class="overlay" id="place-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Build</h2>
        <button class="btn" id="place-close" type="button">Close</button>
      </div>
      <div id="place-list"></div>
    </div>
  </div>

  <!-- Manage an already-placed building: move or remove it -->
  <div class="overlay" id="manage-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2 id="manage-title">Manage</h2>
        <button class="btn" id="manage-close" type="button">Close</button>
      </div>
      <div id="manage-info"></div>
      <div style="display:flex; gap:10px; margin-top:14px; flex-wrap:wrap;">
        <button class="btn" id="manage-move" type="button">✋ Move</button>
        <button class="btn" id="manage-remove" type="button">🗑️ Remove</button>
      </div>
    </div>
  </div>

  <!-- Zoning: every paintable tile, grouped by what it's for, so "Com"/"Ind"
       read as zoning laws rather than unlabelled coloured buttons. -->
  <div class="overlay" id="zoning-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Zoning</h2>
        <button class="btn" id="zoning-close" type="button">Close</button>
      </div>
      <p style="font-size:9px; color:var(--muted); line-height:1.8; margin:0 0 14px;">
        Pick a law, then drag across the map to apply it. Buildings earn nothing
        without a road, and earn more standing on the zone they want.
      </p>
      <div id="zoning-list"></div>
    </div>
  </div>

  <!-- Building Guide: every tier's stats + description, regardless of ownership -->
  <div class="overlay" id="guide-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Building Guide</h2>
        <button class="btn" id="guide-close" type="button">Close</button>
      </div>
      <div id="guide-list"></div>
    </div>
  </div>

  <!-- Bank: current wallet cap (Bank level + Taipei bonus, itemized) and the next level's cost -->
  <div class="overlay" id="bank-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Bank</h2>
        <button class="btn" id="bank-close" type="button">Close</button>
      </div>
      <p style="font-size:10px; color:var(--muted); line-height:1.7; margin:0 0 14px;">Strubles earned past your wallet cap don't accrue — spend down below the cap, or raise it here.</p>
      <div id="bank-cap-breakdown"></div>
      <div class="bank-buy-row">
        <p id="bank-next-info"></p>
        <button class="btn" id="bank-buy" type="button">Upgrade</button>
      </div>

      <!-- Building slots used to be their own button and modal. Both are
           "spend Strubles to raise a ceiling", so they live together now. -->
      <h2 style="font-size:12px; color:var(--gold); font-weight:400; margin:22px 0 10px; padding-top:16px; border-top:1px solid rgba(255,215,0,.25);">Building Slots</h2>
      <p style="font-size:10px; color:var(--muted); line-height:1.7; margin:0 0 14px;">How many buildings your village can hold. Each new slot costs roughly triple the last.</p>
      <div id="expand-info-breakdown"></div>
      <div class="bank-buy-row">
        <p id="expand-next-info"></p>
        <button class="btn" id="expand-buy" type="button">Purchase</button>
      </div>
    </div>
  </div>

  <!-- Music Playlist Modal -->
  <div class="overlay" id="playlist-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Now Playing</h2>
        <button class="btn" id="playlist-close" type="button">Close</button>
      </div>
      <div class="volume-row">
        <button class="volume-mute-btn" id="mute-btn" aria-label="Toggle sound" title="Toggle sound">🔊</button>
        <input type="range" id="volume-slider" min="0" max="100" value="30" aria-label="Music volume" />
      </div>
      <div id="playlist-list"></div>
    </div>
  </div>

  <!-- Background Picker Modal -->
  <div class="overlay" id="bg-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Backgrounds</h2>
        <button class="btn" id="bg-close" type="button">Close</button>
      </div>
      <div id="bg-list"></div>
    </div>
  </div>

  <!-- Cursor Picker Modal -->
  <div class="overlay" id="cursor-overlay">
    <div class="modal">
      <div class="modal-head">
        <h2>Cursors</h2>
        <button class="btn" id="cursor-close" type="button">Close</button>
      </div>
      <div id="cursor-list"></div>
    </div>
  </div>

  <audio id="theme-music" src="/audio/music/home-theme.mp3" preload="none" loop></audio>

<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<script is:inline src="/cloud-sync.js?v=10"></script>
<script is:inline src="/music-library.js?v=13"></script>
<script is:inline src="/music-position.js?v=1"></script>
<script is:inline src="/background-library.js?v=13"></script>
<script is:inline src="/cursor-library.js?v=4"></script>
<script is:inline src="/case-data.js?v=19"></script>
<script is:inline src="/tycoon-buildings.js?v=8"></script>
<script is:inline src="/cursor.js?v=3"></script>
<script is:inline src="/tycoon-bank.js?v=1"></script>
<script is:inline src="/strubles.js?v=3"></script>
<script is:inline>
  // What the page shows until a background is picked, and what "default" in
  // the picker resets to.
  window.PAGE_DEFAULT_BG = { type: 'gif', src: '/tycoon/sky-background.gif', label: 'Skyline', position: 'center' };
</script>
<script is:inline src="/pickers.js?v=11"></script>
<!-- Pinned exact version: Phaser 4 is new (Apr 2026), don't float it. -->
<script is:inline src="https://cdn.jsdelivr.net/npm/phaser@4.0.0/dist/phaser.min.js"></script>
<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);

  // Economy stays frozen outside dev mode until the server-authoritative
  // village save lands (see the rework plan, phase 3). Placing/moving still
  // works so the new map can be tried; production/tax/construction do not.
  const TYCOON_DISABLED = !localStorage.getItem('tycoon_dev_mode');
  $('out-of-order-banner').style.display = TYCOON_DISABLED ? 'block' : 'none';

  // ---------- Constants / data ----------
  const T = 16;                 // pixels per tile (world units)
  const MAP = 16;               // map is MAP x MAP tiles
  const BASE_SLOTS = 5;         // buildings allowed before buying more slots
  const VILLAGE_KEY = 'tycoon_village_v2';
  const LEGACY_GRID_KEY = 'tycoon_grid_v1';
  const LAST_SEEN_KEY = 'tycoon_last_seen_v1';
  const INV_KEY = 'strubles_inventory_v1';
  const SLOTS_KEY = 'tycoon_slots_owned_v1';
  const ORDER = window.TYCOON_BUILDING_ORDER || [];
  const DEFS = window.TYCOON_BUILDINGS || {};
  const MAX_PER_TYPE = window.TYCOON_MAX_PER_TYPE || 5;
  const MAX_CONCURRENT = window.TYCOON_MAX_CONCURRENT_BUILDS || 3;
  const RARITY = window.CASE_RARITIES || {};
  const EXPAND_BASE_COST = 200000;
  const EXPAND_GROWTH = 3;

  // Tile footprint + emoji for pickers (the old PNG art is no longer used).
  const LAYOUT = {
    shabby_apartment:   { w: 1, h: 1, icon: '🏚️' },
    generic_building:   { w: 2, h: 1, icon: '🏢' },
    pagoda:             { w: 2, h: 2, icon: '⛩️' },
    generic_skyscraper: { w: 2, h: 2, icon: '🏙️' },
    taipei_101:         { w: 3, h: 3, icon: '🗼' },
  };
  const foot = (key) => LAYOUT[key] || { w: 1, h: 1, icon: '🏠' };

  // ---------- Persistence ----------
  function loadJSON(k, fb) { try { const v = localStorage.getItem(k); return v != null ? JSON.parse(v) : fb; } catch { return fb; } }
  function saveJSON(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} }

  function slotsOwned() { return Math.max(0, Number(localStorage.getItem(SLOTS_KEY)) || 0); }
  function slotCap() { return BASE_SLOTS + slotsOwned(); }
  function expandCostForSlot(n) { return n <= 0 ? 0 : EXPAND_BASE_COST * Math.pow(EXPAND_GROWTH, n - 1); }

  // Village state: { v:2, nextId, b:[...buildings], tiles:{tx_ty: type} }
  // tiles map: "x_y" -> "residential"/"commercial"/"industrial"/"road"/"water"
  function freshVillage() { return { v: 2, nextId: 1, b: [], tiles: {} }; }

  // First load after the rework: carry the old one-row skyline's buildings
  // over (same construction progress, same keys) into a row on the new map
  // instead of silently dropping what players already built. The legacy key
  // is left untouched.
  function migrateLegacy() {
    const v = freshVillage();
    const old = loadJSON(LEGACY_GRID_KEY, null);
    if (!Array.isArray(old)) return v;
    let cx = 1;
    old.forEach((slot) => {
      if (!slot || !DEFS[slot.key]) return;
      const f = foot(slot.key);
      if (cx + f.w > MAP) return;
      v.b.push(Object.assign({}, slot, { id: v.nextId++, x: cx, y: MAP - 1 - f.h - 1 }));
      cx += f.w + 1;
    });
    return v;
  }

  function loadVillage() {
    const raw = loadJSON(VILLAGE_KEY, null);
    if (raw && raw.v === 2 && Array.isArray(raw.b)) return raw;
    const v = migrateLegacy();
    saveJSON(VILLAGE_KEY, v);
    return v;
  }
  function saveVillage() {
    saveJSON(VILLAGE_KEY, village);
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
  }

  let village = loadVillage();
  let brushMode = null;  // "residential" | "commercial" | "industrial" | "road" | "water" | null

  // Zoning is the layout puzzle: a building earns more standing on the zone
  // it wants, and nothing at all without a road touching it. Industrial is
  // the dirty option — it pays everyone nearby, and tanks village mood.
  const ZONE_AFFINITY = {
    shabby_apartment: 'residential',
    generic_building: 'residential',
    pagoda: 'commercial',
    generic_skyscraper: 'commercial',
    taipei_101: 'commercial',
  };
  // Tile prices scale with how many Strubles you're holding, so laying out a
  // district stays a real spend whether you have 500 or 500,000. Each type has
  // a floor (what a broke player pays) and a share of your balance per tile;
  // the price is whichever is higher. Water and erasing are always free.
  const TILE_BASE = { residential: 50, commercial: 50, industrial: 50, road: 100 };
  const TILE_RATE = { residential: 0.004, commercial: 0.004, industrial: 0.004, road: 0.008 };
  // Fixed for the length of one drag (see the pointerdown handler), so a
  // stroke is priced as a whole instead of getting cheaper tile by tile as
  // your balance drops underneath it.
  let strokeBasis = null;
  function tileCost(type) {
    if (!TILE_BASE[type]) return 0;
    let basis = strokeBasis;
    if (basis == null) { try { basis = Strubles.get(); } catch { basis = 0; } }
    const scaled = Math.round((basis * TILE_RATE[type]) / 5) * 5; // tidy multiples of 5
    return Math.max(TILE_BASE[type], scaled);
  }
  const ZONE_BONUS = 0.25;      // full footprint on its own zone
  const INDUSTRIAL_BONUS = 0.15; // adjacent industrial, at a mood cost

  // ---------- Inventory / counts ----------
  function ownedCounts() {
    const inv = loadJSON(INV_KEY, {});
    const list = Array.isArray(inv.buildings) ? inv.buildings : [];
    const counts = {};
    ORDER.forEach((k) => { counts[k] = 0; });
    list.forEach((k) => { if (counts[k] != null) counts[k]++; });
    return counts;
  }
  function placedCounts(excludeId) {
    const counts = {};
    ORDER.forEach((k) => { counts[k] = 0; });
    village.b.forEach((s) => { if (s.id !== excludeId && counts[s.key] != null) counts[s.key]++; });
    return counts;
  }
  function availableCounts() {
    const owned = ownedCounts(), placed = placedCounts();
    const avail = {};
    ORDER.forEach((k) => { avail[k] = Math.max(0, owned[k] - placed[k]); });
    return avail;
  }
  const buildingCount = () => village.b.filter((s) => s.status === 'building').length;

  // ---------- Economy tick ----------
  // The freeze bounds PAYOUT, not the passage of time. Returning early for
  // everything meant a building never left 'building' once its timer ran
  // out: it rendered at 100% forever, still counted against the 3 concurrent
  // builds, and after three of them no further building could be started at
  // all. Construction now always settles; only earning is gated.
  function tick() {
    const now = Date.now();
    const mood = computeMood();
    let earned = 0, changed = false;
    village.b.forEach((slot) => {
      const def = DEFS[slot.key];
      if (!def) return;
      if (slot.status === 'building' && now >= slot.completesAt) {
        slot.status = 'complete';
        slot.lastProductionAt = slot.completesAt;
        slot.lastTaxAt = slot.completesAt;
        slot.taxDebt = slot.taxDebt || 0;
        changed = true;
      }
      if (slot.status === 'complete' && TYCOON_DISABLED) {
        // Keep the clocks pinned while frozen, so lifting the freeze doesn't
        // pay out everything that "accrued" with the economy switched off.
        if (now - slot.lastProductionAt > 60000) {
          slot.lastProductionAt = now;
          slot.lastTaxAt = now;
          changed = true;
        }
      } else if (slot.status === 'complete') {
        if (slot.lastTaxAt == null) { slot.lastTaxAt = now; slot.taxDebt = 0; changed = true; }
        const eff = productionFor(slot, mood);
        if (eff <= 0) {
          // Unproductive time is forfeited, not banked — otherwise cutting a
          // building off the road network and reconnecting it a day later
          // would pay out that whole day at once.
          if (now - slot.lastProductionAt > 60000) { slot.lastProductionAt = now; changed = true; }
        } else {
          const elapsedMin = Math.max(0, now - slot.lastProductionAt) / 60000;
          const gain = Math.floor(elapsedMin * eff);
          if (gain > 0) {
            earned += gain;
            slot.lastProductionAt += (gain / eff) * 60000;
            changed = true;
          }
        }
        const dailyUpkeep = def.cost * (def.upkeepPct || 0);
        const elapsedTax = Math.max(0, now - slot.lastTaxAt) / 60000;
        const perMin = dailyUpkeep / 1440;
        const taxOwed = perMin > 0 ? Math.floor(elapsedTax * perMin) : 0;
        if (taxOwed > 0) {
          slot.taxDebt = (slot.taxDebt || 0) + taxOwed;
          slot.lastTaxAt += (taxOwed / perMin) * 60000;
          changed = true;
        }
      }
    });
    localStorage.setItem(LAST_SEEN_KEY, String(now));
    if (TYCOON_DISABLED) return changed;
    if (earned > 0) { try { Strubles.add(earned); } catch {} }
    village.b.forEach((slot) => {
      if (slot.status === 'complete' && slot.taxDebt > 0 && Strubles.spend(slot.taxDebt)) {
        slot.taxDebt = 0;
        changed = true;
      }
    });
    return changed;
  }

  // ---------- Map helpers ----------
  function inBounds(x, y, f) { return x >= 0 && y >= 0 && x + f.w <= MAP && y + f.h <= MAP; }
  function overlaps(a, b) {
    return a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;
  }
  // ignoreId lets a building being moved ignore its own old footprint.
  function canPlace(key, x, y, ignoreId) {
    const f = foot(key);
    if (!inBounds(x, y, f)) return false;
    for (let ty = y; ty < y + f.h; ty++) {
      for (let tx = x; tx < x + f.w; tx++) {
        if (getTileType(tx, ty) === 'water') return false;
      }
    }
    const rect = { x, y, w: f.w, h: f.h };
    return !village.b.some((s) => {
      if (s.id === ignoreId) return false;
      const sf = foot(s.key);
      return overlaps(rect, { x: s.x, y: s.y, w: sf.w, h: sf.h });
    });
  }
  // --- Layout rules. Every one of these is read by productionFor(), which is
  // the only place production is computed, so the stat bar and the payout can
  // never disagree. ---

  // Any tile of `type` orthogonally touching the footprint's edge.
  // Strictly orthogonal — a tile meeting only a diagonal corner does not count.
  function touchesTile(s, type) {
    const f = foot(s.key);
    for (let x = s.x; x < s.x + f.w; x++) {
      if (getTileType(x, s.y - 1) === type) return true;
      if (getTileType(x, s.y + f.h) === type) return true;
    }
    for (let y = s.y; y < s.y + f.h; y++) {
      if (getTileType(s.x - 1, y) === type) return true;
      if (getTileType(s.x + f.w, y) === type) return true;
    }
    return false;
  }
  const isRoadConnected = (s) => touchesTile(s, 'road');

  // Fraction of the footprint standing on the zone this building wants.
  function zoneMatch(s) {
    const want = ZONE_AFFINITY[s.key];
    if (!want) return 0;
    const f = foot(s.key);
    let hit = 0;
    for (let y = s.y; y < s.y + f.h; y++) {
      for (let x = s.x; x < s.x + f.w; x++) if (getTileType(x, y) === want) hit++;
    }
    return hit / (f.w * f.h);
  }

  function countZones(type) {
    let c = 0;
    for (const k in village.tiles) if (village.tiles[k] === type) c++;
    return c;
  }

  // Village mood, derived entirely from the layout — it is a readout of the
  // player's decisions, not an independent simulation.
  function computeMood() {
    const done = village.b.filter((s) => s.status === 'complete');
    if (!done.length) return 50;
    let m = 50;
    m += 30 * (done.filter(isRoadConnected).length / done.length);
    m += 20 * (done.reduce((a, s) => a + zoneMatch(s), 0) / done.length);
    const ind = countZones('industrial');
    const zoned = countZones('residential') + countZones('commercial') + ind;
    if (zoned > 0) m -= 25 * (ind / zoned);
    if (countZones('water') > 0) m += 8;
    return Math.max(0, Math.min(100, m));
  }
  const moodMultiplier = (mood) => 0.75 + (mood / 100) * 0.4; // 0.75x .. 1.15x

  function productionFor(s, mood) {
    const def = DEFS[s.key];
    if (!def || s.status !== 'complete') return 0;
    if (!isRoadConnected(s)) return 0; // no road, no business
    let p = def.production;
    p *= 1 + ZONE_BONUS * zoneMatch(s);
    if (touchesTile(s, 'industrial')) p *= 1 + INDUSTRIAL_BONUS;
    if (s.taxDebt > 0) p *= 0.5;
    return p * moodMultiplier(mood);
  }

  function buildingAt(tx, ty) {
    return village.b.find((s) => {
      const f = foot(s.key);
      return tx >= s.x && tx < s.x + f.w && ty >= s.y && ty < s.y + f.h;
    }) || null;
  }

  function syncBalance() { try { $('bal').textContent = Strubles.get().toLocaleString(); } catch {} }
  function fmtDuration(min) {
    if (min >= 1440) return (min / 1440).toFixed(min % 1440 === 0 ? 0 : 1) + 'd';
    if (min >= 60) return (min / 60).toFixed(min % 60 === 0 ? 0 : 1) + 'h';
    return min + 'm';
  }

  // ---------- Procedural pixel art (1 world px per art px, T=16 per tile) ----------
  const hex = (s) => parseInt(s.replace('#', ''), 16);
  function rect(g, color, x, y, w, h, alpha) {
    g.fillStyle(hex(color), alpha == null ? 1 : alpha);
    g.fillRect(x, y, w, h);
  }

  // --- Shading helpers. Everything below is still 1-world-pixel pixel art;
  // the gradients are literal stacks of 1px bands, not smooth fills, so the
  // result stays crisp under Phaser's nearest-neighbour scaling. ---
  function mix(c1, c2, t) {
    const a = hex(c1), b = hex(c2);
    const r = Math.round(((a >> 16) & 255) + ((((b >> 16) & 255) - ((a >> 16) & 255)) * t));
    const g = Math.round(((a >> 8) & 255) + ((((b >> 8) & 255) - ((a >> 8) & 255)) * t));
    const bl = Math.round((a & 255) + (((b & 255) - (a & 255)) * t));
    return (r << 16) | (g << 8) | bl;
  }
  // Vertical gradient, one 1px band per row.
  function vgrad(g, x, y, w, h, top, bottom, alpha) {
    for (let i = 0; i < h; i++) {
      g.fillStyle(mix(top, bottom, h <= 1 ? 0 : i / (h - 1)), alpha == null ? 1 : alpha);
      g.fillRect(x, y + i, w, 1);
    }
  }
  // Horizontal gradient — used for the lit/shadowed sides of a facade.
  function hgrad(g, x, y, w, h, left, right, alpha) {
    for (let i = 0; i < w; i++) {
      g.fillStyle(mix(left, right, w <= 1 ? 0 : i / (w - 1)), alpha == null ? 1 : alpha);
      g.fillRect(x + i, y, 1, h);
    }
  }
  // Stable per-tile pseudo-random so scenery doesn't crawl between redraws.
  const rnd = (x, y, salt) => {
    const n = Math.imul((x * 73856093) ^ (y * 19349663) ^ ((salt || 0) * 83492791), 2654435761) >>> 0;
    return n / 4294967296;
  };

  // Light comes from the upper-left throughout, so every facade has a lit
  // edge and a shadowed one and the roofs carry a top highlight.
  const ART = {
    shabby_apartment(g, ox, oy) {
      rect(g, '#1a0f08', ox + 1, oy + 3, 14, 12, 0.5);          // footing shadow
      vgrad(g, ox + 2, oy + 5, 12, 10, '#bb9468', '#6d4f33');   // brick body
      hgrad(g, ox + 2, oy + 5, 4, 10, '#d4ab7c', '#bb9468');    // lit left face
      rect(g, '#573a22', ox + 13, oy + 5, 1, 10);               // shadowed right edge
      for (let r = 0; r < 4; r++) rect(g, '#5d4028', ox + 2, oy + 7 + r * 2, 12, 1, 0.35); // courses
      vgrad(g, ox + 1, oy + 2, 14, 4, '#9c4b38', '#6d2f22');    // roof
      rect(g, '#c06a4e', ox + 1, oy + 2, 14, 1);                // roof highlight
      rect(g, '#3a1d14', ox + 1, oy + 5, 14, 1);                // eaves line
      [3, 10].forEach((wx) => {                                  // lit windows
        rect(g, '#2a1a10', ox + wx, oy + 8, 3, 3);
        vgrad(g, ox + wx, oy + 8, 3, 3, '#ffe9a8', '#e8a94c');
        rect(g, '#fff6d2', ox + wx, oy + 8, 1, 1);
      });
      vgrad(g, ox + 7, oy + 10, 3, 5, '#5e3a1e', '#3a2412');    // door
      rect(g, '#d7b06a', ox + 9, oy + 12, 1, 1);                // handle
      vgrad(g, ox + 11, oy - 1, 2, 4, '#7d7d7d', '#4e4e4e');    // chimney
      rect(g, '#cfcfcf', ox + 11, oy - 2, 2, 1, 0.5);           // smoke
    },

    generic_building(g, ox, oy) {
      rect(g, '#14171c', ox + 1, oy + 2, 30, 13, 0.5);
      vgrad(g, ox + 2, oy + 4, 28, 11, '#a7b0bd', '#5c6470');   // concrete
      hgrad(g, ox + 2, oy + 4, 6, 11, '#c3cad4', '#a7b0bd');    // lit side
      rect(g, '#464d58', ox + 29, oy + 4, 1, 11);
      vgrad(g, ox + 1, oy + 1, 30, 4, '#78818e', '#4a515c');    // parapet
      rect(g, '#99a2ae', ox + 1, oy + 1, 30, 1);
      rect(g, '#aeb7c2', ox + 4, oy, 5, 2);                     // roof box
      for (let r = 0; r < 2; r++) {                              // window bands
        for (let i = 0; i < 6; i++) {
          const wx = ox + 4 + i * 4, wy = oy + 6 + r * 4;
          rect(g, '#20262e', wx - 1, wy - 1, 4, 4, 0.55);
          vgrad(g, wx, wy, 3, 3, '#d8f0ff', '#6f9fc4');
          rect(g, '#ffffff', wx, wy, 1, 1, 0.8);
        }
      }
      vgrad(g, ox + 14, oy + 11, 4, 4, '#4a2c17', '#2c1a0e');   // entrance
      rect(g, '#ffd98a', ox + 13, oy + 10, 6, 1, 0.75);         // canopy light
    },

    pagoda(g, ox, oy) {
      rect(g, '#120d06', ox + 5, oy + 27, 22, 5, 0.5);
      vgrad(g, ox + 4, oy + 27, 24, 4, '#6d5436', '#3f2f1d');   // stone base
      rect(g, '#8a6c48', ox + 4, oy + 27, 24, 1);
      const tiers = [{ y: 20, w: 24, wall: 6 }, { y: 12, w: 18, wall: 6 }, { y: 4, w: 12, wall: 5 }];
      tiers.forEach((t) => {
        const x = ox + 16 - t.w / 2;
        vgrad(g, x + 2, oy + t.y + 3, t.w - 4, t.wall, '#f3e6c2', '#bda77c'); // plaster
        hgrad(g, x + 2, oy + t.y + 3, 3, t.wall, '#fff6dd', '#f3e6c2');
        for (let i = 0; i < 3; i++) rect(g, '#7c3b22', x + 4 + i * ((t.w - 8) / 2), oy + t.y + 4, 1, t.wall - 2, 0.6);
        vgrad(g, x - 3, oy + t.y, t.w + 6, 3, '#d4503a', '#7a1f16'); // flared roof
        rect(g, '#ef7a5e', x - 2, oy + t.y, t.w + 4, 1);
        rect(g, '#ffd700', x - 3, oy + t.y + 2, t.w + 6, 1);          // gold trim
        rect(g, '#b8911f', x - 3, oy + t.y + 3, t.w + 6, 1, 0.5);
        rect(g, '#ffd700', x - 3, oy + t.y + 1, 1, 2);                // upturned eaves
        rect(g, '#ffd700', x + t.w + 2, oy + t.y + 1, 1, 2);
      });
      vgrad(g, ox + 15, oy - 1, 2, 6, '#fff0a8', '#c9a21a');    // finial
      vgrad(g, ox + 14, oy + 23, 4, 5, '#6b3f1c', '#38200e');   // doorway
      rect(g, '#ffce6b', ox + 14, oy + 25, 4, 1, 0.5);
    },

    generic_skyscraper(g, ox, oy) {
      rect(g, '#0b1118', ox + 5, oy + 4, 23, 27, 0.5);
      vgrad(g, ox + 6, oy + 4, 20, 27, '#6ea6d8', '#1e3550');       // glass curtain
      hgrad(g, ox + 6, oy + 4, 5, 27, '#9fd0f2', '#6ea6d8', 0.55);  // lit face
      rect(g, '#16293d', ox + 25, oy + 4, 1, 27);                   // shadow edge
      vgrad(g, ox + 6, oy + 4, 20, 3, '#395d80', '#24405c');        // crown setback
      for (let r = 0; r < 6; r++) {                                  // window grid
        for (let c = 0; c < 4; c++) {
          const wx = ox + 8 + c * 5, wy = oy + 9 + r * 4;
          const lit = rnd(c, r, 7) > 0.45;
          rect(g, '#101d2b', wx - 1, wy - 1, 4, 3, 0.5);
          vgrad(g, wx, wy, 3, 2, lit ? '#ffeab0' : '#9fd0f2', lit ? '#d99a3a' : '#4d7ba6');
        }
      }
      rect(g, '#2a4055', ox + 6, oy + 30, 20, 1);                   // plinth
      vgrad(g, ox + 15, oy - 2, 2, 6, '#e3e9ef', '#8d949c');        // mast
      rect(g, '#ff4444', ox + 15, oy - 3, 2, 1);                    // beacon
    },
    taipei_101(g, ox, oy) {
      rect(g, '#0a1710', ox + 9, oy + 39, 30, 8, 0.5);
      vgrad(g, ox + 10, oy + 39, 28, 8, '#2c5a42', '#15301f');   // podium
      rect(g, '#3f7a5c', ox + 10, oy + 39, 28, 1);
      for (let i = 0; i < 8; i++) {                               // flared sections
        const w = i === 0 ? 14 : 12 + (i % 2 ? 4 : 0);
        const x = ox + 24 - w / 2;
        const y = oy + 36 - i * 4;
        vgrad(g, x, y, w, 4, '#49b584', '#1f6b4a');               // each tier lighter at its top
        hgrad(g, x, y, 3, 4, '#7fd9ae', '#49b584', 0.7);          // lit left edge
        rect(g, '#144a33', x + w - 1, y, 1, 4);                   // shadowed right edge
        rect(g, '#ffd700', x - 1, y + 3, w + 2, 1);               // gold band between tiers
        rect(g, '#9c7a12', x - 1, y + 4, w + 2, 1, 0.45);
        rect(g, '#dff4ff', x + 2, y + 1, 2, 2, 0.9);              // glazing
        rect(g, '#dff4ff', x + w - 4, y + 1, 2, 2, 0.9);
      }
      vgrad(g, ox + 18, oy + 2, 12, 4, '#49b584', '#246b4c');     // crown
      rect(g, '#ffd700', ox + 18, oy + 5, 12, 1);
      vgrad(g, ox + 23, oy - 3, 2, 6, '#f2f6fa', '#9aa3ab');      // spire
      rect(g, '#ff5555', ox + 23, oy - 4, 2, 1);                  // aircraft light
    },
  };

  // Scaffold look while a building is under construction.
  function drawScaffold(g, ox, oy, w, h, pct) {
    rect(g, '#000000', ox + 1, oy + 2, w - 2, h - 2, 0.35);
    for (let i = 0; i < w - 2; i += 4) rect(g, i % 8 === 0 ? '#ffd23f' : '#262626', ox + 1 + i, oy + 2, 4, 2);
    rect(g, '#262626', ox + 1, oy + 2, 2, h - 2);
    rect(g, '#262626', ox + w - 3, oy + 2, 2, h - 2);
    const fillH = Math.max(1, Math.floor(((h - 6) * pct) / 100));
    rect(g, '#b99b6b', ox + 3, oy + h - 2 - fillH, w - 6, fillH);
    rect(g, '#000000', ox + 1, oy + h - 1, w - 2, 1, 0.6);
  }

  function getTileType(x, y) { return village.tiles[x + '_' + y] || null; }
  function setTileType(x, y, type) {
    if (type) village.tiles[x + '_' + y] = type;
    else delete village.tiles[x + '_' + y];
    terrainDirty = true;
  }
  // The meadow and its zones are expensive to draw now that every tile is
  // shaded, and they only change when a tile is painted — so they are not
  // part of the once-a-second refresh.
  let terrainDirty = true;

  // Roads are autotiled off a 4-bit cardinal mask of their neighbours
  // (N=1,E=2,S=4,W=8), which is what makes a painted run read as one road
  // with proper corners, tees and junctions. Drawing every tile the same way
  // was why they looked unoriented: a corner and a straight were identical.
  function roadMask(x, y) {
    return (getTileType(x, y - 1) === 'road' ? 1 : 0)
         | (getTileType(x + 1, y) === 'road' ? 2 : 0)
         | (getTileType(x, y + 1) === 'road' ? 4 : 0)
         | (getTileType(x - 1, y) === 'road' ? 8 : 0);
  }

  function drawRoadTile(g, x, y, ox, oy) {
    const m = roadMask(x, y);
    const n = !!(m & 1), e = !!(m & 2), s = !!(m & 4), w = !!(m & 8);
    const HALF = T / 2, LANE = 12, EDGE = (T - LANE) / 2; // wide enough to read as a road

    // Asphalt with a pale kerb down each side of the carriageway.
    const armV = (ay, ah) => {
      vgrad(g, ox + EDGE, ay, LANE, ah, '#787d85', '#5e636b');
      rect(g, '#9aa0a8', ox + EDGE, ay, 1, ah);
      rect(g, '#43474e', ox + EDGE + LANE - 1, ay, 1, ah);
    };
    const armH = (ax, aw) => {
      vgrad(g, ax, oy + EDGE, aw, LANE, '#787d85', '#5e636b');
      rect(g, '#9aa0a8', ax, oy + EDGE, aw, 1);
      rect(g, '#43474e', ax, oy + EDGE + LANE - 1, aw, 1);
    };
    vgrad(g, ox + EDGE, oy + EDGE, LANE, LANE, '#787d85', '#5e636b'); // junction core
    if (n) armV(oy, HALF + 1);
    if (s) armV(oy + HALF - 1, HALF + 1);
    if (w) armH(ox, HALF + 1);
    if (e) armH(ox + HALF - 1, HALF + 1);
    if (!m) { // isolated tile: a little paved square rather than nothing
      rect(g, '#9aa0a8', ox + EDGE, oy + EDGE, LANE, 1);
      rect(g, '#43474e', ox + EDGE, oy + EDGE + LANE - 1, LANE, 1);
    }

    // Centre dashes only along a straight run; a junction gets a dot instead,
    // so turns don't look like a painted line running into a kerb.
    const straightV = n && s && !e && !w, straightH = e && w && !n && !s;
    if (straightV) { rect(g, '#e2dcae', ox + HALF - 1, oy + 1, 2, 5); rect(g, '#e2dcae', ox + HALF - 1, oy + 10, 2, 5); }
    else if (straightH) { rect(g, '#e2dcae', ox + 1, oy + HALF - 1, 5, 2); rect(g, '#e2dcae', ox + 10, oy + HALF - 1, 5, 2); }
    else if (m) rect(g, '#e2dcae', ox + HALF - 1, oy + HALF - 1, 2, 2);
  }

  function drawTerrain(g) {
    // Meadow: a soft vertical gradient per tile plus scattered tufts, clover
    // and the odd flower, all keyed off a stable hash so nothing crawls
    // between redraws.
    for (let y = 0; y < MAP; y++) {
      for (let x = 0; x < MAP; x++) {
        const ox = x * T, oy = y * T;
        // A shallow gradient only. A full light-to-dark ramp per tile turned
        // the whole meadow into horizontal stripes, because every tile
        // restarted the ramp at its own top edge.
        const t = rnd(x, y, 1);
        const top = t > 0.66 ? '#4e9a47' : t > 0.33 ? '#489340' : '#438c3c';
        vgrad(g, ox, oy, T, T, top, '#3d8137');
        const blades = 2 + Math.floor(rnd(x, y, 2) * 3);
        for (let i = 0; i < blades; i++) {
          const bx = ox + Math.floor(rnd(x + i, y, 3) * (T - 2)) + 1;
          const by = oy + Math.floor(rnd(x, y + i, 4) * (T - 4)) + 2;
          rect(g, '#5fb356', bx, by, 1, 2, 0.8);
          rect(g, '#2a5f28', bx + 1, by + 1, 1, 1, 0.5);
        }
        if (rnd(x, y, 5) > 0.93) {                               // wildflower
          const fx = ox + 3 + Math.floor(rnd(x, y, 6) * 9);
          const fy = oy + 3 + Math.floor(rnd(x, y, 7) * 9);
          rect(g, '#2a5f28', fx, fy + 1, 1, 2);
          rect(g, rnd(x, y, 8) > 0.5 ? '#ffe36b' : '#ff9ecb', fx, fy, 1, 1);
        }
      }
    }
    // Zones and features paint over the meadow. Each zone carries a shape as
    // well as a hue so they stay distinguishable at low zoom and without
    // relying on colour alone.
    for (let y = 0; y < MAP; y++) {
      for (let x = 0; x < MAP; x++) {
        const type = getTileType(x, y);
        if (!type) continue;
        const ox = x * T, oy = y * T;
        if (type === 'residential') {
          vgrad(g, ox, oy, T, T, '#3f86e8', '#1f4e9c', 0.4);
          rect(g, '#0d2a52', ox + 4, oy + 8, 8, 4, 0.55);        // house shadow
          vgrad(g, ox + 4, oy + 6, 8, 5, '#cfe6ff', '#7fb0e4');  // walls
          rect(g, '#9fd0ff', ox + 5, oy + 4, 6, 2);              // roof
          rect(g, '#e8f4ff', ox + 6, oy + 3, 4, 1);
        } else if (type === 'commercial') {
          vgrad(g, ox, oy, T, T, '#f0a63a', '#b06a12', 0.4);
          vgrad(g, ox + 3, oy + 4, 10, 7, '#ffe9c4', '#d99a4e'); // shopfront
          rect(g, '#b8651c', ox + 3, oy + 7, 10, 1);
          for (let i = 0; i < 5; i++) rect(g, i % 2 ? '#ffffff' : '#e05a3a', ox + 3 + i * 2, oy + 4, 2, 2); // awning
          rect(g, '#7a4a12', ox + 7, oy + 8, 3, 3);              // door
        } else if (type === 'industrial') {
          vgrad(g, ox, oy, T, T, '#8e52b5', '#5a2a7d', 0.44);
          for (let i = -T; i < T; i += 5) {                       // hazard hatching
            for (let j = 0; j < T; j++) {
              const px = ox + i + j;
              if (px >= ox && px < ox + T) rect(g, '#e8cfff', px, oy + j, 1, 1, 0.55);
            }
          }
          vgrad(g, ox + 4, oy + 5, 3, 7, '#b9a0c9', '#6a5480'); // chimney
          rect(g, '#d8c7e6', ox + 3, oy + 3, 5, 2, 0.75);        // smoke
        } else if (type === 'road') {
          drawRoadTile(g, x, y, ox, oy);
        } else if (type === 'water') {
          vgrad(g, ox, oy, T, T, '#2b6f9c', '#113b5c');          // depth
          const w1 = Math.floor(rnd(x, y, 9) * 6);
          rect(g, '#59a8d6', ox + 1 + w1, oy + 4, 6, 1, 0.75);   // ripples
          rect(g, '#59a8d6', ox + 7, oy + 9, 5, 1, 0.6);
          rect(g, '#b9e6ff', ox + 3 + w1, oy + 11, 3, 1, 0.8);   // glint
          rect(g, '#0d2b44', ox, oy + T - 1, T, 1, 0.5);
        }
      }
    }
    // Dirt border
    g.lineStyle(2, hex('#6b4a2e'), 1);
    g.strokeRect(-1, -1, MAP * T + 2, MAP * T + 2);
  }

  // ---------- Phaser scene ----------
  let scene = null, cam = null;
  let camCX = (MAP * T) / 2, camCY = (MAP * T) / 2;
  let selectedId = null;
  // Placement mode: { key, moveId|null, tx, ty, restore|null }
  let placing = null;
  let layer, ghostG, gridG, terrainG, labels = [];

  // Villagers are the village's thermometer, not simulated citizens: how many
  // there are and what they wear is read off the economy. They wander, and
  // they prefer roads. Driven by Phaser's own update() at ~60fps — the old
  // version stepped off the 1s economy interval, which is what made every
  // movement look like a stutter.
  const villagers = [];
  let villagerG = null;
  let mood = 50;
  const WALK = 1.3; // tiles per second

  const villagerCap = () => Math.min(24, village.b.filter((s) => s.status === 'complete').length * 3);
  const walkable = (tx, ty) =>
    tx >= 0 && ty >= 0 && tx < MAP && ty < MAP && !buildingAt(tx, ty) && getTileType(tx, ty) !== 'water';

  // A villager has width, so standing is judged on the corners of a small
  // footprint rather than the single centre point. Checking only the centre
  // let them walk right up to a shoreline with half their body over the
  // water, and straddle building edges.
  const FOOT_X = 0.2, FOOT_Y = 0.12;
  const canStand = (x, y) =>
    walkable(Math.floor(x - FOOT_X), Math.floor(y - FOOT_Y)) &&
    walkable(Math.floor(x + FOOT_X), Math.floor(y - FOOT_Y)) &&
    walkable(Math.floor(x - FOOT_X), Math.floor(y + FOOT_Y)) &&
    walkable(Math.floor(x + FOOT_X), Math.floor(y + FOOT_Y));

  // How attractive a tile is to wander onto. Deliberately mild — it only
  // tilts the odds of a random heading, so they still drift about sporadically
  // instead of marching along streets.
  const ZONES = { residential: 1, commercial: 1, industrial: 1 };
  function tileAppeal(tx, ty) {
    const t = getTileType(tx, ty);
    if (t === 'road') return 3.0;
    if (ZONES[t]) return 2.0;
    // Grass beside a road or a district still counts for something: that's the
    // verge people actually walk along.
    for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
      const n = getTileType(tx + dx, ty + dy);
      if (n === 'road') return 1.4;
      if (ZONES[n]) return 0.9;
    }
    return 0;
  }

  // Picks a new heading at random, weighting each direction by what lies a
  // couple of tiles that way. Anything that would put them in water or a
  // building gets zero weight; if every direction is blocked they just pick
  // one at random and wait it out.
  // `drift` keeps the candidates within the same ±0.7 rad wobble the old
  // random walk used, so the movement reads the same; without it (blocked, or
  // a fresh spawn) any direction is on the table.
  function pickHeading(v, drift) {
    const options = [];
    let total = 0;
    const base = Math.atan2(v.vy, v.vx);
    const here = tileAppeal(Math.floor(v.x), Math.floor(v.y));
    for (let i = 0; i < 10; i++) {
      const a = drift ? base + (Math.random() - 0.5) * 1.4 : Math.random() * Math.PI * 2;
      const cx = Math.cos(a), cy = Math.sin(a);
      const near = canStand(v.x + cx * 0.6, v.y + cy * 0.6);
      const far = canStand(v.x + cx * 1.6, v.y + cy * 1.6);
      if (!near) continue;
      // Appeal is read at two distances so a road a step away counts as well
      // as one two tiles off, and averaged so neither dominates.
      const appeal = (tileAppeal(Math.floor(v.x + cx * 0.9), Math.floor(v.y + cy * 0.9)) +
                      tileAppeal(Math.floor(v.x + cx * 1.8), Math.floor(v.y + cy * 1.8))) / 2;
      let w = (far ? 1 : 0.35) + appeal;
      // Once on a road or in a district, heading for bare grass is less
      // likely — enough that they hang around streets, not so much that they
      // stop wandering.
      if (here > 0.8 && appeal === 0) w *= 0.45;
      // A power curve widens the gap between "on a road" and "bare grass"
      // without touching the ordering, which a straight sum barely did.
      w = Math.pow(w, 1.5);
      options.push({ cx, cy, w });
      total += w;
    }
    if (!options.length) {
      const a = Math.random() * Math.PI * 2;
      return { cx: Math.cos(a), cy: Math.sin(a), stuck: true };
    }
    let r = Math.random() * total;
    for (const o of options) { r -= o.w; if (r <= 0) return o; }
    return options[options.length - 1];
  }

  function spawnVillager() {
    let sx = 0, sy = 0, ok = false;
    for (let i = 0; i < 16 && !ok; i++) {
      sx = Math.random() * MAP; sy = Math.random() * MAP;
      ok = canStand(sx, sy);
    }
    if (!ok) return;
    const v = { x: sx, y: sy, vx: 0, vy: 0, pause: 0 };
    const h = pickHeading(v);
    v.vx = h.cx; v.vy = h.cy;
    villagers.push(v);
  }

  // Called whenever tiles or buildings change. A villager standing where water
  // (or a building) has just been painted would otherwise stay there, so move
  // each affected one to the nearest spot they can actually stand.
  function relocateVillagers() {
    for (let i = villagers.length - 1; i >= 0; i--) {
      const v = villagers[i];
      if (canStand(v.x, v.y)) continue;
      let found = null;
      search:
      for (let r = 1; r <= 8; r++) {
        for (let k = 0; k < 16; k++) {
          const a = (k / 16) * Math.PI * 2;
          const x = v.x + Math.cos(a) * r * 0.5, y = v.y + Math.sin(a) * r * 0.5;
          if (canStand(x, y)) { found = { x, y }; break search; }
        }
      }
      if (found) { v.x = found.x; v.y = found.y; v.pause = 0.3; }
      else villagers.splice(i, 1);
    }
  }

  function stepVillagers(dt) {
    const want = villagerCap();
    if (villagers.length < want) spawnVillager();
    while (villagers.length > want) villagers.pop();

    villagers.forEach((v) => {
      if (v.pause > 0) { v.pause -= dt; return; }
      // Roads are the nice place to be, so walking one is slower (lingering).
      const onRoad = getTileType(Math.floor(v.x), Math.floor(v.y)) === 'road';
      const speed = WALK * (onRoad ? 0.7 : 1);
      const nx = v.x + v.vx * speed * dt;
      const ny = v.y + v.vy * speed * dt;
      if (!canStand(nx, ny)) {
        // Turn and wait rather than reversing velocity, which used to leave
        // them vibrating against a wall forever.
        const h = pickHeading(v);
        v.vx = h.cx; v.vy = h.cy;
        v.pause = 0.2 + Math.random() * 0.5;
        return;
      }
      v.x = nx; v.y = ny;
      if (Math.random() < dt * 0.35) v.pause = 0.4 + Math.random() * 1.2;
      else if (Math.random() < dt * 0.55) {
        // Same sporadic drift as before, but the new heading is a weighted
        // pick, so it leans toward roads and districts rather than being
        // uniformly random.
        const h = pickHeading(v, true);
        if (!h.stuck) { v.vx = h.cx; v.vy = h.cy; }
      }
    });
  }

  // Tan head, a couple of pixels of clothing underneath. The coat color is the
  // only thing mood changes — the head stays skin-toned.
  function drawVillagers() {
    villagerG.clear();
    const coat = mood > 66 ? '#3f6fa8' : mood > 33 ? '#6b5a3f' : '#3a3a3a';
    villagers.forEach((v) => {
      const px = Math.round(v.x * T), py = Math.round(v.y * T);
      rect(villagerG, '#000000', px - 1, py + 4, 3, 1, 0.3);
      rect(villagerG, '#d9a877', px - 1, py - 2, 3, 3);
      rect(villagerG, coat, px - 1, py + 1, 3, 2);
    });
  }

  function clampCam() {
    const vw = cam.width / cam.zoom, vh = cam.height / cam.zoom;
    const wW = MAP * T, wH = MAP * T, pad = 24;
    camCX = vw >= wW + pad * 2 ? wW / 2 : Math.max(vw / 2 - pad, Math.min(wW + pad - vw / 2, camCX));
    camCY = vh >= wH + pad * 2 ? wH / 2 : Math.max(vh / 2 - pad, Math.min(wH + pad - vh / 2, camCY));
    cam.centerOn(camCX, camCY);
  }
  function fitZoom() {
    const z = Math.min(cam.width / (MAP * T + 48), cam.height / (MAP * T + 48));
    return Math.max(0.5, z);
  }
  function recenter() {
    camCX = (MAP * T) / 2; camCY = (MAP * T) / 2;
    cam.setZoom(fitZoom());
    clampCam();
  }
  function setZoom(z) {
    const min = fitZoom() * 0.75;
    cam.setZoom(Math.max(min, Math.min(8, z)));
    clampCam();
  }

  function refresh() {
    if (!scene) return;
    layer.clear();
    // Terrain carries the painted zones/roads/water, so it has to be redrawn
    // whenever tiles change — drawing it once at create() meant a freshly
    // painted tile didn't appear until the page was reloaded.
    if (terrainDirty) { terrainG.clear(); drawTerrain(terrainG); terrainDirty = false; }
    // Tiles or buildings may have just changed under someone's feet.
    relocateVillagers();
    labels.forEach((t) => t.destroy());
    labels = [];
    const now = Date.now();
    mood = computeMood();
    let totalProduction = 0, totalUpkeep = 0, onRoadCount = 0;

    // Draw back-to-front so taller buildings overlap the ones behind them.
    const sorted = village.b.slice().sort((a, b) => (a.y + foot(a.key).h) - (b.y + foot(b.key).h));
    sorted.forEach((s) => {
      if (placing && placing.moveId === s.id) return;
      const def = DEFS[s.key];
      if (!def) return;
      const f = foot(s.key);
      const ox = s.x * T, oy = s.y * T, w = f.w * T, h = f.h * T;
      // Ground shadow
      rect(layer, '#000000', ox + 2, oy + h - 3, w - 2, 4, 0.28);
      let tag = '';
      if (s.status === 'building') {
        const pct = Math.min(100, Math.round(((now - s.startedAt) / (s.completesAt - s.startedAt)) * 100));
        drawScaffold(layer, ox, oy, w, h, pct);
        tag = `${pct}%`;
      } else {
        (ART[s.key] || ART.shabby_apartment)(layer, ox, oy);
        totalProduction += productionFor(s, mood);
        totalUpkeep += def.cost * (def.upkeepPct || 0);
        if (s.taxDebt > 0) {
          rect(layer, '#000000', ox, oy, w, h, 0.45);
          rect(layer, '#ff4444', ox + w - 5, oy + 1, 4, 4);
        }
        // The single most important piece of feedback on the map: a building
        // with no road touching it earns nothing, and says so.
        if (!isRoadConnected(s)) {
          rect(layer, '#000000', ox, oy, w, h, 0.34);
          const bx = ox + w / 2 - 5, by = oy + h / 2 - 3;
          rect(layer, '#ff3b3b', bx, by, 10, 6);
          rect(layer, '#000000', bx + 2, by + 2, 6, 2);
        } else {
          onRoadCount++;
          if (zoneMatch(s) > 0) {
            // Small gold corner pip = standing on the zone it wants.
            rect(layer, '#ffd700', ox + w - 4, oy + h - 4, 3, 3);
          }
        }
      }
      if (s.id === selectedId) {
        layer.lineStyle(1, hex('#ffd700'), 1);
        layer.strokeRect(ox - 0.5, oy - 0.5, w + 1, h + 1);
      }
      if (tag) {
        const t = scene.add.text(ox + w / 2, oy + h / 2, tag, { fontFamily: 'monospace', fontSize: '8px', color: '#ffffff', stroke: '#000000', strokeThickness: 2 });
        t.setOrigin(0.5);
        t.setResolution(4);
        labels.push(t);
      }
    });

    drawGhost();

    const doneCount = village.b.filter((s) => s.status === 'complete').length;
    $('stat-production').textContent = Math.floor(totalProduction);
    $('stat-placed').textContent = village.b.length + '/' + slotCap();
    $('stat-building').textContent = buildingCount() + '/' + MAX_CONCURRENT;
    $('stat-road').textContent = onRoadCount + '/' + doneCount;
    $('stat-road').style.color = doneCount && onRoadCount < doneCount ? '#ff6b6b' : '';
    $('stat-mood').textContent = Math.round(mood) + '%';
    $('stat-upkeep').textContent = Math.floor(totalUpkeep);
    syncBalance();
    maybePushLeaderboardScore(totalProduction - (totalUpkeep / 1440));
  }

  function drawGhost() {
    ghostG.clear();
    gridG.clear();
    if (!placing) return;
    // Faint tile grid while aiming.
    gridG.lineStyle(1, 0xffffff, 0.12);
    for (let i = 0; i <= MAP; i++) {
      gridG.lineBetween(i * T, 0, i * T, MAP * T);
      gridG.lineBetween(0, i * T, MAP * T, i * T);
    }
    if (placing.tx == null) return;
    const f = foot(placing.key);
    const ok = canPlace(placing.key, placing.tx, placing.ty, placing.moveId);
    const ox = placing.tx * T, oy = placing.ty * T;
    ghostG.setAlpha(0.8);
    if (ok) (ART[placing.key] || ART.shabby_apartment)(ghostG, ox, oy);
    rect(ghostG, ok ? '#00ff6a' : '#ff3b3b', ox, oy, f.w * T, f.h * T, ok ? 0.22 : 0.45);
    ghostG.lineStyle(1, hex(ok ? '#00ff6a' : '#ff3b3b'), 1);
    ghostG.strokeRect(ox + 0.5, oy + 0.5, f.w * T - 1, f.h * T - 1);
    const txt = $('place-bar-text');
    const inb = inBounds(placing.tx, placing.ty, f);
    txt.textContent = ok ? `${DEFS[placing.key].label} — tap ✓ to place` : (inb ? 'Something is in the way' : 'Out of bounds');
    txt.classList.toggle('bad', !ok);
    $('place-confirm').disabled = !ok;
  }

  function tileFromPointer(pointer) {
    const wp = cam.getWorldPoint(pointer.x, pointer.y);
    return { tx: Math.floor(wp.x / T), ty: Math.floor(wp.y / T) };
  }

  function aimGhost(tx, ty) {
    if (!placing) return;
    const f = foot(placing.key);
    // The tapped tile becomes the building's centre-ish anchor, clamped inside the map.
    placing.tx = Math.max(0, Math.min(MAP - f.w, tx - Math.floor((f.w - 1) / 2)));
    placing.ty = Math.max(0, Math.min(MAP - f.h, ty - Math.floor((f.h - 1) / 2)));
    refresh();
  }

  function create() {
    scene = this;
    cam = this.cameras.main;
    terrainG = this.add.graphics();
    gridG = this.add.graphics();
    layer = this.add.graphics();
    villagerG = this.add.graphics();
    villagerG.setDepth(5);
    ghostG = this.add.graphics();
    ghostG.setDepth(10);
    this.input.addPointer(1);

    let down = null;
    this.input.on('pointerdown', (p) => {
      down = { x: p.x, y: p.y, t: performance.now(), moved: false };
      // Price the whole stroke off the balance at the moment it starts.
      if (brushMode && brushMode !== 'erase') { try { strokeBasis = Strubles.get(); } catch { strokeBasis = null; } }
    });
    this.input.on('pointermove', (p) => {
      if (!p.isDown || !down) return;
      // Dragging with a brush selected paints a stroke instead of panning —
      // tile-by-tile tapping to lay a road was unusable.
      if (brushMode && !this.input.pointer2.isDown) {
        down.moved = true;
        const t = tileFromPointer(p);
        paintTile(t.tx, t.ty);
        return;
      }
      const p1 = this.input.pointer1, p2 = this.input.pointer2;
      if (p1.isDown && p2.isDown) {
        // Pinch zoom
        const d = Phaser.Math.Distance.Between(p1.x, p1.y, p2.x, p2.y);
        if (down.pinch) setZoom(cam.zoom * (d / down.pinch));
        down.pinch = d;
        down.moved = true;
        return;
      }
      down.pinch = null;
      const dx = p.x - p.prevPosition.x, dy = p.y - p.prevPosition.y;
      if (!down.moved && Math.hypot(p.x - down.x, p.y - down.y) < 6) return;
      down.moved = true;
      camCX -= dx / cam.zoom;
      camCY -= dy / cam.zoom;
      clampCam();
    });
    const endStroke = () => { strokeBasis = null; if (brushMode) setBrushLabel(); };
    this.input.on('pointerupoutside', endStroke);
    this.input.on('pointerup', (p) => {
      try { handleUp(p); } finally { endStroke(); }
    });
    const handleUp = (p) => {
      if (!down) return;
      const wasTap = !down.moved && performance.now() - down.t < 600;
      down = null;
      if (!wasTap) return;
      const { tx, ty } = tileFromPointer(p);
      if (placing) { aimGhost(tx, ty); return; }
      if (brushMode) { paintTile(tx, ty); return; }
      const b = buildingAt(tx, ty);
      selectedId = b ? b.id : null;
      refresh();
      if (b) openManage(b.id);
    };
    this.input.on('wheel', (p, objs, dx, dy) => setZoom(cam.zoom * (dy > 0 ? 0.9 : 1.1)));
    this.scale.on('resize', () => clampCam());

    recenter();
    refresh();
  }

  // Phaser's own render loop. Only villagers animate here; village state is
  // never touched, so this can run every frame without saving anything.
  function update(time, delta) {
    if (!villagerG) return;
    stepVillagers(Math.min(0.05, delta / 1000));
    drawVillagers();
  }

  new Phaser.Game({
    type: Phaser.AUTO,
    parent: 'game-stage',
    transparent: true,
    pixelArt: true,
    antialias: false,
    roundPixels: true,
    scale: { mode: Phaser.Scale.RESIZE, width: '100%', height: '100%' },
    scene: { create, update },
  });

  // ---------- Placement flow ----------
  const placeOverlay = $('place-overlay');
  const placeList = $('place-list');

  function startPlacing(key, moveId) {
    placing = { key, moveId: moveId || null, tx: null, ty: null };
    $('place-bar').classList.add('open');
    $('place-confirm').disabled = true;
    $('place-bar-text').textContent = `Tap the map to aim your ${DEFS[key].label}`;
    $('place-bar-text').classList.remove('bad');
    refresh();
  }
  function stopPlacing() {
    placing = null;
    $('place-bar').classList.remove('open');
    refresh();
  }

  function openPlacePicker() {
    const avail = availableCounts();
    const owned = ownedCounts();
    placeList.innerHTML = '';
    if (!ORDER.some((k) => avail[k] > 0)) {
      const empty = document.createElement('div');
      empty.className = 'picker-empty';
      empty.textContent = "You don't have any unplaced buildings — open an Iantopia Lootbox Basic on the Lootbox page to win one.";
      placeList.appendChild(empty);
      placeOverlay.classList.add('open');
      return;
    }
    ORDER.forEach((key) => {
      if (avail[key] <= 0) return;
      const def = DEFS[key];
      const rarity = RARITY[def.tier] || {};
      const f = foot(key);
      const row = document.createElement('div');
      row.className = 'picker-row';
      row.innerHTML = `<div class="row-icon">${f.icon}</div><div class="row-info">${def.label} <small style="color:${rarity.color || ''}">${rarity.label || ''} · own ${owned[key]}/${MAX_PER_TYPE} · ${avail[key]} unplaced · ${f.w}x${f.h} tiles</small><small>Cost ${def.cost.toLocaleString()} Strubles · builds in ${fmtDuration(def.buildMinutes)} · +${def.production}/min when done</small>${def.description ? `<small class="row-desc">${def.description}</small>` : ''}</div>`;
      row.addEventListener('click', () => {
        if (village.b.length >= slotCap()) {
          alert(`Your village is full (${slotCap()} buildings). Buy more slots, or remove a building first.`);
          return;
        }
        if (buildingCount() >= MAX_CONCURRENT) {
          alert(`Only ${MAX_CONCURRENT} buildings can be under construction at once — wait for one to finish first.`);
          return;
        }
        placeOverlay.classList.remove('open');
        startPlacing(key, null);
      });
      placeList.appendChild(row);
    });
    placeOverlay.classList.add('open');
  }

  function confirmPlacing() {
    if (!placing || placing.tx == null) return;
    const { key, moveId, tx, ty } = placing;
    if (!canPlace(key, tx, ty, moveId)) return;
    if (moveId != null) {
      const b = village.b.find((s) => s.id === moveId);
      if (b) { b.x = tx; b.y = ty; }
    } else {
      const def = DEFS[key];
      if (!Strubles.spend(def.cost)) {
        alert(`Not enough Strubles for the permit (need ${def.cost.toLocaleString()}).`);
        return;
      }
      const now = Date.now();
      village.b.push({
        id: village.nextId++, key, x: tx, y: ty,
        status: 'building', startedAt: now,
        completesAt: now + def.buildMinutes * 60000,
        lastProductionAt: now,
      });
    }
    saveVillage();
    stopPlacing();
  }

  $('build-btn').addEventListener('click', () => { setBrush(null); openPlacePicker(); });
  $('place-confirm').addEventListener('click', confirmPlacing);
  $('place-cancel').addEventListener('click', stopPlacing);
  $('recenter-btn').addEventListener('click', () => { if (cam) recenter(); });

  // --- Brush: paint zones, roads and water. Zones may go under a building
  // (that's how a building ends up matched to its zone); roads and water may
  // not. ---
  const BRUSH_LABEL = {
    residential: 'Residential', commercial: 'Commercial', industrial: 'Industrial',
    road: 'Road', water: 'Water', erase: 'Erase',
  };
  let brushMsgTimer = null;
  function brushMsg(text, bad) {
    const el = $('brush-bar-text');
    el.textContent = text;
    el.classList.toggle('bad', !!bad);
    clearTimeout(brushMsgTimer);
    brushMsgTimer = setTimeout(setBrushLabel, 1600);
  }
  function setBrushLabel() {
    if (!brushMode) return;
    const cost = tileCost(brushMode);
    const el = $('brush-bar-text');
    el.classList.remove('bad');
    el.textContent = brushMode === 'erase'
      ? 'Erase — drag to clear tiles (no refund)'
      : `${BRUSH_LABEL[brushMode]} — ${cost ? cost.toLocaleString() + ' each' : 'free'}, drag to paint`;
  }

  function paintTile(tx, ty) {
    if (!brushMode || tx < 0 || ty < 0 || tx >= MAP || ty >= MAP) return;
    const existing = getTileType(tx, ty);
    if (brushMode === 'erase') {
      if (!existing) return;
      setTileType(tx, ty, null);
      saveVillage(); refresh();
      return;
    }
    if (existing === brushMode) return;
    if (buildingAt(tx, ty) && (brushMode === 'road' || brushMode === 'water')) {
      brushMsg("Can't go under a building", true);
      return;
    }
    const cost = tileCost(brushMode);
    if (cost > 0 && !Strubles.spend(cost)) {
      brushMsg(`Need ${cost.toLocaleString()} Strubles`, true);
      return;
    }
    setTileType(tx, ty, brushMode);
    saveVillage(); refresh();
  }

  function setBrush(mode) {
    brushMode = mode;
    document.querySelectorAll('[data-brush]').forEach((b) => {
      b.style.opacity = (mode && b.dataset.brush === mode) ? '0.55' : '1';
    });
    $('brush-bar').classList.toggle('open', !!mode);
    if (mode) { stopPlacing(); selectedId = null; setBrushLabel(); }
    refresh();
  }
  $('brush-done').addEventListener('click', () => setBrush(null));

  // Grouped so the three zone colours read as a category with a shared
  // purpose, instead of three unexplained buttons sitting next to Road.
  const ZONING_GROUPS = [
    { title: 'Infrastructure', rows: [
      { brush: 'road', icon: '🛣️', name: 'Road',
        blurb: 'Required. A building with no road touching one of its sides earns nothing at all. Roads also carry your villagers.' },
    ]},
    { title: 'Zones', rows: [
      { brush: 'residential', icon: '🏘️', name: 'Residential',
        blurb: 'Homes. Apartments and mid-rises pay up to +25% standing on it.' },
      { brush: 'commercial', icon: '🏬', name: 'Commercial',
        blurb: 'Shops and offices. Pagodas, skyscrapers and Taipei 101 pay up to +25% standing on it.' },
      { brush: 'industrial', icon: '🏭', name: 'Industrial',
        blurb: 'Adds +15% to any building it touches, but every industrial tile drags village mood down — and mood scales all production from 0.75x to 1.15x.' },
    ]},
    { title: 'Terrain', rows: [
      { brush: 'water', icon: '💧', name: 'Water',
        blurb: 'Scenery. Lifts mood a little, and permanently blocks building on that tile until erased.' },
      { brush: 'erase', icon: '🧽', name: 'Erase',
        blurb: 'Clears any painted tile. No refund.' },
    ]},
  ];

  function openZoning() {
    const list = $('zoning-list');
    list.innerHTML = '';
    ZONING_GROUPS.forEach((group) => {
      const h = document.createElement('div');
      h.style.cssText = 'font-size:9px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; margin:12px 0 4px;';
      h.textContent = group.title;
      list.appendChild(h);
      group.rows.forEach((r) => {
        const cost = tileCost(r.brush);
        const row = document.createElement('div');
        row.className = 'picker-row';
        row.innerHTML = `<div class="row-icon">${r.icon}</div><div class="row-info">${r.name}
          <small style="color:var(--gold)">${r.brush === 'erase' || !cost ? 'free' : cost.toLocaleString() + ' Strubles per tile · scales with your balance'}</small>
          <small class="row-desc">${r.blurb}</small></div>`;
        row.addEventListener('click', () => {
          $('zoning-overlay').classList.remove('open');
          setBrush(r.brush);
        });
        list.appendChild(row);
      });
    });
    $('zoning-overlay').classList.add('open');
  }
  $('zoning-btn').addEventListener('click', openZoning);
  wireClose('zoning-overlay', 'zoning-close');
  window.addEventListener('keydown', (e) => {
    if (!placing) return;
    if (e.key === 'Enter') { e.preventDefault(); confirmPlacing(); }
    else if (e.key === 'Escape') { e.preventDefault(); stopPlacing(); }
    else if (placing.tx != null && e.key.startsWith('Arrow')) {
      e.preventDefault();
      const dx = e.key === 'ArrowLeft' ? -1 : e.key === 'ArrowRight' ? 1 : 0;
      const dy = e.key === 'ArrowUp' ? -1 : e.key === 'ArrowDown' ? 1 : 0;
      const f = foot(placing.key);
      placing.tx = Math.max(0, Math.min(MAP - f.w, placing.tx + dx));
      placing.ty = Math.max(0, Math.min(MAP - f.h, placing.ty + dy));
      refresh();
    }
  });
  function wireClose(overlayId, closeId) {
    document.querySelectorAll(`#${overlayId}, #${closeId}`).forEach((el) => {
      el.addEventListener('click', (e) => {
        if (e.target.id === overlayId || e.target.id === closeId) $(overlayId).classList.remove('open');
      });
    });
  }
  wireClose('place-overlay', 'place-close');

  // ---------- Manage a placed building ----------
  const manageOverlay = $('manage-overlay');
  let manageId = null;

  function openManage(id) {
    const s = village.b.find((x) => x.id === id);
    if (!s) return;
    manageId = id;
    const def = DEFS[s.key];
    const rarity = RARITY[def.tier] || {};
    const f = foot(s.key);
    const dailyUpkeep = def.cost * (def.upkeepPct || 0);
    $('manage-title').textContent = def.label;
    const statusLine = s.status === 'building'
      ? 'Under construction — removing forfeits progress, no refund.'
      : `Producing +${def.production}/min.`;
    let upkeepLine = '';
    if (s.status === 'complete') {
      upkeepLine = s.taxDebt > 0
        ? `<small style="color:#ff6b6b;">⚠ Neglected — owes ${Math.floor(s.taxDebt)} Strubles (half production until paid). Upkeep ${Math.floor(dailyUpkeep)}/day.</small>`
        : `<small>Upkeep ${Math.floor(dailyUpkeep)}/day, auto-paid from balance.</small>`;
    }
    $('manage-info').innerHTML = `<div class="guide-row"><div class="row-icon">${f.icon}</div><div class="row-info">${def.label} <small style="color:${rarity.color || ''}">${rarity.label || ''}</small><small>${statusLine}</small>${upkeepLine}${def.description ? `<small class="row-desc">${def.description}</small>` : ''}</div></div>`;
    manageOverlay.classList.add('open');
  }
  function closeManage() {
    manageOverlay.classList.remove('open');
    selectedId = null;
    refresh();
  }
  $('manage-move').addEventListener('click', () => {
    const s = village.b.find((x) => x.id === manageId);
    manageOverlay.classList.remove('open');
    if (!s) return;
    selectedId = null;
    startPlacing(s.key, s.id);
    placing.tx = s.x; placing.ty = s.y;
    refresh();
  });
  $('manage-remove').addEventListener('click', () => {
    village.b = village.b.filter((x) => x.id !== manageId);
    saveVillage();
    closeManage();
  });
  document.querySelectorAll('#manage-overlay, #manage-close').forEach((el) => {
    el.addEventListener('click', (e) => {
      if (e.target.id === 'manage-overlay' || e.target.id === 'manage-close') closeManage();
    });
  });

  // ---------- Building Guide ----------
  $('guide-btn').addEventListener('click', () => {
    const owned = ownedCounts();
    const list = $('guide-list');
    // The layout rules have to be stated somewhere — they're invisible
    // otherwise, and they're the whole game.
    list.innerHTML = `
      <div class="guide-row" style="align-items:flex-start;">
        <div class="row-icon">🛣️</div>
        <div class="row-info"><b style="color:#ff6b6b">Roads are required.</b>
          <small>A building with no road touching one of its sides earns nothing at all. Roads cost ${tileCost('road').toLocaleString()} Strubles a tile right now — the price rises as your balance does.</small></div>
      </div>
      <div class="guide-row" style="align-items:flex-start;">
        <div class="row-icon">🏘️</div>
        <div class="row-info"><b>Zone under your buildings.</b>
          <small>Standing on the zone it wants pays up to +${Math.round(ZONE_BONUS * 100)}%. Each building's zone is listed below. Zones cost ${tileCost('residential').toLocaleString()} a tile right now (also scaling with your balance) and can be painted underneath an existing building.</small></div>
      </div>
      <div class="guide-row" style="align-items:flex-start;">
        <div class="row-icon">🏭</div>
        <div class="row-info"><b>Industry is the dirty option.</b>
          <small>Industrial next door adds +${Math.round(INDUSTRIAL_BONUS * 100)}% to any building, but drags village mood down — and mood scales everything from 0.75x to 1.15x.</small></div>
      </div>
      <div class="guide-row" style="align-items:flex-start;">
        <div class="row-icon">💧</div>
        <div class="row-info"><b>Water is scenery you can't build on.</b>
          <small>Free to paint, lifts mood a little, and permanently blocks that tile until you erase it.</small></div>
      </div>`;
    ORDER.forEach((key) => {
      const def = DEFS[key];
      const rarity = RARITY[def.tier] || {};
      const f = foot(key);
      const dailyUpkeep = def.cost * (def.upkeepPct || 0);
      const row = document.createElement('div');
      row.className = 'guide-row';
      row.innerHTML = `<div class="row-icon">${f.icon}</div><div class="row-info">${def.label} <small style="color:${rarity.color || ''}">${rarity.label || ''} · own ${owned[key]}/${MAX_PER_TYPE} · ${f.w}x${f.h} tiles · wants ${ZONE_AFFINITY[key] || 'any'} zone</small><small>Cost ${def.cost.toLocaleString()} Strubles · builds in ${fmtDuration(def.buildMinutes)} · +${def.production}/min when done · Upkeep ${Math.floor(dailyUpkeep)}/day</small>${def.description ? `<small class="row-desc">${def.description}</small>` : ''}</div>`;
      list.appendChild(row);
    });
    $('guide-overlay').classList.add('open');
  });
  wireClose('guide-overlay', 'guide-close');

  // ---------- Bank (unchanged behaviour: raises the wallet cap) ----------
  function renderBank() {
    const TB = window.TycoonBank;
    const level = TB.currentLevel();
    const bankCap = TB.capForLevel(level);
    const taipei = TB.taipeiBonus();
    $('bank-cap-breakdown').innerHTML = `
      <div class="bank-cap-row"><span>Bank (level ${level})</span><span>${bankCap.toLocaleString()} Strubles</span></div>
      <div class="bank-cap-row"><span>Taipei 101 bonus</span><span>+${taipei.toLocaleString()} Strubles</span></div>
      <div class="bank-cap-row"><span><b>Total cap</b></span><span><b>${(bankCap + taipei).toLocaleString()} Strubles</b></span></div>`;
    $('bank-next-info').textContent = `Next: Level ${level + 1} — costs ${TB.costForLevel(level + 1).toLocaleString()}, raises the cap by ${TB.capGainForLevel(level + 1).toLocaleString()}.`;
  }
  $('bank-btn').addEventListener('click', () => { renderBank(); renderExpand(); $('bank-overlay').classList.add('open'); });
  $('bank-buy').addEventListener('click', () => {
    const TB = window.TycoonBank;
    const level = TB.currentLevel();
    const cost = TB.costForLevel(level + 1);
    if (!Strubles.spend(cost)) {
      alert(`Not enough Strubles for the next level (need ${cost.toLocaleString()}).`);
      return;
    }
    localStorage.setItem(TB.BANK_LEVEL_KEY, String(level + 1));
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
    renderBank();
    syncBalance();
  });
  wireClose('bank-overlay', 'bank-close');

  // ---------- Building slots ----------
  function renderExpand() {
    const owned = slotsOwned();
    $('expand-info-breakdown').innerHTML = `
      <div class="bank-cap-row"><span>Building slots</span><span>${BASE_SLOTS + owned}</span></div>
      <div class="bank-cap-row"><span>Slots purchased</span><span>${owned}</span></div>`;
    $('expand-next-info').textContent = `Next: slot ${BASE_SLOTS + owned + 1} — costs ${expandCostForSlot(owned + 1).toLocaleString()} Strubles.`;
  }
  $('expand-buy').addEventListener('click', () => {
    const owned = slotsOwned();
    const cost = expandCostForSlot(owned + 1);
    if (!Strubles.spend(cost)) {
      alert(`Not enough Strubles for the next slot (need ${cost.toLocaleString()}).`);
      return;
    }
    localStorage.setItem(SLOTS_KEY, String(owned + 1));
    try { window.dispatchEvent(new Event('tycoon:changed')); } catch {}
    renderExpand();
    refresh();
    syncBalance();
  });

  window.addEventListener('inventory:changed', () => refresh());
  window.addEventListener('strubles:change', syncBalance);
  // Tile prices track the balance, so keep the price in the brush bar current
  // between strokes (mid-stroke it is deliberately held steady).
  window.addEventListener('strubles:change', () => { if (brushMode && strokeBasis == null) setBrushLabel(); });
  window.addEventListener('storage', (e) => {
    if (e.key === VILLAGE_KEY) { village = loadVillage(); refresh(); }
    if (e.key === INV_KEY) refresh();
  });
  // Cloud pull reloads the page itself, so no extra reconcile hook is needed.

  // ---------- Sound (same pattern as every other page) ----------
  let audioEnabled = true;
  const themeMusic = $('theme-music');
  const VOLUME_KEY = 'music_volume_v1';
  const volumeSlider = $('volume-slider');
  const savedVolume = parseFloat(localStorage.getItem(VOLUME_KEY));
  themeMusic.volume = isFinite(savedVolume) ? savedVolume : 0.3;
  volumeSlider.value = Math.round(themeMusic.volume * 100);
  volumeSlider.addEventListener('input', () => {
    themeMusic.volume = volumeSlider.value / 100;
    localStorage.setItem(VOLUME_KEY, themeMusic.volume);
  });
  function tryPlayTheme() { if (audioEnabled) themeMusic.play().catch(() => {}); }
  tryPlayTheme();
  const unlockTheme = () => {
    tryPlayTheme();
    window.removeEventListener('pointerdown', unlockTheme);
    window.removeEventListener('keydown', unlockTheme);
  };
  window.addEventListener('pointerdown', unlockTheme);
  window.addEventListener('keydown', unlockTheme);
  $('mute-btn').addEventListener('click', () => {
    audioEnabled = !audioEnabled;
    $('mute-btn').textContent = audioEnabled ? '🔊' : '🔇';
    if (audioEnabled) tryPlayTheme(); else themeMusic.pause();
  });

  // ---------- Reconcile loop ----------
  if (tick()) saveVillage();
  setInterval(() => {
    if (tick()) saveVillage();
    refresh();
  }, 1000);

  // ---------- Leaderboard score push (unchanged) ----------
  let lastPushedNetProduction = null;
  let leaderboardPushInFlight = false;
  function maybePushLeaderboardScore(netProduction) {
    if (!window.CloudSync || !CloudSync.isSignedIn()) return;
    if (netProduction === lastPushedNetProduction || leaderboardPushInFlight) return;
    const user = CloudSync.currentUser;
    if (!user) return;
    leaderboardPushInFlight = true;
    firebase.firestore().collection('leaderboard').doc(user.uid).set({
      displayName: user.displayName || 'Anonymous Tycoon',
      netProduction: Math.round(netProduction * 1000) / 1000,
      updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
    }, { merge: true })
      .then(() => { lastPushedNetProduction = netProduction; })
      .catch((err) => console.error('[leaderboard] push failed:', err))
      .finally(() => { leaderboardPushInFlight = false; });
  }

  // Read-only introspection for QA (same idea as window.HorseGame).
  window.TycoonGame = {
    getState: () => ({
      village, slotCap: slotCap(), placing, brushMode, mood,
      zoom: cam && cam.zoom, villagers: villagers.length,
      villagerPos: villagers.map((v) => [v.x, v.y]),
      cost: { road: tileCost('road'), residential: tileCost('residential') },
      connected: village.b.filter((s) => s.status === 'complete' && isRoadConnected(s)).length,
    }),
  };

  if (window.initPickers) setTimeout(window.initPickers, 100);
})();
</script>
</body>
</html>
