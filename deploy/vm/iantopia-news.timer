[Unit]
Description=Run the Iantopia news pipeline twice daily

[Timer]
# 6am and 6pm Eastern. The zone name lets systemd follow daylight saving time;
# a fixed UTC hour drifts by an hour twice a year.
OnCalendar=*-*-* 06:00:00 America/New_York
OnCalendar=*-*-* 18:00:00 America/New_York
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
