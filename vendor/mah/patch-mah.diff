diff --git a/src/app/model/music.ts b/src/app/model/music.ts
index a49ac035..1b944750 100644
--- a/src/app/model/music.ts
+++ b/src/app/model/music.ts
@@ -1,19 +1,111 @@
+// Iantopia: the background music plays these tracks in a random order, never the
+// same track twice in a row, while a game is running. Music is only audible when the
+// music setting is on (game.music.enabled) and the game is being played.
+const TRACKS = [
+	// The Avatar's Love is kept in assets/music, but it's an Iantopia unlock now,
+	// not part of the Mahjong playlist (too intense for a quiet game).
+	'assets/music/fei-yu-yi-jian-mei.mp3',
+	'assets/music/ninjago-overture.mp3',
+	'assets/music/tian-tian-yue.mp3',
+	'assets/music/sacred-pool-of-tears.mp3',
+	'assets/music/oogway-ascends.mp3',
+	'assets/music/han-palace.mp3',
+];
+
+const VOLUME_KEY = 'mah_music_volume';
+
 export class Music {
 	enabled: boolean = false;
+	// 0 to 1. Saved between visits, and applied to the track that is playing.
+	volume: number = Music.savedVolume();
+	private audio?: HTMLAudioElement;
+	private index = Math.floor(Math.random() * TRACKS.length);
+
+	private static savedVolume(): number {
+		try {
+			const saved = Number.parseFloat(localStorage.getItem(VOLUME_KEY) ?? '');
+			if (Number.isFinite(saved)) {
+				return Math.max(0, Math.min(1, saved));
+			}
+		} catch {
+			// no storage: use the default
+		}
+		return 0.35;
+	}
 
-	play() {
-		// not yet implemented
+	setVolume(value: number): void {
+		this.volume = Math.max(0, Math.min(1, value));
+		if (this.audio) {
+			this.audio.volume = this.volume;
+		}
+		try {
+			localStorage.setItem(VOLUME_KEY, String(this.volume));
+		} catch {
+			// not saved, but still applied
+		}
 	}
 
-	pause() {
-		// not yet implemented
+	play(): void {
+		if (!this.enabled) {
+			return;
+		}
+		// Browsers only let audio start after the player has touched the page, and
+		// the game starts on load, so the start is usually refused. Wait for the
+		// player's first tap or key press, then start the track.
+		this.current().play().catch(() => this.startOnNextGesture());
+	}
+
+	private waitingForGesture = false;
+
+	private startOnNextGesture(): void {
+		if (this.waitingForGesture) {
+			return;
+		}
+		this.waitingForGesture = true;
+		const start = () => {
+			document.removeEventListener('pointerdown', start, true);
+			document.removeEventListener('keydown', start, true);
+			this.waitingForGesture = false;
+			if (this.enabled) {
+				this.current().play().catch(() => this.startOnNextGesture());
+			}
+		};
+		document.addEventListener('pointerdown', start, true);
+		document.addEventListener('keydown', start, true);
 	}
 
-	toggle() {
-		// not yet implemented
+	pause(): void {
+		this.audio?.pause();
+	}
+
+	toggle(): void {
+		if (this.enabled) {
+			this.play();
+		} else {
+			this.pause();
+		}
 	}
 
 	toggleMusic(): void {
-		// not yet implemented
+		this.toggle();
+	}
+
+	private current(): HTMLAudioElement {
+		if (!this.audio) {
+			const audio = new Audio(TRACKS[this.index]);
+			audio.volume = this.volume;
+			audio.addEventListener('ended', () => this.next());
+			this.audio = audio;
+		}
+		return this.audio;
+	}
+
+	private next(): void {
+		// Pick a random track other than the one that just ended.
+		const pick = Math.floor(Math.random() * (TRACKS.length - 1));
+		this.index = pick >= this.index ? pick + 1 : pick;
+		const audio = this.current();
+		audio.src = TRACKS[this.index];
+		if (this.enabled) {
+			void audio.play().catch(() => {});
+		}
 	}
 }
