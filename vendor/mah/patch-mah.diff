+	// Iantopia: sound files shipped with the app (see assets/sfx). Each play
+	// makes its own element, so quick repeats can overlap instead of cutting off.
+	playFile(src: string, volume: number = 0.6): void {
+		if (!this.enabled) {
+			return;
+		}
+		try {
+			const audio = new Audio(src);
+			audio.volume = volume;
+			void audio.play().catch(() => {});
+		} catch {
+			// no audio support on this platform
+		}
+	}
 }
