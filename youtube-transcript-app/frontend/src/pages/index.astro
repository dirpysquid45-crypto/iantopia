---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>YouTube Transcript Downloader</title>
    <style is:global>
      .file-item {
        margin-bottom: 15px;
      }

      .file-item:hover .file-title {
        background: rgba(0, 80, 0, 0.6);
        border-left-color: #00ff00;
        box-shadow: 0 0 20px rgba(0, 255, 0, 0.4);
        text-shadow: 0 0 10px #00ff00, 0 0 5px rgba(0, 255, 0, 0.6);
      }

      .file-title {
        color: #00ff00 !important;
        font-family: 'Courier New', monospace !important;
        font-size: 13px !important;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 8px;
        padding: 10px 12px;
        background: rgba(0, 60, 0, 0.5);
        border: 1px solid rgba(0, 255, 0, 0.5);
        border-left: 3px solid #00ff00;
        word-break: break-all;
        transition: all 0.3s ease;
        text-shadow: 0 0 8px #00ff00, 0 0 3px rgba(0, 255, 0, 0.4) !important;
      }

      .file-row {
        background: rgba(0, 30, 0, 0.25);
        border: 1px solid rgba(0, 170, 0, 0.5);
        border-left: 3px solid #00dd00;
        padding: 10px 15px;
        display: grid;
        grid-template-columns: 90px 1fr;
        gap: 15px;
        align-items: center;
        transition: all 0.3s ease;
        margin-bottom: 2px;
      }

      .file-row:hover {
        background: rgba(0, 50, 0, 0.4);
        box-shadow: 0 0 20px rgba(0, 255, 0, 0.25);
        border-color: #00ff00;
        border-left-color: #00ff00;
      }

      .file-type {
        background: rgba(0, 100, 0, 0.3);
        border: 1px solid #00ff00;
        padding: 6px 10px;
        text-align: center;
        font-size: 10px;
        font-weight: bold;
        color: #00ff00 !important;
        font-family: 'Courier New', monospace;
        letter-spacing: 1px;
        line-height: 1.4;
      }

      .file-size {
        color: #00aa00 !important;
        font-family: 'Courier New', monospace;
        font-size: 11px;
        text-align: center;
        letter-spacing: 0.5px;
      }

      .file-action {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
      }

      .file-btn {
        padding: 8px 18px !important;
        font-size: 10px !important;
        font-weight: bold !important;
        border: 2px solid #00ff00 !important;
        background: rgba(0, 120, 0, 0.4) !important;
        color: #00ff00 !important;
        font-family: 'Courier New', monospace !important;
        letter-spacing: 1px !important;
        white-space: nowrap;
        flex-shrink: 0;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }

      .file-btn:hover {
        background: rgba(0, 200, 0, 0.5) !important;
        box-shadow: 0 0 25px rgba(0, 255, 0, 0.9), inset 0 0 15px rgba(0, 255, 0, 0.2) !important;
        transform: scale(1.08) translateY(-2px) !important;
        border-color: #00ff00 !important;
      }

      .file-btn-delete {
        padding: 8px 18px !important;
        font-size: 10px !important;
        font-weight: bold !important;
        border: 2px solid #ff3333 !important;
        background: rgba(120, 0, 0, 0.4) !important;
        color: #ff3333 !important;
        font-family: 'Courier New', monospace !important;
        letter-spacing: 1px !important;
        white-space: nowrap;
        flex-shrink: 0;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }

      .file-btn-delete:hover {
        background: rgba(200, 0, 0, 0.5) !important;
        box-shadow: 0 0 25px rgba(255, 51, 51, 0.9), inset 0 0 15px rgba(255, 51, 51, 0.2) !important;
        transform: scale(1.08) translateY(-2px) !important;
        border-color: #ff3333 !important;
      }

      .file-btn:active {
        transform: scale(1.02) translateY(0) !important;
      }

      @keyframes matrix-fall {
        0% {
          transform: translateY(-50px) perspective(800px) rotateX(0deg) rotateZ(0deg) scale(0.8);
          opacity: 0;
          filter: brightness(0.3) blur(2px);
        }
        10% {
          opacity: 0.9;
          filter: brightness(1) blur(0px);
          transform: translateY(0px) perspective(800px) rotateX(0deg) rotateZ(0deg) scale(1);
        }
        85% {
          opacity: 0.9;
          filter: brightness(1) blur(0px);
        }
        100% {
          transform: translateY(100vh) perspective(800px) rotateX(60deg) rotateZ(8deg) scale(0.5);
          opacity: 0;
          filter: brightness(0.5) blur(2px);
        }
      }

      @keyframes matrix-fall-slow {
        0% {
          transform: translateY(-100%) perspective(1500px) rotateX(0deg) scaleY(1);
          opacity: 0;
          filter: brightness(0.3);
        }
        5% {
          opacity: 0.6;
          filter: brightness(0.8);
        }
        50% {
          filter: brightness(1);
          transform: translateY(50vh) perspective(1500px) rotateX(45deg) scaleY(1.05);
        }
        95% {
          opacity: 0.6;
          filter: brightness(0.8);
        }
        100% {
          transform: translateY(100vh) perspective(1500px) rotateX(90deg) scaleY(1);
          opacity: 0;
          filter: brightness(0.3);
        }
      }

      @keyframes matrix-drift {
        0% {
          transform: translateY(-100%) translateX(0px) perspective(2000px) rotateX(0deg) rotateY(0deg);
          opacity: 0;
        }
        5% {
          opacity: 0.4;
        }
        50% {
          transform: translateY(50vh) translateX(50px) perspective(2000px) rotateX(45deg) rotateY(15deg);
        }
        95% {
          opacity: 0.4;
        }
        100% {
          transform: translateY(100vh) translateX(100px) perspective(2000px) rotateX(90deg) rotateY(30deg);
          opacity: 0;
        }
      }

      @keyframes matrix-drift-left {
        0% {
          transform: translateY(-100%) translateX(0px) perspective(2000px) rotateX(0deg) rotateY(0deg);
          opacity: 0;
        }
        5% {
          opacity: 0.4;
        }
        50% {
          transform: translateY(50vh) translateX(-50px) perspective(2000px) rotateX(45deg) rotateY(-15deg);
        }
        95% {
          opacity: 0.4;
        }
        100% {
          transform: translateY(100vh) translateX(-100px) perspective(2000px) rotateX(90deg) rotateY(-30deg);
          opacity: 0;
        }
      }
    </style>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      @keyframes glow {
        0%, 100% {
          text-shadow: 0 0 2px #00ff00;
        }
        50% {
          text-shadow: 0 0 10px #00ff00, 0 0 20px #00ff00;
        }
      }

      body {
        font-family: 'Courier New', monospace;
        background: #000;
        min-height: 100vh;
        padding: 20px;
        overflow: hidden;
        position: relative;
      }

      .matrix-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        overflow: visible;
        z-index: 1;
        background: #000;
        perspective: 1200px;
        pointer-events: none;
      }

      .matrix-bg::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      .matrix-char {
        position: fixed;
        color: #00ff00;
        font-family: 'Courier New', monospace;
        font-weight: bold;
        font-size: 24px;
        opacity: 0.8;
        animation: matrix-fall 8s linear infinite;
        text-shadow: 0 0 10px #00ff00, 0 0 20px rgba(0, 255, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        will-change: transform, opacity;
        z-index: 1;
        pointer-events: none;
        line-height: 1;
        letter-spacing: 2px;
      }

      .matrix-char.slow {
        animation: matrix-fall-slow linear infinite;
        font-size: 18px;
        opacity: 0.6;
        color: #00aa00;
        text-shadow: 0 0 8px #00aa00;
        will-change: transform;
      }

      .matrix-char.drift {
        animation: matrix-drift linear infinite;
        font-size: 16px;
        opacity: 0.4;
        color: #008800;
        text-shadow: 0 0 4px #008800;
        will-change: transform;
      }

      .matrix-char.drift-left {
        animation: matrix-drift-left linear infinite;
        font-size: 16px;
        opacity: 0.4;
        color: #005500;
        text-shadow: 0 0 4px #005500;
        will-change: transform;
      }

      .content-wrapper {
        position: relative;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        pointer-events: auto;
      }

      .container {
        background: rgba(15, 15, 15, 0.98);
        border: 2px solid #00ff00;
        box-shadow: 0 0 20px rgba(0, 255, 0, 0.3), inset 0 0 20px rgba(0, 255, 0, 0.05);
        padding: 40px;
        width: 100%;
        max-width: 900px;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        z-index: 50;
      }

      @media (max-width: 600px) {
        .container { padding: 20px; }
        .file-row { grid-template-columns: 70px 1fr; gap: 10px; }
        h1 { font-size: 22px; }
        .input-group { flex-direction: column; gap: 8px; }
        .input-group button { width: 100%; }
      }

      h1 {
        font-size: 28px;
        margin-bottom: 10px;
        color: #00ff00;
        text-shadow: 0 0 10px #00ff00;
        letter-spacing: 2px;
        font-weight: bold;
      }

      .subtitle {
        color: #00aa00;
        margin-bottom: 30px;
        font-size: 14px;
        letter-spacing: 1px;
      }

      .input-group {
        display: flex;
        gap: 0;
        margin-bottom: 20px;
      }

      input {
        flex: 1;
        padding: 12px;
        border: 1px solid #00ff00;
        background: rgba(0, 0, 0, 0.8);
        color: #00ff00;
        font-size: 14px;
        font-family: 'Courier New', monospace;
        transition: all 0.2s;
      }

      input::placeholder {
        color: #006600;
      }

      input:focus {
        outline: none;
        box-shadow: 0 0 15px rgba(0, 255, 0, 0.5), inset 0 0 10px rgba(0, 255, 0, 0.1);
      }

      @keyframes shine {
        0% {
          background-position: -1000px 0;
        }
        100% {
          background-position: 1000px 0;
        }
      }

      @keyframes grow-hover {
        0% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
        100% {
          transform: scale(1.08);
        }
      }

      button {
        padding: 12px 30px;
        background: rgba(0, 255, 0, 0.1);
        color: #00ff00;
        border: 1px solid #00ff00;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        font-family: 'Courier New', monospace;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        letter-spacing: 1px;
        position: relative;
        overflow: hidden;
      }

      button::before {
        content: '';
        position: absolute;
        top: 0;
        left: -1000px;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.3),
          transparent
        );
        animation: none;
      }

      button:hover {
        background: rgba(0, 255, 0, 0.2);
        box-shadow: 0 0 25px rgba(0, 255, 0, 0.6), inset 0 0 15px rgba(0, 255, 0, 0.2), 0 10px 25px rgba(0, 255, 0, 0.3);
        transform: scale(1.08) translateY(-3px);
        animation: none;
      }

      button:hover::before {
        animation: shine 0.6s ease-in-out;
      }

      button:active {
        background: rgba(0, 255, 0, 0.3);
        transform: scale(1.05) translateY(-1px);
      }

      button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .download-btn {
        background: rgba(0, 120, 0, 0.4) !important;
        padding: 8px 18px !important;
        font-size: 11px !important;
        font-weight: 700 !important;
        margin: 0 !important;
        border: 2px solid #00ff00 !important;
        color: #00ff00 !important;
        font-family: 'Courier New', monospace !important;
        letter-spacing: 1px !important;
        white-space: nowrap;
        flex-shrink: 0;
        position: relative !important;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }

      .download-btn::before {
        content: '' !important;
        position: absolute !important;
        top: 0 !important;
        left: -1000px !important;
        width: 100% !important;
        height: 100% !important;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.2),
          transparent
        ) !important;
        animation: none !important;
      }

      .download-btn:hover {
        background: rgba(0, 200, 0, 0.5) !important;
        box-shadow: 0 0 25px rgba(0, 255, 0, 0.9), inset 0 0 15px rgba(0, 255, 0, 0.3) !important;
        transform: scale(1.08) translateY(-1px) !important;
        border-color: #00ff00 !important;
      }

      .download-btn:active {
        background: rgba(0, 255, 0, 0.4) !important;
        transform: scale(1.02) translateY(0) !important;
      }

      .status {
        margin-top: 20px;
        padding: 15px;
        border: 1px solid #00ff00;
        font-size: 14px;
        display: none;
        letter-spacing: 0.5px;
        opacity: 0;
        transform: translateY(-10px);
        transition: all 0.3s ease-in-out;
      }

      .status.show {
        display: block;
        opacity: 1;
        transform: translateY(0);
      }

      .status.loading {
        background: rgba(0, 50, 0, 0.3);
        color: #00ff00;
        border-color: #00ff00;
        animation: glow 1s infinite;
      }

      .status.success {
        background: rgba(0, 80, 0, 0.3);
        color: #00ff00;
        border-color: #00aa00;
      }

      .status.error {
        background: rgba(80, 0, 0, 0.3);
        color: #ff3333;
        border-color: #ff3333;
      }

      .status.duplicate {
        background: rgba(80, 40, 0, 0.3);
        color: #ffaa00;
        border-color: #ffaa00;
      }

      .duplicate-actions {
        display: flex;
        gap: 0;
        margin-top: 15px;
      }

      .duplicate-actions button {
        flex: 1;
        padding: 10px;
      }

      .skip-btn {
        background: rgba(60, 60, 60, 0.3);
        color: #999;
        border-color: #666;
      }

      .skip-btn:hover {
        background: rgba(80, 80, 80, 0.3);
        box-shadow: 0 0 10px rgba(100, 100, 100, 0.3);
      }

      .overwrite-btn {
        background: rgba(100, 0, 0, 0.2);
        color: #ff3333;
        border-color: #ff3333;
      }

      .overwrite-btn:hover {
        background: rgba(150, 0, 0, 0.3);
        box-shadow: 0 0 10px rgba(255, 50, 50, 0.4);
      }

      .checkbox-group {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
      }

      .checkbox-group input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #00ff00;
      }

      .checkbox-group label {
        font-size: 13px;
        color: #00aa00;
        cursor: pointer;
      }

      .transcripts-section {
        margin-top: 40px;
        padding-top: 0;
        border-top: 1px solid #00ff00;
        max-height: 300px;
        overflow-y: auto;
        padding-right: 10px;
        position: relative;
      }

      .transcripts-section::-webkit-scrollbar {
        width: 8px;
      }

      .transcripts-section::-webkit-scrollbar-track {
        background: rgba(0, 255, 0, 0.1);
      }

      .transcripts-section::-webkit-scrollbar-thumb {
        background: #00ff00;
        border-radius: 0;
      }

      .transcripts-section h2 {
        font-size: 16px;
        margin-bottom: 20px;
        margin-top: 0;
        color: #00ff00;
        text-shadow: 0 0 12px #00ff00;
        letter-spacing: 2px;
        font-weight: bold;
        position: sticky;
        top: 0;
        background: rgba(15, 15, 15, 0.98);
        padding: 10px 0 10px 0;
        border-bottom: 1px solid rgba(0, 255, 0, 0.3);
        z-index: 10;
      }

      .empty-state {
        text-align: center;
        padding: 30px 20px;
        color: #006600;
      }

      .empty-state-icon {
        font-size: 48px;
        margin-bottom: 10px;
      }

      /* ---------- Terms of Service modal ---------- */
      #tos-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 100;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.85);
        padding: 20px;
      }
      #tos-overlay.open { display: flex; }

      .tos-box {
        width: min(620px, 94vw);
        max-height: 84vh;
        overflow-y: auto;
        background: #000;
        border: 2px solid #00ff00;
        box-shadow: 0 0 25px rgba(0, 255, 0, 0.5), inset 0 0 20px rgba(0, 255, 0, 0.05);
        padding: 28px;
        font-family: 'Courier New', monospace;
      }

      .tos-box h1 {
        font-size: 20px;
        letter-spacing: 2px;
        color: #00ff00;
        text-shadow: 0 0 10px #00ff00, 0 0 4px #00ff00;
        margin-bottom: 6px;
        text-transform: uppercase;
      }

      .tos-box .tos-sub {
        color: #009900;
        font-size: 11px;
        margin-bottom: 26px;
        font-style: italic;
      }

      .tos-box h2 {
        color: #00e0ff;
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin: 22px 0 8px;
      }
      .tos-box h2:first-of-type { margin-top: 0; }

      .tos-box p {
        color: #00cc00;
        font-size: 12.5px;
        line-height: 1.7;
      }

      .tos-box .tos-contact {
        color: #00ff00;
        text-shadow: 0 0 6px rgba(0, 255, 0, 0.6);
      }

      #tos-close {
        all: unset;
        display: block;
        margin: 26px auto 0;
        cursor: pointer;
        padding: 10px 22px;
        border: 2px solid #00ff00;
        background: rgba(0, 60, 0, 0.5);
        color: #00ff00;
        font-family: 'Courier New', monospace;
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
        text-align: center;
        transition: background 0.2s ease, box-shadow 0.2s ease;
      }
      #tos-close:hover {
        background: rgba(0, 200, 0, 0.3);
        box-shadow: 0 0 15px rgba(0, 255, 0, 0.5);
      }
    </style>
  </head>
  <body>
    <div class="matrix-bg" id="matrixBg"></div>

    <div class="content-wrapper">
      <div class="container">
        <a href="/" id="homeLink" style="display:inline-block; color:#00ff00; text-decoration:none; border:1px solid #00ff00; padding:6px 12px; font-size:11px; letter-spacing:1px; margin-bottom:15px; font-family:'Courier New', monospace; cursor:pointer;">&larr; HOME</a>
        <a href="#" id="tosLink" style="display:inline-block; color:#00ff00; text-decoration:none; border:1px solid #00ff00; padding:6px 12px; font-size:11px; letter-spacing:1px; margin-bottom:15px; margin-left:8px; font-family:'Courier New', monospace; cursor:pointer;">TERMS OF SERVICE</a>

        <!-- Terms of Service modal -->
        <div id="tos-overlay" role="dialog" aria-modal="true" aria-labelledby="tos-title">
          <div class="tos-box">
            <h1 id="tos-title">Terms of Service</h1>
            <p class="tos-sub">YouTube Transcript / Video / Audio Downloader</p>

            <h2>&gt;&gt;&gt; Your Responsibility</h2>
            <p>
              You are responsible for ensuring all downloads comply with copyright law.
              Do not download copyrighted content without permission.
            </p>

            <h2>&gt;&gt;&gt; How It Works</h2>
            <p>
              This service converts videos on-demand and streams the result directly to
              you. Files are not stored on our server — only on your device.
            </p>

            <h2>&gt;&gt;&gt; Your Download History</h2>
            <p>
              Your download history is stored locally in your browser using localStorage.
              Clearing your browser cache will clear this history. History is private
              and not shared with us or other users.
            </p>

            <h2>&gt;&gt;&gt; No Liability</h2>
            <p>
              We provide this tool as-is with no warranty. We are not liable for lost
              files, misuse, or legal consequences from user actions.
            </p>

            <h2>&gt;&gt;&gt; DMCA Takedown</h2>
            <p>
              Since we do not store files, DMCA notices are not applicable. If you have
              concerns about specific content, contact YouTube directly at
              <span class="tos-contact">https://www.youtube.com/copyright_complaint_form</span>
            </p>

            <h2>&gt;&gt;&gt; No Warranty</h2>
            <p>This service is provided as-is. No guarantees of uptime or availability.</p>

            <button id="tos-close">Close</button>
          </div>
        </div>
        <h1>> YT-TRANSCRIPT_PLUS</h1>
        <p class="subtitle">>> Download transcripts & videos from YouTube</p>
        <p style="color: #006600; font-size: 11px; margin-top: 5px; margin-bottom: 30px; letter-spacing: 1px; text-align: right;">a widget by EEN</p>

        <div style="margin-bottom: 30px;">
          <p style="color: #00aa00; font-size: 12px; margin-bottom: 10px; letter-spacing: 1px;">>>> TRANSCRIPT MODE</p>
          <div class="input-group">
            <input
              type="text"
              id="youtubeUrl"
              placeholder="https://www.youtube.com/watch?v=..."
              autocomplete="off"
            />
            <button id="fetchBtn">[FETCH]</button>
          </div>
        </div>

        <div style="margin-bottom: 30px;">
          <p style="color: #00aa00; font-size: 12px; margin-bottom: 10px; letter-spacing: 1px;">>>> VIDEO MODE</p>
          <div class="input-group">
            <input
              type="text"
              id="videoUrl"
              placeholder="https://www.youtube.com/watch?v=..."
              autocomplete="off"
            />
            <button id="downloadVideoBtn">[DOWNLOAD]</button>
          </div>
        </div>

        <div style="margin-bottom: 30px;">
          <p style="color: #00aa00; font-size: 12px; margin-bottom: 10px; letter-spacing: 1px;">>>> AUDIO MODE (MP3)</p>
          <div class="input-group">
            <input
              type="text"
              id="audioUrl"
              placeholder="https://www.youtube.com/watch?v=..."
              autocomplete="off"
            />
            <button id="downloadAudioBtn">[DOWNLOAD]</button>
          </div>
        </div>

        <div id="status" class="status"></div>

        <div class="transcripts-section">
          <h2>>>> YOUR DOWNLOADS</h2>
          <p style="color: #006600; font-size: 10px; margin-bottom: 12px;">
            Tracked locally in your browser only — nothing is stored on our server.
          </p>
          <div id="downloadsHistoryList">
            <div class="empty-state">
              <div class="empty-state-icon">∅</div>
              <p>No downloads yet</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      // Matrix rain effect with 0s and 1s
      function initMatrix() {
        const matrixBg = document.getElementById('matrixBg');
        if (!matrixBg) return;

        // Create foreground layer - fast falling 0s and 1s with staggered timing
        let totalChars = 0;
        for (let i = 0; i < 60; i++) {
          const char = document.createElement('div');
          char.className = 'matrix-char';
          char.textContent = Math.random() > 0.5 ? '0' : '1';
          const leftPos = Math.random() * 100;
          char.style.left = leftPos + '%';
          char.style.top = '-50px';
          const duration = Math.random() * 3 + 5;
          const delay = (i / 60) * 0.3 + Math.random() * 0.2;
          char.style.animationDuration = duration + 's';
          char.style.animationDelay = delay + 's';
          char.style.fontSize = '28px';
          matrixBg.appendChild(char);
          totalChars++;
        }

        // Create mid layer - medium speed 0s and 1s
        for (let i = 0; i < 40; i++) {
          const char = document.createElement('div');
          char.className = 'matrix-char slow';
          char.textContent = Math.random() > 0.5 ? '0' : '1';
          char.style.left = Math.random() * 100 + '%';
          const duration = Math.random() * 6 + 8;
          const delay = (i / 40) * 0.8 + Math.random() * 0.5;
          char.style.animationDuration = duration + 's';
          char.style.animationDelay = delay + 's';
          char.style.opacity = String(0.5 + Math.random() * 0.2);
          matrixBg.appendChild(char);
          totalChars++;
        }

        // Create background layer - drifting right
        for (let i = 0; i < 30; i++) {
          const char = document.createElement('div');
          char.className = 'matrix-char drift';
          char.textContent = Math.random() > 0.5 ? '0' : '1';
          char.style.left = Math.random() * 100 + '%';
          const duration = Math.random() * 10 + 12;
          const delay = (i / 30) * 1.2 + Math.random() * 0.8;
          char.style.animationDuration = duration + 's';
          char.style.animationDelay = delay + 's';
          char.style.opacity = String(0.3 + Math.random() * 0.15);
          matrixBg.appendChild(char);
          totalChars++;
        }

        // Create background layer - drifting left
        for (let i = 0; i < 30; i++) {
          const char = document.createElement('div');
          char.className = 'matrix-char drift-left';
          char.textContent = Math.random() > 0.5 ? '0' : '1';
          char.style.left = Math.random() * 100 + '%';
          const duration = Math.random() * 10 + 12;
          const delay = (i / 30) * 1.2 + Math.random() * 0.8;
          char.style.animationDuration = duration + 's';
          char.style.animationDelay = delay + 's';
          char.style.opacity = String(0.25 + Math.random() * 0.1);
          matrixBg.appendChild(char);
          totalChars++;
        }
      }

      // Home button handler - navigates in same tab
      function goHome(e) {
        e.preventDefault();
        e.stopPropagation();
        window.location.href = 'https://iantopia.com/';
      }

      // Set home link handler
      const homeLink = document.getElementById('homeLink');
      if (homeLink) {
        homeLink.removeAttribute('href');
        homeLink.style.cursor = 'pointer';
        homeLink.addEventListener('click', goHome);
      }

      // Wait for DOM to be fully loaded
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMatrix);
      } else {
        initMatrix();
      }

      // Relative path — nginx proxies /api/ to the backend container on
      // port 80, so this works identically whether accessed via
      // iantopia.com, localhost, or qasim's IP directly.
      const API_BASE = '/api';

      const urlInput = document.getElementById("youtubeUrl");
      const fetchBtn = document.getElementById("fetchBtn");
      const videoInput = document.getElementById("videoUrl");
      const downloadVideoBtn = document.getElementById("downloadVideoBtn");
      const audioInput = document.getElementById("audioUrl");
      const downloadAudioBtn = document.getElementById("downloadAudioBtn");
      const statusDiv = document.getElementById("status");
      const downloadsHistoryList = document.getElementById("downloadsHistoryList");

      fetchBtn.addEventListener("click", handleFetch);
      urlInput.addEventListener("keypress", (e) => {
        if (e.key === "Enter") handleFetch();
      });

      downloadVideoBtn.addEventListener("click", handleDownloadVideo);
      videoInput.addEventListener("keypress", (e) => {
        if (e.key === "Enter") handleDownloadVideo();
      });

      downloadAudioBtn.addEventListener("click", handleDownloadAudio);
      audioInput.addEventListener("keypress", (e) => {
        if (e.key === "Enter") handleDownloadAudio();
      });

      // --- Download history (localStorage-only; nothing is stored server-side) ---
      const HISTORY_KEY = "downloadHistory";

      function getDownloadHistory() {
        try {
          return JSON.parse(localStorage.getItem(HISTORY_KEY) || "[]");
        } catch {
          return [];
        }
      }

      function saveDownloadHistory(history) {
        localStorage.setItem(HISTORY_KEY, JSON.stringify(history));
      }

      function addToDownloadHistory(entry) {
        const history = getDownloadHistory();
        history.unshift({ id: `${Date.now()}-${Math.random().toString(36).slice(2)}`, ...entry });
        saveDownloadHistory(history);
        renderDownloadHistory();
      }

      function forgetDownload(id) {
        const history = getDownloadHistory().filter((entry) => entry.id !== id);
        saveDownloadHistory(history);
        renderDownloadHistory();
      }

      const TYPE_LABELS = { transcript: "TX", video: "VD", audio: "MP3" };

      function renderDownloadHistory() {
        const history = getDownloadHistory();

        if (history.length === 0) {
          downloadsHistoryList.innerHTML = `
            <div class="empty-state">
              <div class="empty-state-icon">∅</div>
              <p>No downloads yet</p>
            </div>
          `;
          return;
        }

        downloadsHistoryList.innerHTML = history.map((entry) => `
          <div class="file-item">
            <div class="file-title" title="${entry.filename}">➤ ${entry.filename}</div>
            <div class="file-row">
              <div class="file-type">${TYPE_LABELS[entry.type] || "?"}<br/><span class="file-size">${new Date(entry.timestamp).toLocaleDateString()}</span></div>
              <div class="file-action">
                <button class="file-btn" data-redownload-id="${entry.id}">[REDOWNLOAD]</button>
                <button class="file-btn-delete" data-id="${entry.id}">[FORGET]</button>
              </div>
            </div>
          </div>
        `).join("");
      }

      // Nothing is stored server-side, so a "redownload" is really just
      // re-running the original fetch against the same source URL — the
      // history entry only ever held metadata + the source url, never bytes.
      const DOWNLOAD_CONFIG = {
        transcript: { endpoint: "fetch-transcript", fallbackFilename: "transcript.txt", loadingMessage: ">>> Processing..." },
        video: { endpoint: "download-video", fallbackFilename: "video.mp4", loadingMessage: ">>> Downloading video... (this may take a while)" },
        audio: { endpoint: "download-audio", fallbackFilename: "audio.mp3", loadingMessage: ">>> Extracting audio... (this may take a while)" },
      };

      async function redownloadEntry(id, button) {
        const entry = getDownloadHistory().find((e) => e.id === id);
        const config = entry && DOWNLOAD_CONFIG[entry.type];
        if (!config) {
          showStatus("error", ">>> ERROR: Can't redownload — unknown entry");
          return;
        }
        await streamDownload({ ...config, url: entry.url, type: entry.type, button });
      }

      downloadsHistoryList.addEventListener("click", (e) => {
        const redownloadBtn = e.target.closest("button[data-redownload-id]");
        if (redownloadBtn) {
          redownloadEntry(redownloadBtn.dataset.redownloadId, redownloadBtn);
          return;
        }
        const forgetBtn = e.target.closest("button[data-id]");
        if (forgetBtn) {
          forgetDownload(forgetBtn.dataset.id);
        }
      });

      renderDownloadHistory();

      // Extracts the server-provided filename from a Content-Disposition
      // header (e.g. `attachment; filename="Some Title.mp3"`), falling
      // back to the given default if the header is missing/unparseable.
      function filenameFromResponse(response, fallback) {
        const cd = response.headers.get("content-disposition") || "";
        const match = cd.match(/filename\*?=(?:UTF-8'')?"?([^";\n]+)"?/i);
        if (match && match[1]) {
          try {
            return decodeURIComponent(match[1]);
          } catch {
            return match[1];
          }
        }
        return fallback;
      }

      // Streams a blob to the user as a file download via a throwaway
      // object URL — the file only ever exists in browser memory.
      function triggerBrowserDownload(blob, filename) {
        const objectUrl = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = objectUrl;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(objectUrl);
      }

      async function streamDownload({ endpoint, url, type, fallbackFilename, button, loadingMessage }) {
        button.disabled = true;
        showStatus("loading", loadingMessage);

        try {
          const response = await fetch(`${API_BASE}/${endpoint}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ url }),
          });

          if (!response.ok) {
            const data = await response.json().catch(() => ({}));
            showStatus("error", `>>> ERROR: ${data.detail || "Unknown error"}`);
            return;
          }

          const blob = await response.blob();
          const filename = filenameFromResponse(response, fallbackFilename);
          triggerBrowserDownload(blob, filename);

          addToDownloadHistory({ filename, type, timestamp: new Date().toISOString(), url });
          showStatus("success", `✓ Downloaded: ${filename}`);
        } catch (error) {
          showStatus("error", `>>> ERROR: ${error.message}`);
        } finally {
          button.disabled = false;
        }
      }

      async function handleFetch() {
        const url = urlInput.value.trim();
        if (!url) {
          showStatus("error", ">>> ERROR: URL field empty");
          return;
        }

        await streamDownload({
          endpoint: "fetch-transcript",
          url,
          type: "transcript",
          fallbackFilename: "transcript.txt",
          button: fetchBtn,
          loadingMessage: ">>> Processing...",
        });
        urlInput.value = "";
      }

      async function handleDownloadVideo() {
        const url = videoInput.value.trim();
        if (!url) {
          showStatus("error", ">>> ERROR: Video URL field empty");
          return;
        }

        await streamDownload({
          endpoint: "download-video",
          url,
          type: "video",
          fallbackFilename: "video.mp4",
          button: downloadVideoBtn,
          loadingMessage: ">>> Downloading video... (this may take a while)",
        });
        videoInput.value = "";
      }

      async function handleDownloadAudio() {
        const url = audioInput.value.trim();
        if (!url) {
          showStatus("error", ">>> ERROR: Audio URL field empty");
          return;
        }

        await streamDownload({
          endpoint: "download-audio",
          url,
          type: "audio",
          fallbackFilename: "audio.mp3",
          button: downloadAudioBtn,
          loadingMessage: ">>> Extracting audio... (this may take a while)",
        });
        audioInput.value = "";
      }

      function showStatus(type, message) {
        statusDiv.textContent = message;
        statusDiv.className = `status show ${type}`;
      }

      // --- Terms of Service modal ---
      const tosLink = document.getElementById('tosLink');
      const tosOverlay = document.getElementById('tos-overlay');
      const tosClose = document.getElementById('tos-close');

      tosLink.addEventListener('click', (e) => {
        e.preventDefault();
        tosOverlay.classList.add('open');
      });
      tosClose.addEventListener('click', () => tosOverlay.classList.remove('open'));
      tosOverlay.addEventListener('click', (e) => {
        if (e.target === tosOverlay) tosOverlay.classList.remove('open');
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') tosOverlay.classList.remove('open');
      });
    </script>
  </body>
</html>
